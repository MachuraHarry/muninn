# Secrets — niemals committen
.env
*.key
*_key
*TOKEN*

# Lokale Zustandsdaten (Seele, sqlite-Dateien)
.data/
*.db
*.sqlite
*.sqlite3
*.log
*.lock

# MCP-Laufzeitdaten (Filesystem-Server-Sandbox, Playwright-Snapshots)
mcp_data/
.playwright-mcp/

# Playwright-Browserprofil (echte Session-Cookies fuer dauerhafte Logins)
.playwright-profile/

# Google-OAuth-Tokens (bewusst AUSSERHALB von mcp_data, siehe google_creds/README)
google_creds/

# TTS-Zwischendateien (Sprachnachrichten-Synthese, siehe tts_synth.sh)
tts_tmp/

# Vault-Zwischendateien (openssl-Ver-/Entschluesselung, siehe vault.pipe) -
# Klartext liegt hier nur Sekundenbruchteile, wird nach jedem Aufruf geloescht
.vault_tmp/

# Pipe-Caches / Bytecode
~/.pipe
*.pipec
__pycache__/
*.pyc

# OS
.DS_Store
