--! muninn_test.pipe — deterministische Tests für Muninn (ohne KI, ohne Netz).
--! Ausführen:  pipe -test   (aus dem muninn/ Verzeichnis)
import "pipe-test"
import "sqlite"
import "modules/memory.pipe" as mem
import "modules/swarm.pipe" as grm
import "modules/executor.pipe" as exe
import "modules/web.pipe" as web
import "modules/mcp.pipe" as mcp
import "modules/scheduler.pipe" as sched
import "modules/docker_tools.pipe" as dt

--! Regelklassifikation: Kategorien ohne KI.
test "rule_classify erkennt 'merke/erinnere' als permanent"
    expect_eq (mem.rule_classify "Merke dir, dass ich Tee mag") "permanent" "merke -> permanent"
    expect_eq (mem.rule_classify "Erinnere mich an den Zahnarzt") "reminder" "erinnere -> reminder"

test "rule_classify erkennt Aufgaben"
    expect_eq (mem.rule_classify "Erledige bitte das Reporting") "task" "erledige -> task"
    expect_eq (mem.rule_classify "Mache die Hausaufgaben") "task" "mache -> task"

test "rule_classify erkennt Ziele"
    expect_eq (mem.rule_classify "Mein Ziel ist es, Pipe zu lernen") "goal" "ziel -> goal"

test "rule_classify erkennt Fragen"
    expect_eq (mem.rule_classify "Warum regnet es?") "question" "? -> question"

test "rule_classify fällt sonst auf Frage zurück"
    expect_eq (mem.rule_classify "Heute ist schönes Wetter") "question" "default question"

--! sql_escape: einfache Anführungszeichen verdoppeln.
test "sql_escape verdoppelt Hochkommas"
    expect_eq (mem.sql_escape "O'Brien") "O''Brien" "quote escaped"

--! Seele: meta + memories auf einer In-Memory-DB.
test "meta_set/meta_get Roundtrip"
    h: mem.init_db ":memory:"
    mem.meta_set h "bot_name" "Muninn"
    expect_eq (mem.meta_get h "bot_name") "Muninn" "roundtrip"
    mem.close h

--! /settings (P6): setting_get/setting_set-Roundtrip + Default ohne
--! gesetzten Wert, getrennt pro Chat (zwei Chats teilen sich NICHT dieselbe
--! Einstellung).
test "setting_get/setting_set Roundtrip mit Default und Chat-Trennung"
    h: mem.init_db ":memory:"
    expect_eq (mem.setting_get h "1" "style" "normal") "normal" "unbekannt -> default"
    mem.setting_set h "1" "style" "knapp"
    expect_eq (mem.setting_get h "1" "style" "normal") "knapp" "roundtrip"
    expect_eq (mem.setting_get h "2" "style" "normal") "normal" "anderer Chat unbeeinflusst"

--! setting_cycle: jeder Einstellungswert rotiert deterministisch durch alle
--! seine erlaubten Werte und kommt am Ende wieder beim Start an.
test "setting_cycle rotiert durch alle Werte und kommt zurueck zum Start"
    expect_eq (mem.setting_cycle "style" "knapp") "normal" "style knapp -> normal"
    expect_eq (mem.setting_cycle "style" "normal") "ausfuehrlich" "style normal -> ausfuehrlich"
    expect_eq (mem.setting_cycle "style" "ausfuehrlich") "knapp" "style ausfuehrlich -> knapp"
    expect_eq (mem.setting_cycle "sprache" "de") "en" "sprache de -> en"
    expect_eq (mem.setting_cycle "sprache" "en") "de" "sprache en -> de"
    expect_eq (mem.setting_cycle "proaktiv" "on") "off" "proaktiv on -> off"
    expect_eq (mem.setting_cycle "proaktiv" "off") "on" "proaktiv off -> on"
    expect_eq (mem.setting_cycle "gedaechtnis" "locker") "normal" "gedaechtnis locker -> normal"
    expect_eq (mem.setting_cycle "gedaechtnis" "normal") "streng" "gedaechtnis normal -> streng"
    expect_eq (mem.setting_cycle "gedaechtnis" "streng") "locker" "gedaechtnis streng -> locker"

test "settings_prompt_prefix ist leer bei Standardeinstellungen, sonst mit Hinweis"
    h: mem.init_db ":memory:"
    expect_eq (mem.settings_prompt_prefix h "1") "" "Standard -> kein Hinweis"
    mem.setting_set h "1" "sprache" "en"
    expect_eq (contains (mem.settings_prompt_prefix h "1") "ENGLISCH") true "Sprache-Hinweis enthalten"

test "setting_proaktiv_enabled folgt der Einstellung, Standard ist an"
    h: mem.init_db ":memory:"
    expect_eq (mem.setting_proaktiv_enabled h "1") true "Standard: proaktiv an"
    mem.setting_set h "1" "proaktiv" "off"
    expect_eq (mem.setting_proaktiv_enabled h "1") false "nach Abschalten: aus"

--! Selbst-Diagnose (P7): log_error/error_summary gruppieren nach tag und
--! zaehlen korrekt, auch bei mehreren verschiedenen tags durcheinander.
test "log_error/error_summary gruppiert nach tag und zaehlt korrekt"
    h: mem.init_db ":memory:"
    mem.log_error h "run_gremium_stream" "Fehler A"
    mem.log_error h "run_gremium_stream" "Fehler B"
    mem.log_error h "handle_update" "Fehler C"
    summary: mem.error_summary h 7
    expect_eq (len summary) 2 "zwei verschiedene tags"
    top: at summary 0
    expect_eq (get top "tag") "run_gremium_stream" "haeufigster tag zuerst"
    expect_eq (get top "cnt") 2 "zweimal gezaehlt"

test "error_summary ignoriert Eintraege ausserhalb des Zeitfensters"
    h: mem.init_db ":memory:"
    mem.log_error h "alter_fehler" "laengst vorbei"
    db_exec h ("UPDATE error_log SET ts = '" ++ (mem.cutoff_ts 10) ++ "' WHERE tag = 'alter_fehler'")
    mem.log_error h "neuer_fehler" "gerade eben"
    summary3: mem.error_summary h 3
    expect_eq (len summary3) 1 "nur der neue Fehler zaehlt bei 3 Tagen Fenster"
    expect_eq (get (at summary3 0) "tag") "neuer_fehler" "der aktuelle Fehler"

test "prune_error_log entfernt nur Eintraege aelter als N Tage"
    h: mem.init_db ":memory:"
    mem.log_error h "alt" "wird geloescht"
    db_exec h ("UPDATE error_log SET ts = '" ++ (mem.cutoff_ts 40) ++ "' WHERE tag = 'alt'")
    mem.log_error h "neu" "bleibt"
    mem.prune_error_log h 30
    rows: db_query h "SELECT tag FROM error_log"
    expect_eq (len rows) 1 "nur ein Eintrag uebrig"
    expect_eq (get (at rows 0) "tag") "neu" "der neue Eintrag bleibt"

test "setting_consolidate_days liefert die richtigen Tage je Stufe"
    h: mem.init_db ":memory:"
    normal: mem.setting_consolidate_days h "1"
    expect_eq (get normal "decay") 14 "normal decay"
    expect_eq (get normal "forget") 30 "normal forget"
    mem.setting_set h "1" "gedaechtnis" "locker"
    locker: mem.setting_consolidate_days h "1"
    expect_eq (get locker "decay") 30 "locker decay"
    expect_eq (get locker "forget") 60 "locker forget"
    mem.setting_set h "1" "gedaechtnis" "streng"
    streng: mem.setting_consolidate_days h "1"
    expect_eq (get streng "decay") 7 "streng decay"
    expect_eq (get streng "forget") 14 "streng forget"

test "add_memory und top_memories nach Importance"
    h: mem.init_db ":memory:"
    mem.add_memory h "Espresso-Vorliebe" "permanent" 4 "test" "persoenlich"
    mem.add_memory h "Hausarbeit erledigen" "task" 2 "test" "persoenlich"
    expect_eq (mem.memory_count h) 2 "zwei Erinnerungen"
    top: mem.top_memories h 1
    expect_eq (get (at top 0) "content") "Espresso-Vorliebe" "hoechste Importance zuerst"
    mem.close h

test "recipes liefert nur Rezepte, wichtigste zuerst"
    h: mem.init_db ":memory:"
    mem.add_memory h "REZEPT: BTC-Kurs — btc-echo.de abrufen, zusammenfassen" "rezept" 4 "test" "rezept"
    mem.add_memory h "Ganz normale Erinnerung" "permanent" 5 "test" "x"
    mem.add_memory h "REZEPT: Wetterbericht — wetter.com abrufen, kurz vorlesen" "rezept" 2 "test" "rezept"
    rs: mem.recipes h
    expect_eq (len rs) 2 "nur die zwei Rezepte"
    expect_eq (at rs 0) "REZEPT: BTC-Kurs — btc-echo.de abrufen, zusammenfassen" "wichtigstes Rezept zuerst"
    expect_eq (at rs 1) "REZEPT: Wetterbericht — wetter.com abrufen, kurz vorlesen" "zweites Rezept danach"
    mem.close h

test "set_importance aendert die Importance einer Erinnerung"
    h: mem.init_db ":memory:"
    id: mem.add_memory h "Notiz" "fact" 2 "test" "x"
    mem.set_importance h id 5
    top: mem.top_memories h 1
    expect_eq (get (at top 0) "importance") 5 "importance aktualisiert"
    mem.close h

--! Ziele (Web-Dashboard P3).
test "list_goals liefert die juengsten Ziele mit Status"
    h: mem.init_db ":memory:"
    mem.add_goal h "Pipe lernen"
    mem.add_goal h "Muninn ausbauen"
    goals: mem.list_goals h 10
    expect_eq (len goals) 2 "zwei Ziele"
    expect_eq (get (at goals 0) "goal_text") "Muninn ausbauen" "neuestes zuerst"
    expect_eq (get (at goals 0) "status") "offen" "Default-Status offen"
    mem.close h

test "set_goal_status aendert den Status eines Ziels"
    h: mem.init_db ":memory:"
    id: mem.add_goal h "Pipe lernen"
    mem.set_goal_status h id "erledigt"
    goals: mem.list_goals h 10
    expect_eq (get (at goals 0) "status") "erledigt" "Status aktualisiert"
    mem.close h

test "log_event protokolliert Ereignisse"
    h: mem.init_db ":memory:"
    mem.log_event h "42" "Hallo" "fleeting"
    rows: mem.recent_events h 1
    expect_eq (get (at rows 0) "msg") "Hallo" "event gespeichert"
    mem.close h

--! Episodisches Gedaechtnis (P2): Threads + Nachrichtenverlauf pro Chat.
test "active_thread ist pro Chat stabil (legt nur einmal an)"
    h: mem.init_db ":memory:"
    t1: mem.active_thread h "42"
    t2: mem.active_thread h "42"
    expect_eq t1 t2 "gleicher Chat -> gleicher aktiver Thread"
    mem.close h

test "active_thread unterscheidet Chats"
    h: mem.init_db ":memory:"
    ta: mem.active_thread h "1"
    tb: mem.active_thread h "2"
    expect_falsy (ta == tb) "verschiedene Chats -> verschiedene Threads"
    mem.close h

test "add_message/thread_history liefert chronologische Reihenfolge"
    h: mem.init_db ":memory:"
    tid: mem.active_thread h "42"
    mem.add_message h tid "42" "user" "Frage 1"
    mem.add_message h tid "42" "assistant" "Antwort 1"
    mem.add_message h tid "42" "user" "Frage 2"
    hist: mem.thread_history h tid 10
    expect_eq (len hist) 3 "drei Nachrichten"
    expect_eq (get (at hist 0) "content") "Frage 1" "aeltester zuerst"
    expect_eq (get (at hist 2) "content") "Frage 2" "neuester zuletzt"
    mem.close h

test "thread_history begrenzt auf n juengste Nachrichten"
    h: mem.init_db ":memory:"
    tid: mem.active_thread h "1"
    mem.add_message h tid "1" "user" "a"
    mem.add_message h tid "1" "user" "b"
    mem.add_message h tid "1" "user" "c"
    hist: mem.thread_history h tid 2
    expect_eq (len hist) 2 "nur die letzten 2"
    expect_eq (get (at hist 0) "content") "b" "b zuerst von den letzten beiden"
    expect_eq (get (at hist 1) "content") "c" "c zuletzt"
    mem.close h

test "format_history rendert Rollen lesbar"
    rows: [{role: "user", content: "Hallo"}, {role: "assistant", content: "Hi!"}]
    out: mem.format_history rows
    expect_contains out "Nutzer: Hallo" "Nutzer-Zeile"
    expect_contains out "Muninn: Hi!" "Muninn-Zeile"

test "close_thread beendet den aktiven Thread; naechster Aufruf legt frischen an"
    h: mem.init_db ":memory:"
    t1: mem.active_thread h "7"
    mem.add_message h t1 "7" "user" "alte Nachricht"
    mem.close_thread h "7"
    t2: mem.active_thread h "7"
    expect_falsy (t1 == t2) "neuer Thread nach /reset"
    hist: mem.thread_history h t2 10
    expect_eq (len hist) 0 "frischer Thread ist leer"
    mem.close h

--! open_locked/close_locked (P3): Wrapper um init_db/close mit echter
--! OS-Sperre (file_lock/file_unlock, in Pipe selbst getestet). Nutzt eine
--! echte Datei statt ":memory:", da eine Sperre nur fuer Dateien Sinn ergibt.
test "open_locked/close_locked liefern eine funktionsfaehige, persistente DB"
    path: "/tmp/muninn_test_open_locked.db"
    if file_exists path
        file_delete path
    hl: mem.open_locked path
    expect_eq ((get hl "h") != nil) true "h vorhanden"
    expect_eq ((get hl "lock") != nil) true "lock vorhanden"
    mem.add_memory (get hl "h") "Gesperrt gespeichert" "fact" 3 "test" "x"
    mem.close_locked hl
    hl2: mem.open_locked path
    expect_eq (mem.memory_count (get hl2 "h")) 1 "Erinnerung nach close_locked persistiert"
    mem.close_locked hl2
    file_delete path

--! Konsolidierung ("Traum", P2): Zeitstempel + Verdichtung/Vergessen.
--! Hinweis: datetime('now') wird vom reinen-Pipe-sqlite-Modul NICHT ausgewertet
--! (siehe now_ts-Kommentar in memory.pipe) — now_ts baut den Zeitstempel daher
--! selbst; diese Tests decken auch das ab.
test "now_ts liefert ein sortierbares 19-Zeichen-Datumsformat"
    ts: mem.now_ts 0
    expect_eq (len ts) 19 "YYYY-MM-DD HH:MM:SS"

test "cutoff_ts liegt in der Vergangenheit von now_ts"
    c: mem.cutoff_ts 1
    n: mem.now_ts 0
    expect_eq (c < n) true "1 Tag zurueck < jetzt"

test "consolidate_threads verdichtet einen geschlossenen Thread zu einer Zusammenfassung"
    h: mem.init_db ":memory:"
    tid: mem.active_thread h "5"
    mem.add_message h tid "5" "user" "Ich mag Espresso sehr."
    mem.add_message h tid "5" "assistant" "Notiert."
    mem.close_thread h "5"
    done: mem.consolidate_threads h 3
    expect_eq done 1 "ein Thread verdichtet"
    hist: mem.thread_history h tid 10
    expect_eq (len hist) 0 "Rohnachrichten geloescht"
    top: mem.top_memories h 5
    expect_eq (len top) 1 "eine Zusammenfassung gespeichert"
    expect_eq (get (at top 0) "kind") "summary" "kind summary"

test "consolidate_threads laesst aktive, junge Threads unangetastet"
    h: mem.init_db ":memory:"
    tid: mem.active_thread h "6"
    mem.add_message h tid "6" "user" "Frisches Gespraech"
    done: mem.consolidate_threads h 3
    expect_eq done 0 "kein Thread faellig"
    hist: mem.thread_history h tid 10
    expect_eq (len hist) 1 "Nachricht bleibt erhalten"

test "consolidate_memories senkt Importance alter, nicht-permanenter Erinnerungen"
    h: mem.init_db ":memory:"
    id: mem.add_memory h "Alte Notiz" "fact" 3 "test" "x"
    db_exec h ("UPDATE memories SET ts = '" ++ (mem.cutoff_ts 30) ++ "' WHERE id = " ++ (to_str id))
    res: mem.consolidate_memories h 14 60
    expect_eq (get res "decayed") 1 "eine Erinnerung gealtert"
    top: mem.top_memories h 5
    expect_eq (get (at top 0) "importance") 2 "importance von 3 auf 2 gesenkt"

test "consolidate_memories vergisst alte Erinnerungen bei Importance 0"
    h: mem.init_db ":memory:"
    id: mem.add_memory h "Laengst vergessen" "fact" 0 "test" "x"
    db_exec h ("UPDATE memories SET ts = '" ++ (mem.cutoff_ts 40) ++ "' WHERE id = " ++ (to_str id))
    res: mem.consolidate_memories h 14 30
    expect_eq (get res "forgotten") 1 "eine Erinnerung vergessen"
    expect_eq (mem.memory_count h) 0 "geloescht"

test "consolidate_memories laesst 'permanent' unangetastet"
    h: mem.init_db ":memory:"
    id: mem.add_memory h "Wichtige Dauer-Erinnerung" "permanent" 3 "test" "x"
    db_exec h ("UPDATE memories SET ts = '" ++ (mem.cutoff_ts 100) ++ "' WHERE id = " ++ (to_str id))
    res: mem.consolidate_memories h 1 1
    expect_eq (get res "decayed") 0 "permanent decayt nicht"
    expect_eq (get res "forgotten") 0 "permanent wird nicht vergessen"
    top: mem.top_memories h 5
    expect_eq (get (at top 0) "importance") 3 "importance unveraendert"

test "consolidate fasst Thread- und Memory-Konsolidierung zusammen"
    h: mem.init_db ":memory:"
    tid: mem.active_thread h "9"
    mem.add_message h tid "9" "user" "Test"
    mem.close_thread h "9"
    res: mem.consolidate h 14 30
    expect_eq (get res "threads_summarized") 1 "ein Thread verdichtet"
    expect_eq (get res "memories_decayed") 0 "nichts zu altern"
    expect_eq (get res "memories_forgotten") 0 "nichts zu vergessen"

--! Wissensgraph.
test "add_entity dedupliziert Namen"
    h: mem.init_db ":memory:"
    a1: mem.add_entity h "Alpha" "person"
    a2: mem.add_entity h "Alpha" "person"
    expect_eq a1 a2 "gleicher Name -> gleiche id"
    mem.close h

test "add_relation und neighbors_of"
    h: mem.init_db ":memory:"
    mem.add_relation h "Alpha" "Beta" "kennt"
    n: mem.neighbors_of h "Alpha"
    expect_eq (len n) 1 "ein Nachbar"
    expect_eq (get (at n 0) "rel") "kennt" "relation"
    expect_eq (get (at n 0) "target") "Beta" "zielname"
    mem.close h

test "add_relation dedupliziert dieselbe (from, to, rel)-Kombination"
    h: mem.init_db ":memory:"
    mem.add_relation h "Alpha" "Beta" "kennt"
    mem.add_relation h "Alpha" "Beta" "kennt"
    n: mem.neighbors_of h "Alpha"
    expect_eq (len n) 1 "keine doppelte Relation"
    mem.close h

test "add_relation behaelt unterschiedliche Relationen zwischen denselben Entitaeten"
    h: mem.init_db ":memory:"
    mem.add_relation h "Alpha" "Beta" "kennt"
    mem.add_relation h "Alpha" "Beta" "mag"
    n: mem.neighbors_of h "Alpha"
    expect_eq (len n) 2 "zwei verschiedene Relationen bleiben"
    mem.close h

--! Auto-Entitäten (P2): apply_extraction ist die deterministisch testbare
--! Verarbeitung eines (hier von Hand gebauten) Extraktions-Ergebnisses —
--! auto_link selbst braucht einen echten KI-Provider und wird hier nicht getestet.
test "apply_extraction schreibt Entitaeten und Relationen in den Graphen"
    h: mem.init_db ":memory:"
    extraction: {entities: [{name: "Harry", kind: "person"}, {name: "Pipe", kind: "sprache"}], relations: [{from: "Harry", to: "Pipe", rel: "entwickelt"}]}
    mem.apply_extraction h extraction
    n: mem.neighbors_of h "Harry"
    expect_eq (len n) 1 "eine Relation"
    expect_eq (get (at n 0) "rel") "entwickelt" "relation korrekt"
    expect_eq (get (at n 0) "target") "Pipe" "ziel korrekt"
    mem.close h

test "apply_extraction ignoriert unvollstaendige Eintraege statt abzustuerzen"
    h: mem.init_db ":memory:"
    extraction: {entities: [{name: "", kind: "person"}, {kind: "ohne-namen"}], relations: [{from: "X", to: "Y"}, {from: "", to: "Y", rel: "r"}]}
    mem.apply_extraction h extraction
    rows: db_query h "SELECT COUNT(*) AS c FROM entities"
    expect_eq (get (at rows 0) "c") 0 "keine leeren/unvollstaendigen Eintraege gespeichert"
    mem.close h

test "apply_extraction mit nil oder leerer Extraktion tut nichts"
    h: mem.init_db ":memory:"
    mem.apply_extraction h nil
    mem.apply_extraction h {}
    rows: db_query h "SELECT COUNT(*) AS c FROM entities"
    expect_eq (get (at rows 0) "c") 0 "nichts angelegt"
    mem.close h

--! Dokument-Ingestion (P2): chunk_text/ingest_document sind rein (kein KI/Netz
--! im Chunking selbst — nur das anschliessende add_memory ruft optional KI auf,
--! faellt aber unter pipe -test wie ueberall sonst auf "kein Embedding" zurueck).
test "chunk_text: leerer Text -> leere Liste"
    expect_eq (len (mem.chunk_text "" 100)) 0 "nichts zu chunken"
    expect_eq (len (mem.chunk_text "   " 100)) 0 "nur Whitespace -> nichts"

test "chunk_text: kurzer Text passt in einen Chunk"
    chunks: mem.chunk_text "Ein kurzer Absatz." 100
    expect_eq (len chunks) 1 "ein Chunk"
    expect_eq (at chunks 0) "Ein kurzer Absatz." "Inhalt erhalten"

test "chunk_text: Absaetze, die auch zu zweit nicht passen, bleiben getrennt"
    text: "Absatz eins.\n\nAbsatz zwei.\n\nAbsatz drei."
    chunks: mem.chunk_text text 15
    expect_eq (len chunks) 3 "jeder Absatz (12 Zeichen) eigener Chunk bei max_len 15"
    expect_eq (at chunks 0) "Absatz eins." "erster Chunk"

test "chunk_text: kurze Absaetze werden in einen Chunk zusammengefasst, wenn sie passen"
    text: "eins.\n\nzwei."
    chunks: mem.chunk_text text 100
    expect_eq (len chunks) 1 "passen zusammen in einen Chunk"
    expect_contains (at chunks 0) "eins." "erster Absatz enthalten"
    expect_contains (at chunks 0) "zwei." "zweiter Absatz enthalten"

test "chunk_text: ein zu langer Absatz wird hart geschnitten"
    text: "abcdefghij"
    chunks: mem.chunk_text text 4
    expect_eq (len chunks) 3 "10 Zeichen / 4 -> 3 Chunks (4+4+2)"
    expect_eq (at chunks 0) "abcd" "erster Chunk"
    expect_eq (at chunks 2) "ij" "letzter Chunk"

--! Baut einen n*10 Zeichen langen Fuellparagraphen (fuer Chunk-Grenzen-Tests
--! gegen ingest_document's fest verdrahtetes max_len von 1200).
fn filler_para n
    p: ""
    i: 0
    while i < n
        p: p ++ "0123456789"
        i: i + 1
    p

test "ingest_document speichert jeden Chunk als eigene Erinnerung"
    h: mem.init_db ":memory:"
    p: filler_para 70
    text: p ++ "\n\n" ++ p ++ "\n\n" ++ p
    res: mem.ingest_document h text "test-quelle" "Testdoku" 20
    expect_eq (get res "chunks_total") 3 "drei Chunks (je 700 Zeichen, zwei zusammen > 1200)"
    expect_eq (get res "chunks_ingested") 3 "alle drei gespeichert"
    expect_eq (mem.memory_count h) 3 "drei Erinnerungen"
    top: mem.top_memories h 10
    expect_eq (get (at top 0) "kind") "document" "kind document"
    mem.close h

test "ingest_document begrenzt auf max_chunks"
    h: mem.init_db ":memory:"
    p: filler_para 70
    text: p ++ "\n\n" ++ p ++ "\n\n" ++ p
    res: mem.ingest_document h text "test-quelle" "Testdoku" 2
    expect_eq (get res "chunks_total") 3 "insgesamt drei Chunks vorhanden"
    expect_eq (get res "chunks_ingested") 2 "aber nur zwei gespeichert (Limit)"
    expect_eq (mem.memory_count h) 2 "zwei Erinnerungen"
    mem.close h

--! RAG-Fallback: ohne Embeddings greift die Stichwortsuche.
test "keyword_retrieve findet passende Erinnerungen"
    h: mem.init_db ":memory:"
    mem.add_memory h "Der Nutzer liebt Espresso" "permanent" 3 "test" "x"
    mem.add_memory h "Der Nutzer mag keine Ananas auf Pizza" "permanent" 3 "test" "x"
    r: mem.keyword_retrieve h "Espresso" 5
    expect_eq (len r) 1 "eine Treffer"
    expect_eq (at r 0) "Der Nutzer liebt Espresso" "richtiger Inhalt"
    mem.close h

test "retrieve_context fällt ohne Vektoren auf keyword zurück"
    h: mem.init_db ":memory:"
    mem.add_memory h "Der Nutzer liebt Espresso" "permanent" 3 "test" "x"
    ctx: mem.retrieve_context h "Espresso" 3
    expect_eq (len ctx) 1 "eine relevante Erinnerung"
    expect_eq (at ctx 0) "Der Nutzer liebt Espresso" "korrekt"
    mem.close h

test "retrieve_context rankt nach Wortüberlappung"
    h: mem.init_db ":memory:"
    mem.add_memory h "Pfannkuchen braucht Mehl und Milch" "permanent" 3 "test" "x"
    mem.add_memory h "Die Katze schläft viel" "permanent" 3 "test" "x"
    ctx: mem.retrieve_context h "Wie mache ich Pfannkuchen?" 1
    expect_eq (len ctx) 1 "eine relevante Erinnerung"
    expect_eq (at ctx 0) "Pfannkuchen braucht Mehl und Milch" "Top-Match"

--! Vektor-Mathematik (kein KI-Call).
test "cosine_sim identischer Vektoren ist 1"
    sim: cosine_sim ([1, 0, 0]) ([1, 0, 0])
    expect_gt sim 0.999 "identisch -> ~1"

test "nearest findet den ähnlichsten Vektor"
    top: nearest ([1, 0, 0]) ([[0, 1, 0], [1, 0, 0], [0, 0, 1]]) 1
    expect_eq (len top) 1 "ein Index"
    expect_eq (at top 0) 1 "Index 1 ist am ähnlichsten"

--! Gremium: Registrierung läuft fehlerfrei (kein KI-Call nötig).
test "init_gremium registriert Agenten und Tools ohne Fehler"
    r: grm.init_gremium 0
    expect_eq r nil "Rückgabe ist nil (kein Fehler)"

--! Executor: Plan-Bibliothek (deterministisch).
test "plan_template: permanent -> store-Schritt"
    steps: exe.plan_template "permanent" "Merke Espresso"
    expect_eq (len steps) 1 "ein Schritt"
    expect_eq (get (at steps 0) "action") "store" "action store"

test "plan_template: task -> store + goal"
    steps: exe.plan_template "task" "Erledige Reporting"
    expect_eq (len steps) 2 "zwei Schritte"
    expect_eq (get (at steps 1) "action") "goal" "zweiter Schritt goal"

test "plan_template: unbekannte Art -> leer"
    steps: exe.plan_template "fleeting" "Wetter"
    expect_eq (len steps) 0 "keine Schritte"

--! Executor: Schritt-Dispatcher.
test "exec_step store schreibt in die Seele"
    h: mem.init_db ":memory:"
    exe.init_executor h
    s: {}
    set s "action" "store"
    set s "content" "Test"
    set s "kind" "permanent"
    set s "importance" 3
    r: exe.exec_step h s
    expect_eq (get r "ok") true "ok"
    expect_eq (mem.memory_count h) 1 "eine Erinnerung"
    mem.close h

test "exec_step unbekannte Aktion scheitert"
    h: mem.init_db ":memory:"
    exe.init_executor h
    s: {}
    set s "action" "boom"
    r: exe.exec_step h s
    expect_eq (get r "ok") false "scheitert"
    mem.close h

--! mcp_call (P1): exec_step ruft ein registriertes Werkzeug per tool_call auf —
--! deterministisch, ohne KI/Netz. Ein lokales ai_tool steht hier stellvertretend
--! fuer ein per MCP gebrücktes Werkzeug (beide liegen in derselben Tool-Registry).
fn test_echo_tool msg
    "echo: " ++ msg

test "exec_step mcp_call ruft ein registriertes Werkzeug per tool_call auf"
    ai_tool "test_echo_tool" "Testwerkzeug fuer mcp_call" {msg: "Nachricht"} test_echo_tool
    h: mem.init_db ":memory:"
    exe.init_executor h
    s: {action: "mcp_call", tool: "test_echo_tool", args: {msg: "hallo"}}
    r: exe.exec_step h s
    expect_eq (get r "ok") true "ok"
    expect_eq (get r "result") "echo: hallo" "Ergebnis vom Werkzeug"
    mem.close h

test "exec_step mcp_call ohne 'tool' scheitert mit klarer Fehlermeldung"
    h: mem.init_db ":memory:"
    exe.init_executor h
    s: {action: "mcp_call"}
    r: exe.exec_step h s
    expect_eq (get r "ok") false "scheitert ohne tool"
    mem.close h

test "exec_step mcp_call mit unbekanntem Werkzeug scheitert statt abzustuerzen"
    h: mem.init_db ":memory:"
    exe.init_executor h
    s: {action: "mcp_call", tool: "kein_solches_werkzeug"}
    r: exe.exec_step h s
    expect_eq (get r "ok") false "scheitert sauber"
    mem.close h

test "normalize_steps akzeptiert mcp_call als bekannte Aktion"
    raw: [{action: "mcp_call", tool: "test_echo_tool", args: {msg: "x"}}, {action: "unbekannt"}]
    steps: exe.normalize_steps raw
    expect_eq (len steps) 1 "nur mcp_call bleibt uebrig"
    expect_eq (get (at steps 0) "action") "mcp_call" "action erhalten"

--! Executor: Plan-Ausführung + Checkpoints + Feedback-Loop.
test "run_plan führt einen Plan bis zum Ende aus"
    h: mem.init_db ":memory:"
    steps: exe.plan_template "permanent" "Merke Espresso"
    r: exe.run_plan h "Merke Espresso" steps
    expect_eq (get r "ok") true "ok"
    st: exe.plan_state h (get r "plan_id")
    expect_eq (get st "state") "done" "state done"
    mem.close h

test "recent_plans liefert die juengsten Plaene (Web-Dashboard)"
    h: mem.init_db ":memory:"
    steps: exe.plan_template "permanent" "Merke Espresso"
    exe.run_plan h "Merke Espresso" steps
    plans: exe.recent_plans h 10
    expect_eq (len plans) 1 "ein Plan"
    expect_eq (get (at plans 0) "goal") "Merke Espresso" "goal korrekt"
    expect_eq (get (at plans 0) "state") "done" "state done"
    mem.close h

test "run_plan Feedback-Loop streicht fehlgeschlagenen Schritt"
    h: mem.init_db ":memory:"
    steps: []
    bad: {}
    set bad "action" "boom"
    push steps bad
    good: {}
    set good "action" "store"
    set good "content" "Trotzdem gemerkt"
    set good "kind" "permanent"
    set good "importance" 2
    push steps good
    r: exe.run_plan h "Test" steps
    expect_eq (get r "ok") true "trotz Fehler erfolgreich"
    expect_eq (mem.memory_count h) 1 "guter Schritt ausgeführt"
    mem.close h

--! Web: HTML-Strippen und Entities.
test "strip_html entfernt Tags und Entities"
    t: web.strip_html "<p>Hallo <b>Welt</b> &amp; alle</p>"
    expect_contains t "Hallo" "Text erhalten"
    expect_contains t "Welt" "Text erhalten"
    expect_contains t "&" "Entity &amp; decodiert"
    expect_falsy (contains t "<") "keine Tags mehr"

test "html_clean bereinigt Whitespace"
    t: web.html_clean "  a    b\n\n\nc  "
    expect_contains t "a b" "Whitespace verdichtet"
    expect_contains t "c" "Inhalt erhalten"

--! MCP (P1): Konfig-Parsing und exec-Whitelist sind pure Funktionen, ohne Netz/exec testbar.
test "parse_mcp_config: leer/nil -> []"
    expect_eq (len (mcp.parse_mcp_config nil)) 0 "nil -> leer"
    expect_eq (len (mcp.parse_mcp_config "")) 0 "leerer String -> leer"
    expect_eq (len (mcp.parse_mcp_config "  ")) 0 "nur Whitespace -> leer"

test "parse_mcp_config: ungueltiges JSON -> [] statt Fehler"
    expect_eq (len (mcp.parse_mcp_config "{nicht: valides json")) 0 "kaputtes JSON -> leer"

test "parse_mcp_config: JSON-Objekt statt Liste -> []"
    expect_eq (len (mcp.parse_mcp_config "{\"alias\":\"fs\"}")) 0 "kein Array -> leer"

test "parse_mcp_config: gueltige Server-Liste wird geparst"
    raw: "[{\"alias\":\"fs\",\"type\":\"stdio\",\"command\":\"npx\",\"args\":[\"-y\",\"server-fs\"]}]"
    servers: mcp.parse_mcp_config raw
    expect_eq (len servers) 1 "ein Server"
    expect_eq (get (at servers 0) "alias") "fs" "alias korrekt"
    expect_eq (get (at servers 0) "command") "npx" "command korrekt"

test "exec_whitelist_for: leere Serverliste -> leere Whitelist"
    expect_eq (len (mcp.exec_whitelist_for ([]))) 0 "keine Server -> kein exec noetig"

test "exec_whitelist_for: extrahiert und dedupliziert Kommando-Basenamen"
    raw: "[{\"command\":\"npx\",\"args\":[]},{\"command\":\"/usr/bin/npx\",\"args\":[]},{\"command\":\"node\",\"args\":[]}]"
    servers: mcp.parse_mcp_config raw
    wl: mcp.exec_whitelist_for servers
    expect_eq (len wl) 2 "npx (dedupliziert ueber Pfad) + node"
    expect_contains (to_json wl) "npx" "npx in Whitelist"
    expect_contains (to_json wl) "node" "node in Whitelist"

test "exec_whitelist_for: SSE-Server tragen nichts zur exec-Whitelist bei"
    raw: "[{\"type\":\"sse\",\"url\":\"http://localhost:9090/mcp\"}]"
    servers: mcp.parse_mcp_config raw
    expect_eq (len (mcp.exec_whitelist_for servers)) 0 "sse braucht kein exec"

--! Web: DDG-Ergebnis-Parsing (deterministisches Fixture).
test "parse_ddg extrahiert Titel und URLs"
    fixture: "x result__a\" href=\"//duckduckgo.com/l/?uddg=https%3A%2F%2Fexample.com&amp;rut=1\">Erster Titel</a> y result__a\" href=\"//duckduckgo.com/l/?uddg=https%3A%2F%2Fexample.org&amp;rut=2\">Zweiter Titel</a> z"
    r: web.parse_ddg fixture
    expect_eq (len r) 2 "zwei Ergebnisse"
    expect_eq (get (at r 0) "title") "Erster Titel" "erster Titel"
    expect_eq (get (at r 0) "url") "https://example.com" "erste URL decodiert"
    expect_eq (get (at r 1) "title") "Zweiter Titel" "zweiter Titel"
    expect_eq (get (at r 1) "url") "https://example.org" "zweite URL decodiert"

--! Scheduler (P4): Zeit-/Wiederholungslogik ist rein und deterministisch.
--! Fester Referenz-Zeitpunkt: 2026-08-30 00:00:00 UTC = 1788048000.
test "next_hhmm liefert heute 08:00, wenn jetzt noch davor"
    due: sched.next_hhmm 8 0 1788048000 0
    expect_eq due 1788076800 "2026-08-30 08:00:00 UTC"

test "next_hhmm springt auf morgen, wenn die Zeit schon vorbei ist"
    due: sched.next_hhmm 8 0 1788076800 0
    expect_eq due 1788163200 "2026-08-31 08:00:00 UTC"

test "next_hhmm respektiert einen Zeitzonen-Offset"
    due: sched.next_hhmm 8 0 1788048000 7200
    expect_eq due 1788069600 "08:00 lokal (UTC+2) = 06:00 UTC"

test "parse_reminder_rule erkennt 'in N minutes'"
    r: sched.parse_reminder_rule "Remind me in 5 minutes about the break" 1000 0
    expect_eq (get r "due") 1300 "1000 + 5*60"
    expect_eq (get r "repeat") "" "einmalig"

test "parse_reminder_rule erkennt 'in N hours'"
    r: sched.parse_reminder_rule "Remind me in 2 hours about the meeting" 1000 0
    expect_eq (get r "due") 8200 "1000 + 2*3600"

test "parse_reminder_rule erkennt 'at HH:MM'"
    r: sched.parse_reminder_rule "Remind me at 8:30 about the dentist" 1788048000 0
    expect_eq (get r "due") 1788078600 "2026-08-30 08:30:00 UTC"

test "parse_reminder_rule erkennt 'tomorrow'"
    r: sched.parse_reminder_rule "Remind me tomorrow about the report" 1000 0
    expect_eq (get r "due") 87400 "1000 + 86400"

test "parse_reminder_rule faellt auf 'in one hour' zurueck"
    r: sched.parse_reminder_rule "Remind me about the report" 1000 0
    expect_eq (get r "due") 4600 "1000 + 3600"

test "schedule/due/mark_fired: einmalige Aufgabe wird erledigt"
    h: mem.init_db ":memory:"
    sched.init_scheduler h
    id: sched.schedule h "reminder" "42" "Test" 1000 ""
    due: sched.due h 1000
    expect_eq (len due) 1 "eine fällige Aufgabe"
    expect_eq (get (at due 0) "kind") "reminder" "kind korrekt"
    sched.mark_fired h id "" 1000
    expect_eq (len (sched.due h 2000)) 0 "nach mark_fired nicht mehr fällig"
    mem.close h

test "schedule/due: erst nach Fälligkeit erscheint die Aufgabe"
    h: mem.init_db ":memory:"
    sched.init_scheduler h
    sched.schedule h "reminder" "42" "Test" 5000 ""
    expect_eq (len (sched.due h 4000)) 0 "noch nicht fällig"
    expect_eq (len (sched.due h 5000)) 1 "jetzt fällig"
    mem.close h

test "mark_fired schiebt daily-Aufgabe auf den nächsten Tag"
    h: mem.init_db ":memory:"
    sched.init_scheduler h
    id: sched.schedule h "briefing" "42" "Daily" 1000 "daily"
    sched.mark_fired h id "daily" 1000
    due: sched.due h 1000
    expect_eq (len due) 0 "heute nicht mehr fällig"
    due2: sched.due h 87400
    expect_eq (len due2) 1 "morgen wieder fällig (1000 + 86400)"
    mem.close h

test "mark_fired schiebt 5min-Aufgabe auf den naechsten Takt (Hintergrund-Job-Check)"
    h: mem.init_db ":memory:"
    sched.init_scheduler h
    id: sched.schedule h "job_check" "42" "1" 1000 "5min"
    sched.mark_fired h id "5min" 1000
    due: sched.due h 1000
    expect_eq (len due) 0 "gleich nicht mehr faellig"
    due2: sched.due h 1300
    expect_eq (len due2) 1 "in 5 Minuten wieder faellig (1000 + 300)"
    mem.close h

test "docker_tools: create_job/get_job/update_job-Rundlauf"
    h: mem.init_db ":memory:"
    jid: dt.create_job h "42" "test-container" "Testbeschreibung"
    j: dt.get_job h jid
    expect_eq (get j "status") "running" "neuer Job startet als 'running'"
    dt.update_job h jid "done" "fertig, alles gut"
    j2: dt.get_job h jid
    expect_eq (get j2 "status") "done" "Status nach update_job"
    expect_eq (get j2 "result") "fertig, alles gut" "Ergebnis nach update_job"
    expect_eq (dt.get_job h 99999) nil "unbekannte id liefert nil"
    mem.close h

--! cancel_job/cancel_all_running (P8: echter Abbruch-Mechanismus, siehe
--! Kommentar dort) — nur der reine DB-Zustandsuebergang ohne echten
--! Docker-Aufruf ist deterministisch testbar (cancel_job ruft exec() NUR
--! auf, wenn status == 'running'; ein bereits abgeschlossener/unbekannter
--! Job loest also KEINEN echten Docker-Aufruf aus). Der tatsaechliche
--! Container-Abbruch wurde live gegengetestet, siehe Commit-Beschreibung.
test "cancel_job ist ein No-op fuer bereits abgeschlossene oder unbekannte Jobs"
    h: mem.init_db ":memory:"
    jid: dt.create_job h "1" "c" "Testbeschreibung"
    dt.update_job h jid "done" "schon fertig"
    expect_eq (dt.cancel_job h jid) true "no-op auf bereits fertigem Job"
    j: dt.get_job h jid
    expect_eq (get j "status") "done" "Status bleibt unangetastet"
    expect_eq (dt.cancel_job h 99999) false "unbekannte id liefert false"

--! docker_environments (P9: dauerhafte, wiederverwendbare Umgebungen statt
--! reflexartig neue Container anzulegen, siehe Kommentar in
--! docker_tools.pipe). registrieren/auflisten sind reine DB-Logik; der
--! echte Docker-Abbruch-Pfad von entfernen (auf eine WIRKLICH aktive
--! Umgebung) wurde live gegengetestet, siehe Commit-Beschreibung — hier
--! nur der deterministische "nicht gefunden"-Zweig (loest KEINEN
--! Docker-Aufruf aus).
test "docker_environment registrieren/auflisten Rundlauf, getrennt nach Chat"
    h: mem.init_db ":memory:"
    r: dt.tool_docker_environment_registrieren h "1" "dev-env" "Testumgebung fuer Node-Projekte" "node:20, npm, git"
    expect_eq (contains r "registriert") true "Bestaetigung enthaelt 'registriert'"
    liste: dt.tool_docker_environments_auflisten h "1"
    expect_eq (contains liste "dev-env") true "registrierte Umgebung erscheint in der Liste"
    expect_eq (contains liste "Node-Projekte") true "Zweck erscheint in der Liste"
    andere_chat: dt.tool_docker_environments_auflisten h "2"
    expect_eq (contains andere_chat "dev-env") false "anderer Chat sieht die Umgebung nicht"

test "docker_environment_registrieren lehnt ungueltige Container-Namen ab"
    h: mem.init_db ":memory:"
    r: dt.tool_docker_environment_registrieren h "1" "un guel tig!" "x" "y"
    expect_eq (contains r "Abgelehnt") true "ungueltiger Name wird abgelehnt"

test "docker_environment_entfernen meldet fehlende Umgebung ohne Docker-Aufruf"
    h: mem.init_db ":memory:"
    r: dt.tool_docker_environment_entfernen h "1" "existiert-nicht"
    expect_eq (contains r "Keine aktive Umgebung") true "sauberer Hinweis statt Fehler"

test "scheduler: create_background_task/get_background_task-Rundlauf"
    h: mem.init_db ":memory:"
    tid: sched.create_background_task h "42" "Beispielaufgabe" "Schritt 1 erledigt, Schritt 2 fehlt"
    t: sched.get_background_task h tid
    expect_eq (get t "task") "Beispielaufgabe" "Aufgabe wird korrekt gespeichert"
    expect_eq (get t "progress") "Schritt 1 erledigt, Schritt 2 fehlt" "Fortschritt wird korrekt gespeichert"
    expect_eq (sched.get_background_task h 99999) nil "unbekannte id liefert nil"
    mem.close h

test "next_due_ms liefert Millisekunden bis zur nächsten Aufgabe (oder nil)"
    h: mem.init_db ":memory:"
    sched.init_scheduler h
    expect_eq (sched.next_due_ms h 1000) nil "ohne Aufgaben nil"
    sched.schedule h "reminder" "42" "Test" 15000 ""
    expect_eq (sched.next_due_ms h 1000) 14000000 "14 s in ms"
    mem.close h

test "list und cancel verwalten offene Aufgaben eines Chats"
    h: mem.init_db ":memory:"
    sched.init_scheduler h
    id1: sched.schedule h "reminder" "42" "A" 1000 ""
    sched.schedule h "reminder" "43" "B" 1000 ""
    expect_eq (len (sched.list h "42")) 1 "nur Chat 42"
    sched.cancel h id1
    expect_eq (len (sched.list h "42")) 0 "cancelled taucht nicht mehr auf"
    mem.close h

test "compose_briefing nennt Erinnerungen und offene Ziele"
    h: mem.init_db ":memory:"
    mem.add_memory h "Der Nutzer liebt Espresso" "permanent" 4 "test" "x"
    mem.add_goal h "Pipe lernen"
    b: sched.compose_briefing h
    expect_contains b "Good morning" "Begruessung"
    expect_contains b "Espresso" "wichtigste Erinnerung"
    expect_contains b "Pipe lernen" "offenes Ziel"
    mem.close h

--! Executor-Resume (P4): unterbrochene Pläne ab Checkpoint fortsetzen.
test "resume_plan setzt einen unterbrochenen Plan ab Checkpoint fort"
    h: mem.init_db ":memory:"
    exe.init_executor h
    s0: {action: "store", content: "Schritt 0", kind: "permanent", importance: 2}
    s1: {action: "store", content: "Schritt 1", kind: "permanent", importance: 2}
    steps: [s0, s1]
    db_exec h ("INSERT INTO plans (goal, steps, state, step_idx, result, created, updated) VALUES ('Test', '" ++ (mem.sql_escape (to_json steps)) ++ "', 'running', 1, '', 't', 't')")
    pid: get (at (db_query h "SELECT max(id) AS mid FROM plans") 0) "mid"
    r: exe.resume_plan h pid
    expect_eq (get r "ok") true "resume ok"
    expect_eq (get r "steps_done") 2 "beide Schritte erledigt"
    expect_eq (mem.memory_count h) 1 "nur der verbleibende Schritt wurde ausgefuehrt"
    st: exe.plan_state h pid
    expect_eq (get st "state") "done" "Plan jetzt done"
    mem.close h

test "resume_running_plans setzt alle laufenden Pläne fort"
    h: mem.init_db ":memory:"
    exe.init_executor h
    s0: {action: "store", content: "A", kind: "permanent", importance: 2}
    s1: {action: "store", content: "B", kind: "permanent", importance: 2}
    steps: [s0, s1]
    db_exec h ("INSERT INTO plans (goal, steps, state, step_idx, result, created, updated) VALUES ('T', '" ++ (mem.sql_escape (to_json steps)) ++ "', 'running', 1, '', 't', 't')")
    n: exe.resume_running_plans h
    expect_eq n 1 "ein Plan fortgesetzt"
    expect_eq (mem.memory_count h) 1 "ein Schritt ausgefuehrt"
    mem.close h

test "resume_plan auf abgeschlossenem Plan scheitert sauber"
    h: mem.init_db ":memory:"
    steps: exe.plan_template "permanent" "Merke Espresso"
    r: exe.run_plan h "Merke Espresso" steps
    res: exe.resume_plan h (get r "plan_id")
    expect_eq (get res "ok") false "bereits done"
    mem.close h

--! Feedback-Lernen (P4): 👍/👎 passen die Importance gespeicherter Antworten an.
test "adjust_by_content erhöht und senkt die Importance passender Erinnerungen"
    h: mem.init_db ":memory:"
    id: mem.add_memory h "Testinhalt" "fact" 3 "test" "x"
    n: mem.adjust_by_content h "Testinhalt" 1
    expect_eq n 1 "eine Erinnerung angepasst"
    top: mem.top_memories h 1
    expect_eq (get (at top 0) "importance") 4 "3 -> 4"
    neg: -2
    mem.adjust_by_content h "Testinhalt" neg
    top2: mem.top_memories h 1
    expect_eq (get (at top2 0) "importance") 2 "4 -> 2"
    mem.close h

test "adjust_by_content clampet auf 1..5 und findet keinen Treffer ohne Match"
    h: mem.init_db ":memory:"
    id: mem.add_memory h "Wichtig" "fact" 5 "test" "x"
    mem.adjust_by_content h "Wichtig" 3
    top: mem.top_memories h 1
    expect_eq (get (at top 0) "importance") 5 "bleibt bei 5 (Clamp)"
    expect_eq (mem.adjust_by_content h "nicht vorhanden" 1) 0 "kein Treffer"
    mem.close h

--! condense_fact (Fix): ohne KI fällt auf 300 Zeichen zurück statt den
--! kompletten Text zu speichern.
test "condense_fact kürzt ohne KI auf 300 Zeichen"
    long: "0123456789012345678901234567890123456789"
    long: long ++ long ++ long ++ long ++ long ++ long ++ long ++ long
    expect_eq (len long) 320 "Ausgangstext 320 Zeichen"
    out: mem.condense_fact long
    expect_eq (len out) 300 "gekürzt auf 300"
