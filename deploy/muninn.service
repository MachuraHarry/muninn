[Unit]
Description=Muninn — persoenlicher KI-Agent (Telegram-Bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/muninn
Environment=PATH=/root/.local/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/pipe muninn.pipe

# Sauberes Herunterfahren: der Pipe-Interpreter faengt SIGTERM/SIGINT selbst
# ab, schliesst alle MCP-Subprozesse geordnet und beendet sich danach mit
# Exit-Code 143/130 (konventionell 128+Signalnummer) — kein echter Fehler,
# aber systemd wertet jeden Nicht-Null-Code sonst als "failed". Zusaetzlich
# raeumt systemds eigenes cgroup-basiertes Kill-Verhalten (Standard:
# KillMode=control-group) beim Stoppen ohnehin ALLE Prozesse der Unit auf
# (inkl. MCP-Enkel-Prozesse), auch falls der interpreterseitige Shutdown
# je einen Fall uebersehen sollte.
SuccessExitStatus=143 130
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

# Zweite Verteidigungslinie neben dem Pipe-internen exec()-Timeout (siehe
# setup_sandbox in muninn.pipe): der Haupt-Loop meldet sich nach JEDER
# Zyklus-Iteration per "systemd-notify WATCHDOG=1" (erfolgreich oder
# abgefangener Fehler zaehlt gleichermassen als "lebt noch") — bleibt dieses
# Signal laenger als WatchdogSec aus, wertet systemd den Dienst als
# gehaengt, killt ihn und startet ihn dank Restart=on-failure automatisch
# neu, statt dass ein Haenger erst manuell entdeckt werden muss (live
# passiert: ein blockierender exec()-Aufruf legte den GESAMTEN Bot fuer
# Stunden lahm, bis das von Hand aufgefallen ist). 900s (15 Minuten) statt
# knapper bemessen, weil Pipe bewusst single-threaded ist — waehrend eines
# echten, aber LEGITIMEN langen Gremiums-Durchlaufs (viele Runden, viele
# Werkzeugaufrufe) kann kein Heartbeat gesendet werden, das darf nicht
# faelschlich als Haenger gewertet werden. Deckt trotzdem jeden ECHTEN
# unbegrenzten Haenger zuverlaessig ab, der sonst fuer immer stehen bliebe.
WatchdogSec=900

# Loggt automatisch in den systemd-Journal (journalctl -u muninn -f) statt
# in eine manuell verwaltete Datei wie beim bisherigen nohup-Start.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
