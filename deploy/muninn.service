[Unit]
Description=Muninn — personal AI agent (Telegram bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/muninn
Environment=PATH=/root/.local/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/pipe muninn.pipe

# Clean shutdown: the Pipe interpreter itself catches SIGTERM/SIGINT,
# cleanly closes all MCP subprocesses, and then exits with exit code
# 143/130 (conventionally 128+signal number) — not a real error, but
# systemd otherwise treats any non-zero code as "failed". Additionally,
# systemd's own cgroup-based kill behavior (default: KillMode=control-
# group) cleans up ALL processes of the unit on stop anyway (incl. MCP
# grandchild processes), even if the interpreter-side shutdown should
# ever miss a case.
SuccessExitStatus=143 130
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

# Second line of defense alongside Pipe's internal exec() timeout (see
# setup_sandbox in muninn.pipe): the main loop checks in after EVERY cycle
# iteration via "systemd-notify WATCHDOG=1" (a success or a caught error
# both count equally as "still alive") — if this signal is missing for
# longer than WatchdogSec, systemd considers the service hung, kills it,
# and automatically restarts it thanks to Restart=on-failure, instead of a
# hang having to be discovered manually first (happened live: a blocking
# exec() call took down the ENTIRE bot for hours until it was noticed by
# hand). Set to 900s (15 minutes) rather than tighter, because Pipe is
# deliberately single-threaded — during a real but LEGITIMATE long gremium
# run (many rounds, many tool calls) no heartbeat can be sent, and that
# must not be wrongly counted as a hang. Still reliably covers any REAL
# unbounded hang that would otherwise sit stuck forever.
WatchdogSec=900

# Automatically logs to the systemd journal (journalctl -u muninn -f)
# instead of a manually managed file like the previous nohup-based start.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
