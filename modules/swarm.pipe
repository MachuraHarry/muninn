--! swarm.pipe — Muninns inneres Gremium (ai_swarm-Handoffs).
--! Agenten verfeinern eine Antwort: planer -> faktenwaechter -> kritiker -> registrator,
--! optional ueber "werkzeugmeister" mit Zugriff auf per MCP angebundene externe Tools (P1).
--! Hinweis: Map-Literale müssen in Pipe einzeilig sein, daher stehen die Configs einzeilig.
import "modules/memory.pipe" as mem
import "modules/web.pipe" as web
import "modules/mcp.pipe" as mcp
import "modules/scheduler.pipe" as sched
import "modules/docker_tools.pipe" as dt
import "modules/telegram.pipe" as tel

--! Geteilter, mutabler Zustand: aktueller DB-Handle + Chat-Kontext fuer die Tools.
--! tz_offset/token werden einmalig beim Start gesetzt (set_tz_offset/set_token),
--! dbh/cid pro Lauf (run_gremium) — token+cid werden von tool_bild_senden/
--! tool_datei_senden gebraucht, um ueberhaupt an Telegram senden zu koennen.
STATE: {dbh: nil, cid: nil, tz_offset: 0, token: nil, google_email: nil}

fn cur_dbh _
    get STATE "dbh"

--! Einmalig beim Start zu setzen (siehe setup_core in muninn.pipe).
export fn set_tz_offset off
    set STATE "tz_offset" off
    nil

--! Einmalig beim Start zu setzen (siehe setup_core in muninn.pipe). Getrennt
--! von set_tz_offset, damit der Telegram-Token — wie alle Secrets — nur an
--! genau einer Stelle im Code angefasst wird.
export fn set_token tok
    set STATE "token" tok
    nil

--! Einmalig beim Start zu setzen (siehe setup_core in muninn.pipe). Damit
--! entfaellt der frueher hier hart codierte Literal-Wert (ein Release-
--! Blocker: jede fremde Installation haette Harrys eigene E-Mail-Adresse
--! im System-Prompt gehabt statt der eigenen konfigurierten).
export fn set_google_email email
    set STATE "google_email" email
    nil

--! Loest einen von einem Werkzeug (z.B. Playwright-Screenshot) gemeldeten,
--! meist RELATIVEN Pfad zu einem absoluten Pfad auf. Muninn laeuft immer aus
--! /root/muninn heraus (siehe alle Start-Kommandos in muninn.pipe).
fn resolve_muninn_path path
    if (len path) > 0 && (substring path 0 1) == "/"
        path
    else
        "/root/muninn/" ++ path

--! Tool: relevante Erinnerungen aus der Seele abrufen.
fn tool_erinnerungen_suchen query
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    ctx: mem.retrieve_context h query 5
    if (len ctx) == 0
        return "Keine relevanten Erinnerungen gefunden."
    out: ""
    for c in ctx
        out: out ++ "- " ++ c ++ "\n"
    out

--! Tool: ein wiederverwendbares Workflow-Rezept speichern (bewaehrte
--! Schrittfolge fuer eine wiederkehrende Aufgabe — z.B. 'BTC-Kurs: erst
--! btc-echo.de per web_fetch abrufen, dann als Sprachnachricht senden').
fn tool_rezept_speichern name schritte
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    if name == nil || (trim name) == ""
        return "Rezept-Name fehlt."
    if schritte == nil || (trim schritte) == ""
        return "Rezept-Schritte fehlen."
    mem.add_memory h ("REZEPT: " ++ (trim name) ++ " — " ++ (trim schritte)) "rezept" 4 "gremium" "rezept"
    "Rezept gespeichert: " ++ (trim name)

--! Tool: gespeicherte Workflow-Rezepte auflisten, um eine wiederkehrende
--! Aufgabe nach bewaehrtem Muster abzuarbeiten.
fn tool_rezepte_suchen query
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    rs: mem.recipes h
    if (len rs) == 0
        return "Keine Rezepte gespeichert."
    out: ""
    for r in rs
        out: out ++ "- " ++ r ++ "\n"
    out

--! Tool: eine Erkenntnis dauerhaft merken.
fn tool_merken content kind
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    mem.add_memory h content kind 3 "gremium" "gremium"
    "Gemerkt: " ++ content

--! Tool: im Web suchen (Titel + URL).
fn tool_web_search query
    results: web.web_results query 5
    if (len results) == 0
        return "Keine Treffer im Web."
    out: ""
    i: 0
    while i < (len results)
        r: at results i
        t: get r "title"
        u: get r "url"
        if t != nil && u != nil
            out: out ++ (to_str (i + 1)) ++ ". " ++ t ++ "\n   " ++ u ++ "\n"
        i: i + 1
    out

--! Tool: eine Webseite abrufen (Fließtext, gekürzt).
fn tool_web_fetch url
    text: web.web_fetch url
    if text == ""
        return "Seite nicht abrufbar."
    text

--! Tool: eine Erkenntnis mit Quellen-URL dauerhaft merken.
fn tool_merken_quelle content source
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    mem.add_memory h content "fact" 3 source "web"
    "Gemerkt (Quelle: " ++ source ++ "): " ++ content

--! Tool: eine zeitgesteuerte Erinnerung planen (Ersatz fuer die alte, blinde
--! "task"-Klassifikation — jetzt entscheidet das Gremium selbst, mit vollem
--! Gespraechskontext, ob und wann etwas erinnert werden soll, statt dass ein
--! kontextfreier Klassifikations-Aufruf das vorab und unzuverlaessig festlegt).
--! text: die zu erinnernde Sache in natuerlicher Sprache samt Zeitangabe, z.B.
--! "morgen um 6 Uhr: Termin zur Arbeit" — sched.parse_reminder zerlegt das.
fn tool_erinnerung_planen text
    h: cur_dbh 0
    cid: get STATE "cid"
    if h == nil || cid == nil
        return "Kein Chat-Kontext verfuegbar, kann keine Erinnerung planen."
    tzo: get STATE "tz_offset"
    parsed: sched.parse_reminder text now tzo
    sched.schedule h "reminder" (to_str cid) (get parsed "text") (get parsed "due") (get parsed "repeat")
    "Erinnerung geplant fuer " ++ (format_time ((get parsed "due") + tzo) "2006-01-02 15:04:05") ++ ": " ++ (get parsed "text")

--! Selbstwissen ueber Muninn, das allen Gremium-Agenten vorangestellt wird, damit
--! Meta-Fragen ueber Muninns eigene Faehigkeiten direkt beantwortet werden statt
--! faelschlich "kein Wissen" zu behaupten und eine Web-Recherche auszuloesen.
SELF_ID: "Selbstwissen ueber Muninn (bei Fragen UEBER MUNINN SELBST — Faehigkeiten, Technik, Architektur — DIREKT aus diesem Wissen antworten, NIE 'kein Wissen' behaupten und dafuer KEINE Web-Recherche starten): Muninn ist ein persoenlicher KI-Agent, geschrieben in der Skriptsprache 'pipe' (ein Go-Interpreter). Muninn nutzt DeepSeek als LLM-Provider mit Tool-Use/Function-Calling, kann also im Prinzip auch Code lesen und schreiben. Muninn hat ein persistentes SQLite-Langzeitgedaechtnis (Erinnerungen + Wissensgraph), kann selbststaendig im Web recherchieren (DuckDuckGo + Wikipedia), Aufgaben und Ziele planen sowie ueber einen Executor ausfuehren, zeitgesteuerte Erinnerungen und ein taegliches Briefing setzen, Dokumente lernen (auch PDFs — Text wird automatisch per pdftotext extrahiert, keine reinen Bild-Scans ohne Text-Layer), Fotos verstehen/beschreiben (DeepSeek-Vision), Sprachnachrichten verstehen (lokale Transkription per whisper-transcribe-mcp, kein API-Key), auf Anfrage Bilder generieren (kostenloser KI-Bildgenerator, kein API-Key), GitHub-Repos in einem isolierten Docker-Container klonen und deren Testsuite ausfuehren (laeuft im Hintergrund, meldet sich automatisch mit den echten Testergebnissen), dauerhafte Docker-Umgebungen registrieren und wiederverwenden statt fuer jede Anfrage einen neuen Container anzulegen, und optional per MCP an externe Werkzeuge (z.B. Dateisystem) angebunden werden. Muninn laeuft per Telegram-Bot und Web-Dashboard.\n\n"

--! Harte Handoff-Regel gegen vorzeitige Antworten: ohne diese Regel beendet ein
--! Agent den Swarm manchmal, indem er direkt Text ausgibt statt sein Handoff-
--! Werkzeug aufzurufen (beobachtet bei faktenwaechter auf Meta-Fragen — der Swarm
--! endete dort statt beim registrator, samt ungefiltertem internem Kommentar wie
--! "Ich habe mich im Gremium verheddert..."). Nur der registrator darf enden.
HANDOFF_RULE: "WICHTIG: Du bist NICHT der letzte Agent in der Kette und deine Textantwort geht NIE direkt an den Nutzer. Du MUSST am Ende IMMER dein Handoff-Werkzeug aufrufen, auch wenn du die Antwort schon fertig im Kopf hast — sonst bricht das Gespraech unsauber ab. Nur 'registrator' darf ohne Handoff enden.\n\n"

--! Ohne diese Regel diagnostiziert das Modell einen Parameter-/Validierungs-
--! fehler eines Werkzeugs faelschlich als "kaputte Anbindung" und gibt auf,
--! statt die Fehlermeldung zu lesen und mit korrigierten Parametern erneut
--! zu versuchen. Beobachtet live: docker_exec_command mit command als String
--! statt Array aufgerufen -> Zod-Fehler "Required at command" -> Antwort an
--! den Nutzer war "die Docker-Exec-Anbindung ist fehlerhaft", obwohl der
--! Aufruf mit korrektem Array-Parameter nachweislich funktioniert (Test:
--! "echo hallo-von-drinnen" kam korrekt aus dem Container zurueck).
RETRY_RULE: "Bekommst du von einem Werkzeug einen Fehler zu falschen/fehlenden Parametern (Validierungsfehler, 'Required', 'invalid arguments' o.ae.), ist das FAST IMMER ein Zeichen, dass DU die Parameter falsch uebergeben hast (falscher Typ, falscher Name, falsche Struktur) — NICHT, dass das Werkzeug oder seine Anbindung kaputt ist. Lies die Fehlermeldung genau, korrigiere deinen Aufruf entsprechend und versuche es SOFORT nochmal, bevor du dem Nutzer irgendetwas ueber eine 'fehlerhafte Anbindung' erzaehlst. Erst wenn auch ein korrigierter Versuch scheitert, ist ein echtes technisches Problem plausibel.\n\n"

--! Ohne diese Regel behauptet das Modell, ein Dienst/eine Web-Oberflaeche sei
--! erreichbar, nur weil ein Port gemappt wurde — ohne das je zu pruefen.
--! Beobachtet: ein frisch gestarteter Docker-Container wurde als "OpenCode-
--! Oberflaeche unter http://127.0.0.1:4096 erreichbar" beworben, obwohl die
--! Verbindung nur eine leere Antwort lieferte (kein Webserver im Container)
--! — und selbst nachdem 'docker_container_logs' LEERE Logs zeigte (ein
--! deutliches Warnsignal), wurde die Behauptung wiederholt statt korrigiert.
VERIFY_CLAIM_RULE: "Behaupte NIEMALS, dass ein Dienst/eine Web-Oberflaeche/eine URL erreichbar oder funktionsfaehig ist, nur weil du einen Port gemappt oder einen Container gestartet hast — das beweist nur, dass der Container LAEUFT, nicht, dass darin etwas Sinnvolles auf diesem Port lauscht. Hast du ein Werkzeug zur Verifikation (z.B. 'docker_container_logs', 'web_fetch' auf die URL), nutze es und beziehe dich auf das TATSAECHLICHE Ergebnis. Zeigen Logs nichts oder wirkt ein Dienst inaktiv, sag das ehrlich ('Container laeuft, aber ob/was dort auf Port X reagiert, ist unklar') statt eine Erreichbarkeit zu behaupten, die du nicht geprueft hast.\n\n"

--! Ohne diese Regel antwortet das Modell auf zeitabhaengige Fragen (Uhrzeit,
--! Wetter, aktuelle Ereignisse) faelschlich mit einer generischen "als
--! Sprachmodell habe ich keinen Echtzeitzugriff"-Ausrede, OBWOHL 'web_search'
--! verfuegbar ist — beobachtet bei "Wie viel Uhr ist es aktuell in
--! Deutschland?". question_needs_research (muninn.pipe) faengt das nur als
--! Notnagel ab, wenn die Formulierung zufaellig auf der Trigger-Liste steht.
TOOL_DISCIPLINE_RULE: "Fuer aktuelle/zeitabhaengige Informationen (Uhrzeit, Datum, Wetter, aktuelle Ereignisse, Kurse, Nachrichten) darfst du NIEMALS aus deinem eigenen Sprachmodell-Wissen antworten oder behaupten, du haettest 'keinen Echtzeitzugriff' — du HAST Zugriff via 'web_search'/'web_fetch'. Nutze sie in diesen Faellen IMMER, bevor du antwortest.\n\n"

--! Verwandt mit TOOL_DISCIPLINE_RULE, aber ein anderer Fehlermodus: die KI
--! RUFT web_search auf, bekommt Ergebnisse, die nicht relevant/aktuell genug
--! wirken (z.B. Wikipedia-Artikel statt Tagesnachrichten), und erfindet DANN
--! eine pauschale "meine Websuche ist technisch nicht verfuegbar"-Ausrede
--! statt ehrlich zu sagen, dass die Treffer nicht gut waren, oder es mit
--! einer praeziseren Anfrage/direktem web_fetch auf eine bekannte Quelle
--! (z.B. tagesschau.de) erneut zu versuchen. Beobachtet bei "Was sind die
--! aktuellen Nachrichten in Deutschland?" — web_search/web_fetch funktionierten
--! nachweislich (isoliert reproduziert), die KI behauptete trotzdem "an
--! technische Grenzen gestossen" und "derzeit nicht erreichbar".
RESULT_HONESTY_RULE: "Behaupte NIEMALS pauschal, 'web_search'/'web_fetch' seien 'technisch nicht verfuegbar', 'derzeit nicht erreichbar' oder du seist an 'technische Grenzen gestossen' — das ist so gut wie nie wahr. Liefert ein Aufruf nur schlechte/irrelevante Treffer (z.B. alte Wikipedia-Artikel statt aktueller Nachrichten), ist das ein Qualitaetsproblem der TREFFER, kein Ausfall des Werkzeugs: versuche es mit einer praeziseren Suchanfrage erneut, oder rufe 'web_fetch' direkt auf einer bekannten Quelle auf (z.B. tagesschau.de fuer deutsche Nachrichten). Bleibt das Ergebnis danach immer noch duenn, sag ehrlich 'ich habe nur X gefunden, das war nicht sehr ergiebig' — NIE eine erfundene technische Ausrede.\n\n"

--! Ohne diese Regel erfindet das Modell bei zu vagen Anfragen ("Mach mal
--! irgendwas") entweder eine nicht stattgefundene Aktion ("dann mach ich eben
--! kurz den Mond an") oder bricht mit einem rohen internen Fehler ab (die alte
--! freie JSON-Schrittplanung im Executor tat genau das, ohne jeden Kontext —
--! deshalb ist dieser Pfad jetzt komplett durchs Gremium ersetzt, das echten
--! Kontext und echte Werkzeuge hat).
HONESTY_RULE: "Ist eine Nutzeranfrage zu vage oder unspezifisch, um eine konkrete, sinnvolle Aktion daraus abzuleiten (z.B. 'mach mal irgendwas'), erfinde NIEMALS eine Aktion und behaupte NIEMALS, etwas getan zu haben, das nicht wirklich stattgefunden hat. Frage stattdessen freundlich und konkret nach, was genau gewuenscht ist.\n\n"

--! tg_html (telegram.pipe) wandelt **fett**/*kursiv*/`code`/[text](url)
--! zuverlaessig in Telegrams HTML-Parse-Mode um (robuster als Telegrams
--! eigenes strenges "Markdown", das bei unausgewogenen Entities still auf
--! Klartext zurueckfiel) — diese Grundformatierung darf die KI also normal
--! per CommonMark-Syntax nutzen. Was aber NIE gut rendert, egal welcher
--! Modus: Markdown-Ueberschriften (#), Tabellen, verschachtelte Listen —
--! die gibt es in Telegram-Chats schlicht nicht, diese Regel haelt die
--! Ausgabe deshalb strukturell einfach.
FORMAT_RULE: "Formatiere deine Antwort fuer einen Telegram-Chat, nicht fuer ein Dokument: keine Markdown-Ueberschriften (#), keine Tabellen, keine verschachtelten Listen. **Fettung**/*Kursiv*/`Code`/[Links](url) darfst du normal per CommonMark-Syntax nutzen, das wird zuverlaessig dargestellt. Kurze Absaetze statt langer Bloecke.\n\n"

--! Ohne diese Regel behauptet das Modell bei Fragen zu Muninns eigenen
--! Werkzeugen faelschlich Dinge wie "ich habe keinen Zugriff auf Werkzeuge" —
--! per Websuche auf generischen Hilfeseiten "recherchiert", die logischerweise
--! nicht wissen koennen, was DIESER konkrete Bot verbunden hat (beobachtet bei
--! "kannst du mit deinen Werkzeugen ein Google Workspace einrichten?", obwohl
--! filesystem+memory MCP-Server verbunden waren). tools_desc wird in
--! init_gremium dynamisch aus der ECHTEN, aktuell verbundenen Werkzeugliste
--! gebaut, nicht als statischer Text.
--!
--! Ergaenzend: Ergebnisse von 'erinnerungen_suchen' duerfen nicht unbesehen als
--! Aussagen des Nutzers gelten — mem.retrieve_context markiert alles ausser
--! "permanent"/"document" (also KI-Recherche-Ergebnisse, Task-Protokolle) mit
--! einem Praefix. Beobachtet: eine alte AfD-Recherche wurde bei "Wofuer
--! interessiere ich mich?" als "klares Signal fuer politisches Interesse"
--! fehlinterpretiert, obwohl sie nur eine fruehere Recherche zu einer ANDEREN
--! Frage war, keine Aussage ueber den Nutzer.
SECURITY_HONESTY_RULE: "Gibst du Aussagen ueber die SICHERHEIT des Systems oder konkrete Systembefunde aus (Kernel-Versionen, Sandbox-/Container-Eigenschaften, Exploits wie 'Dirty Pipe', Seccomp-/Namespace-Status, UID-Mapping, Egress-Gates o.ae.), unterscheide STRENG nach Herkunft: (1) VERIFIZIERT ist nur, was du in DIESEM Lauf selbst per Werkzeug/eigener Ausgabe geprueft hast — nenne dann die konkrete Quelle (z.B. 'docker info zeigt: nur seccomp'). (2) Aus dem Gedaechtnis stammende Audit-Erkenntnisse darfst du zitieren, aber kennzeichne sie als 'aus frueheren Audits, aktuell nicht erneut geprueft'. (3) Reines Sprachmodell-Vorwissen ueber Sicherheitsluecken darfst du NIE als Befund UEBER DIESES System ausgeben. Markiere alles, was du nicht selbst in diesem Lauf geprueft hast, als 'ungeprueft'. Erfinde niemals Versionsnummern, Dateipfade oder Testergebnisse, um einen Report vollstaendiger wirken zu lassen.\n\n"

MEMORY_HONESTY_RULE: "Ergebnisse von 'erinnerungen_suchen', die mit '[fruehere Recherche/Protokoll, KEINE Aussage des Nutzers]' markiert sind, sind KI-generierte Recherche-Ergebnisse oder Protokolle — KEINE Aussagen des Nutzers ueber sich selbst. Aus solchen Eintraegen darfst du NIEMALS auf Interessen, Meinungen oder Praeferenzen des Nutzers schliessen. Nur unmarkierte Eintraege sind tatsaechliche Aussagen des Nutzers. Findest du zu einer Frage nach Interessen/Vorlieben nur markierte oder gar keine Eintraege, sag ehrlich, dass dazu noch nichts Eindeutiges von ihm gespeichert ist, statt aus Recherche-Nebenprodukten eine Praeferenz zu konstruieren.\n\n"

--! Selbstwissen + echte, aktuelle Werkzeugliste als EIN Kontext-Block — fuer
--! Code AUSSERHALB des Gremiums, der trotzdem "als Muninn" antworten muss
--! (der Web-Recherche-Fallback in muninn.pipe: wenn das Gremium eine Frage
--! nicht beantworten kann, wird zusaetzlich recherchiert und ein eigener,
--! schlanker ai_chat-Aufruf formuliert die Antwort). Ohne dieses Wissen
--! behauptet ein bare ai_chat-Aufruf mit nur "Du bist Muninn, ein
--! persoenlicher KI-Assistent" als Prompt schnell faelschlich, gar keine
--! Werkzeuge/Systemzugriff zu haben — beobachtet live: "Ich kann keine
--! Docker-Container erstellen, ich bin ein textbasierter Recherche-
--! Assistent", obwohl werkzeug_docker das nachweislich kann (siehe
--! docker_tools.pipe, live mit einem echten nginx-Container getestet).
--! Absichtlich eine schlanke Teilmenge der init_gremium-Logik (nur die
--! Beschreibung, keine Agenten-Registrierung) statt diese zu duplizieren.
export fn self_context _
    local_names: ["erinnerungen_suchen", "merken", "web_search", "web_fetch", "merken_quelle", "erinnerung_planen", "docker_pull_image", "docker_create_container"]
    mcp_groups: mcp.discovered_tools_by_source local_names
    mcp_names: []
    for grp in mcp_groups
        for tn in (get grp "tools")
            push mcp_names tn
    desc: "ECHTE, aktuell verfuegbare Werkzeuge: 'erinnerungen_suchen' (Gedaechtnis durchsuchen), 'merken'/'merken_quelle' (dauerhaft speichern), 'web_search'/'web_fetch' (im Internet recherchieren), 'erinnerung_planen' (Termin/Erinnerung planen)"
    if (len mcp_groups) > 0
        desc: desc ++ ", sowie per MCP extern angebunden: " ++ (join mcp_names ", ") ++ ". Bei Docker gehoeren zusaetzlich 'docker_pull_image'/'docker_create_container' dazu (Image ziehen, Container starten — OHNE Volume-Mounts/--privileged, das ist Absicht, keine fehlende Faehigkeit)."
    else
        desc: desc ++ ". Kein externer MCP-Server angebunden."
    desc: desc ++ " Behaupte NIE pauschal, keine Werkzeuge/keinen Systemzugriff zu haben, wenn diese Liste nicht leer ist.\n\n"
    SELF_ID ++ desc

--! Tool: ein Bild (z.B. ein Screenshot, den ein anderes Werkzeug lokal
--! gespeichert hat) an den Nutzer in Telegram senden. Nutzt sendPhoto (zeigt
--! inline im Chat an, Telegram komprimiert/konvertiert).
fn tool_bild_senden path caption
    tok: get STATE "token"
    cid: get STATE "cid"
    if tok == nil || cid == nil
        return "Kein Telegram-Kontext verfuegbar, kann kein Bild senden."
    full_path: resolve_muninn_path path
    if !(file_exists full_path)
        return "Datei nicht gefunden: " ++ full_path
    res: tel.tel_send_photo tok cid full_path caption
    if (get res "ok") == false
        return "Senden fehlgeschlagen: " ++ (to_str (get res))
    "Bild gesendet: " ++ full_path

--! Tool: eine beliebige Datei (z.B. ein per Filesystem-Werkzeug erzeugtes
--! Dokument) an den Nutzer in Telegram senden. Nutzt sendDocument (behaelt
--! Originalformat/-qualitaet, wird als Datei-Anhang statt inline gezeigt).
fn tool_datei_senden path caption
    tok: get STATE "token"
    cid: get STATE "cid"
    if tok == nil || cid == nil
        return "Kein Telegram-Kontext verfuegbar, kann keine Datei senden."
    full_path: resolve_muninn_path path
    if !(file_exists full_path)
        return "Datei nicht gefunden: " ++ full_path
    res: tel.tel_send_document tok cid full_path caption
    if (get res "ok") == false
        return "Senden fehlgeschlagen: " ++ (to_str (get res))
    "Datei gesendet: " ++ full_path

--! Maximale Zeichenzahl fuer eine Sprachnachricht — Vorlesen ist fuer kurze,
--! lockere Antworten gedacht, nicht fuer lange/inhaltsreiche Texte (siehe
--! FORMAT_RULE-Ergaenzung unten).
TTS_MAX_CHARS: 600

--! Fuehrt die feste Piper->ffmpeg-Pipeline (tts_synth.sh) aus. Kein Parameter
--! davon ist AI-kontrollierbar ausser dem Text selbst (Stimme/Encoding sind
--! im Skript fest verdrahtet) — analog zum docker_tools.pipe-Muster mit
--! festem Kommando-Template statt frei waehlbarer Flags.
fn tts_synthesize text
    dir: "/root/muninn/tts_tmp"
    id: (to_str now) ++ "_" ++ (to_str (random_range 100000 999999))
    txt_path: dir ++ "/" ++ id ++ ".txt"
    ogg_path: dir ++ "/" ++ id ++ ".ogg"
    write_file txt_path text
    r: exec ("/root/muninn/tts_synth.sh " ++ txt_path ++ " " ++ ogg_path)
    file_delete txt_path
    print ("tts_synthesize: exec-status=" ++ (to_str (get r "status")) ++ " ogg=" ++ ogg_path)
    if (get r "status") != 0
        print ("tts_synthesize FEHLGESCHLAGEN: " ++ (to_str (get r "output")))
        return {ok: false, ogg_path: nil, error: (get r "output")}
    if !(file_exists ogg_path)
        print ("tts_synthesize: Ausgabedatei fehlt: " ++ ogg_path)
        return {ok: false, ogg_path: nil, error: "Keine Ausgabedatei erzeugt."}
    print ("tts_synthesize OK: " ++ ogg_path)
    {ok: true, ogg_path: ogg_path, error: nil}

--! Tool: Text als echte Sprachnachricht (statt Textnachricht) an den Nutzer
--! senden — lokale Piper-Synthese, kein Cloud-Dienst/API-Key noetig.
fn tool_sprachnachricht_senden text
    tok: get STATE "token"
    cid: get STATE "cid"
    if tok == nil || cid == nil
        return "Kein Telegram-Kontext verfuegbar, kann keine Sprachnachricht senden."
    if text == nil || (trim text) == ""
        return "Kein Text zum Vorlesen angegeben."
    spoken: text
    if (len spoken) > TTS_MAX_CHARS
        spoken: (substring spoken 0 TTS_MAX_CHARS) ++ "…"
    synth: tts_synthesize spoken
    if !(get synth "ok")
        print ("sprachnachricht_senden: Synthese-Fehler: " ++ (to_str (get synth "error")))
        return "Sprachsynthese fehlgeschlagen: " ++ (to_str (get synth "error"))
    ogg: get synth "ogg_path"
    res: tel.tel_send_voice tok cid ogg nil
    file_delete ogg
    print ("sprachnachricht_senden: sendVoice-Ergebnis ok=" ++ (to_str (get res "ok")) ++ " -> " ++ (tel.shorten_body (to_str res)))
    if (get res "ok") == false
        return "Senden der Sprachnachricht fehlgeschlagen: " ++ (to_str res)
    "Sprachnachricht gesendet."

--! Tool: startet ein Docker-Setup, das laenger dauern darf (z.B.
--! Paketinstallation), OHNE die Antwort zu blockieren. 'docker run -d'
--! liefert zurueck, sobald der Container GESTARTET ist — die eigentliche
--! Einrichtung laeuft danach beim Docker-Daemon weiter, unabhaengig vom
--! Muninn-Prozess. Legt einen Job-Tracking-Eintrag an und plant per
--! Scheduler eine spaetere Pruefung ein (job_check, siehe muninn.pipe
--! sched_tick) — DAS ist das "cronjob-artige Abfragen", nicht ein Pipe-
--! Hintergrund-Thread (bewusst vermieden, siehe Kommentar bei
--! setup_sandbox in muninn.pipe: ein Pipe-Goroutine haette sich mit dem
--! per-Nachricht rotierenden Sandbox-Profil in die Quere kommen koennen).
fn tool_docker_hintergrund_setup image name setup_command beschreibung
    tok: get STATE "token"
    cid: get STATE "cid"
    dbh: get STATE "dbh"
    if tok == nil || cid == nil || dbh == nil
        return "Kein Chat-/Datenbank-Kontext verfuegbar, kann kein Hintergrund-Setup starten."
    start_res: dt.tool_docker_setup_starten image name setup_command
    if !(get start_res "ok")
        return "Setup konnte nicht gestartet werden: " ++ (get start_res "message")
    real_name: get start_res "name"
    jid: dt.create_job dbh cid real_name beschreibung
    due: now + 180
    sched.schedule dbh "job_check" cid (to_str jid) due "5min"
    "Setup gestartet (Container '" ++ real_name ++ "'). Ich melde mich automatisch, sobald es fertig ist — du musst nicht warten."

--! Tool (werkzeug_docker): Status der zuletzt gestarteten Hintergrund-
--! Docker-Jobs dieses Chats abrufen — siehe docker_tools.pipe fuer den
--! Live-Befund, der das noetig machte (wiederholte parallele Duplikat-Jobs).
fn tool_docker_job_status _
    dbh: get STATE "dbh"
    cid: get STATE "cid"
    if dbh == nil || cid == nil
        return "Kein Chat-/Datenbank-Kontext verfuegbar."
    dt.tool_docker_job_status dbh cid

--! Tool (Registrator): bricht SOFORT alle laufenden Hintergrund-Docker-Jobs
--! UND geplanten Hintergrund-Fortsetzungen (job_check/task_check) dieses
--! Chats ab — Sicherheitsnetz fuer natuerlichsprachliche Abbruch-Bitten
--! mitten im Gespraech; /stop (muninn.pipe) ist der ZUVERLAESSIGE,
--! deterministische Hauptweg, der nie von einer KI-Entscheidung abhaengt.
--! Siehe RESULT_HONESTY_RULE: dieses Werkzeug MUSS tatsaechlich aufgerufen
--! werden, ein Abbruch darf NIE nur behauptet werden (live beobachtet: die
--! KI sagte zweimal "alles abgebrochen", startete aber im selben Zug einen
--! neuen Job, weil es vorher schlicht kein echtes Abbruch-Werkzeug gab).
fn tool_docker_jobs_abbrechen _
    dbh: get STATE "dbh"
    cid: get STATE "cid"
    if dbh == nil || cid == nil
        return "Kein Chat-/Datenbank-Kontext verfuegbar."
    cancelled: dt.cancel_all_running dbh (to_str cid)
    n_sched: 0
    for r in (sched.list dbh (to_str cid))
        if (get r "kind") == "job_check" || (get r "kind") == "task_check"
            sched.cancel dbh (get r "id")
            n_sched: n_sched + 1
    "Abgebrochen: " ++ (to_str (len cancelled)) ++ " laufende(r) Docker-Hintergrund-Job(s) (Container entfernt), " ++ (to_str n_sched) ++ " geplante Fortsetzung(en) storniert."

--! Tool (werkzeug_docker): registriert einen Container als dauerhafte,
--! wiederverwendbare Umgebung — siehe Kommentar bei
--! docker_tools.pipe:tool_docker_environment_registrieren fuer die
--! Abgrenzung zu einmaligen docker_hintergrund_setup-Jobs.
fn tool_docker_environment_registrieren container_name purpose installed
    dbh: get STATE "dbh"
    cid: get STATE "cid"
    if dbh == nil || cid == nil
        return "Kein Chat-/Datenbank-Kontext verfuegbar."
    dt.tool_docker_environment_registrieren dbh cid container_name purpose installed

--! Tool (werkzeug_docker): listet registrierte dauerhafte Umgebungen.
fn tool_docker_environments_auflisten _
    dbh: get STATE "dbh"
    cid: get STATE "cid"
    if dbh == nil || cid == nil
        return "Kein Chat-/Datenbank-Kontext verfuegbar."
    dt.tool_docker_environments_auflisten dbh cid

--! Tool (werkzeug_docker): entfernt eine registrierte dauerhafte Umgebung.
fn tool_docker_environment_entfernen container_name
    dbh: get STATE "dbh"
    cid: get STATE "cid"
    if dbh == nil || cid == nil
        return "Kein Chat-/Datenbank-Kontext verfuegbar."
    dt.tool_docker_environment_entfernen dbh cid container_name

--! Tool (nur Registrator): stellt eine BELIEBIGE Aufgabe zurueck, die
--! offensichtlich mehr Zeit/mehr Runden braucht, als in diesem einen
--! Gremiums-Lauf uebrig sind — nicht nur Docker (siehe
--! tool_docker_hintergrund_setup fuer den SPEZIFISCHEN, guenstiger zu
--! pruefenden Fall). Legt einen Fortschritts-Checkpoint an und plant per
--! Scheduler eine Fortsetzung ein: beim naechsten Tick bekommt das
--! Gremium ein FRISCHES Rundenbudget und arbeitet mit dem gespeicherten
--! Fortschritt weiter (siehe muninn.pipe sched_tick, Zweig "task_check").
--! Kann dabei ERNEUT aufgerufen werden, wenn wieder nicht genug Zeit
--! bleibt — so entsteht eine Kette beliebig vieler Fortsetzungen, bis die
--! Aufgabe wirklich fertig ist.
fn tool_hintergrund_fortsetzen zusammenfassung fortschritt
    cid: get STATE "cid"
    dbh: get STATE "dbh"
    if cid == nil || dbh == nil
        return "Kein Kontext verfuegbar, kann nicht im Hintergrund fortsetzen."
    if zusammenfassung == nil || (trim zusammenfassung) == ""
        return "Zusammenfassung der Aufgabe fehlt."
    task_id: sched.create_background_task dbh cid zusammenfassung fortschritt
    due: now + 120
    sched.schedule dbh "task_check" cid (to_str task_id) due ""
    "Hintergrund-Fortsetzung eingeplant (#" ++ (to_str task_id) ++ "). Antworte dem Nutzer JETZT kurz, dass du weiterarbeitest und dich automatisch meldest, sobald fertig — behaupte NICHT, dass die Aufgabe schon fertig ist."

--! URL-Encoding fuer den Prompt-Teil der Pollinations-Bild-URL (die Standard-
--! urlencode oben in telegram.pipe ist privat/dort nicht importierbar,
--! daher eine eigene, kleine Variante mit den fuer Bildprompts relevanten
--! Sonderzeichen).
fn pollinations_urlencode s
    s: replace_all s "%" "%25"
    s: replace_all s " " "%20"
    s: replace_all s "\"" "%22"
    s: replace_all s "#" "%23"
    s: replace_all s "&" "%26"
    s: replace_all s "'" "%27"
    s: replace_all s "+" "%2B"
    s: replace_all s "," "%2C"
    s: replace_all s "/" "%2F"
    s: replace_all s ":" "%3A"
    s: replace_all s ";" "%3B"
    s: replace_all s "=" "%3D"
    s: replace_all s "?" "%3F"
    s

--! Ruft Pollinations.ai's offene Bild-URL-API auf — kostenlos, KEIN API-Key
--! noetig (anonyme Nutzung laut offizieller Doku erlaubt, ca. 1 Anfrage/15s,
--! evtl. kleines Wasserzeichen). Live getestet: der eigentliche, per npm
--! vertriebene MCP-Server verlangt inzwischen einen Key, die darunterliegende
--! klassische HTTP-API (image.pollinations.ai/prompt/...) aber weiterhin
--! nicht. http_request statt http_get: 30s statt 10s Timeout — ein frischer,
--! noch nie generierter Prompt braucht live beobachtet bis zu ~6s, ein
--! einzelner 10s-Timeout-Ausrutscher trat live einmal auf.
fn pollinations_generate prompt width height
    seed: random_range 100000 999999
    url: "https://image.pollinations.ai/prompt/" ++ (pollinations_urlencode prompt) ++ "?width=" ++ (to_str width) ++ "&height=" ++ (to_str height) ++ "&seed=" ++ (to_str seed) ++ "&nologo=true"
    r: http_request "GET" url {}
    if (get r "status") != 200
        return {ok: false, path: nil, error: "HTTP " ++ (to_str (get r "status")) ++ " von Pollinations.ai"}
    body: get r "body"
    if body == nil || (len body) < 100
        return {ok: false, path: nil, error: "Leere oder ungueltige Bildantwort."}
    path: "/root/muninn/mcp_data/bild_" ++ (to_str now) ++ "_" ++ (to_str seed) ++ ".jpg"
    write_file path body
    {ok: true, path: path, error: nil}

--! Tool: ein Bild per KI (Pollinations.ai, kostenlos, kein API-Key) aus einer
--! Textbeschreibung erzeugen UND direkt an den Nutzer senden — Generieren
--! und Senden bewusst in EINEM Werkzeugaufruf (analog zu
--! tool_sprachnachricht_senden), damit die KI das nicht als zwei separate
--! Schritte falsch verketten kann (z.B. Bild erzeugen, aber den Pfad beim
--! Senden falsch angeben).
fn tool_bild_erstellen prompt
    tok: get STATE "token"
    cid: get STATE "cid"
    if tok == nil || cid == nil
        return "Kein Telegram-Kontext verfuegbar, kann kein Bild erstellen/senden."
    if prompt == nil || (trim prompt) == ""
        return "Keine Bildbeschreibung angegeben."
    gen: pollinations_generate prompt 1024 1024
    if !(get gen "ok")
        return "Bildgenerierung fehlgeschlagen: " ++ (to_str (get gen "error"))
    path: get gen "path"
    res: tel.tel_send_photo tok cid path nil
    file_delete path
    if (get res "ok") == false
        return "Bild erstellt, aber Senden fehlgeschlagen: " ++ (to_str res)
    "Bild erstellt und gesendet."

--! Registriert Tools und Gremium-Agenten (einmalig beim Start).
--! Bindet zusaetzlich alle bereits per mcp.connect_servers verbundenen MCP-Tools
--! (Dateisystem, GitHub, ...) an einen eigenen "werkzeugmeister"-Agenten (P1).
export fn init_gremium _
    ai_tool "erinnerungen_suchen" "Relevante Erinnerungen aus Muninns Langzeitgedaechtnis abrufen, um Fakten zu belegen." {query: "Suchanfrage"} tool_erinnerungen_suchen
    ai_tool "merken" "Eine wichtige dauerhafte Erkenntnis ueber den Nutzer speichern." {content: "Inhalt", kind: "Kategorie"} tool_merken
    ai_tool "web_search" "Im Internet suchen; liefert Titel und URLs der Top-Treffer." {query: "Suchbegriffe"} tool_web_search
    ai_tool "web_fetch" "Eine Webseite abrufen und deren Fließtext liefern." {url: "Vollständige URL"} tool_web_fetch
    ai_tool "merken_quelle" "Eine aus dem Web gewonnene Erkenntnis dauerhaft mit Quellen-URL speichern." {content: "Erkenntnis", source: "Quellen-URL"} tool_merken_quelle
    ai_tool "erinnerung_planen" "Eine zeitgesteuerte Erinnerung fuer den Nutzer planen (z.B. bei Terminen/Verpflichtungen mit Zeitangabe)." {text: "Was erinnert werden soll, inkl. Zeitangabe in natuerlicher Sprache"} tool_erinnerung_planen
    --! Bewusst eingeschraenkte Docker-Erweiterung (Image ziehen, Container
    --! anlegen) — siehe docker_tools.pipe fuer die Sicherheitsbegruendung.
    --! Ergaenzt den MCP-Server "docker" (verwaltet nur BESTEHENDE Container).
    ai_tool "docker_pull_image" "Ein Docker-Image von einer Registry herunterladen (z.B. 'nginx:latest')." {image: "Image-Name inkl. optionalem Tag"} dt.tool_docker_pull_image
    ai_tool "docker_create_container" "Einen neuen Container aus einem Image starten. KEINE Volume-Mounts moeglich, KEIN --privileged. Standardmaessig nur auf localhost erreichbar (public='true' fuer oeffentlich, nur wenn explizit gewuenscht)." {image: "Image-Name (ggf. vorher mit docker_pull_image geholt)", name: "Container-Name", host_port: "Port auf dem Host", container_port: "Port im Container", public: "'true' fuer oeffentlich erreichbar, sonst nur localhost"} dt.tool_docker_create_container
    ai_tool "docker_hintergrund_setup" "Ein Docker-Setup starten, das LAENGER dauern darf (z.B. Paketinstallation) — blockiert NICHT, meldet sich automatisch per Scheduler, sobald fertig. Fuer schnelle Container aus einem fertigen Image stattdessen 'docker_create_container' nutzen." {image: "Image-Name (Basis-Image, z.B. 'ubuntu:22.04')", name: "Container-Name", setup_command: "Shell-Befehl(e), die IM Container ausgefuehrt werden (z.B. Paketinstallation) — && erlaubt, laeuft isoliert im Container", beschreibung: "Kurze Beschreibung der Aufgabe fuer die spaetere Rueckmeldung"} tool_docker_hintergrund_setup
    ai_tool "docker_job_status" "Zeigt den Status der zuletzt gestarteten Hintergrund-Docker-Jobs dieses Chats. IMMER zuerst aufrufen, bevor du fuer eine Aufgabe, fuer die schon ein Job laufen KOENNTE (z.B. nach einer Fehlermeldung oder auf 'wie weit bist du'), einen neuen Job startest — NIEMALS blind einen zweiten, parallelen Job fuer dieselbe Aufgabe starten." {} tool_docker_job_status
    ai_tool "docker_jobs_abbrechen" "Bricht SOFORT alle laufenden Hintergrund-Docker-Jobs UND geplanten Hintergrund-Fortsetzungen dieses Chats ab (Container werden entfernt, Scheduler-Eintraege storniert)." {} tool_docker_jobs_abbrechen
    ai_tool "docker_environments_auflisten" "Zeigt registrierte DAUERHAFTE, wiederverwendbare Docker-Umgebungen dieses Chats (Name, Zweck, installierte Tools). IMMER zuerst aufrufen, bevor du fuer eine Anfrage, die irgendeine Linux-/Docker-Umgebung braucht, einen NEUEN Container anlegst — pruefe, ob eine bestehende Umgebung schon passt." {} tool_docker_environments_auflisten
    ai_tool "docker_environment_registrieren" "Registriert einen Container als dauerhafte, wiederverwendbare Umgebung (Name, Zweck, installierte Tools) — NUR fuer Container, die bewusst laenger/dauerhaft laufen sollen (z.B. eine Test-/Entwicklungsumgebung), NICHT fuer einmalige Test-/Build-Laeufe (die tracked 'docker_hintergrund_setup' bereits selbst und sollen fertig werden/aufgeraeumt werden)." {container_name: "Name des laufenden Containers", purpose: "Wofuer diese Umgebung gedacht ist (kurz, konkret)", installed: "Was installiert ist (Sprache/Version, Tools, Pakete)"} tool_docker_environment_registrieren
    ai_tool "docker_environment_entfernen" "Entfernt eine registrierte dauerhafte Umgebung (Container UND Registrierung) — wenn der Nutzer sagt, sie nicht mehr zu brauchen." {container_name: "Name der zu entfernenden Umgebung"} tool_docker_environment_entfernen
    --! Bilder/Dateien an den Nutzer senden (z.B. ein Screenshot, den
    --! werkzeug_browser lokal gespeichert hat, oder eine per Filesystem-
    --! Werkzeug erzeugte Datei) — ohne das kann Muninn nur ÜBER Dateien
    --! reden, sie aber nicht tatsaechlich verschicken.
    ai_tool "bild_senden" "Ein Bild (Screenshot o.ae.) aus einer lokalen Datei an den Nutzer in Telegram senden (zeigt inline im Chat)." {path: "Pfad zur Bilddatei (relativ zu /root/muninn oder absolut)", caption: "Optionale Bildunterschrift"} tool_bild_senden
    ai_tool "datei_senden" "Eine beliebige lokale Datei an den Nutzer in Telegram senden (als Datei-Anhang, Originalformat)." {path: "Pfad zur Datei (relativ zu /root/muninn oder absolut)", caption: "Optionale Beschreibung"} tool_datei_senden
    ai_tool "sprachnachricht_senden" "Text als gesprochene Sprachnachricht (statt Textnachricht) an den Nutzer senden — lokale Sprachsynthese, kein Cloud-Dienst." {text: "Der zu sprechende Text (kurz halten, max. ca. 600 Zeichen — keine Links/Listen/Code, die klingen als Sprache nicht sinnvoll)"} tool_sprachnachricht_senden
    ai_tool "bild_erstellen" "Ein NEUES Bild aus einer Textbeschreibung per KI generieren und direkt an den Nutzer senden (kostenlos, kein API-Key). NICHT fuer bereits vorhandene Dateien/Screenshots — dafuer 'bild_senden'." {prompt: "Detaillierte Bildbeschreibung auf Englisch (bessere Ergebnisse als Deutsch)"} tool_bild_erstellen
    ai_tool "hintergrund_fortsetzen" "Eine BELIEBIGE Aufgabe zurueckstellen, die erkennbar mehr Zeit/Runden braucht als jetzt uebrig sind (nicht nur Docker) — Muninn arbeitet automatisch mit frischem Rundenbudget weiter und meldet sich, sobald fertig. Kann bei Bedarf mehrfach hintereinander aufgerufen werden." {zusammenfassung: "Kurze Zusammenfassung der urspruenglichen Aufgabe", fortschritt: "Was bisher erledigt ist und was noch zu tun ist, moeglichst konkret"} tool_hintergrund_fortsetzen
    ai_tool "rezept_speichern" "Ein wiederverwendbares Workflow-Rezept (bewaehrte Schrittfolge fuer eine wiederkehrende Aufgabe) dauerhaft speichern." {name: "Kurzer, eindeutiger Rezept-Name", schritte: "Die einzelnen Schritte der Reihe nach, konkret und umsetzbar"} tool_rezept_speichern
    ai_tool "rezepte_suchen" "Gespeicherte Workflow-Rezepte abrufen, um wiederkehrende Aufgaben nach bewaehrtem Muster zu loesen." {query: "Stichworte zur Aufgabe"} tool_rezepte_suchen

    local_names: ["erinnerungen_suchen", "merken", "web_search", "web_fetch", "merken_quelle", "erinnerung_planen", "docker_pull_image", "docker_create_container", "docker_hintergrund_setup", "docker_job_status", "docker_jobs_abbrechen", "docker_environments_auflisten", "docker_environment_registrieren", "docker_environment_entfernen", "bild_senden", "datei_senden", "hintergrund_fortsetzen", "rezept_speichern", "rezepte_suchen"]
    --! P5: EIN fokussierter Spezial-Agent PRO angebundenem MCP-Server statt
    --! eines Alleskoenners mit allen Werkzeugen — skaliert automatisch mit
    --! jedem neuen MCP-Server (kein Code-Umbau noetig), und haelt die
    --! Tool-Auswahl der KI pro Agent klein und treffsicher, statt sie bei
    --! sehr vielen Werkzeugen mit einer riesigen flachen Liste zu ueberfordern.
    mcp_groups: mcp.discovered_tools_by_source local_names
    has_mcp: (len mcp_groups) > 0
    mcp_names: []
    specialist_names: []
    specialist_desc: ""
    --! Zweipass-Aufbau: im ersten Durchlauf ist specialist_names erst
    --! TEILWEISE gefuellt (waechst mit jeder Iteration) — ein Spezialist,
    --! der frueh in mcp_groups steht, wuerde beim direkten Registrieren also
    --! NICHT an spaeter registrierte Spezialisten weiterleiten koennen. Erst
    --! Metadaten sammeln, DANACH im zweiten Durchlauf mit der vollstaendigen
    --! Liste registrieren — sonst kann z.B. 'werkzeug_google' (Gmail-Suche)
    --! nach getaner Arbeit nicht direkt an 'werkzeug_dokument' (Bericht
    --! schreiben) uebergeben, wenn 'dokument' erst SPAETER in mcp_groups
    --! auftaucht (beobachtet live: "Suche Rechnungen aus E-Mails und
    --! schreib dazu einen Bericht" scheiterte genau daran).
    specialist_meta: []
    for grp in mcp_groups
        alias: get grp "alias"
        if (len alias) > 0 && (substring alias ((len alias) - 1) (len alias)) == "_"
            alias: substring alias 0 ((len alias) - 1)
        gtools: get grp "tools"
        for tn in gtools
            push mcp_names tn
        extra_note: ""
        if alias == "docker"
            --! Nur der Docker-Spezialist bekommt zusaetzlich die lokalen,
            --! eingeschraenkten Image-Pull/Container-Erstellen-Werkzeuge (siehe
            --! docker_tools.pipe) — die MCP-Werkzeuge aus '" ++ alias ++ "'
            --! koennen das nicht, nur bestehende Container verwalten.
            push gtools "docker_pull_image"
            push gtools "docker_create_container"
            push gtools "docker_hintergrund_setup"
            push gtools "docker_job_status"
            push gtools "docker_jobs_abbrechen"
            push gtools "docker_environments_auflisten"
            push gtools "docker_environment_registrieren"
            push gtools "docker_environment_entfernen"
            extra_note: " Zusaetzlich hast du 'docker_pull_image' und 'docker_create_container' fuer neue Container/Images — dabei gibt es KEINE Volume-Mounts und KEIN --privileged, das ist Absicht (Sicherheit), nicht ein fehlendes Feature; biete das dem Nutzer nicht als moeglich an. Neue Container sind standardmaessig nur auf localhost erreichbar, ausser der Nutzer will es ausdruecklich oeffentlich (dann public='true'). Geht es um ein Setup, das LAENGER dauern koennte (z.B. Pakete installieren, ein System einrichten — nicht nur ein fertiges Image direkt starten), nutze STATTDESSEN 'docker_hintergrund_setup': das blockiert NICHT, sondern meldet sich automatisch, sobald fertig — rufe es auf, gib die 'gestartet, ich melde mich automatisch'-Rueckmeldung direkt an den Nutzer weiter, und warte/frage NICHT selbst nach, ob es fertig ist. GITHUB-REPO KLONEN UND TESTEN: verlangt der Nutzer, ein GitHub-Repo herunterzuladen/zu testen/auszufuehren, nutze GENAU DAFUER 'docker_hintergrund_setup' — kein separates Werkzeug noetig. Waehle ein passendes Basis-Image nach der erkennbaren Sprache des Projekts — nutze IMMER die 'floating' Major-Version-Tags ('node:lts-alpine' fuer JavaScript/TypeScript, 'python:3-slim' fuer Python, 'golang:1-alpine' fuer Go, 'rust:1-slim' fuer Rust, 'eclipse-temurin:21-jdk' fuer Java/Kotlin/Maven/Gradle), NIEMALS eine geratene spezifische Minor-Version (z.B. NICHT 'golang:1.22-alpine') — live beobachtet: eine geratene, zu alte Go-Version scheiterte an 'go.mod requires go >= 1.25.0', bevor die Tests ueberhaupt liefen. Baue setup_command als EINE Kette: zuerst git installieren (Alpine: 'apk add --no-cache git', Debian/Ubuntu-Basis: 'apt-get update -qq && apt-get install -y -qq git'), dann 'GIT_TERMINAL_PROMPT=0 git clone --depth 1 <repo-url> /repo && cd /repo && <Installationsbefehl> && <Testbefehl>' (z.B. 'npm install && npm test', 'pip install -r requirements.txt && pytest', 'go test ./...', 'cargo test'). Ist das Projekt in seinem README/Makefile erkennbar anders aufgebaut (z.B. anderer Testbefehl, extra Setup-Schritte), passe die Befehlskette entsprechend an — bei Unsicherheit erst kurz 'web_fetch' auf die rohe Makefile-/README-URL nutzen statt einen Build-Befehl zu erraten. Das laeuft VOLLSTAENDIG isoliert im Container (kein Volume-Mount, kein Zugriff auf den Host) — Testfehler/Abstuerze/Nebenwirkungen IM Container sind unproblematisch und erwartbar, dafuer ist die Docker-Isolation da; es gibt bewusst KEIN Zeit-/Ressourcenlimit fuer den Testlauf selbst. Nach Abschluss meldet sich Muninn automatisch mit den ECHTEN Container-Logs (Testausgabe, siehe job_check in muninn.pipe) — erfinde NIE Testergebnisse, warte auf die echte Rueckmeldung. BEVOR du 'docker_hintergrund_setup' fuer eine Aufgabe (er)neut aufrufst — egal ob als Reaktion auf eine Fehlermeldung oder eine Rueckfrage wie 'wie weit bist du' —, rufe IMMER ZUERST 'docker_job_status' auf: laeuft dafuer schon ein Job (Status 'running'), warte auf dessen automatische Rueckmeldung statt EINEN ZWEITEN, PARALLELEN Job fuer dieselbe Aufgabe zu starten (live beobachtet: zwei gleichzeitig laufende Jobs fuer dieselbe Anfrage, weil jede Rueckfrage einen weiteren Versuch ausloeste). NIEMALS 'docker_remove_container' oder 'docker_stop_container' (MCP-Werkzeuge aus 'docker') auf einem per 'docker_hintergrund_setup' gestarteten Container aufrufen, solange dessen Job noch 'running' ist — job_check erledigt Fertigstellungs-Erkennung UND Aufraeumen automatisch; ein manuelles Entfernen zerstoert die Job-Verfolgung, die Ergebnisse gehen verloren UND job_check meldet danach faelschlich einen Fehlschlag. Will der Nutzer einen laufenden Job WIRKLICH abbrechen, nutze STATTDESSEN 'docker_jobs_abbrechen'. BESTEHENDE UMGEBUNGEN WIEDERVERWENDEN STATT IMMER NEU ANZULEGEN: verlangt eine Anfrage NUR 'irgendeine Linux-/Docker-Umgebung' (z.B. 'gib mir eine Shell zum Ausprobieren', 'richte mir eine Testumgebung ein', ohne dass es um ein NEUES, spezifisches Setup wie 'installiere X' oder einen einmaligen Repo-Test geht), rufe ZUERST 'docker_environments_auflisten' auf — passt eine bestehende registrierte Umgebung zum Zweck, nutze SIE (per 'docker_exec_command' aus den MCP-Werkzeugen aus 'docker' direkt Befehle darin ausfuehren), STATT reflexartig einen neuen Container anzulegen. Nur wenn keine passende existiert oder der Nutzer ausdruecklich eine NEUE/andere Umgebung will, lege einen neuen Container an ('docker_create_container' fuer schnelle Faelle, 'docker_hintergrund_setup' wenn Einrichtung laenger dauert). Ist der neu angelegte Container als DAUERHAFTE, wiederverwendbare Umgebung gedacht (nicht ein einmaliger Test-/Build-Lauf!), rufe danach 'docker_environment_registrieren' mit Name, Zweck und installierten Tools auf, damit du (und spaetere Anfragen) ihn wiederfinden und wiederverwenden koennen. Registriere NIEMALS einmalige Repo-Test-/Build-Container ueber 'docker_hintergrund_setup' — die sollen fertig werden, gemeldet und aufgeraeumt werden (siehe job_check), nicht als wiederverwendbare Umgebung erscheinen."
        if alias == "google"
            google_email: get STATE "google_email"
            if google_email == nil || google_email == ""
                extra_note: " No Google account is configured for this Muninn instance (USER_GOOGLE_EMAIL missing from the 'google' MCP server's env) — tell the user honestly that Gmail/Drive/Calendar tools need a configured Google account before they can be used."
            else
                extra_note: " The user's Google account is " ++ google_email ++ " — pass this as 'user_google_email' on EVERY Gmail/Drive/Calendar tool call, it is never filled in automatically. If a tool reports missing login/authorization, call 'start_google_auth' IMMEDIATELY (service_name e.g. 'gmail') and pass the returned Google consent URL VERBATIM to the user so they can open it in a browser — NEVER claim that connecting the Google account isn't possible. The user has knowingly granted full Gmail send access as well as full read/write access to Drive and Calendar."
        if alias == "praesentation"
            --! Ohne diese Anleitung verliert sich die KI im grossen
            --! Vorlagen-/Template-Werkzeugsatz (create_presentation_from_templates,
            --! populate_placeholder, manage_text, ...) und erreicht
            --! save_presentation oft gar nicht mehr, bevor die Rundenzahl
            --! aufgebraucht ist (live beobachtet: 18 Runden, viele
            --! Tool-Experimente, nie gespeichert). Der simple 3-Schritt-Pfad
            --! (create -> add_slide pro Folie -> save) ist isoliert getestet
            --! zuverlaessig und schnell.
            extra_note: " Nutze IMMER den einfachen Weg: 'ppt_create_presentation' EINMAL aufrufen (liefert eine presentation_id), dann pro gewuenschter Folie 'ppt_add_slide' mit presentation_id+title+content, zum Schluss GENAU EINMAL 'ppt_save_presentation' mit presentation_id und file_path (IMMER unter '/root/muninn/mcp_data/<sprechender-name>.pptx'). Nutze NICHT das Vorlagen-/Template-System (create_presentation_from_templates, populate_placeholder, manage_text) — das braucht viel mehr Schritte und fuehrt oft dazu, dass die Praesentation nie gespeichert wird. Danach uebergib an 'kritiker' — der Registrator schickt die fertige Datei per 'datei_senden'; du selbst hast dieses Werkzeug nicht."
        if alias == "dokument"
            extra_note: " Nutze 'word_create_document' EINMAL mit filename (IMMER unter '/root/muninn/mcp_data/<sprechender-name>.docx') — das legt die Datei direkt an, KEIN separater Speicher-Schritt noetig. Danach 'word_add_heading'/'word_add_paragraph' etc. mit demselben filename pro Abschnitt — jeder Aufruf schreibt sofort in die Datei. 'word_convert_to_pdf' NUR wenn der Nutzer ausdruecklich ein PDF wollte (nicht von dir aus versuchen — auf diesem Server ist dafuer kein LibreOffice/Word installiert, der Versuch schlaegt IMMER fehl und bringt nur eine unnoetige Fehlermeldung). Danach uebergib an 'kritiker' — der Registrator schickt die fertige Datei per 'datei_senden'; du selbst hast dieses Werkzeug nicht."
        agent_name: "werkzeug_" ++ alias
        push specialist_names agent_name
        specialist_desc: specialist_desc ++ "- '" ++ agent_name ++ "': Werkzeuge aus '" ++ alias ++ "' (" ++ (join gtools ", ") ++ ")\n"
        push specialist_meta {agent_name: agent_name, alias: alias, gtools: gtools, extra_note: extra_note}

    --! Zweiter Durchlauf: specialist_names ist jetzt vollstaendig, jeder
    --! Spezialist kann also an JEDEN anderen Spezialisten weiterleiten
    --! (ausser an sich selbst) — nicht nur an kritiker/planer.
    for meta in specialist_meta
        agent_name: get meta "agent_name"
        alias: get meta "alias"
        gtools: get meta "gtools"
        extra_note: get meta "extra_note"
        peer_handoff: ["kritiker", "planer"]
        for sn in specialist_names
            if sn != agent_name
                push peer_handoff sn
        swarm_agent agent_name {system: SELF_ID ++ HANDOFF_RULE ++ RETRY_RULE ++ VERIFY_CLAIM_RULE ++ RESULT_HONESTY_RULE ++ "Du bist der Spezial-Agent fuer '" ++ alias ++ "' im Gremium von Muninn. Du hast NUR Zugriff auf die per MCP aus '" ++ alias ++ "' angebundenen Werkzeuge." ++ extra_note ++ " WICHTIG: Nutze das Selbstwissen oben aktiv, bevor du eine Anfrage bearbeitest — geht es z.B. um 'Pipe', ist damit hoechstwahrscheinlich Muninns EIGENE Skriptsprache gemeint (siehe Selbstwissen), NICHT Unix-Pipes/das Shell-Symbol '|', auch wenn Letzteres dein allgemeines Sprachmodell-Vorwissen naheliegender erscheinen laesst. Ist bei einem Begriff aus der Nutzeranfrage unklar, ob Muninn selbst oder etwas Allgemeines gemeint ist, bevorzuge den Bezug zu Muninn selbst oder frage im Zweifel kurz nach — erfinde NIE einfach die allgemeinere, thematisch nahliegendere Bedeutung. Brauchst du fuer die Anfrage mehrere dieser Werkzeuge nacheinander (z.B. erst einen Ort/eine ID nachschlagen, dann damit die eigentlichen Daten abrufen), rufe sie ALLE in dieser einen Runde nacheinander auf, BEVOR du weiterleitest — nicht nach jedem einzelnen Werkzeug zurueckspringen, das verbraucht unnoetig Runden. Braucht die Anfrage NACH deiner Arbeit noch eine ANDERE Faehigkeit (z.B. hast du recherchiert/Daten geholt, aber die sollen jetzt in ein Dokument/eine Praesentation), leite DIREKT an den passenden anderen werkzeug_<alias>-Spezialisten weiter (siehe Spezialisten-Liste oben) statt nur an 'kritiker' — der kann selbst keine Dokumente/Praesentationen erzeugen oder andere Werkzeuge bedienen. KRITISCH: Verlangt DEINE eigene Rolle ein konkretes Ergebnis (z.B. eine erstellte Datei, ein angelegter Container, ein gesendeter Termin) — du bist genau dafuer der zustaendige Spezialist —, dann MUSST du mindestens eines deiner eigenen Werkzeuge tatsaechlich aufrufen, BEVOR du weiterleitest. Formuliere das Ergebnis NIEMALS nur als Text/Vorschlag und leite NIEMALS direkt weiter, ohne selbst gehandelt zu haben — ein anderer Agent kann deine Werkzeuge nicht nachtraeglich fuer dich aufrufen, die Aufgabe bliebe dann faktisch unerledigt, auch wenn der Text danach fertig klingt. Ist deine Arbeit fertig und wird nichts Weiteres gebraucht, rufe 'kritiker' auf, um dein Ergebnis weiterzugeben.", tools: gtools, handoff: peer_handoff}

    --! Dynamisch aus dem ECHTEN Zustand gebaut (nicht statischer Text wie
    --! SELF_ID) — siehe Kommentar bei MEMORY_HONESTY_RULE oben.
    tools_desc: "ECHTE, aktuell verfuegbare Werkzeuge (fuer Fragen ueber deine eigenen Faehigkeiten/Werkzeuge IMMER diese Liste nutzen — NIE 'web_search', das Internet weiss nicht, welche Werkzeuge DU verbunden hast): 'erinnerungen_suchen' (Muninns Gedaechtnis durchsuchen), 'merken'/'merken_quelle' (dauerhaft speichern), 'web_search'/'web_fetch' (im Internet recherchieren), 'erinnerung_planen' (Termin/Erinnerung planen), 'bild_erstellen' (ein neues Bild aus einer Textbeschreibung per KI generieren und senden), 'hintergrund_fortsetzen' (eine zu lange dauernde Aufgabe zurueckstellen und automatisch weiterarbeiten), 'rezept_speichern'/'rezepte_suchen' (bewaehrte Arbeitsablaeufe als Rezepte speichern und wiederverwenden)"
    if has_mcp
        tools_desc: tools_desc ++ ", sowie per MCP extern angebunden: " ++ (join mcp_names ", ") ++ ". Verfuegbare Werkzeug-Spezialisten im Gremium:\n" ++ specialist_desc
    else
        tools_desc: tools_desc ++ ". Aktuell ist KEIN externer MCP-Server angebunden — Aktionen in Drittsystemen (Cloud-Dienste, Google Workspace, GitHub etc.) sind daher NICHT moeglich, bis ein passender MCP-Server konfiguriert wird."
    tools_desc: tools_desc ++ " Fehlt ein gefragtes Werkzeug in dieser Liste, sag ehrlich, dass es aktuell nicht angebunden ist — behaupte NIE pauschal 'ich habe keinen Zugriff auf Werkzeuge', wenn diese Liste nicht leer ist.\n\n"

    --! "registrator" ist hier bewusst mit dabei (nicht nur bei kritiker_handoff):
    --! reine Bildgenerierungs-Anfragen ('erstelle mir ein Bild von...') sollen
    --! DIREKT von planer an registrator gehen (der 'bild_erstellen' hat),
    --! ohne unnoetigen Umweg ueber faktenwaechter/kritiker — live beobachtet,
    --! dass ohne dieses Handoff-Ziel eine simple Bildanfrage 16 Runden lang
    --! zwischen den anderen Agenten hin- und hersprang, bevor sie zufaellig
    --! bei registrator landete.
    planer_handoff: ["faktenwaechter", "kritiker", "registrator"]
    kritiker_handoff: ["faktenwaechter", "registrator"]
    faktenwaechter_handoff: ["kritiker", "planer"]
    for sn in specialist_names
        push planer_handoff sn
        push kritiker_handoff sn
        push faktenwaechter_handoff sn

    swarm_agent "planer" {system: SELF_ID ++ tools_desc ++ HANDOFF_RULE ++ HONESTY_RULE ++ SECURITY_HONESTY_RULE ++ "Du bist der Planer im inneren Gremium von Muninn, einem persoenlichen KI-Agenten mit Langzeitgedaechtnis. Analysiere die Nutzeranfrage. Bei MEHRSCHRITTIGEN oder komplexen Aufgaben (mehrere Teilschritte oder mehrere Werkzeuge noetig): rufe ZUERST 'rezepte_suchen' auf — gibt es ein gespeichertes Rezept fuer genau diese Art Aufgabe, folge dessen Schritten (Weiterleitungen/Reihenfolge entsprechend dem Rezept). Zerlege grosse Aufgaben in klare Teilschritte und steuere sie der Reihe nach an die passenden Spezialisten; wiederholte Einzelschritte laufen ueber die Weiterleitungen der Spezialisten zurueck zu dir, dann gibst du den naechsten Teilschritt frei. Ist es eine Meta-Frage ueber Muninn selbst ODER seine Werkzeuge/Faehigkeiten, leite trotzdem an 'faktenwaechter' weiter (der beantwortet sie direkt aus dem Selbstwissen/der Werkzeugliste oben). Bei sonstigen Fakten- oder Gedaechtnisfragen leite ebenfalls an 'faktenwaechter' weiter. Verlangt die Anfrage RECHERCHE (z.B. 'suche im Netz', 'aktuelle Nachrichten') UND zusaetzlich EIN ERGEBNIS-WERKZEUG (z.B. 'schreib es in ein Dokument', 'als Praesentation') — auch 'Bericht'/'Report'/'Studie'/'Gutachten' zaehlen als Dokument-Ergebnis-Anfrage — leite ZUERST an 'faktenwaechter' weiter, NICHT direkt an den werkzeug_<alias>-Spezialisten: der recherchiert und reicht danach selbst an den passenden Spezialisten weiter, sobald er echte Inhalte hat. 'werkzeug_browser' ist NUR fuer echte Website-Interaktion (navigieren, klicken, Formulare, Screenshots) — NICHT fuer allgemeine Web-Recherche/Nachrichten, dafuer ist 'faktenwaechter' (web_search/web_fetch) zustaendig. Erfordert die Anfrage NUR ein konkretes externes Werkzeug ohne vorherige Recherche, leite an den PASSENDEN Werkzeug-Spezialisten aus der Liste oben weiter (nicht an einen falschen — waehle anhand der dort aufgefuehrten Werkzeugnamen). Verlangt die Anfrage NUR ein NEU zu generierendes Bild (z.B. 'erstelle/generiere/zeichne mir ein Bild von...') OHNE Recherche oder sonstige Aufgabe, leite DIREKT an 'registrator' weiter — der hat das Bild-Werkzeug 'bild_erstellen', kein Umweg ueber 'faktenwaechter'/'kritiker' noetig. Verlangt die Anfrage, laufende Hintergrund-Aufgaben/Docker-Jobs abzubrechen/zu stoppen, leite DIREKT an 'registrator' weiter (der hat 'docker_jobs_abbrechen') — das ist zeitkritisch, kein Umweg ueber Recherche/Kritik noetig. Siehst du den Hinweis '[SYSTEM] Only N of M rounds remain' bei einer mehrschrittigen, noch nicht fertigen Aufgabe: leite SOFORT an 'registrator' weiter (der nutzt 'hintergrund_fortsetzen') statt mitten in der Zerlegung zu scheitern. Sonst leite an 'kritiker' weiter. Gib selbst NIE die Endantwort und NIE internes Reasoning aus.", tools: ["rezepte_suchen"], handoff: planer_handoff}

    swarm_agent "faktenwaechter" {system: SELF_ID ++ tools_desc ++ HANDOFF_RULE ++ TOOL_DISCIPLINE_RULE ++ RESULT_HONESTY_RULE ++ MEMORY_HONESTY_RULE ++ SECURITY_HONESTY_RULE ++ "Du bist der Faktenwaechter im Gremium. Ist die Frage eine Meta-Frage ueber Muninn selbst ODER seine Werkzeuge/Faehigkeiten (z.B. 'kannst du mit deinen Werkzeugen X tun'), beantworte sie DIREKT aus dem Selbstwissen/der Werkzeugliste oben, OHNE 'web_search' aufzurufen — das Internet weiss nichts ueber DEINE Werkzeugverbindungen. Auch dann rufst du danach dein Handoff-Werkzeug 'kritiker' auf, du gibst NIE selbst die finale Antwort aus. Bei allen anderen Fragen stuetze jede Aussage auf Muninns Gedaechtnis UND das Internet: rufe 'erinnerungen_suchen' auf, um relevante Erinnerungen zu finden; wenn das Gedaechtnis nichts hergibt, nutze 'web_search' und 'web_fetch', um die Antwort im Internet zu recherchieren. Verlangt die Anfrage NACH der Recherche zusaetzlich ein ERGEBNIS-WERKZEUG (z.B. 'schreib es in ein Dokument und schick es mir'), leite deine recherchierten Inhalte DIREKT an den passenden werkzeug_<alias>-Spezialisten weiter (z.B. 'werkzeug_dokument'), NICHT an 'kritiker' — der kann selbst keine Dokumente/Praesentationen erzeugen. Sonst rufe IMMER 'kritiker' auf, um deine fundierte Antwort weiterzugeben. Siehst du den Hinweis '[SYSTEM] Only N of M rounds remain' — leite JETZT SOFORT an 'kritiker' weiter (auch mit unvollstaendiger Recherche), NICHT an einen werkzeug_<alias>-Spezialisten oder zurueck an 'planer' — 'kritiker' erreicht 'registrator' in nur einem weiteren Schritt, jeder andere Umweg kostet Runden, die dann fehlen.", tools: ["erinnerungen_suchen", "web_search", "web_fetch"], handoff: faktenwaechter_handoff}

    swarm_agent "kritiker" {system: HANDOFF_RULE ++ MEMORY_HONESTY_RULE ++ SECURITY_HONESTY_RULE ++ "Du bist der Kritiker im Gremium. Pruefe die bisherige Antwort auf Luecken, Widersprueche und Unklarheiten und verbessere sie zu einer praezisen, ehrlichen Antwort. Wenn Fakten fehlen, leite an 'faktenwaechter' zurueck. Sonst rufe IMMER 'registrator' auf, um die verbesserte Antwort weiterzugeben — auch wenn die Antwort schon gut ist oder eine Aufgabe (Dokument/Praesentation/...) nur teilweise erledigt wurde: der Registrator schickt trotzdem das bisherige Ergebnis, ANSTATT dass du hier weiter zwischen Agenten hin- und herspringst. Siehst du den Hinweis '[SYSTEM] Only N of M rounds remain' — leite JETZT SOFORT an 'registrator' weiter, egal wie unvollstaendig die Faktenlage ist (der kann bei echtem Zeitdruck 'hintergrund_fortsetzen' aufrufen); leite in diesem Fall NIEMALS zurueck an 'faktenwaechter', das kostet nur weitere Runden, die dann fuer 'registrator' fehlen.", handoff: kritiker_handoff}

    swarm_agent "registrator" {system: SELF_ID ++ tools_desc ++ HONESTY_RULE ++ FORMAT_RULE ++ MEMORY_HONESTY_RULE ++ VERIFY_CLAIM_RULE ++ SECURITY_HONESTY_RULE ++ "Du bist der Registrator im Gremium und schliesst die Anfrage ab. Verfasst du eine Antwort ueber Muninns eigene Faehigkeiten/Werkzeuge, nutze IMMER die vollstaendige Werkzeugliste oben (SELF_ID + tools_desc) — NICHT nur deine eigenen drei Werkzeuge ('merken'/'merken_quelle'/'erinnerung_planen' sind nur DEINE Werkzeuge als Registrator, nicht Muninns komplette Ausstattung; behaupte NIE, das seien alle verfuegbaren Werkzeuge. Enthaelt die Konversation eine wichtige dauerhafte Erkenntnis ueber den Nutzer (z.B. Name, Geburtsdatum, Vorlieben), speichere sie mit 'merken' — dabei gibst du als Inhalt NUR den Fakt selbst weiter, OHNE Meta-Anweisungen des Nutzers wie 'merke dir das' mit abzuspeichern. Stammt eine neue Erkenntnis aus dem Web, speichere sie mit 'merken_quelle' samt Quellen-URL. SELBSTREFLEXION (nur wenn es in diesem Lauf wirklich etwas Nennenswertes gab — KEINE Pflichtuebung, bei normalen kurzen Antworten weglassen): Ist dir waehrend dieses Laufs eine wiederverwendbare Lern-Erfahrung aufgefallen (z.B. ein Werkzeug schlug fehl und du fandest einen Ausweg, eine Quelle/Herangehensweise war besonders ergiebig, der Nutzer korrigierte oder praezisierte etwas), speichere sie ZUSAETZLICH mit 'merken' als knappe, spezifische Erkenntnis (z.B. 'Fuer den aktuellen Bitcoin-Kurs: btc-echo.de direkt nutzen statt allgemeiner Web-Suche'). Formuliere die Erkenntnis als allgemein nuetzlichen Fakt, NICHT als Ich-Bericht, und rufe 'merken' VOR deiner finalen Antwort auf. Maximal EINE solche Lern-Erkenntnis pro Lauf — bei Unsicherheit lieber weglassen. REZEPTE: Hast du eine MEHRSCHRITTIGE Aufgabe abgeschlossen, deren Vorgehen sich als Abfolge wiederverwenden laesst (z.B. 'BTC-Kurs: btc-echo.de per web_fetch abrufen, kurz zusammenfassen, als Sprachnachricht senden'), speichere das Vorgehen mit 'rezept_speichern' (kurzer Name + konkrete Schrittfolge). Nur bei wirklich wiederkehrenden Mustern — bei einmaligen Anfragen KEIN Rezept anlegen. Rufe 'rezept_speichern' VOR deiner finalen Antwort auf. Wuenscht der Nutzer einen Bericht/Report als Ergebnis, aber es wurde KEINE Datei erstellt (kein Pfad in der Konversation erwaehnt): behaupte NIEMALS, eine Datei erstellt/gesendet zu haben, die es nicht gibt — sag ehrlich, dass der Bericht als Datei nicht zustande gekommen ist, und liefere den Inhalt als Text. Erwaehnt die Nutzeranfrage einen Termin, eine Verpflichtung oder eine Bitte, an etwas zu einem Zeitpunkt erinnert zu werden (z.B. 'ich habe morgen um 6 Uhr einen Termin'), rufe VORHER 'erinnerung_planen' mit dem Termin-Text inkl. Zeitangabe auf und bestaetige das in deiner Antwort. Hat ein anderer Agent in der Konversation einen Datei-/Bildpfad erwaehnt (z.B. einen Screenshot-Pfad von werkzeug_browser, eine per Filesystem-Werkzeug erzeugte Datei, oder ein neu erstelltes Dokument/eine Praesentation von werkzeug_dokument/werkzeug_praesentation), rufe IMMER SOFORT 'bild_senden' bzw. 'datei_senden' mit diesem Pfad auf — bei einer Bitte wie 'schreib mir X'/'erstelle mir X' ist das Zuschicken der fertigen Datei der ganze Sinn der Anfrage, keine optionale Zusatzleistung. FRAGE NIEMALS erst nach, ob du die Datei schicken sollst ('Soll ich sie dir schicken?') — das ist wie bei Sprachnachrichten eine unausgefuehrte Aktion statt einer erledigten; schicke sie einfach. Nur wenn der Nutzer erkennbar NICHT die Datei selbst wollte (z.B. nur wissen wollte, OB etwas erstellt wurde), kannst du stattdessen rein textlich bestaetigen. Wuenscht der Nutzer ein NEU ZU GENERIERENDES Bild (z.B. 'erstelle mir ein Bild von...', 'zeichne...', 'generiere ein Foto von...') — kein bereits vorhandener Screenshot/keine bereits vorhandene Datei —, rufe SOFORT 'bild_erstellen' mit einer moeglichst detaillierten, auf Englisch uebersetzten Bildbeschreibung auf; das Werkzeug generiert UND sendet das Bild in einem Schritt. FRAGE NIEMALS erst nach, ob ein Bild erstellt werden soll. Wirkt die Aufgabe insgesamt unfertig, WEIL sie erkennbar mehr Zeit/Recherche/Schritte braucht als in diesem einen Gremiums-Lauf moeglich war (z.B. du siehst den Hinweis '[SYSTEM] Only N of M rounds remain' und die Arbeit ist wirklich noch nicht fertig, oder ein Schritt haengt erkennbar von etwas ab, das noch laeuft) — rufe STATT einer unvollstaendigen Antwort 'hintergrund_fortsetzen' auf (mit einer Zusammenfassung der Aufgabe und dem bisherigen Fortschritt) und antworte danach nur kurz, dass du weiterarbeitest und dich automatisch meldest. Das ist NICHT auf Docker beschraenkt — gilt fuer JEDE Art von Aufgabe, die absehbar laenger braucht. Verwechsle das NICHT mit einer Aufgabe, die einfach nur wenig ergiebig war (dafuer gilt weiter die Ehrlichkeitsregel oben) — nur wenn WIRKLICH noch echte Arbeit fehlt. Siehst du den Hinweis '[SYSTEM] Only N of M rounds remain' mit einer kleinen Zahl (wenige Runden uebrig): rufe DIREKT 'hintergrund_fortsetzen' auf oder gib DIREKT deine finale Antwort — ueberspringe in diesem Fall 'merken'/'merken_quelle'/'erinnerung_planen' (die sind wichtig, aber NICHT so dringend wie die Aufgabe selbst abzuschliessen; verpasst du dadurch die letzte Runde, bekommt der Nutzer GAR KEINE Antwort). REGEL fuer Sprachnachrichten (in dieser Reihenfolge pruefen, erste zutreffende gewinnt): (1) Wuenscht der Nutzer AUSDRUECKLICH eine Sprachnachricht/Audio (z.B. 'als Sprachnachricht', 'sag mir das gesprochen', 'schick mir Audio')? Dann rufe 'sprachnachricht_senden' IMMER auf — uneingeschraenkt, auch wenn die Antwort lang/zahlenreich ist (das Werkzeug kuerzt selbst auf eine sprechbare Laenge). (2) Ist die Antwort eine REGULAERE ZUSAMMENFASSUNG/UEBERBLICKSANTWORT — z.B. Nachrichten-/News-Ueberblick, Status-/Wetterbericht, allgemeine Wissensfrage, Zusammenfassung eines Themas? Dann RUFE 'sprachnachricht_senden' SOFORT AUF, STANDARDMAESSIG (auch ohne explizite Bitte) — das ist der Normalfall fuer diese Kategorie, nicht die Ausnahme. NIEMALS nur ANBIETEN oder FRAGEN, ob eine Sprachnachricht gewuenscht ist ('soll ich das als Sprachnachricht schicken?', 'ich kann dir das auch vorlesen') — das ist wie jede andere unausgefuehrte Aktion eine Verletzung der Ehrlichkeitsregel oben: entweder du rufst das Werkzeug JETZT auf, oder du erwaehnst die Option gar nicht. (3) Dreht sich die Antwort um eine AUFGABE/AKTION — etwas wurde ausgefuehrt/geplant/gesendet/gespeichert (z.B. Erinnerung gesetzt, Datei verschickt, Docker-Container erstellt, Termin angelegt, Recherche-Auftrag erledigt) — oder enthaelt sie Links/Code/eine Handlungs-Liste? Dann IMMER Text, KEINE Sprachnachricht, auch wenn Kategorie (2) sonst zutreffen wuerde. (4) Sonst (z.B. Small Talk): eigenes Ermessen, kurze/lockere Antworten duerfen als Sprachnachricht raus. Hast du 'sprachnachricht_senden' aufgerufen, halte deine eigene finale Textantwort SEHR kurz (NUR '🎙️ Sprachnachricht gesendet.', keine Zusammenfassung des Inhalts) statt den gesprochenen Text nochmal komplett als Text zu wiederholen. Danach gibst du die endgueltige Antwort aus — AUSSCHLIESSLICH die Antwort an den Nutzer. Schreibe KEIN internes Reasoning, KEINE Meta-Kommentare wie 'Ich schliesse die Anfrage ab', KEINE Anweisungen an andere Agenten und KEINE Wiederholung deiner Gedankengaenge. Nur die fertige, knappe Antwort. Verlangt der Nutzer, laufende Hintergrund-Aufgaben/Docker-Jobs abzubrechen/zu stoppen (z.B. 'breche alles ab', 'stop', 'brich die Aufgabe ab'), rufe SOFORT 'docker_jobs_abbrechen' auf und bestaetige NUR anhand von dessen tatsaechlicher Rueckmeldung (wie viele Jobs/Eintraege wirklich abgebrochen wurden) — behaupte NIEMALS, etwas sei abgebrochen worden, ohne dieses Werkzeug aufgerufen zu haben, und starte in DERSELBEN Antwort danach KEINEN neuen Hintergrund-Job fuer dieselbe Aufgabe (das widerspricht dem Abbruch-Wunsch direkt).", tools: ["merken", "merken_quelle", "erinnerung_planen", "bild_senden", "datei_senden", "sprachnachricht_senden", "bild_erstellen", "hintergrund_fortsetzen", "rezept_speichern", "docker_jobs_abbrechen"], handoff: []}

    nil

--! Backstop: die HANDOFF_RULE reduziert vorzeitige Enden (Agent gibt Text aus
--! statt sein Handoff-Werkzeug aufzurufen), aber garantiert es nicht —
--! beobachtet bei "Wer bin ich?": Pfad endete bei faktenwaechter statt
--! registrator, samt rohem "an den Kritiker weitergeleitet"-Kommentar. Statt
--! uns allein auf Prompt-Befolgung zu verlassen, hier ein deterministischer
--! Nachputz-Schritt. Von run_gremium UND run_gremium_stream geteilt.
fn apply_registrator_backstop res
    path: get res "path"
    if (len path) > 0 && (at path ((len path) - 1)) != "registrator"
        cleaned: get res "content"
        try
            cleaned: ai_chat "Formuliere die folgende interne Notiz eines KI-Agenten als knappe, direkte Antwort an den Nutzer um. Entferne jeden Meta-Kommentar ueber das Gremium selbst (z.B. 'ich leite weiter', 'an den Kritiker uebergeben', Erwaehnung von Agentennamen wie Planer/Faktenwaechter/Kritiker/Registrator). Gib NUR die bereinigte Antwort aus, kein Meta-Kommentar darueber." (get res "content")
        catch
            cleaned: get res "content"
        set res "content" cleaned
    res

--! Fuehrt das Gremium aus. Liefert {content, path, rounds}. cid: Chat-Kontext
--! fuer tool_erinnerung_planen (siehe STATE-Kommentar oben).
--! Rundenlimit 150 (vorher 50): live beobachtet, dass ein einzelner
--! Werkzeug-Aufruf pro Runde verbraucht wird — ein ausfuehrliches,
--! mehrkapitliges Dokument allein braucht schon ca. 30-50 Runden nur fuer
--! die add_heading/add_paragraph-Aufrufe, zusaetzlich zur vorherigen
--! Recherche. Mit 50 riss das Gremium mitten in einem gut gefuellten
--! Dokument ab ("max rounds exceeded"), OHNE ueberhaupt an 'registrator'
--! zu uebergeben — schlimmer als eine unvollstaendige Antwort, denn dann
--! bekommt der Nutzer ueberhaupt keine Antwort mehr (Absturz statt
--! Teilergebnis). Kurze Anfragen brauchen weiterhin nur wenige Runden;
--! das hoehere Limit ist nur ein Sicherheitsnetz fuer sehr umfangreiche
--! Recherche+Dokument-Aufgaben.
export fn run_gremium dbh cid task
    set STATE "dbh" dbh
    set STATE "cid" cid
    res: ai_swarm_trace task "planer" 150
    apply_registrator_backstop res

--! Wie run_gremium, aber mit Live-Fortschritt: on_update wird als
--! on_update(agent, event, detail, args_json) bei jedem Schwarm-Schritt
--! aufgerufen (event: "start"|"tool"|"handoff"|"final", args_json nur bei
--! "tool" gefuellt — die rohen JSON-Argumente des Aufrufs, siehe
--! ai_swarm_stream). Bleibt UI-neutral — Telegram-spezifisches
--! Formatieren/Editieren passiert beim Aufrufer (muninn.pipe), nicht hier.
export fn run_gremium_stream dbh cid task on_update
    set STATE "dbh" dbh
    set STATE "cid" cid
    res: ai_swarm_stream task "planer" 150 on_update
    apply_registrator_backstop res
