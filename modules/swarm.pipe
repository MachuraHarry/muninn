--! swarm.pipe — Muninns inneres Gremium (ai_swarm-Handoffs).
--! Agenten verfeinern eine Antwort: planer -> faktenwaechter -> kritiker -> registrator,
--! optional ueber "werkzeugmeister" mit Zugriff auf per MCP angebundene externe Tools (P1).
--! Hinweis: Map-Literale müssen in Pipe einzeilig sein, daher stehen die Configs einzeilig.
import "modules/memory.pipe" as mem
import "modules/web.pipe" as web
import "modules/mcp.pipe" as mcp
import "modules/scheduler.pipe" as sched
import "modules/docker_tools.pipe" as dt
import "modules/telegram.pipe" as tel

--! Geteilter, mutabler Zustand: aktueller DB-Handle + Chat-Kontext fuer die Tools.
--! tz_offset/token werden einmalig beim Start gesetzt (set_tz_offset/set_token),
--! dbh/cid pro Lauf (run_gremium) — token+cid werden von tool_bild_senden/
--! tool_datei_senden gebraucht, um ueberhaupt an Telegram senden zu koennen.
STATE: {dbh: nil, cid: nil, tz_offset: 0, token: nil}

fn cur_dbh _
    get STATE "dbh"

--! Einmalig beim Start zu setzen (siehe setup_core in muninn.pipe).
export fn set_tz_offset off
    set STATE "tz_offset" off
    nil

--! Einmalig beim Start zu setzen (siehe setup_core in muninn.pipe). Getrennt
--! von set_tz_offset, damit der Telegram-Token — wie alle Secrets — nur an
--! genau einer Stelle im Code angefasst wird.
export fn set_token tok
    set STATE "token" tok
    nil

--! Loest einen von einem Werkzeug (z.B. Playwright-Screenshot) gemeldeten,
--! meist RELATIVEN Pfad zu einem absoluten Pfad auf. Muninn laeuft immer aus
--! /root/muninn heraus (siehe alle Start-Kommandos in muninn.pipe).
fn resolve_muninn_path path
    if (len path) > 0 && (substring path 0 1) == "/"
        path
    else
        "/root/muninn/" ++ path

--! Tool: relevante Erinnerungen aus der Seele abrufen.
fn tool_erinnerungen_suchen query
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    ctx: mem.retrieve_context h query 5
    if (len ctx) == 0
        return "Keine relevanten Erinnerungen gefunden."
    out: ""
    for c in ctx
        out: out ++ "- " ++ c ++ "\n"
    out

--! Tool: eine Erkenntnis dauerhaft merken.
fn tool_merken content kind
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    mem.add_memory h content kind 3 "gremium" "gremium"
    "Gemerkt: " ++ content

--! Tool: im Web suchen (Titel + URL).
fn tool_web_search query
    results: web.web_results query 5
    if (len results) == 0
        return "Keine Treffer im Web."
    out: ""
    i: 0
    while i < (len results)
        r: at results i
        t: get r "title"
        u: get r "url"
        if t != nil && u != nil
            out: out ++ (to_str (i + 1)) ++ ". " ++ t ++ "\n   " ++ u ++ "\n"
        i: i + 1
    out

--! Tool: eine Webseite abrufen (Fließtext, gekürzt).
fn tool_web_fetch url
    text: web.web_fetch url
    if text == ""
        return "Seite nicht abrufbar."
    text

--! Tool: eine Erkenntnis mit Quellen-URL dauerhaft merken.
fn tool_merken_quelle content source
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    mem.add_memory h content "fact" 3 source "web"
    "Gemerkt (Quelle: " ++ source ++ "): " ++ content

--! Tool: eine zeitgesteuerte Erinnerung planen (Ersatz fuer die alte, blinde
--! "task"-Klassifikation — jetzt entscheidet das Gremium selbst, mit vollem
--! Gespraechskontext, ob und wann etwas erinnert werden soll, statt dass ein
--! kontextfreier Klassifikations-Aufruf das vorab und unzuverlaessig festlegt).
--! text: die zu erinnernde Sache in natuerlicher Sprache samt Zeitangabe, z.B.
--! "morgen um 6 Uhr: Termin zur Arbeit" — sched.parse_reminder zerlegt das.
fn tool_erinnerung_planen text
    h: cur_dbh 0
    cid: get STATE "cid"
    if h == nil || cid == nil
        return "Kein Chat-Kontext verfuegbar, kann keine Erinnerung planen."
    tzo: get STATE "tz_offset"
    parsed: sched.parse_reminder text now tzo
    sched.schedule h "reminder" (to_str cid) (get parsed "text") (get parsed "due") (get parsed "repeat")
    "Erinnerung geplant fuer " ++ (format_time ((get parsed "due") + tzo) "2006-01-02 15:04:05") ++ ": " ++ (get parsed "text")

--! Selbstwissen ueber Muninn, das allen Gremium-Agenten vorangestellt wird, damit
--! Meta-Fragen ueber Muninns eigene Faehigkeiten direkt beantwortet werden statt
--! faelschlich "kein Wissen" zu behaupten und eine Web-Recherche auszuloesen.
SELF_ID: "Selbstwissen ueber Muninn (bei Fragen UEBER MUNINN SELBST — Faehigkeiten, Technik, Architektur — DIREKT aus diesem Wissen antworten, NIE 'kein Wissen' behaupten und dafuer KEINE Web-Recherche starten): Muninn ist ein persoenlicher KI-Agent, geschrieben in der Skriptsprache 'pipe' (ein Go-Interpreter). Muninn nutzt DeepSeek als LLM-Provider mit Tool-Use/Function-Calling, kann also im Prinzip auch Code lesen und schreiben. Muninn hat ein persistentes SQLite-Langzeitgedaechtnis (Erinnerungen + Wissensgraph), kann selbststaendig im Web recherchieren (DuckDuckGo + Wikipedia), Aufgaben und Ziele planen sowie ueber einen Executor ausfuehren, zeitgesteuerte Erinnerungen und ein taegliches Briefing setzen, Dokumente lernen, Fotos verstehen/beschreiben (DeepSeek-Vision) und optional per MCP an externe Werkzeuge (z.B. Dateisystem) angebunden werden. Muninn laeuft per Telegram-Bot und Web-Dashboard.\n\n"

--! Harte Handoff-Regel gegen vorzeitige Antworten: ohne diese Regel beendet ein
--! Agent den Swarm manchmal, indem er direkt Text ausgibt statt sein Handoff-
--! Werkzeug aufzurufen (beobachtet bei faktenwaechter auf Meta-Fragen — der Swarm
--! endete dort statt beim registrator, samt ungefiltertem internem Kommentar wie
--! "Ich habe mich im Gremium verheddert..."). Nur der registrator darf enden.
HANDOFF_RULE: "WICHTIG: Du bist NICHT der letzte Agent in der Kette und deine Textantwort geht NIE direkt an den Nutzer. Du MUSST am Ende IMMER dein Handoff-Werkzeug aufrufen, auch wenn du die Antwort schon fertig im Kopf hast — sonst bricht das Gespraech unsauber ab. Nur 'registrator' darf ohne Handoff enden.\n\n"

--! Ohne diese Regel diagnostiziert das Modell einen Parameter-/Validierungs-
--! fehler eines Werkzeugs faelschlich als "kaputte Anbindung" und gibt auf,
--! statt die Fehlermeldung zu lesen und mit korrigierten Parametern erneut
--! zu versuchen. Beobachtet live: docker_exec_command mit command als String
--! statt Array aufgerufen -> Zod-Fehler "Required at command" -> Antwort an
--! den Nutzer war "die Docker-Exec-Anbindung ist fehlerhaft", obwohl der
--! Aufruf mit korrektem Array-Parameter nachweislich funktioniert (Test:
--! "echo hallo-von-drinnen" kam korrekt aus dem Container zurueck).
RETRY_RULE: "Bekommst du von einem Werkzeug einen Fehler zu falschen/fehlenden Parametern (Validierungsfehler, 'Required', 'invalid arguments' o.ae.), ist das FAST IMMER ein Zeichen, dass DU die Parameter falsch uebergeben hast (falscher Typ, falscher Name, falsche Struktur) — NICHT, dass das Werkzeug oder seine Anbindung kaputt ist. Lies die Fehlermeldung genau, korrigiere deinen Aufruf entsprechend und versuche es SOFORT nochmal, bevor du dem Nutzer irgendetwas ueber eine 'fehlerhafte Anbindung' erzaehlst. Erst wenn auch ein korrigierter Versuch scheitert, ist ein echtes technisches Problem plausibel.\n\n"

--! Ohne diese Regel behauptet das Modell, ein Dienst/eine Web-Oberflaeche sei
--! erreichbar, nur weil ein Port gemappt wurde — ohne das je zu pruefen.
--! Beobachtet: ein frisch gestarteter Docker-Container wurde als "OpenCode-
--! Oberflaeche unter http://127.0.0.1:4096 erreichbar" beworben, obwohl die
--! Verbindung nur eine leere Antwort lieferte (kein Webserver im Container)
--! — und selbst nachdem 'docker_container_logs' LEERE Logs zeigte (ein
--! deutliches Warnsignal), wurde die Behauptung wiederholt statt korrigiert.
VERIFY_CLAIM_RULE: "Behaupte NIEMALS, dass ein Dienst/eine Web-Oberflaeche/eine URL erreichbar oder funktionsfaehig ist, nur weil du einen Port gemappt oder einen Container gestartet hast — das beweist nur, dass der Container LAEUFT, nicht, dass darin etwas Sinnvolles auf diesem Port lauscht. Hast du ein Werkzeug zur Verifikation (z.B. 'docker_container_logs', 'web_fetch' auf die URL), nutze es und beziehe dich auf das TATSAECHLICHE Ergebnis. Zeigen Logs nichts oder wirkt ein Dienst inaktiv, sag das ehrlich ('Container laeuft, aber ob/was dort auf Port X reagiert, ist unklar') statt eine Erreichbarkeit zu behaupten, die du nicht geprueft hast.\n\n"

--! Ohne diese Regel antwortet das Modell auf zeitabhaengige Fragen (Uhrzeit,
--! Wetter, aktuelle Ereignisse) faelschlich mit einer generischen "als
--! Sprachmodell habe ich keinen Echtzeitzugriff"-Ausrede, OBWOHL 'web_search'
--! verfuegbar ist — beobachtet bei "Wie viel Uhr ist es aktuell in
--! Deutschland?". question_needs_research (muninn.pipe) faengt das nur als
--! Notnagel ab, wenn die Formulierung zufaellig auf der Trigger-Liste steht.
TOOL_DISCIPLINE_RULE: "Fuer aktuelle/zeitabhaengige Informationen (Uhrzeit, Datum, Wetter, aktuelle Ereignisse, Kurse, Nachrichten) darfst du NIEMALS aus deinem eigenen Sprachmodell-Wissen antworten oder behaupten, du haettest 'keinen Echtzeitzugriff' — du HAST Zugriff via 'web_search'/'web_fetch'. Nutze sie in diesen Faellen IMMER, bevor du antwortest.\n\n"

--! Verwandt mit TOOL_DISCIPLINE_RULE, aber ein anderer Fehlermodus: die KI
--! RUFT web_search auf, bekommt Ergebnisse, die nicht relevant/aktuell genug
--! wirken (z.B. Wikipedia-Artikel statt Tagesnachrichten), und erfindet DANN
--! eine pauschale "meine Websuche ist technisch nicht verfuegbar"-Ausrede
--! statt ehrlich zu sagen, dass die Treffer nicht gut waren, oder es mit
--! einer praeziseren Anfrage/direktem web_fetch auf eine bekannte Quelle
--! (z.B. tagesschau.de) erneut zu versuchen. Beobachtet bei "Was sind die
--! aktuellen Nachrichten in Deutschland?" — web_search/web_fetch funktionierten
--! nachweislich (isoliert reproduziert), die KI behauptete trotzdem "an
--! technische Grenzen gestossen" und "derzeit nicht erreichbar".
RESULT_HONESTY_RULE: "Behaupte NIEMALS pauschal, 'web_search'/'web_fetch' seien 'technisch nicht verfuegbar', 'derzeit nicht erreichbar' oder du seist an 'technische Grenzen gestossen' — das ist so gut wie nie wahr. Liefert ein Aufruf nur schlechte/irrelevante Treffer (z.B. alte Wikipedia-Artikel statt aktueller Nachrichten), ist das ein Qualitaetsproblem der TREFFER, kein Ausfall des Werkzeugs: versuche es mit einer praeziseren Suchanfrage erneut, oder rufe 'web_fetch' direkt auf einer bekannten Quelle auf (z.B. tagesschau.de fuer deutsche Nachrichten). Bleibt das Ergebnis danach immer noch duenn, sag ehrlich 'ich habe nur X gefunden, das war nicht sehr ergiebig' — NIE eine erfundene technische Ausrede.\n\n"

--! Ohne diese Regel erfindet das Modell bei zu vagen Anfragen ("Mach mal
--! irgendwas") entweder eine nicht stattgefundene Aktion ("dann mach ich eben
--! kurz den Mond an") oder bricht mit einem rohen internen Fehler ab (die alte
--! freie JSON-Schrittplanung im Executor tat genau das, ohne jeden Kontext —
--! deshalb ist dieser Pfad jetzt komplett durchs Gremium ersetzt, das echten
--! Kontext und echte Werkzeuge hat).
HONESTY_RULE: "Ist eine Nutzeranfrage zu vage oder unspezifisch, um eine konkrete, sinnvolle Aktion daraus abzuleiten (z.B. 'mach mal irgendwas'), erfinde NIEMALS eine Aktion und behaupte NIEMALS, etwas getan zu haben, das nicht wirklich stattgefunden hat. Frage stattdessen freundlich und konkret nach, was genau gewuenscht ist.\n\n"

--! Telegram rendert nur sein eigenes, sehr einfaches Markdown (einfache
--! Sternchen fuer fett, kein Markdown-Standard) — die tg_markdown-Normalisierung
--! in telegram.pipe wandelt **fett** zwar in *fett* um, aber Ueberschriften/
--! Tabellen/verschachtelte Listen bleiben trotzdem kaputt bzw. wirken in einem
--! Chat overdressed. Diese Regel haelt die Ausgabe von vornherein einfach.
FORMAT_RULE: "Formatiere deine Antwort fuer einen Telegram-Chat, nicht fuer ein Dokument: keine Markdown-Ueberschriften (#), keine Tabellen, keine verschachtelten Listen. Fettung sparsam mit *einfachen* Sternchen. Kurze Absaetze statt langer Bloecke.\n\n"

--! Ohne diese Regel behauptet das Modell bei Fragen zu Muninns eigenen
--! Werkzeugen faelschlich Dinge wie "ich habe keinen Zugriff auf Werkzeuge" —
--! per Websuche auf generischen Hilfeseiten "recherchiert", die logischerweise
--! nicht wissen koennen, was DIESER konkrete Bot verbunden hat (beobachtet bei
--! "kannst du mit deinen Werkzeugen ein Google Workspace einrichten?", obwohl
--! filesystem+memory MCP-Server verbunden waren). tools_desc wird in
--! init_gremium dynamisch aus der ECHTEN, aktuell verbundenen Werkzeugliste
--! gebaut, nicht als statischer Text.
--!
--! Ergaenzend: Ergebnisse von 'erinnerungen_suchen' duerfen nicht unbesehen als
--! Aussagen des Nutzers gelten — mem.retrieve_context markiert alles ausser
--! "permanent"/"document" (also KI-Recherche-Ergebnisse, Task-Protokolle) mit
--! einem Praefix. Beobachtet: eine alte AfD-Recherche wurde bei "Wofuer
--! interessiere ich mich?" als "klares Signal fuer politisches Interesse"
--! fehlinterpretiert, obwohl sie nur eine fruehere Recherche zu einer ANDEREN
--! Frage war, keine Aussage ueber den Nutzer.
MEMORY_HONESTY_RULE: "Ergebnisse von 'erinnerungen_suchen', die mit '[fruehere Recherche/Protokoll, KEINE Aussage des Nutzers]' markiert sind, sind KI-generierte Recherche-Ergebnisse oder Protokolle — KEINE Aussagen des Nutzers ueber sich selbst. Aus solchen Eintraegen darfst du NIEMALS auf Interessen, Meinungen oder Praeferenzen des Nutzers schliessen. Nur unmarkierte Eintraege sind tatsaechliche Aussagen des Nutzers. Findest du zu einer Frage nach Interessen/Vorlieben nur markierte oder gar keine Eintraege, sag ehrlich, dass dazu noch nichts Eindeutiges von ihm gespeichert ist, statt aus Recherche-Nebenprodukten eine Praeferenz zu konstruieren.\n\n"

--! Selbstwissen + echte, aktuelle Werkzeugliste als EIN Kontext-Block — fuer
--! Code AUSSERHALB des Gremiums, der trotzdem "als Muninn" antworten muss
--! (der Web-Recherche-Fallback in muninn.pipe: wenn das Gremium eine Frage
--! nicht beantworten kann, wird zusaetzlich recherchiert und ein eigener,
--! schlanker ai_chat-Aufruf formuliert die Antwort). Ohne dieses Wissen
--! behauptet ein bare ai_chat-Aufruf mit nur "Du bist Muninn, ein
--! persoenlicher KI-Assistent" als Prompt schnell faelschlich, gar keine
--! Werkzeuge/Systemzugriff zu haben — beobachtet live: "Ich kann keine
--! Docker-Container erstellen, ich bin ein textbasierter Recherche-
--! Assistent", obwohl werkzeug_docker das nachweislich kann (siehe
--! docker_tools.pipe, live mit einem echten nginx-Container getestet).
--! Absichtlich eine schlanke Teilmenge der init_gremium-Logik (nur die
--! Beschreibung, keine Agenten-Registrierung) statt diese zu duplizieren.
export fn self_context _
    local_names: ["erinnerungen_suchen", "merken", "web_search", "web_fetch", "merken_quelle", "erinnerung_planen", "docker_pull_image", "docker_create_container"]
    mcp_groups: mcp.discovered_tools_by_source local_names
    mcp_names: []
    for grp in mcp_groups
        for tn in (get grp "tools")
            push mcp_names tn
    desc: "ECHTE, aktuell verfuegbare Werkzeuge: 'erinnerungen_suchen' (Gedaechtnis durchsuchen), 'merken'/'merken_quelle' (dauerhaft speichern), 'web_search'/'web_fetch' (im Internet recherchieren), 'erinnerung_planen' (Termin/Erinnerung planen)"
    if (len mcp_groups) > 0
        desc: desc ++ ", sowie per MCP extern angebunden: " ++ (join mcp_names ", ") ++ ". Bei Docker gehoeren zusaetzlich 'docker_pull_image'/'docker_create_container' dazu (Image ziehen, Container starten — OHNE Volume-Mounts/--privileged, das ist Absicht, keine fehlende Faehigkeit)."
    else
        desc: desc ++ ". Kein externer MCP-Server angebunden."
    desc: desc ++ " Behaupte NIE pauschal, keine Werkzeuge/keinen Systemzugriff zu haben, wenn diese Liste nicht leer ist.\n\n"
    SELF_ID ++ desc

--! Tool: ein Bild (z.B. ein Screenshot, den ein anderes Werkzeug lokal
--! gespeichert hat) an den Nutzer in Telegram senden. Nutzt sendPhoto (zeigt
--! inline im Chat an, Telegram komprimiert/konvertiert).
fn tool_bild_senden path caption
    tok: get STATE "token"
    cid: get STATE "cid"
    if tok == nil || cid == nil
        return "Kein Telegram-Kontext verfuegbar, kann kein Bild senden."
    full_path: resolve_muninn_path path
    if !(file_exists full_path)
        return "Datei nicht gefunden: " ++ full_path
    res: tel.tel_send_photo tok cid full_path caption
    if (get res "ok") == false
        return "Senden fehlgeschlagen: " ++ (to_str (get res))
    "Bild gesendet: " ++ full_path

--! Tool: eine beliebige Datei (z.B. ein per Filesystem-Werkzeug erzeugtes
--! Dokument) an den Nutzer in Telegram senden. Nutzt sendDocument (behaelt
--! Originalformat/-qualitaet, wird als Datei-Anhang statt inline gezeigt).
fn tool_datei_senden path caption
    tok: get STATE "token"
    cid: get STATE "cid"
    if tok == nil || cid == nil
        return "Kein Telegram-Kontext verfuegbar, kann keine Datei senden."
    full_path: resolve_muninn_path path
    if !(file_exists full_path)
        return "Datei nicht gefunden: " ++ full_path
    res: tel.tel_send_document tok cid full_path caption
    if (get res "ok") == false
        return "Senden fehlgeschlagen: " ++ (to_str (get res))
    "Datei gesendet: " ++ full_path

--! Maximale Zeichenzahl fuer eine Sprachnachricht — Vorlesen ist fuer kurze,
--! lockere Antworten gedacht, nicht fuer lange/inhaltsreiche Texte (siehe
--! FORMAT_RULE-Ergaenzung unten).
TTS_MAX_CHARS: 600

--! Fuehrt die feste Piper->ffmpeg-Pipeline (tts_synth.sh) aus. Kein Parameter
--! davon ist AI-kontrollierbar ausser dem Text selbst (Stimme/Encoding sind
--! im Skript fest verdrahtet) — analog zum docker_tools.pipe-Muster mit
--! festem Kommando-Template statt frei waehlbarer Flags.
fn tts_synthesize text
    dir: "/root/muninn/tts_tmp"
    id: (to_str now) ++ "_" ++ (to_str (random_range 100000 999999))
    txt_path: dir ++ "/" ++ id ++ ".txt"
    ogg_path: dir ++ "/" ++ id ++ ".ogg"
    write_file txt_path text
    r: exec ("/root/muninn/tts_synth.sh " ++ txt_path ++ " " ++ ogg_path)
    file_delete txt_path
    if (get r "status") != 0
        return {ok: false, ogg_path: nil, error: (get r "output")}
    if !(file_exists ogg_path)
        return {ok: false, ogg_path: nil, error: "Keine Ausgabedatei erzeugt."}
    {ok: true, ogg_path: ogg_path, error: nil}

--! Tool: Text als echte Sprachnachricht (statt Textnachricht) an den Nutzer
--! senden — lokale Piper-Synthese, kein Cloud-Dienst/API-Key noetig.
fn tool_sprachnachricht_senden text
    tok: get STATE "token"
    cid: get STATE "cid"
    if tok == nil || cid == nil
        return "Kein Telegram-Kontext verfuegbar, kann keine Sprachnachricht senden."
    if text == nil || (trim text) == ""
        return "Kein Text zum Vorlesen angegeben."
    spoken: text
    if (len spoken) > TTS_MAX_CHARS
        spoken: (substring spoken 0 TTS_MAX_CHARS) ++ "…"
    synth: tts_synthesize spoken
    if !(get synth "ok")
        return "Sprachsynthese fehlgeschlagen: " ++ (to_str (get synth "error"))
    ogg: get synth "ogg_path"
    res: tel.tel_send_voice tok cid ogg nil
    file_delete ogg
    if (get res "ok") == false
        return "Senden der Sprachnachricht fehlgeschlagen: " ++ (to_str res)
    "Sprachnachricht gesendet."

--! Registriert Tools und Gremium-Agenten (einmalig beim Start).
--! Bindet zusaetzlich alle bereits per mcp.connect_servers verbundenen MCP-Tools
--! (Dateisystem, GitHub, ...) an einen eigenen "werkzeugmeister"-Agenten (P1).
export fn init_gremium _
    ai_tool "erinnerungen_suchen" "Relevante Erinnerungen aus Muninns Langzeitgedaechtnis abrufen, um Fakten zu belegen." {query: "Suchanfrage"} tool_erinnerungen_suchen
    ai_tool "merken" "Eine wichtige dauerhafte Erkenntnis ueber den Nutzer speichern." {content: "Inhalt", kind: "Kategorie"} tool_merken
    ai_tool "web_search" "Im Internet suchen; liefert Titel und URLs der Top-Treffer." {query: "Suchbegriffe"} tool_web_search
    ai_tool "web_fetch" "Eine Webseite abrufen und deren Fließtext liefern." {url: "Vollständige URL"} tool_web_fetch
    ai_tool "merken_quelle" "Eine aus dem Web gewonnene Erkenntnis dauerhaft mit Quellen-URL speichern." {content: "Erkenntnis", source: "Quellen-URL"} tool_merken_quelle
    ai_tool "erinnerung_planen" "Eine zeitgesteuerte Erinnerung fuer den Nutzer planen (z.B. bei Terminen/Verpflichtungen mit Zeitangabe)." {text: "Was erinnert werden soll, inkl. Zeitangabe in natuerlicher Sprache"} tool_erinnerung_planen
    --! Bewusst eingeschraenkte Docker-Erweiterung (Image ziehen, Container
    --! anlegen) — siehe docker_tools.pipe fuer die Sicherheitsbegruendung.
    --! Ergaenzt den MCP-Server "docker" (verwaltet nur BESTEHENDE Container).
    ai_tool "docker_pull_image" "Ein Docker-Image von einer Registry herunterladen (z.B. 'nginx:latest')." {image: "Image-Name inkl. optionalem Tag"} dt.tool_docker_pull_image
    ai_tool "docker_create_container" "Einen neuen Container aus einem Image starten. KEINE Volume-Mounts moeglich, KEIN --privileged. Standardmaessig nur auf localhost erreichbar (public='true' fuer oeffentlich, nur wenn explizit gewuenscht)." {image: "Image-Name (ggf. vorher mit docker_pull_image geholt)", name: "Container-Name", host_port: "Port auf dem Host", container_port: "Port im Container", public: "'true' fuer oeffentlich erreichbar, sonst nur localhost"} dt.tool_docker_create_container
    --! Bilder/Dateien an den Nutzer senden (z.B. ein Screenshot, den
    --! werkzeug_browser lokal gespeichert hat, oder eine per Filesystem-
    --! Werkzeug erzeugte Datei) — ohne das kann Muninn nur ÜBER Dateien
    --! reden, sie aber nicht tatsaechlich verschicken.
    ai_tool "bild_senden" "Ein Bild (Screenshot o.ae.) aus einer lokalen Datei an den Nutzer in Telegram senden (zeigt inline im Chat)." {path: "Pfad zur Bilddatei (relativ zu /root/muninn oder absolut)", caption: "Optionale Bildunterschrift"} tool_bild_senden
    ai_tool "datei_senden" "Eine beliebige lokale Datei an den Nutzer in Telegram senden (als Datei-Anhang, Originalformat)." {path: "Pfad zur Datei (relativ zu /root/muninn oder absolut)", caption: "Optionale Beschreibung"} tool_datei_senden
    ai_tool "sprachnachricht_senden" "Text als gesprochene Sprachnachricht (statt Textnachricht) an den Nutzer senden — lokale Sprachsynthese, kein Cloud-Dienst." {text: "Der zu sprechende Text (kurz halten, max. ca. 600 Zeichen — keine Links/Listen/Code, die klingen als Sprache nicht sinnvoll)"} tool_sprachnachricht_senden

    local_names: ["erinnerungen_suchen", "merken", "web_search", "web_fetch", "merken_quelle", "erinnerung_planen", "docker_pull_image", "docker_create_container", "bild_senden", "datei_senden"]
    --! P5: EIN fokussierter Spezial-Agent PRO angebundenem MCP-Server statt
    --! eines Alleskoenners mit allen Werkzeugen — skaliert automatisch mit
    --! jedem neuen MCP-Server (kein Code-Umbau noetig), und haelt die
    --! Tool-Auswahl der KI pro Agent klein und treffsicher, statt sie bei
    --! sehr vielen Werkzeugen mit einer riesigen flachen Liste zu ueberfordern.
    mcp_groups: mcp.discovered_tools_by_source local_names
    has_mcp: (len mcp_groups) > 0
    mcp_names: []
    specialist_names: []
    specialist_desc: ""
    for grp in mcp_groups
        alias: get grp "alias"
        if (len alias) > 0 && (substring alias ((len alias) - 1) (len alias)) == "_"
            alias: substring alias 0 ((len alias) - 1)
        gtools: get grp "tools"
        for tn in gtools
            push mcp_names tn
        extra_note: ""
        if alias == "docker"
            --! Nur der Docker-Spezialist bekommt zusaetzlich die lokalen,
            --! eingeschraenkten Image-Pull/Container-Erstellen-Werkzeuge (siehe
            --! docker_tools.pipe) — die MCP-Werkzeuge aus '" ++ alias ++ "'
            --! koennen das nicht, nur bestehende Container verwalten.
            push gtools "docker_pull_image"
            push gtools "docker_create_container"
            extra_note: " Zusaetzlich hast du 'docker_pull_image' und 'docker_create_container' fuer neue Container/Images — dabei gibt es KEINE Volume-Mounts und KEIN --privileged, das ist Absicht (Sicherheit), nicht ein fehlendes Feature; biete das dem Nutzer nicht als moeglich an. Neue Container sind standardmaessig nur auf localhost erreichbar, ausser der Nutzer will es ausdruecklich oeffentlich (dann public='true')."
        if alias == "google"
            extra_note: " Das Google-Konto des Nutzers ist harrymachura6@gmail.com — gib dieses 'user_google_email' bei JEDEM Gmail/Drive/Kalender-Werkzeugaufruf mit, es wird nie automatisch ergaenzt. Meldet ein Werkzeug, es fehle die Anmeldung/Autorisierung, rufe SOFORT 'start_google_auth' auf (service_name z.B. 'gmail') und gib die zurueckgegebene Google-Freigabe-URL WOERTLICH an den Nutzer weiter, damit er sie im Browser oeffnen kann — behaupte NIE, das Verbinden des Google-Kontos ginge nicht. Der Nutzer hat vollen Gmail-Versand sowie vollen Lese-/Schreibzugriff auf Drive und Kalender bewusst freigegeben."
        if alias == "praesentation"
            --! Ohne diese Anleitung verliert sich die KI im grossen
            --! Vorlagen-/Template-Werkzeugsatz (create_presentation_from_templates,
            --! populate_placeholder, manage_text, ...) und erreicht
            --! save_presentation oft gar nicht mehr, bevor die Rundenzahl
            --! aufgebraucht ist (live beobachtet: 18 Runden, viele
            --! Tool-Experimente, nie gespeichert). Der simple 3-Schritt-Pfad
            --! (create -> add_slide pro Folie -> save) ist isoliert getestet
            --! zuverlaessig und schnell.
            extra_note: " Nutze IMMER den einfachen Weg: 'ppt_create_presentation' EINMAL aufrufen (liefert eine presentation_id), dann pro gewuenschter Folie 'ppt_add_slide' mit presentation_id+title+content, zum Schluss GENAU EINMAL 'ppt_save_presentation' mit presentation_id und file_path (IMMER unter '/root/muninn/mcp_data/<sprechender-name>.pptx'). Nutze NICHT das Vorlagen-/Template-System (create_presentation_from_templates, populate_placeholder, manage_text) — das braucht viel mehr Schritte und fuehrt oft dazu, dass die Praesentation nie gespeichert wird. Danach uebergib an 'kritiker' — der Registrator schickt die fertige Datei per 'datei_senden'; du selbst hast dieses Werkzeug nicht."
        if alias == "dokument"
            extra_note: " Nutze 'word_create_document' EINMAL mit filename (IMMER unter '/root/muninn/mcp_data/<sprechender-name>.docx') — das legt die Datei direkt an, KEIN separater Speicher-Schritt noetig. Danach 'word_add_heading'/'word_add_paragraph' etc. mit demselben filename pro Abschnitt — jeder Aufruf schreibt sofort in die Datei. 'word_convert_to_pdf' NUR wenn der Nutzer ausdruecklich ein PDF wollte (nicht von dir aus versuchen — auf diesem Server ist dafuer kein LibreOffice/Word installiert, der Versuch schlaegt IMMER fehl und bringt nur eine unnoetige Fehlermeldung). Danach uebergib an 'kritiker' — der Registrator schickt die fertige Datei per 'datei_senden'; du selbst hast dieses Werkzeug nicht."
        agent_name: "werkzeug_" ++ alias
        push specialist_names agent_name
        specialist_desc: specialist_desc ++ "- '" ++ agent_name ++ "': Werkzeuge aus '" ++ alias ++ "' (" ++ (join gtools ", ") ++ ")\n"
        swarm_agent agent_name {system: SELF_ID ++ HANDOFF_RULE ++ RETRY_RULE ++ VERIFY_CLAIM_RULE ++ RESULT_HONESTY_RULE ++ "Du bist der Spezial-Agent fuer '" ++ alias ++ "' im Gremium von Muninn. Du hast NUR Zugriff auf die per MCP aus '" ++ alias ++ "' angebundenen Werkzeuge." ++ extra_note ++ " WICHTIG: Nutze das Selbstwissen oben aktiv, bevor du eine Anfrage bearbeitest — geht es z.B. um 'Pipe', ist damit hoechstwahrscheinlich Muninns EIGENE Skriptsprache gemeint (siehe Selbstwissen), NICHT Unix-Pipes/das Shell-Symbol '|', auch wenn Letzteres dein allgemeines Sprachmodell-Vorwissen naheliegender erscheinen laesst. Ist bei einem Begriff aus der Nutzeranfrage unklar, ob Muninn selbst oder etwas Allgemeines gemeint ist, bevorzuge den Bezug zu Muninn selbst oder frage im Zweifel kurz nach — erfinde NIE einfach die allgemeinere, thematisch nahliegendere Bedeutung. Brauchst du fuer die Anfrage mehrere dieser Werkzeuge nacheinander (z.B. erst einen Ort/eine ID nachschlagen, dann damit die eigentlichen Daten abrufen), rufe sie ALLE in dieser einen Runde nacheinander auf, BEVOR du 'kritiker' aufrufst — nicht nach jedem einzelnen Werkzeug zurueckspringen, das verbraucht unnoetig Runden. Rufe erst danach IMMER 'kritiker' auf, um dein Ergebnis weiterzugeben.", tools: gtools, handoff: ["kritiker", "planer"]}

    --! Dynamisch aus dem ECHTEN Zustand gebaut (nicht statischer Text wie
    --! SELF_ID) — siehe Kommentar bei MEMORY_HONESTY_RULE oben.
    tools_desc: "ECHTE, aktuell verfuegbare Werkzeuge (fuer Fragen ueber deine eigenen Faehigkeiten/Werkzeuge IMMER diese Liste nutzen — NIE 'web_search', das Internet weiss nicht, welche Werkzeuge DU verbunden hast): 'erinnerungen_suchen' (Muninns Gedaechtnis durchsuchen), 'merken'/'merken_quelle' (dauerhaft speichern), 'web_search'/'web_fetch' (im Internet recherchieren), 'erinnerung_planen' (Termin/Erinnerung planen)"
    if has_mcp
        tools_desc: tools_desc ++ ", sowie per MCP extern angebunden: " ++ (join mcp_names ", ") ++ ". Verfuegbare Werkzeug-Spezialisten im Gremium:\n" ++ specialist_desc
    else
        tools_desc: tools_desc ++ ". Aktuell ist KEIN externer MCP-Server angebunden — Aktionen in Drittsystemen (Cloud-Dienste, Google Workspace, GitHub etc.) sind daher NICHT moeglich, bis ein passender MCP-Server konfiguriert wird."
    tools_desc: tools_desc ++ " Fehlt ein gefragtes Werkzeug in dieser Liste, sag ehrlich, dass es aktuell nicht angebunden ist — behaupte NIE pauschal 'ich habe keinen Zugriff auf Werkzeuge', wenn diese Liste nicht leer ist.\n\n"

    planer_handoff: ["faktenwaechter", "kritiker"]
    kritiker_handoff: ["faktenwaechter", "registrator"]
    for sn in specialist_names
        push planer_handoff sn
        push kritiker_handoff sn

    swarm_agent "planer" {system: SELF_ID ++ tools_desc ++ HANDOFF_RULE ++ HONESTY_RULE ++ "Du bist der Planer im inneren Gremium von Muninn, einem persoenlichen KI-Agenten mit Langzeitgedaechtnis. Analysiere die Nutzeranfrage. Ist es eine Meta-Frage ueber Muninn selbst ODER seine Werkzeuge/Faehigkeiten, leite trotzdem an 'faktenwaechter' weiter (der beantwortet sie direkt aus dem Selbstwissen/der Werkzeugliste oben). Bei sonstigen Fakten- oder Gedaechtnisfragen leite ebenfalls an 'faktenwaechter' weiter. Erfordert die Anfrage ein konkretes externes Werkzeug, leite an den PASSENDEN Werkzeug-Spezialisten aus der Liste oben weiter (nicht an einen falschen — waehle anhand der dort aufgefuehrten Werkzeugnamen). Sonst leite an 'kritiker' weiter. Gib selbst NIE die Endantwort und NIE internes Reasoning aus.", handoff: planer_handoff}

    swarm_agent "faktenwaechter" {system: SELF_ID ++ tools_desc ++ HANDOFF_RULE ++ TOOL_DISCIPLINE_RULE ++ RESULT_HONESTY_RULE ++ MEMORY_HONESTY_RULE ++ "Du bist der Faktenwaechter im Gremium. Ist die Frage eine Meta-Frage ueber Muninn selbst ODER seine Werkzeuge/Faehigkeiten (z.B. 'kannst du mit deinen Werkzeugen X tun'), beantworte sie DIREKT aus dem Selbstwissen/der Werkzeugliste oben, OHNE 'web_search' aufzurufen — das Internet weiss nichts ueber DEINE Werkzeugverbindungen. Auch dann rufst du danach dein Handoff-Werkzeug 'kritiker' auf, du gibst NIE selbst die finale Antwort aus. Bei allen anderen Fragen stuetze jede Aussage auf Muninns Gedaechtnis UND das Internet: rufe 'erinnerungen_suchen' auf, um relevante Erinnerungen zu finden; wenn das Gedaechtnis nichts hergibt, nutze 'web_search' und 'web_fetch', um die Antwort im Internet zu recherchieren. Rufe danach IMMER 'kritiker' auf, um deine fundierte Antwort weiterzugeben.", tools: ["erinnerungen_suchen", "web_search", "web_fetch"], handoff: ["kritiker", "planer"]}

    swarm_agent "kritiker" {system: HANDOFF_RULE ++ MEMORY_HONESTY_RULE ++ "Du bist der Kritiker im Gremium. Pruefe die bisherige Antwort auf Luecken, Widersprueche und Unklarheiten und verbessere sie zu einer praezisen, ehrlichen Antwort. Wenn Fakten fehlen, leite an 'faktenwaechter' zurueck. Sonst rufe IMMER 'registrator' auf, um die verbesserte Antwort weiterzugeben — auch wenn die Antwort schon gut ist oder eine Aufgabe (Dokument/Praesentation/...) nur teilweise erledigt wurde: der Registrator schickt trotzdem das bisherige Ergebnis, ANSTATT dass du hier weiter zwischen Agenten hin- und herspringst.", handoff: kritiker_handoff}

    swarm_agent "registrator" {system: SELF_ID ++ tools_desc ++ HONESTY_RULE ++ FORMAT_RULE ++ MEMORY_HONESTY_RULE ++ VERIFY_CLAIM_RULE ++ "Du bist der Registrator im Gremium und schliesst die Anfrage ab. Verfasst du eine Antwort ueber Muninns eigene Faehigkeiten/Werkzeuge, nutze IMMER die vollstaendige Werkzeugliste oben (SELF_ID + tools_desc) — NICHT nur deine eigenen drei Werkzeuge ('merken'/'merken_quelle'/'erinnerung_planen' sind nur DEINE Werkzeuge als Registrator, nicht Muninns komplette Ausstattung; behaupte NIE, das seien alle verfuegbaren Werkzeuge. Enthaelt die Konversation eine wichtige dauerhafte Erkenntnis ueber den Nutzer (z.B. Name, Geburtsdatum, Vorlieben), speichere sie mit 'merken' — dabei gibst du als Inhalt NUR den Fakt selbst weiter, OHNE Meta-Anweisungen des Nutzers wie 'merke dir das' mit abzuspeichern. Stammt eine neue Erkenntnis aus dem Web, speichere sie mit 'merken_quelle' samt Quellen-URL. Erwaehnt die Nutzeranfrage einen Termin, eine Verpflichtung oder eine Bitte, an etwas zu einem Zeitpunkt erinnert zu werden (z.B. 'ich habe morgen um 6 Uhr einen Termin'), rufe VORHER 'erinnerung_planen' mit dem Termin-Text inkl. Zeitangabe auf und bestaetige das in deiner Antwort. Hat ein anderer Agent in der Konversation einen Datei-/Bildpfad erwaehnt (z.B. einen Screenshot-Pfad von werkzeug_browser, eine per Filesystem-Werkzeug erzeugte Datei, oder ein neu erstelltes Dokument/eine Praesentation von werkzeug_dokument/werkzeug_praesentation), rufe IMMER SOFORT 'bild_senden' bzw. 'datei_senden' mit diesem Pfad auf — bei einer Bitte wie 'schreib mir X'/'erstelle mir X' ist das Zuschicken der fertigen Datei der ganze Sinn der Anfrage, keine optionale Zusatzleistung. FRAGE NIEMALS erst nach, ob du die Datei schicken sollst ('Soll ich sie dir schicken?') — das ist wie bei Sprachnachrichten eine unausgefuehrte Aktion statt einer erledigten; schicke sie einfach. Nur wenn der Nutzer erkennbar NICHT die Datei selbst wollte (z.B. nur wissen wollte, OB etwas erstellt wurde), kannst du stattdessen rein textlich bestaetigen. REGEL fuer Sprachnachrichten (in dieser Reihenfolge pruefen, erste zutreffende gewinnt): (1) Wuenscht der Nutzer AUSDRUECKLICH eine Sprachnachricht/Audio (z.B. 'als Sprachnachricht', 'sag mir das gesprochen', 'schick mir Audio')? Dann rufe 'sprachnachricht_senden' IMMER auf — uneingeschraenkt, auch wenn die Antwort lang/zahlenreich ist (das Werkzeug kuerzt selbst auf eine sprechbare Laenge). (2) Ist die Antwort eine REGULAERE ZUSAMMENFASSUNG/UEBERBLICKSANTWORT — z.B. Nachrichten-/News-Ueberblick, Status-/Wetterbericht, allgemeine Wissensfrage, Zusammenfassung eines Themas? Dann RUFE 'sprachnachricht_senden' SOFORT AUF, STANDARDMAESSIG (auch ohne explizite Bitte) — das ist der Normalfall fuer diese Kategorie, nicht die Ausnahme. NIEMALS nur ANBIETEN oder FRAGEN, ob eine Sprachnachricht gewuenscht ist ('soll ich das als Sprachnachricht schicken?', 'ich kann dir das auch vorlesen') — das ist wie jede andere unausgefuehrte Aktion eine Verletzung der Ehrlichkeitsregel oben: entweder du rufst das Werkzeug JETZT auf, oder du erwaehnst die Option gar nicht. (3) Dreht sich die Antwort um eine AUFGABE/AKTION — etwas wurde ausgefuehrt/geplant/gesendet/gespeichert (z.B. Erinnerung gesetzt, Datei verschickt, Docker-Container erstellt, Termin angelegt, Recherche-Auftrag erledigt) — oder enthaelt sie Links/Code/eine Handlungs-Liste? Dann IMMER Text, KEINE Sprachnachricht, auch wenn Kategorie (2) sonst zutreffen wuerde. (4) Sonst (z.B. Small Talk): eigenes Ermessen, kurze/lockere Antworten duerfen als Sprachnachricht raus. Hast du 'sprachnachricht_senden' aufgerufen, halte deine eigene finale Textantwort SEHR kurz (NUR '🎙️ Sprachnachricht gesendet.', keine Zusammenfassung des Inhalts) statt den gesprochenen Text nochmal komplett als Text zu wiederholen. Danach gibst du die endgueltige Antwort aus — AUSSCHLIESSLICH die Antwort an den Nutzer. Schreibe KEIN internes Reasoning, KEINE Meta-Kommentare wie 'Ich schliesse die Anfrage ab', KEINE Anweisungen an andere Agenten und KEINE Wiederholung deiner Gedankengaenge. Nur die fertige, knappe Antwort.", tools: ["merken", "merken_quelle", "erinnerung_planen", "bild_senden", "datei_senden", "sprachnachricht_senden"], handoff: []}

    nil

--! Backstop: die HANDOFF_RULE reduziert vorzeitige Enden (Agent gibt Text aus
--! statt sein Handoff-Werkzeug aufzurufen), aber garantiert es nicht —
--! beobachtet bei "Wer bin ich?": Pfad endete bei faktenwaechter statt
--! registrator, samt rohem "an den Kritiker weitergeleitet"-Kommentar. Statt
--! uns allein auf Prompt-Befolgung zu verlassen, hier ein deterministischer
--! Nachputz-Schritt. Von run_gremium UND run_gremium_stream geteilt.
fn apply_registrator_backstop res
    path: get res "path"
    if (len path) > 0 && (at path ((len path) - 1)) != "registrator"
        cleaned: get res "content"
        try
            cleaned: ai_chat "Formuliere die folgende interne Notiz eines KI-Agenten als knappe, direkte Antwort an den Nutzer um. Entferne jeden Meta-Kommentar ueber das Gremium selbst (z.B. 'ich leite weiter', 'an den Kritiker uebergeben', Erwaehnung von Agentennamen wie Planer/Faktenwaechter/Kritiker/Registrator). Gib NUR die bereinigte Antwort aus, kein Meta-Kommentar darueber." (get res "content")
        catch
            cleaned: get res "content"
        set res "content" cleaned
    res

--! Fuehrt das Gremium aus. Liefert {content, path, rounds}. cid: Chat-Kontext
--! fuer tool_erinnerung_planen (siehe STATE-Kommentar oben).
export fn run_gremium dbh cid task
    set STATE "dbh" dbh
    set STATE "cid" cid
    res: ai_swarm_trace task "planer" 50
    apply_registrator_backstop res

--! Wie run_gremium, aber mit Live-Fortschritt: on_update wird als
--! on_update(agent, event, detail, args_json) bei jedem Schwarm-Schritt
--! aufgerufen (event: "start"|"tool"|"handoff"|"final", args_json nur bei
--! "tool" gefuellt — die rohen JSON-Argumente des Aufrufs, siehe
--! ai_swarm_stream). Bleibt UI-neutral — Telegram-spezifisches
--! Formatieren/Editieren passiert beim Aufrufer (muninn.pipe), nicht hier.
export fn run_gremium_stream dbh cid task on_update
    set STATE "dbh" dbh
    set STATE "cid" cid
    res: ai_swarm_stream task "planer" 50 on_update
    apply_registrator_backstop res
