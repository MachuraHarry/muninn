--! swarm.pipe — Muninn's inner gremium (ai_swarm handoffs).
--! Agents refine an answer: planer -> faktenwaechter -> kritiker -> registrator,
--! optionally via "werkzeugmeister" with access to externally connected MCP tools (P1).
--! Note: map literals must be single-line in Pipe, so the configs are single-line.
import "modules/memory.pipe" as mem
import "modules/web.pipe" as web
import "modules/mcp.pipe" as mcp
import "modules/scheduler.pipe" as sched
import "modules/docker_tools.pipe" as dt
import "modules/telegram.pipe" as tel

--! Shared, mutable state: current DB handle + chat context for the tools.
--! tz_offset/token/available_servers are set once at startup
--! (set_tz_offset/set_token/set_available_servers), dbh/cid per run
--! (run_gremium) — token+cid are needed by tool_bild_senden/
--! tool_datei_senden to be able to send to Telegram at all. mcp_activated
--! is reset per run by run_gremium_stream (see tool_werkzeug_aktivieren).
STATE: {dbh: nil, cid: nil, tz_offset: 0, token: nil, google_email: nil, available_servers: [], mcp_activated: []}

--! Per-agent model/timeout routing (deepseek-v4-pro for research/Slideshot)
--! was tried and reverted — the pro model's latency, combined with
--! round_check only ever being able to react BETWEEN gremium rounds (never
--! mid-flight during a single still-running HTTP call) in Muninn's
--! single-threaded main loop, made individual turns take long enough that
--! the whole bot looked unresponsive for minutes at a time. Every agent
--! uses the single model/timeout set once at boot (setup_ai, muninn.pipe).

fn cur_dbh _
    get STATE "dbh"

--! Set once at startup (see setup_core in muninn.pipe).
export fn set_tz_offset off
    set STATE "tz_offset" off
    nil

--! Set once at startup (see setup_core in muninn.pipe): the FULL configured
--! server list (regardless of connection state), so init_gremium can tell
--! agents which specialists exist but aren't active yet, and
--! tool_werkzeug_aktivieren can look up a server's config by alias to
--! connect it on demand. See the lazy-MCP-loading plan — setup_core no
--! longer eagerly connects every server at boot.
export fn set_available_servers list
    set STATE "available_servers" list
    nil

--! Set once at startup (see setup_core in muninn.pipe). Kept separate from
--! set_tz_offset, so the Telegram token — like all secrets — is only
--! touched at exactly one place in the code.
export fn set_token tok
    set STATE "token" tok
    nil

--! Set once at startup (see setup_core in muninn.pipe). This removes the
--! literal value that used to be hardcoded here (a release blocker: any
--! third-party installation would have had Harry's own email address in
--! the system prompt instead of its own configured one).
export fn set_google_email email
    set STATE "google_email" email
    nil

--! Resolves a mostly RELATIVE path reported by a tool (e.g. a Playwright
--! screenshot) into an absolute path. Muninn always runs from /root/muninn
--! (see all start commands in muninn.pipe).
--! Trusted root directories a tool-supplied path is allowed to resolve
--! into (see resolve_muninn_path). Besides Muninn's own tree, this
--! includes slideshot-mcp's fixed, non-configurable output directory
--! (confirmed via its own 'health_check' tool: "outDir":
--! "/tmp/slideshot-output") — without it, tool_bild_senden/tool_datei_senden
--! reject every slideshot render as "outside the allowed directory" (live
--! observed: forces a clumsy background-task workaround instead of a
--! plain send). Add further externally-trusted tool output directories
--! here as they come up, one entry per line.
TRUSTED_PATH_ROOTS: ["/root/muninn/", "/tmp/slideshot-output/"]

--! Resolves a tool-supplied path against the trusted roots (TRUSTED_PATH_ROOTS
--! above), rejecting anything that would escape ALL of them (an absolute
--! path elsewhere, or "../" traversal out of one) — without this,
--! tool_bild_senden/tool_datei_senden would happily read+send ANY host
--! file the process can access (e.g. .env) if the AI is ever tricked into
--! supplying such a path (a prompt-injected web page, a compromised MCP
--! tool response). Returns nil on rejection — callers must check for that
--! instead of trusting a non-empty string is always safe to read.
fn resolve_muninn_path path
    if path == nil || path == ""
        return nil
    default_root: at TRUSTED_PATH_ROOTS 0
    full: path
    if !((len path) > 0 && (substring path 0 1) == "/")
        full: default_root ++ path
    --! Normalize ".."/"." segments (no path-normalization builtin in Pipe)
    --! before checking the prefix — a raw substring/prefix check on the
    --! unnormalized string would miss "/root/muninn/../../etc/passwd".
    parts: split full "/"
    out: []
    for seg in parts
        if seg == ".."
            if (len out) > 0
                out: slice out 0 ((len out) - 1)
        else if seg != "." && seg != ""
            push out seg
    normalized: "/" ++ (join out "/")
    for root in TRUSTED_PATH_ROOTS
        if (len normalized) >= (len root) && (substring normalized 0 (len root)) == root
            return normalized
    nil

--! Tool: fetch relevant memories from the soul.
fn tool_erinnerungen_suchen query
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    ctx: mem.retrieve_context h query 5
    if (len ctx) == 0
        return "Keine relevanten Erinnerungen gefunden."
    out: ""
    for c in ctx
        out: out ++ "- " ++ c ++ "\n"
    out

--! Tool: store a reusable workflow recipe (a proven sequence of steps for
--! a recurring task — e.g. 'BTC price: first fetch btc-echo.de via
--! web_fetch, then send as a voice message').
fn tool_rezept_speichern name schritte
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    if name == nil || (trim name) == ""
        return "Rezept-Name fehlt."
    if schritte == nil || (trim schritte) == ""
        return "Rezept-Schritte fehlen."
    n: trim name
    --! tags holds the recipe's own name (not a literal placeholder) so
    --! add_memory's kind="rezept" dedup branch can upsert by name instead
    --! of piling up a new row every time the same recipe gets refined.
    mem.add_memory h ("REZEPT: " ++ n ++ " — " ++ (trim schritte)) "rezept" 4 "gremium" n
    "Rezept gespeichert: " ++ n

--! Tool: search stored workflow recipes by relevance to the current task,
--! to handle a recurring task following a proven pattern.
fn tool_rezepte_suchen query
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    rs: mem.recipe_search h query 5
    if (len rs) == 0
        return "Keine Rezepte gespeichert."
    out: ""
    for r in rs
        out: out ++ "- " ++ r ++ "\n"
    out

--! Tool: connects one configured-but-not-yet-active MCP server on demand
--! (see the lazy-MCP-loading plan — Muninn no longer eagerly connects
--! every server at boot, only the ones a message's keywords already
--! matched, see ensure_mcp_for_task in muninn.pipe). CRITICAL LIMITATION
--! the caller must be told (see the tool description in init_gremium):
--! ai_swarm_stream freezes the whole agent/tool set ONCE at the start of
--! THIS run — a specialist activated here, even though init_gremium is
--! re-run synchronously right below and DOES take effect immediately at
--! the process level, is only visible to the NEXT run_gremium_stream
--! call, never to the rest of THIS one. muninn.pipe's handle_message
--! detects this (via mcp_activated on the returned result, see
--! run_gremium_stream below) and automatically retries the whole task
--! once — so from the user's side it still resolves in one exchange, just
--! with one extra round-trip.
fn tool_werkzeug_aktivieren alias
    if (mcp.is_connected alias)
        return "Werkzeug '" ++ alias ++ "' ist bereits aktiv."
    server: nil
    for s in (get STATE "available_servers")
        if (get s "alias") == alias
            server: s
    if server == nil
        known: []
        for s in (get STATE "available_servers")
            a: get s "alias"
            if a != nil && !(mcp.is_connected a)
                push known a
        return "Unbekannter Alias '" ++ alias ++ "'. Tatsaechlich verfuegbar, aber noch nicht aktiv: " ++ (join known ", ")
    results: mcp.connect_servers [server]
    r: at results 0
    if (get r "ok") == true
        push (get STATE "mcp_activated") alias
        init_gremium 0
        "Werkzeug '" ++ alias ++ "' aktiviert. Es steht erst im NAECHSTEN Versuch fuer diese Aufgabe zur Verfuegung, nicht in dieser Runde — leite JETZT normal an einen der bereits aktiven Agenten weiter (oder an registrator, falls nichts weiter noetig ist)."
    else
        "Aktivierung von '" ++ alias ++ "' fehlgeschlagen: " ++ (get r "error")

--! Tool: searches the official MCP server registry (registry.modelcontextprotocol.io)
--! for a server Muninn doesn't have yet. Only surfaces servers Muninn can
--! actually connect to (npm-packaged stdio servers — Muninn has no
--! generic HTTP/streamable-transport MCP client, so "remotes"-only
--! registry entries, e.g. ones needing a third-party hub's bearer token,
--! are silently skipped, they don't fit at all) and, among those, only
--! ones needing no extra secret Harry would have to supply (no
--! collection-a-new-API-key UX exists yet) — such entries are still
--! MENTIONED, not silently dropped, so the model can tell the user
--! honestly instead of pretending nothing was found.
fn tool_mcp_registry_suchen query
    url: "https://registry.modelcontextprotocol.io/v0.1/servers?search=" ++ (url_encode query)
    data: nil
    try
        data: http_get_json url
    catch e
        return "Registry-Suche fehlgeschlagen: " ++ (to_str e)
    servers: nil
    if data != nil
        servers: get data "servers"
    if servers == nil || (len servers) == 0
        return "Keine Treffer in der MCP-Registry fuer '" ++ query ++ "'."
    matches: ""
    n_matches: 0
    skipped: ""
    for entry in servers
        srv: get entry "server"
        if srv != nil && n_matches < 5
            packages: get srv "packages"
            found: nil
            if packages != nil
                for pkg in packages
                    if found == nil && (get pkg "registryType") == "npm"
                        transport: get pkg "transport"
                        if transport != nil && (get transport "type") == "stdio"
                            found: pkg
            if found != nil
                needs_secret: false
                envs: get found "environmentVariables"
                if envs != nil
                    for ev in envs
                        if (get ev "isRequired") == true
                            needs_secret: true
                name: get srv "name"
                desc: get srv "description"
                ident: get found "identifier"
                if needs_secret
                    skipped: skipped ++ "- " ++ name ++ " (braucht einen API-Key, uebersprungen)\n"
                else
                    matches: matches ++ "- " ++ name ++ " — " ++ desc ++ " (npm: " ++ ident ++ ")\n"
                    n_matches: n_matches + 1
    out: ""
    if matches != ""
        out: "Treffer:\n" ++ matches
    if skipped != ""
        out: out ++ "Ausserdem gefunden, aber uebersprungen:\n" ++ skipped
    if out == ""
        out: "Keine passenden, direkt nutzbaren Treffer (nur Remote-/HTTP-Server gefunden, die Muninn nicht verbinden kann)."
    out

--! Tool: proposes adding a new MCP server discovered via
--! mcp_registry_suchen — sends Harry a Yes/No button, NEVER installs
--! anything itself. See handle_callback's "mcp_add_yes"/"mcp_add_no"
--! branches in muninn.pipe for what actually happens on tap.
--! Only ONE proposal can be pending at a time (single-user bot — a fixed
--! meta key, no per-proposal id needed) — see muninn.pipe's
--! resolve_mcp_proposal and the deterministic "pending_mcp_add" gate in
--! handle_message: while this is set, EVERY incoming message is
--! intercepted BEFORE it ever reaches the gremium (Ja/Nein resolves it,
--! anything else just re-reminds the user) — never left to an agent's own
--! judgment. Live-observed why this had to be deterministic: after
--! proposing, the user replied "installier's und teste es" instead of
--! tapping the button — the gremium (not yet aware ANY decision existed)
--! took that at face value and burned a real Docker container trying to
--! "install and test" the server itself, completely redundant with (and
--! unrelated to) the real npm/stdio connection this approval flow sets up
--! on actual approval.
fn tool_mcp_server_vorschlagen alias name beschreibung npm_paket
    if alias == nil || alias == ""
        return "Kein Alias angegeben."
    if (mcp.is_connected alias)
        return "Alias '" ++ alias ++ "' ist bereits verbunden."
    for s in (get STATE "available_servers")
        if (get s "alias") == alias
            return "Alias '" ++ alias ++ "' ist bereits konfiguriert."
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    tok: get STATE "token"
    cid: get STATE "cid"
    if tok == nil || cid == nil
        return "Kein Telegram-Kontext verfuegbar, kann keinen Vorschlag senden."
    existing_pending: mem.meta_get h "pending_mcp_add"
    if existing_pending != nil && existing_pending != ""
        return "Es gibt bereits einen offenen Vorschlag, der auf eine Ja/Nein-Antwort wartet — erst DIESEN entscheiden lassen, bevor ein neuer vorgeschlagen wird."
    kb: []
    row: []
    push row (tel.tel_button "✅ Ja, hinzufuegen" "mcp_add_yes")
    push row (tel.tel_button "❌ Nein" "mcp_add_no")
    push kb row
    text: "🔌 Neuer MCP-Server gefunden:\n\n**" ++ name ++ "** (`" ++ alias ++ "`)\n" ++ beschreibung ++ "\nnpm: " ++ npm_paket ++ "\n\nLaeuft bei Zustimmung als uneingeschraenkter lokaler Prozess (`npx -y " ++ npm_paket ++ "`) — bitte nur bestaetigen, wenn du der Quelle vertraust. Antworte mit Ja/Nein oder tippe den Button — bis dahin passiert NICHTS."
    --! The pending-approval gate is only armed AFTER a confirmed successful
    --! send — armed first and the send fails (network blip, or an
    --! exception), the user would be permanently locked out by
    --! handle_message's deterministic gate (muninn.pipe) without ever
    --! having seen a proposal to answer.
    sendres: nil
    try
        sendres: tel.tel_send_message_kb tok cid text kb
    catch e
        return ("Senden des Vorschlags fehlgeschlagen: " ++ (to_str e))
    if (get sendres "ok") == false
        return "Senden des Vorschlags fehlgeschlagen: " ++ (to_str (get sendres))
    mem.meta_set h "pending_mcp_add" (to_json {alias: alias, name: name, beschreibung: beschreibung, npm_paket: npm_paket})
    "Vorschlag an Harry gesendet, wartet auf Bestaetigung. WICHTIG: bis er antwortet, ist NICHTS installiert. Schreibt er DANACH etwas anderes (z.B. 'installier's', 'teste es') — das System faengt jede Nachricht waehrend eine Bestaetigung aussteht deterministisch VOR dir ab, du bekommst so eine Nachricht erst gar nicht zu sehen. Versuch also NIEMALS selbst, den vorgeschlagenen Server anderweitig (z.B. per Docker) zu installieren oder zu testen — das ist nie noetig."

--! Tool: permanently remember a piece of information.
fn tool_merken content kind
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    mem.add_memory h content kind 3 "gremium" "gremium"
    "Gemerkt: " ++ content

--! Tool: search the web (title + URL).
fn tool_web_search query
    results: web.web_results query 5
    if (len results) == 0
        return "Keine Treffer im Web."
    out: ""
    i: 0
    while i < (len results)
        r: at results i
        t: get r "title"
        u: get r "url"
        if t != nil && u != nil
            out: out ++ (to_str (i + 1)) ++ ". " ++ t ++ "\n   " ++ u ++ "\n"
        i: i + 1
    out

--! Tool: fetch a web page (body text, truncated).
fn tool_web_fetch url
    text: web.web_fetch url
    if text == ""
        return "Seite nicht abrufbar."
    text

--! Tool: permanently remember a piece of information with a source URL.
fn tool_merken_quelle content source
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    mem.add_memory h content "fact" 3 source "web"
    "Gemerkt (Quelle: " ++ source ++ "): " ++ content

--! Tool: publishes a long text (research summary, report) as a Telegraph
--! (telegra.ph) page instead of it being cut off at Telegram's message
--! length limit or sent as a downloadable file -- Telegraph pages get
--! Telegram's fast, native-feeling Instant View reader automatically.
--! Reuses one persistent Telegraph account (token stored in meta) across
--! every publish instead of creating a new one each time.
fn tool_bericht_veroeffentlichen title text
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    if title == nil || (trim title) == "" || text == nil || (trim text) == ""
        return "Titel oder Text fehlt."
    token: mem.meta_get h "telegraph_token"
    if token == nil || token == ""
        token: web.web_telegraph_account 0
        if token == nil
            return "Telegraph-Account konnte nicht angelegt werden."
        mem.meta_set h "telegraph_token" token
    url: web.web_telegraph_publish token (trim title) text
    if url == nil
        return "Veroeffentlichung fehlgeschlagen."
    "Veroeffentlicht: " ++ url

--! Escapes a path for embedding as ONE host-side argv token in an exec()
--! command string — same duplicated-locally pattern as docker_tools.pipe's
--! own copy (see the comment there: an extra import here would needlessly
--! risk the sqlite-shadowing bug that motivated keeping this un-exported).
fn shell_quote s
    s: replace_all s "\\" "\\\\"
    s: replace_all s "\"" "\\\""
    s

--! Tool: finds a free, open-source icon (Iconify, 200'000+ icons, no API
--! key) matching a search term and saves it as a ready-to-use PNG in
--! mcp_data/icons/ -- for embedding into presentations/documents
--! (werkzeug_praesentation's manage_image, werkzeug_dokument's add_picture)
--! or sending directly (bild_senden). PNG, not SVG: neither python-docx
--! nor office-powerpoint-mcp-server can embed SVG directly, only raster
--! images -- rsvg-convert (see setup_sandbox's exec whitelist) rasterizes
--! the fetched SVG.
fn tool_icon_holen suchbegriff farbe groesse
    if suchbegriff == nil || (trim suchbegriff) == ""
        return "Suchbegriff fehlt."
    ids: web.web_icon_search (trim suchbegriff) 1
    if (len ids) == 0
        return "Kein passendes Icon gefunden fuer '" ++ suchbegriff ++ "'."
    icon_id: at ids 0
    --! groesse is interpolated unquoted into a shell command below (unlike
    --! the paths, which go through shell_quote) — a raw to_str of an
    --! AI-supplied value would let something like "128; rm -rf /tmp/x"
    --! reach exec() verbatim. Validate it's actually a plain positive
    --! integer instead, falling back to the default on anything else.
    px_n: 128
    if groesse != nil && groesse != ""
        try
            px_n: to_num groesse
        catch
            px_n: 128
        if !(is_num px_n) || px_n <= 0 || px_n > 2048
            px_n: 128
    px: to_str (round px_n)
    svg: web.web_icon_svg icon_id farbe px
    if svg == nil
        return "Icon '" ++ icon_id ++ "' konnte nicht abgerufen werden."
    safe_name: replace_all icon_id ":" "_"
    make_dir "/root/muninn/mcp_data/icons"
    svg_path: "/root/muninn/mcp_data/icons/" ++ safe_name ++ ".svg"
    png_path: "/root/muninn/mcp_data/icons/" ++ safe_name ++ ".png"
    write_file svg_path svg
    cmd: "rsvg-convert -w " ++ px ++ " -h " ++ px ++ " -o \"" ++ (shell_quote png_path) ++ "\" \"" ++ (shell_quote svg_path) ++ "\""
    r: exec cmd
    if (get r "status") != 0
        return "SVG->PNG-Umwandlung fehlgeschlagen (" ++ icon_id ++ "): " ++ (get r "output")
    "Icon gespeichert: " ++ png_path ++ " (" ++ icon_id ++ ")"

--! Tool: searches a real photo (not a simple line icon — see
--! tool_icon_holen for those, and 'bild_erstellen' for a completely
--! AI-generated image) via web_image_search and downloads it locally
--! through Openverse's own thumbnail proxy — see web_image_search/
--! web_image_download's doc comments (web.pipe) for why the original
--! provider URL isn't used directly (unreliable hotlinking, live-
--! verified). For embedding into HTML (e.g. werkzeug_slideshot), use the
--! returned path as a 'LOCAL:<path>' marker in <img src="..."> exactly
--! like an icon_holen result — see tool_bild_pfade_einbetten.
fn tool_bild_suchen suchbegriff
    if suchbegriff == nil || (trim suchbegriff) == ""
        return "Suchbegriff fehlt."
    q: trim suchbegriff
    results: web.web_image_search q 1
    if (len results) == 0
        return "Kein passendes Bild gefunden fuer '" ++ q ++ "'."
    top: at results 0
    id: get top "id"
    content: web.web_image_download id
    if content == nil || content == ""
        return "Bild konnte nicht heruntergeladen werden fuer '" ++ q ++ "'."
    safe_slug: lower (regex_replace "[^a-zA-Z0-9]+" "-" q)
    if (len safe_slug) > 40
        safe_slug: substring safe_slug 0 40
    short_id: id
    if (len id) > 8
        short_id: substring id 0 8
    make_dir "/root/muninn/mcp_data/images"
    img_path: "/root/muninn/mcp_data/images/" ++ safe_slug ++ "-" ++ short_id ++ ".jpg"
    write_file img_path content
    title: get top "title"
    creator: get top "creator"
    license: get top "license"
    attrib: ""
    if title != nil && title != ""
        attrib: " (\"" ++ (to_str title) ++ "\""
        if creator != nil && creator != ""
            attrib: attrib ++ " von " ++ (to_str creator)
        attrib: attrib ++ ", Lizenz " ++ (to_str license) ++ ")"
    "Bild gespeichert: " ++ img_path ++ attrib

--! Tool: create a long-term goal (a genuine ongoing objective, NOT a
--! one-off task that's done as soon as this conversation ends -- e.g.
--! "learn Spanish this year", not "create a text file"). Shows up in
--! /goals (Telegram, interactive) and the web dashboard.
fn tool_ziel_anlegen text
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    if text == nil || (trim text) == ""
        return "Ziel-Text fehlt."
    gid: mem.add_goal h (trim text)
    "Ziel angelegt (#" ++ (to_str gid) ++ "): " ++ (trim text)

--! Tool: mark a previously created goal as done (id from /goals or a
--! prior 'ziel_anlegen' confirmation).
fn tool_ziel_erledigt id
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    gid: to_num id
    if gid == nil
        return "Ungueltige Ziel-ID."
    mem.set_goal_status h gid "done"
    "Ziel #" ++ (to_str gid) ++ " als erledigt markiert."

--! Tool: schedule a time-based reminder (replacement for the old, blind
--! "task" classification — now the gremium decides for itself, with full
--! conversation context, whether and when something should be a reminder,
--! instead of a context-free classification call deciding that in advance
--! and unreliably). text: the thing to remember in natural language incl. a
--! time reference, e.g. "tomorrow at 6am: appointment for work" —
--! sched.parse_reminder parses that.
fn tool_erinnerung_planen text
    h: cur_dbh 0
    cid: get STATE "cid"
    if h == nil || cid == nil
        return "Kein Chat-Kontext verfuegbar, kann keine Erinnerung planen."
    tzo: get STATE "tz_offset"
    parsed: sched.parse_reminder text now tzo
    sched.schedule h "reminder" (to_str cid) (get parsed "text") (get parsed "due") (get parsed "repeat")
    "Erinnerung geplant fuer " ++ (format_time ((get parsed "due") + tzo) "2006-01-02 15:04:05") ++ ": " ++ (get parsed "text")

--! Self-knowledge about Muninn, prepended to every gremium agent so that
--! meta-questions about Muninn's own capabilities get answered directly
--! instead of wrongly claiming "no knowledge" and triggering a web search.
SELF_ID: "Self-knowledge about Muninn (for questions ABOUT MUNINN ITSELF — capabilities, technology, architecture — answer DIRECTLY from this knowledge, NEVER claim 'no knowledge' and start a web search for it): Muninn is a personal AI agent, written in the 'pipe' scripting language (a Go interpreter). Muninn uses DeepSeek as its LLM provider with tool use/function calling, so in principle it can also read and write code. Muninn has a persistent SQLite long-term memory (memories + knowledge graph), can independently research the web (DuckDuckGo + Wikipedia), plan tasks and goals and execute them via an executor, set time-based reminders and a daily briefing, learn documents (including PDFs — text is automatically extracted via pdftotext, not pure image scans without a text layer), understand/describe photos (DeepSeek Vision), understand voice messages (local transcription via whisper-transcribe-mcp, no API key), generate images on request (free AI image generator, no API key), clone GitHub repos in an isolated Docker container and run their test suite (runs in the background, automatically reports back with the real test results), register and reuse persistent Docker environments instead of creating a new container for every request, and optionally be connected to external tools via MCP (e.g. filesystem). Muninn runs via a Telegram bot and a web dashboard.\n\n"

--! Hard handoff rule against premature answers: without this rule, an agent
--! sometimes ends the swarm by outputting text directly instead of calling
--! its handoff tool (observed with faktenwaechter on meta-questions — the
--! swarm ended there instead of at registrator, complete with an unfiltered
--! internal comment like "I got tangled up in the gremium..."). Only the
--! registrator is allowed to end.
HANDOFF_RULE: "WICHTIG: Du bist NICHT der letzte Agent in der Kette und deine Textantwort geht NIE direkt an den Nutzer. Du MUSST am Ende IMMER dein Handoff-Werkzeug aufrufen, auch wenn du die Antwort schon fertig im Kopf hast — sonst bricht das Gespraech unsauber ab. Nur 'registrator' darf ohne Handoff enden.\n\n"

--! Without this rule, the model wrongly diagnoses a tool's parameter/
--! validation error as a "broken connection" and gives up, instead of
--! reading the error message and retrying with corrected parameters.
--! Observed live: docker_exec_command called with command as a string
--! instead of an array -> Zod error "Required at command" -> the reply to
--! the user was "the Docker exec connection is broken", even though the
--! call demonstrably works with the correct array parameter (test: "echo
--! hello-from-inside" came back correctly from the container).
RETRY_RULE: "Bekommst du von einem Werkzeug einen Fehler zu falschen/fehlenden Parametern (Validierungsfehler, 'Required', 'invalid arguments' o.ae.), ist das FAST IMMER ein Zeichen, dass DU die Parameter falsch uebergeben hast (falscher Typ, falscher Name, falsche Struktur) — NICHT, dass das Werkzeug oder seine Anbindung kaputt ist. Lies die Fehlermeldung genau, korrigiere deinen Aufruf entsprechend und versuche es SOFORT nochmal, bevor du dem Nutzer irgendetwas ueber eine 'fehlerhafte Anbindung' erzaehlst. Erst wenn auch ein korrigierter Versuch scheitert, ist ein echtes technisches Problem plausibel.\n\n"

--! Without this rule, the model claims a service/web UI is reachable just
--! because a port was mapped — without ever checking. Observed: a freshly
--! started Docker container was advertised as "OpenCode UI reachable at
--! http://127.0.0.1:4096", even though the connection only returned an
--! empty response (no web server in the container) — and even after
--! 'docker_container_logs' showed EMPTY logs (a clear warning sign), the
--! claim was repeated instead of corrected.
VERIFY_CLAIM_RULE: "Behaupte NIEMALS, dass ein Dienst/eine Web-Oberflaeche/eine URL erreichbar oder funktionsfaehig ist, nur weil du einen Port gemappt oder einen Container gestartet hast — das beweist nur, dass der Container LAEUFT, nicht, dass darin etwas Sinnvolles auf diesem Port lauscht. Hast du ein Werkzeug zur Verifikation (z.B. 'docker_container_logs', 'web_fetch' auf die URL), nutze es und beziehe dich auf das TATSAECHLICHE Ergebnis. Zeigen Logs nichts oder wirkt ein Dienst inaktiv, sag das ehrlich ('Container laeuft, aber ob/was dort auf Port X reagiert, ist unklar') statt eine Erreichbarkeit zu behaupten, die du nicht geprueft hast.\n\n"

--! ONLY for the registrator (the only agent whose answer goes directly to
--! the user as the final answer WITHOUT a tool call — every other agent is
--! intercepted on plain text with no tool call and forced to retry, see
--! swarm.go). Observed live: during a difficult honesty trade-off
--! (VERIFY_CLAIM_RULE: "can I really back this up?"), the model wrote out
--! its entire thought process ("I need to check... Let me look... I should
--! be honest...") AS PART OF the message sent to the user, even though the
--! corresponding instruction already existed in the registrator prompt —
--! presumably buried too far back in a very long prompt block to reliably
--! kick in during a complex trade-off. Placed as its own, prominent rule
--! BEFORE that block, with a concrete negative example (few-shot works more
--! reliably than an abstract instruction).
NO_REASONING_LEAK_RULE: "KRITISCH: deine Antwort geht DIREKT und UNGEFILTERT an den Nutzer in Telegram — gib AUSSCHLIESSLICH die fertige, finale Antwort aus, NIEMALS deinen Denkprozess davor, auch nicht bei einer schwierigen Abwaegung (z.B. zwischen Ehrlichkeit und einer unsicheren Behauptung, siehe VERIFY_CLAIM_RULE). Verboten sind Saetze wie 'Ich muss pruefen...', 'Ich schaue in den Gespraechsverlauf...', 'Der Nutzer sagt...', 'Ich sollte ehrlich sein...' als sichtbare Selbstanalyse VOR der eigentlichen Antwort. Triff die Abwaegung STILL fuer dich und gib NUR das Ergebnis aus. Beispiel einer VERBOTENEN Antwort: 'Ich muss die tatsaechlichen Logs pruefen... Der Nutzer sagt, das war erfolgreich... Ich sollte ehrlich sein... Nein, nicht vergessen — der Testlauf ist erfolgreich abgeschlossen!' — nur der LETZTE Satz waere die richtige, vollstaendige Antwort; alles davor darf nie im Chat erscheinen.\n\n"

--! Ohne diese Regel erwaehnt der Registrator einen vom werkzeug_<alias>-
--! Spezialisten generierten Link (z.B. einen Google-Autorisierungs-Consent-
--! Link) nur BEILAEUFIG, statt ihn woertlich zu wiederholen — die eigene
--! Anweisung "gib den Link woertlich weiter" steckt bislang NUR im
--! extra_note des jeweiligen Spezialisten (siehe alias == "google" unten),
--! nicht bei kritiker/registrator, die die tatsaechliche Endantwort
--! komponieren. Live beobachtet: google_start_google_auth lieferte
--! nachweislich eine echte, funktionierende Autorisierungs-URL, der
--! Registrator schrieb aber nur "die bereitgestellte Autorisierungs-URL
--! manuell (ist in der Systemmeldung oben enthalten)" — OHNE die URL
--! selbst zu nennen. Der Nutzer sieht aber NIE die "Systemmeldung", NUR die
--! finale Antwort — der Login war dadurch praktisch unmoeglich, obwohl der
--! Link laengst existierte.
LINK_RELAY_RULE: "Enthaelt eine vorherige Nachricht oder ein Werkzeug-Ergebnis in dieser Konversation eine URL/einen Link, den der Nutzer selbst oeffnen muss (z.B. ein Autorisierungs-/Consent-Link, eine Freigabe-URL, ein Datei-Link), gib diesen Link IMMER WOERTLICH UND VOLLSTAENDIG in deiner Antwort aus — buchstabengetreu kopiert, NIEMALS zusammengefasst, gekuerzt oder durch einen Verweis wie 'siehe oben', 'ist in der Systemmeldung enthalten' oder 'wurde bereits angezeigt' ersetzt. Der Nutzer sieht AUSSCHLIESSLICH deine finale Antwort, NIE interne Agenten-Nachrichten oder Werkzeug-Rohausgaben — ein nicht wiederholter Link existiert fuer ihn schlicht nicht, selbst wenn er technisch laengst generiert wurde.\n\n"

--! Without this rule, the model wrongly answers time-dependent questions
--! (time, weather, current events) with a generic "as a language model I
--! have no real-time access" excuse, EVEN THOUGH 'web_search' is available
--! — observed with "What time is it currently in Germany?".
--! question_needs_research (muninn.pipe) only catches this as a stopgap if
--! the phrasing happens to be on the trigger list.
TOOL_DISCIPLINE_RULE: "Fuer aktuelle/zeitabhaengige Informationen (Uhrzeit, Datum, Wetter, aktuelle Ereignisse, Kurse, Nachrichten) darfst du NIEMALS aus deinem eigenen Sprachmodell-Wissen antworten oder behaupten, du haettest 'keinen Echtzeitzugriff' — du HAST Zugriff via 'web_search'/'web_fetch'. Nutze sie in diesen Faellen IMMER, bevor du antwortest.\n\n"

--! Related to TOOL_DISCIPLINE_RULE, but a different failure mode: the AI
--! DOES call web_search, gets results that don't look relevant/current
--! enough (e.g. Wikipedia articles instead of daily news), and THEN invents
--! a blanket "my web search is technically unavailable" excuse instead of
--! honestly saying the results weren't good, or retrying with a more
--! precise query/a direct web_fetch on a known source (e.g. tagesschau.de).
--! Observed with "What's the current news in Germany?" — web_search/
--! web_fetch demonstrably worked (reproduced in isolation), the AI still
--! claimed it had "hit technical limits" and was "currently unreachable".
RESULT_HONESTY_RULE: "Behaupte NIEMALS pauschal, 'web_search'/'web_fetch' seien 'technisch nicht verfuegbar', 'derzeit nicht erreichbar' oder du seist an 'technische Grenzen gestossen' — das ist so gut wie nie wahr. Liefert ein Aufruf nur schlechte/irrelevante Treffer (z.B. alte Wikipedia-Artikel statt aktueller Nachrichten), ist das ein Qualitaetsproblem der TREFFER, kein Ausfall des Werkzeugs: versuche es mit einer praeziseren Suchanfrage erneut, oder rufe 'web_fetch' direkt auf einer bekannten Quelle auf (z.B. tagesschau.de fuer deutsche Nachrichten). Bleibt das Ergebnis danach immer noch duenn, sag ehrlich 'ich habe nur X gefunden, das war nicht sehr ergiebig' — NIE eine erfundene technische Ausrede.\n\n"

--! Without this rule, the model responds to overly vague requests ("do
--! something") either by inventing an action that never happened ("okay,
--! I'll just turn on the moon") or by aborting with a raw internal error
--! (the old free-form JSON step planning in the executor did exactly that,
--! with no context at all — which is why this path is now completely
--! replaced by the gremium, which has real context and real tools).
HONESTY_RULE: "Ist eine Nutzeranfrage zu vage oder unspezifisch, um eine konkrete, sinnvolle Aktion daraus abzuleiten (z.B. 'mach mal irgendwas'), erfinde NIEMALS eine Aktion und behaupte NIEMALS, etwas getan zu haben, das nicht wirklich stattgefunden hat. Frage stattdessen freundlich und konkret nach, was genau gewuenscht ist. Fragt der Nutzer, WARUM du zuvor etwas Bestimmtes getan/geantwortet hast (z.B. 'wieso hast du recherchiert statt normal zu antworten?'), erfinde NIEMALS eine plausibel klingende, aber unbelegte technische Erklaerung (z.B. 'das war wohl ein versehentlich gesendeter Befehl') — wenn dir der tatsaechliche Grund aus der Konversation nicht wirklich ersichtlich ist, sag ehrlich, dass du es nicht genau weisst, statt eine Vermutung als Tatsache zu praesentieren.\n\n"

--! The registrator's final answer is sent as a Telegram Rich Message
--! (Bot API 10.1+, tel.tel_send_rich_message/tel_edit_rich_message* in
--! telegram.pipe, wired in via muninn.pipe's tel_finalize/
--! tel_finalize_after_tree) — real GitHub-Flavored-Markdown, natively
--! rendered by Telegram itself: headings, genuine tables, nested/task
--! lists, blockquotes, not just the old **bold**/*italic*/`code`/[links]
--! subset tg_html could convert. Each send falls back to a plain send on
--! its own if a client ever rejects it (Rich Messages are new), so this
--! rule can freely tell the model to use the full structure — no risk of
--! a broken message if the format isn't actually supported somewhere.
FORMAT_RULE: "Deine Antwort wird als Telegram Rich Message gesendet: echtes GitHub-Flavored-Markdown wird nativ dargestellt, nicht nur **Fettung**/*Kursiv*/`Code`/[Links](url) (die weiterhin normal per CommonMark-Syntax funktionieren), sondern auch Ueberschriften (#/##), echte Tabellen (| Spalte | Spalte |) und Listen (auch verschachtelt). Nutze diese Struktur gezielt, wann immer sie die Antwort klarer macht — z.B. eine Tabelle fuer einen Vergleich/eine Uebersicht mit mehreren Werten, Ueberschriften zur Gliederung einer laengeren Antwort, eine Liste bei mehreren Punkten. Das ist aber kein Zwang: eine kurze, einfache Antwort bleibt ein kurzer Fliesstext ohne unnoetige Struktur. Kurze Absaetze statt langer Bloecke.\n\n"

--! Without this rule, the model wrongly claims things like "I have no
--! access to tools" for questions about Muninn's own tools — "researched"
--! via a web search on generic help pages, which logically can't know what
--! THIS specific bot has connected (observed with "can you set up a Google
--! Workspace with your tools?", even though filesystem+memory MCP servers
--! were connected). tools_desc is built dynamically in init_gremium from
--! the REAL, currently connected tool list, not as static text.
--!
--! Additionally: results from 'erinnerungen_suchen' must not be taken at
--! face value as statements by the user — mem.retrieve_context marks
--! everything except "permanent"/"document" (i.e. AI research results, task
--! logs) with a prefix. Observed: an old AfD research result was misread,
--! on "What am I interested in?", as a "clear signal of political
--! interest", even though it was just earlier research for a DIFFERENT
--! question, not a statement about the user.
SECURITY_HONESTY_RULE: "Gibst du Aussagen ueber die SICHERHEIT des Systems oder konkrete Systembefunde aus (Kernel-Versionen, Sandbox-/Container-Eigenschaften, Exploits wie 'Dirty Pipe', Seccomp-/Namespace-Status, UID-Mapping, Egress-Gates o.ae.), unterscheide STRENG nach Herkunft: (1) VERIFIZIERT ist nur, was du in DIESEM Lauf selbst per Werkzeug/eigener Ausgabe geprueft hast — nenne dann die konkrete Quelle (z.B. 'docker info zeigt: nur seccomp'). (2) Aus dem Gedaechtnis stammende Audit-Erkenntnisse darfst du zitieren, aber kennzeichne sie als 'aus frueheren Audits, aktuell nicht erneut geprueft'. (3) Reines Sprachmodell-Vorwissen ueber Sicherheitsluecken darfst du NIE als Befund UEBER DIESES System ausgeben. Markiere alles, was du nicht selbst in diesem Lauf geprueft hast, als 'ungeprueft'. Erfinde niemals Versionsnummern, Dateipfade oder Testergebnisse, um einen Report vollstaendiger wirken zu lassen.\n\n"

MEMORY_HONESTY_RULE: "Ergebnisse von 'erinnerungen_suchen', die mit '[earlier research/log entry, NOT a statement by the user]' markiert sind, sind KI-generierte Recherche-Ergebnisse oder Protokolle — KEINE Aussagen des Nutzers ueber sich selbst. Aus solchen Eintraegen darfst du NIEMALS auf Interessen, Meinungen oder Praeferenzen des Nutzers schliessen. Nur unmarkierte Eintraege sind tatsaechliche Aussagen des Nutzers. Findest du zu einer Frage nach Interessen/Vorlieben nur markierte oder gar keine Eintraege, sag ehrlich, dass dazu noch nichts Eindeutiges von ihm gespeichert ist, statt aus Recherche-Nebenprodukten eine Praeferenz zu konstruieren.\n\n"

--! Self-knowledge + the real, current tool list as ONE context block — for
--! code OUTSIDE the gremium that still has to answer "as Muninn" (the web
--! research fallback in muninn.pipe: when the gremium can't answer a
--! question, extra research is done and its own, lean ai_chat call
--! formulates the answer). Without this knowledge, a bare ai_chat call with
--! only "You are Muninn, a personal AI assistant" as the prompt quickly and
--! wrongly claims to have no tools/system access at all — observed live: "I
--! can't create Docker containers, I'm a text-based research assistant",
--! even though werkzeug_docker demonstrably can (see docker_tools.pipe,
--! tested live with a real nginx container). Deliberately a lean subset of
--! the init_gremium logic (just the description, no agent registration)
--! instead of duplicating it.
export fn self_context _
    local_names: ["erinnerungen_suchen", "merken", "web_search", "web_fetch", "merken_quelle", "erinnerung_planen", "docker_pull_image", "docker_create_container"]
    mcp_groups: mcp.discovered_tools_by_source local_names
    mcp_names: []
    for grp in mcp_groups
        for tn in (get grp "tools")
            push mcp_names tn
    desc: "REAL, currently available tools: 'erinnerungen_suchen' (search memory), 'merken'/'merken_quelle' (store permanently), 'web_search'/'web_fetch' (research the internet), 'erinnerung_planen' (schedule an appointment/reminder)"
    if (len mcp_groups) > 0
        desc: desc ++ ", plus externally connected via MCP: " ++ (join mcp_names ", ") ++ ". For Docker, 'docker_pull_image'/'docker_create_container' are also included (pull an image, start a container — WITHOUT volume mounts/--privileged, that's intentional, not a missing capability)."
    else
        desc: desc ++ ". No external MCP server connected."
    desc: desc ++ " NEVER blanketly claim to have no tools/system access when this list isn't empty.\n\n"
    SELF_ID ++ desc

--! file_index / workspaces: a durable registry of every file Muninn has
--! actually sent, plus named reusable subfolders ("workspaces") under
--! mcp_data — the direct counterpart to docker_tools.pipe's
--! docker_environments (same "durable, reusable, named resource" idea,
--! applied to the filesystem instead of containers). Without this, every
--! request for a report/presentation on a topic already covered before
--! reflexively created a brand-new file — mcp_data accumulated dozens of
--! near-duplicate documents with no way for Muninn to know they already
--! existed (user-observed, live-verified: 8 near-identical iterations of
--! one document sitting loose side by side).
fn init_file_index h
    mem.raw_exec h "CREATE TABLE IF NOT EXISTS file_index (id INTEGER PRIMARY KEY AUTOINCREMENT, path TEXT, chat_id TEXT, caption TEXT, workspace TEXT, created TEXT)"
    mem.raw_exec h "CREATE TABLE IF NOT EXISTS workspaces (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, zweck TEXT, created TEXT, status TEXT)"
    nil

--! Which registered, active workspace (if any) a path belongs to, by
--! checking whether its parent directory name matches a workspace.
fn workspace_for_path h full_path
    parts: split full_path "/"
    if (len parts) < 2
        return ""
    parent: at parts ((len parts) - 2)
    rows: mem.raw_query h ("SELECT name FROM workspaces WHERE name = '" ++ (mem.sql_escape parent) ++ "' AND status = 'active'")
    if (len rows) > 0
        parent
    else
        ""

--! Records a successfully sent file in the durable file index —
--! deterministic (called automatically from tool_bild_senden/
--! tool_datei_senden below, no extra AI discipline needed to keep the
--! index accurate). Best-effort: logging must never break a send that
--! already succeeded by the time this runs.
fn record_sent_file full_path caption
    h: cur_dbh 0
    if h == nil
        return nil
    cap: caption
    if cap == nil
        cap: ""
    try
        init_file_index h
        ws: workspace_for_path h full_path
        mem.raw_exec h ("INSERT INTO file_index (path, chat_id, caption, workspace, created) VALUES ('" ++ (mem.sql_escape full_path) ++ "', '" ++ (mem.sql_escape (to_str (get STATE "cid"))) ++ "', '" ++ (mem.sql_escape cap) ++ "', '" ++ (mem.sql_escape ws) ++ "', '" ++ (mem.sql_escape (mem.now_ts 0)) ++ "')")
    catch
        nil
    nil

--! Tool: creates a new, reusable workspace subfolder under mcp_data — a
--! named place to keep everything about one ongoing topic/project
--! together instead of every file landing loose in mcp_data's root.
fn tool_workspace_erstellen name zweck
    if !(dt.valid_identifier name)
        return "Abgelehnt: '" ++ (to_str name) ++ "' ist kein gueltiger Workspace-Name (nur Buchstaben/Zahlen/_/-/., max. 63 Zeichen)."
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    init_file_index h
    existing: mem.raw_query h ("SELECT id FROM workspaces WHERE name = '" ++ (mem.sql_escape name) ++ "' AND status = 'active'")
    if (len existing) > 0
        return "Workspace '" ++ name ++ "' existiert bereits."
    make_dir ("/root/muninn/mcp_data/" ++ name)
    mem.raw_exec h ("INSERT INTO workspaces (name, zweck, created, status) VALUES ('" ++ (mem.sql_escape name) ++ "', '" ++ (mem.sql_escape zweck) ++ "', '" ++ (mem.sql_escape (mem.now_ts 0)) ++ "', 'active')")
    "Workspace '" ++ name ++ "' angelegt: " ++ zweck

--! Tool: lists active workspaces — check this FIRST before creating a new
--! file for a request about an existing topic/project, so related work
--! lands together instead of scattered across mcp_data's root.
fn tool_workspaces_auflisten _
    h: cur_dbh 0
    if h == nil
        return "Keine Datenbank verbunden."
    init_file_index h
    rows: mem.raw_query h "SELECT name, zweck FROM workspaces WHERE status = 'active' ORDER BY id DESC"
    if (len rows) == 0
        return "Keine Workspaces angelegt."
    out: "Aktive Workspaces:\n"
    for r in rows
        out: out ++ "- " ++ (get r "name") ++ ": " ++ (get r "zweck") ++ "\n"
    out

--! Scans mcp_data's top level for loose files not yet organized into a
--! workspace, asks ONE lean ai_chat call (not a full gremium run — same
--! cheap single-shot pattern as do_search's summarizer) to propose a
--! thematic grouping, then executes it deterministically: make_dir +
--! file_move only, NEVER file_delete — the AI only PROPOSES folder
--! names/groupings, every actual filesystem change happens afterward in
--! plain code (the same propose-then-execute split already used for the
--! MCP-server-approval flow). Silent on success (only logged) — matches
--! selbstdiagnose's "only speak up if actually noteworthy" philosophy.
--! Already-organized subfolders (icons/, or anything previously moved by
--! this same function) are never touched, only genuinely loose files.
export fn organize_mcp_data dbh cid
    init_file_index dbh
    base: "/root/muninn/mcp_data"
    entries: []
    try
        entries: list_dir base
    catch e0
        print ("organize_mcp_data: list_dir failed: " ++ (to_str e0))
        return "list_dir failed"
    already: {}
    for r in (mem.raw_query dbh "SELECT path FROM file_index WHERE workspace != ''")
        set already (get r "path") true
    loose: []
    for e in entries
        if (len e) == 0 || (substring e ((len e) - 1) (len e)) != "/"
            full: base ++ "/" ++ e
            if (get already full) == nil
                push loose e
    if (len loose) == 0
        return "Nothing to organize."
    prompt: "You are organizing a messy flat file directory into thematic subfolders. Given this list of filenames, propose short, lowercase, hyphen-or-underscore-separated folder names (matching the style of existing folders like 'friedrich_merz', 'creo-kritik-slides') and group the files by topic. Files with an unclear/unrelated topic can share one generic 'sonstiges' folder. Respond with ONLY a JSON object mapping folder name to a list of exact filenames taken from the input — no explanation, no markdown code fences.\n\nFiles:\n" ++ (join loose "\n")
    resp: ""
    try
        resp: ai_chat "You are a careful file-organizing assistant. Respond with ONLY valid JSON, nothing else." prompt
    catch e1
        print ("organize_mcp_data: ai_chat failed: " ++ (to_str e1))
        return "ai_chat failed"
    grouping: nil
    try
        grouping: parse_json (trim resp)
    catch e2
        print ("organize_mcp_data: could not parse grouping JSON: " ++ (to_str e2))
        return "parse failed"
    if grouping == nil || (type_of grouping) != "MAP"
        print "organize_mcp_data: grouping response was not a JSON object, skipping this run"
        return "invalid grouping"
    moved: 0
    for folder in (keys grouping)
        if dt.valid_identifier folder
            files: get grouping folder
            if (type_of files) == "LIST"
                dest_dir: base ++ "/" ++ folder
                make_dir dest_dir
                for fname in files
                    --! Only ever act on a filename that was genuinely in
                    --! THIS run's loose list — guards against the AI
                    --! hallucinating a filename that doesn't exist, or
                    --! (worse) one crafted to escape mcp_data.
                    if contains loose fname
                        src: base ++ "/" ++ fname
                        dst: dest_dir ++ "/" ++ fname
                        if file_exists src
                            try
                                file_move src dst
                                mem.raw_exec dbh ("INSERT INTO file_index (path, chat_id, caption, workspace, created) VALUES ('" ++ (mem.sql_escape dst) ++ "', '" ++ (mem.sql_escape (to_str cid)) ++ "', '', '" ++ (mem.sql_escape folder) ++ "', '" ++ (mem.sql_escape (mem.now_ts 0)) ++ "')")
                                moved: moved + 1
                            catch e3
                                print ("organize_mcp_data: move failed for " ++ fname ++ ": " ++ (to_str e3))
    "Organized " ++ (to_str moved) ++ " file(s)."

--! Tool: send an image (e.g. a screenshot that another tool saved locally)
--! to the user on Telegram. Uses sendPhoto (shows inline in the chat,
--! Telegram compresses/converts).
fn tool_bild_senden path caption
    tok: get STATE "token"
    cid: get STATE "cid"
    if tok == nil || cid == nil
        return "Kein Telegram-Kontext verfuegbar, kann kein Bild senden."
    full_path: resolve_muninn_path path
    if full_path == nil
        return "Ungueltiger Pfad (ausserhalb der erlaubten Verzeichnisse): " ++ (to_str path)
    if !(file_exists full_path)
        return "Datei nicht gefunden: " ++ full_path
    res: tel.tel_send_photo tok cid full_path caption
    if (get res "ok") == false
        --! Automatic fallback to sendDocument — live-observed repeatedly:
        --! Telegram's sendPhoto rejects Slideshot's tall 9:16 (1080x1920)
        --! renders with "Bad Request: PHOTO_INVALID_DIMENSIONS" (an
        --! inline-photo aspect-ratio limit, not a filesystem/access
        --! problem — but the AI, seeing only the raw failure, kept
        --! misdiagnosing it as one). sendDocument has no such dimension
        --! restriction, so this guarantees delivery regardless of which
        --! tool the calling agent reached for, instead of relying on it
        --! to correctly pick 'datei_senden' for a tall image every time.
        res2: tel.tel_send_document tok cid full_path caption
        if (get res2 "ok") == false
            return "Senden fehlgeschlagen (als Bild UND als Datei versucht): " ++ (to_str (get res2))
        record_sent_file full_path caption
        return ("Bild gesendet (als Datei, da Telegram das Bild-Format als Inline-Foto ablehnte — z.B. zu extremes Seitenverhaeltnis): " ++ full_path)
    record_sent_file full_path caption
    "Bild gesendet: " ++ full_path

--! Tool: send any file (e.g. a document created via the filesystem tool) to
--! the user on Telegram. Uses sendDocument (keeps the original format/
--! quality, shown as a file attachment instead of inline).
fn tool_datei_senden path caption
    tok: get STATE "token"
    cid: get STATE "cid"
    if tok == nil || cid == nil
        return "Kein Telegram-Kontext verfuegbar, kann keine Datei senden."
    full_path: resolve_muninn_path path
    if full_path == nil
        return "Ungueltiger Pfad (ausserhalb der erlaubten Verzeichnisse): " ++ (to_str path)
    if !(file_exists full_path)
        return "Datei nicht gefunden: " ++ full_path
    res: tel.tel_send_document tok cid full_path caption
    if (get res "ok") == false
        return "Senden fehlgeschlagen: " ++ (to_str (get res))
    record_sent_file full_path caption
    "Datei gesendet: " ++ full_path

--! Tool: takes a FULL HTML document authored by the slideshot specialist
--! and deterministically replaces every `<img src="LOCAL:<path>">` marker
--! with the real `data:image/<type>;base64,<...>` URI of that local file.
--!
--! WHY this exists instead of a per-image "give me the base64 string"
--! tool (the old `tool_bild_als_base64`, since removed): live-diagnosed
--! this session — when the specialist had to copy a real (tens of
--! thousands of characters long) base64 string, as returned by a text
--! tool result, into its OWN next tool-call's `html` argument, it did NOT
--! faithfully reproduce it. It fabricated a short, syntactically-valid
--! but content-free JPEG (571 bytes, correct magic+EOI markers) instead
--! of copying the real ~30-70 KB file — an LLM cannot reliably
--! verbatim-reproduce large opaque binary-as-text payloads through its
--! own generation. The fix: never ask the model to touch base64 at all.
--! It only ever needs to write a short local file path (already handed
--! to it verbatim by icon_holen/bild_suchen) as a `LOCAL:`-prefixed
--! marker; substitution into real image bytes happens here, in plain
--! deterministic code, once per full HTML document.
--!
--! Uses the same path security boundary (resolve_muninn_path) and the
--! same extension-based MIME guessing (png/jpg/jpeg/webp/gif; unknown ->
--! png) as the old tool_bild_als_base64.
fn tool_bild_pfade_einbetten html
    marker: "LOCAL:"
    out: ""
    remaining: html
    idx: index_of remaining marker
    while idx >= 0
        out: out ++ (substring remaining 0 idx)
        after: substring remaining (idx + (len marker)) (len remaining)
        end_quote: index_of after "\""
        if end_quote < 0
            out: out ++ marker ++ after
            remaining: ""
        else
            path: substring after 0 end_quote
            rest: substring after end_quote (len after)
            full_path: resolve_muninn_path path
            if full_path != nil && (file_exists full_path)
                content: read_file full_path
                ext: lower (at (split full_path ".") ((len (split full_path ".")) - 1))
                mime: "image/png"
                if ext == "jpg" || ext == "jpeg"
                    mime: "image/jpeg"
                else if ext == "webp"
                    mime: "image/webp"
                else if ext == "gif"
                    mime: "image/gif"
                out: out ++ "data:" ++ mime ++ ";base64," ++ (base64_encode content)
            remaining: rest
        idx: index_of remaining marker
    out ++ remaining

--! Maximum character count for a voice message — reading aloud is meant
--! for short, casual replies, not long/content-heavy text (see the
--! FORMAT_RULE addendum below).
TTS_MAX_CHARS: 600

--! Runs the fixed Piper->ffmpeg pipeline (tts_synth.sh). None of its
--! parameters are AI-controllable except the text itself (voice/encoding
--! are hardwired in the script) — analogous to the docker_tools.pipe
--! pattern with a fixed command template instead of freely chosen flags.
fn tts_synthesize text
    dir: "/root/muninn/tts_tmp"
    id: (to_str now) ++ "_" ++ (to_str (random_range 100000 999999))
    txt_path: dir ++ "/" ++ id ++ ".txt"
    ogg_path: dir ++ "/" ++ id ++ ".ogg"
    write_file txt_path text
    r: exec ("/root/muninn/tts_synth.sh " ++ txt_path ++ " " ++ ogg_path)
    file_delete txt_path
    print ("tts_synthesize: exec-status=" ++ (to_str (get r "status")) ++ " ogg=" ++ ogg_path)
    if (get r "status") != 0
        print ("tts_synthesize FEHLGESCHLAGEN: " ++ (to_str (get r "output")))
        return {ok: false, ogg_path: nil, error: (get r "output")}
    if !(file_exists ogg_path)
        print ("tts_synthesize: Ausgabedatei fehlt: " ++ ogg_path)
        return {ok: false, ogg_path: nil, error: "Keine Ausgabedatei erzeugt."}
    print ("tts_synthesize OK: " ++ ogg_path)
    {ok: true, ogg_path: ogg_path, error: nil}

--! Tool: send text as a real voice message (instead of a text message) to
--! the user — local Piper synthesis, no cloud service/API key needed.
fn tool_sprachnachricht_senden text
    tok: get STATE "token"
    cid: get STATE "cid"
    if tok == nil || cid == nil
        return "Kein Telegram-Kontext verfuegbar, kann keine Sprachnachricht senden."
    if text == nil || (trim text) == ""
        return "Kein Text zum Vorlesen angegeben."
    spoken: text
    if (len spoken) > TTS_MAX_CHARS
        spoken: (substring spoken 0 TTS_MAX_CHARS) ++ "…"
    synth: tts_synthesize spoken
    if !(get synth "ok")
        print ("sprachnachricht_senden: Synthese-Fehler: " ++ (to_str (get synth "error")))
        return "Sprachsynthese fehlgeschlagen: " ++ (to_str (get synth "error"))
    ogg: get synth "ogg_path"
    res: tel.tel_send_voice tok cid ogg nil
    file_delete ogg
    print ("sprachnachricht_senden: sendVoice-Ergebnis ok=" ++ (to_str (get res "ok")) ++ " -> " ++ (tel.shorten_body (to_str res)))
    if (get res "ok") == false
        return "Senden der Sprachnachricht fehlgeschlagen: " ++ (to_str res)
    "Sprachnachricht gesendet."

--! Tool: starts a Docker setup that's allowed to take longer (e.g. package
--! installation), WITHOUT blocking the reply. 'docker run -d' returns as
--! soon as the container has STARTED — the actual setup then continues on
--! the Docker daemon, independent of the Muninn process. Creates a job
--! tracking entry and schedules a later check via the scheduler (job_check,
--! see sched_tick in muninn.pipe) — THAT is the "cronjob-like polling", not
--! a Pipe background thread (deliberately avoided, see the setup_sandbox
--! comment in muninn.pipe: a Pipe goroutine could have gotten in the way of
--! the per-message-rotating sandbox profile).
fn tool_docker_hintergrund_setup image name setup_command beschreibung
    tok: get STATE "token"
    cid: get STATE "cid"
    dbh: get STATE "dbh"
    if tok == nil || cid == nil || dbh == nil
        return "Kein Chat-/Datenbank-Kontext verfuegbar, kann kein Hintergrund-Setup starten."
    --! Deterministic duplicate-job guard — the prompt-only "check
    --! docker_job_status first" rule below was NOT reliably followed (see
    --! dt.running_job_for_chat's doc comment), so this refuses a second
    --! job outright instead of trusting the model to remember.
    existing: dt.running_job_for_chat dbh cid
    if existing != nil
        return "Es laeuft bereits ein Hintergrund-Job fuer diesen Chat (Container '" ++ (get existing "container_name") ++ "', gestartet " ++ (get existing "created") ++ ": " ++ (get existing "description") ++ ") — KEIN neuer Job wurde gestartet. Warte auf dessen automatische Rueckmeldung, oder rufe 'docker_job_status' fuer Details auf. Soll wirklich etwas anderes/paralleles laufen, muss der laufende Job erst per 'docker_jobs_abbrechen' beendet werden."
    start_res: dt.tool_docker_setup_starten image name setup_command
    if !(get start_res "ok")
        return "Setup konnte nicht gestartet werden: " ++ (get start_res "message")
    real_name: get start_res "name"
    jid: dt.create_job dbh cid real_name beschreibung
    due: now + 180
    sched.schedule dbh "job_check" cid (to_str jid) due "5min"
    "Setup gestartet (Container '" ++ real_name ++ "'). Ich melde mich automatisch, sobald es fertig ist — du musst nicht warten."

--! Tool (werkzeug_docker): fetch the status of the most recently started
--! background Docker jobs for this chat — see docker_tools.pipe for the
--! live finding that made this necessary (repeated parallel duplicate
--! jobs).
fn tool_docker_job_status _
    dbh: get STATE "dbh"
    cid: get STATE "cid"
    if dbh == nil || cid == nil
        return "Kein Chat-/Datenbank-Kontext verfuegbar."
    dt.tool_docker_job_status dbh cid

--! Tool (registrator): IMMEDIATELY cancels all running background Docker
--! jobs AND scheduled background continuations (job_check/task_check) for
--! this chat — a safety net for natural-language cancellation requests
--! mid-conversation; /stop (muninn.pipe) is the RELIABLE, deterministic
--! main path that never depends on an AI decision. See RESULT_HONESTY_RULE:
--! this tool MUST actually be called, a cancellation must NEVER just be
--! claimed (observed live: the AI said "everything cancelled" twice, but
--! started a new job in the same breath, because there simply wasn't a real
--! cancellation tool before).
fn tool_docker_jobs_abbrechen _
    dbh: get STATE "dbh"
    cid: get STATE "cid"
    if dbh == nil || cid == nil
        return "Kein Chat-/Datenbank-Kontext verfuegbar."
    cancelled: dt.cancel_all_running dbh (to_str cid)
    n_sched: 0
    for r in (sched.list dbh (to_str cid))
        if (get r "kind") == "job_check" || (get r "kind") == "task_check"
            sched.cancel dbh (get r "id")
            n_sched: n_sched + 1
    "Abgebrochen: " ++ (to_str (len cancelled)) ++ " laufende(r) Docker-Hintergrund-Job(s) (Container entfernt), " ++ (to_str n_sched) ++ " geplante Fortsetzung(en) storniert."

--! Tool (werkzeug_docker): registers a container as a persistent, reusable
--! environment — see the comment at
--! docker_tools.pipe:tool_docker_environment_registrieren for the
--! distinction from one-off docker_hintergrund_setup jobs.
fn tool_docker_environment_registrieren container_name purpose installed
    dbh: get STATE "dbh"
    cid: get STATE "cid"
    if dbh == nil || cid == nil
        return "Kein Chat-/Datenbank-Kontext verfuegbar."
    dt.tool_docker_environment_registrieren dbh cid container_name purpose installed

--! Tool (werkzeug_docker): lists registered persistent environments.
fn tool_docker_environments_auflisten _
    dbh: get STATE "dbh"
    cid: get STATE "cid"
    if dbh == nil || cid == nil
        return "Kein Chat-/Datenbank-Kontext verfuegbar."
    dt.tool_docker_environments_auflisten dbh cid

--! Tool (werkzeug_docker): removes a registered persistent environment.
fn tool_docker_environment_entfernen container_name
    dbh: get STATE "dbh"
    cid: get STATE "cid"
    if dbh == nil || cid == nil
        return "Kein Chat-/Datenbank-Kontext verfuegbar."
    dt.tool_docker_environment_entfernen dbh cid container_name

--! Tool (registrator only): defers ANY task that obviously needs more
--! time/more rounds than are left in this one gremium run — not just
--! Docker (see tool_docker_hintergrund_setup for the SPECIFIC, cheaper-to-
--! check case). Creates a progress checkpoint and schedules a continuation
--! via the scheduler: on the next tick the gremium gets a FRESH round
--! budget and continues working with the saved progress (see sched_tick in
--! muninn.pipe, branch "task_check"). Can be called AGAIN if there still
--! isn't enough time — this creates a chain of as many continuations as
--! needed until the task is truly done.
fn tool_hintergrund_fortsetzen zusammenfassung fortschritt
    cid: get STATE "cid"
    dbh: get STATE "dbh"
    if cid == nil || dbh == nil
        return "Kein Kontext verfuegbar, kann nicht im Hintergrund fortsetzen."
    if zusammenfassung == nil || (trim zusammenfassung) == ""
        return "Zusammenfassung der Aufgabe fehlt."
    task_id: sched.create_background_task dbh cid zusammenfassung fortschritt
    due: now + 120
    sched.schedule dbh "task_check" cid (to_str task_id) due ""
    "Hintergrund-Fortsetzung eingeplant (#" ++ (to_str task_id) ++ "). Antworte dem Nutzer JETZT kurz, dass du weiterarbeitest und dich automatisch meldest, sobald fertig — behaupte NICHT, dass die Aufgabe schon fertig ist."

--! URL encoding for the prompt part of the Pollinations image URL (the
--! standard urlencode above in telegram.pipe is private/not importable
--! there, hence its own small variant with the special characters relevant
--! for image prompts).
fn pollinations_urlencode s
    s: replace_all s "%" "%25"
    s: replace_all s " " "%20"
    s: replace_all s "\"" "%22"
    s: replace_all s "#" "%23"
    s: replace_all s "&" "%26"
    s: replace_all s "'" "%27"
    s: replace_all s "+" "%2B"
    s: replace_all s "," "%2C"
    s: replace_all s "/" "%2F"
    s: replace_all s ":" "%3A"
    s: replace_all s ";" "%3B"
    s: replace_all s "=" "%3D"
    s: replace_all s "?" "%3F"
    s

--! Calls Pollinations.ai's open image URL API — free, NO API key needed
--! (anonymous use allowed per the official docs, about 1 request/15s,
--! possibly a small watermark). Tested live: the actual MCP server
--! distributed via npm now requires a key, but the underlying classic HTTP
--! API (image.pollinations.ai/prompt/...) still doesn't. http_request
--! instead of http_get: 30s instead of 10s timeout — a fresh, never-before-
--! generated prompt was observed live to need up to ~6s, a single 10s
--! timeout hiccup occurred once live.
fn pollinations_generate prompt width height
    seed: random_range 100000 999999
    url: "https://image.pollinations.ai/prompt/" ++ (pollinations_urlencode prompt) ++ "?width=" ++ (to_str width) ++ "&height=" ++ (to_str height) ++ "&seed=" ++ (to_str seed) ++ "&nologo=true"
    r: http_request "GET" url {}
    if (get r "status") != 200
        return {ok: false, path: nil, error: "HTTP " ++ (to_str (get r "status")) ++ " from Pollinations.ai"}
    body: get r "body"
    if body == nil || (len body) < 100
        return {ok: false, path: nil, error: "Empty or invalid image response."}
    path: "/root/muninn/mcp_data/bild_" ++ (to_str now) ++ "_" ++ (to_str seed) ++ ".jpg"
    write_file path body
    {ok: true, path: path, error: nil}

--! Tool: generate an image via AI (Pollinations.ai, free, no API key) from
--! a text description AND send it directly to the user — generating and
--! sending deliberately combined into ONE tool call (analogous to
--! tool_sprachnachricht_senden), so the AI can't wrongly chain this as two
--! separate steps (e.g. generate an image but pass the wrong path when
--! sending it).
fn tool_bild_erstellen prompt
    tok: get STATE "token"
    cid: get STATE "cid"
    if tok == nil || cid == nil
        return "Kein Telegram-Kontext verfuegbar, kann kein Bild erstellen/senden."
    if prompt == nil || (trim prompt) == ""
        return "Keine Bildbeschreibung angegeben."
    gen: pollinations_generate prompt 1024 1024
    if !(get gen "ok")
        return "Bildgenerierung fehlgeschlagen: " ++ (to_str (get gen "error"))
    path: get gen "path"
    res: tel.tel_send_photo tok cid path nil
    file_delete path
    if (get res "ok") == false
        return "Bild erstellt, aber Senden fehlgeschlagen: " ++ (to_str res)
    "Bild erstellt und gesendet."

--! Registers tools and gremium agents (once at startup). Additionally
--! binds all MCP tools already connected via mcp.connect_servers
--! (filesystem, GitHub, ...) to their own "werkzeugmeister" agent (P1).
export fn init_gremium _
    ai_tool "erinnerungen_suchen" "Fetch relevant memories from Muninn's long-term memory to support facts." {query: "Search query"} tool_erinnerungen_suchen
    ai_tool "merken" "Store an important, permanent piece of information about the user." {content: "Content", kind: "Category"} tool_merken
    ai_tool "web_search" "Search the internet; returns titles and URLs of the top results." {query: "Search terms"} tool_web_search
    ai_tool "web_fetch" "Fetch a web page and return its body text." {url: "Full URL"} tool_web_fetch
    ai_tool "merken_quelle" "Permanently store a piece of information obtained from the web, with its source URL." {content: "Information", source: "Source URL"} tool_merken_quelle
    ai_tool "erinnerung_planen" "Schedule a time-based reminder for the user (e.g. for appointments/obligations with a time reference)." {text: "What should be remembered, including a time reference in natural language"} tool_erinnerung_planen
    --! Deliberately restricted Docker extension (pull image, create
    --! container) — see docker_tools.pipe for the security rationale.
    --! Complements the "docker" MCP server (which only manages EXISTING
    --! containers).
    ai_tool "docker_pull_image" "Download a Docker image from a registry (e.g. 'nginx:latest')." {image: "Image name incl. optional tag"} dt.tool_docker_pull_image
    ai_tool "docker_create_container" "Start a new container from an image. NO volume mounts possible, NO --privileged. Reachable on localhost only by default (public='true' for public, only if explicitly requested)." {image: "Image name (pull with docker_pull_image first if needed)", name: "Container name", host_port: "Port on the host", container_port: "Port inside the container", public: "'true' to be publicly reachable, otherwise localhost only"} dt.tool_docker_create_container
    ai_tool "docker_hintergrund_setup" "Start a Docker setup that's allowed to take LONGER (e.g. package installation) — does NOT block, automatically reports back via the scheduler once done. For a quick container from a ready-made image, use 'docker_create_container' instead." {image: "Image name (base image, e.g. 'ubuntu:22.04')", name: "Container name", setup_command: "Shell command(s) run INSIDE the container (e.g. package installation) — && allowed, runs isolated inside the container", beschreibung: "Short description of the task for the later report-back"} tool_docker_hintergrund_setup
    ai_tool "docker_job_status" "Shows the status of the most recently started background Docker jobs for this chat. ALWAYS call first before starting a new job for a task that a job COULD already be running for (e.g. after an error message or on 'how far along are you') — NEVER blindly start a second, parallel job for the same task." {} tool_docker_job_status
    ai_tool "docker_jobs_abbrechen" "IMMEDIATELY cancels all running background Docker jobs AND scheduled background continuations for this chat (containers are removed, scheduler entries cancelled)." {} tool_docker_jobs_abbrechen
    ai_tool "docker_environments_auflisten" "Shows registered PERSISTENT, reusable Docker environments for this chat (name, purpose, installed tools). ALWAYS call first before creating a NEW container for a request that just needs some Linux/Docker environment — check whether an existing environment already fits." {} tool_docker_environments_auflisten
    ai_tool "docker_environment_registrieren" "Registers a container as a persistent, reusable environment (name, purpose, installed tools) — ONLY for containers deliberately meant to run longer/permanently (e.g. a test/dev environment), NOT for one-off test/build runs (which 'docker_hintergrund_setup' already tracks itself and which are meant to finish/be cleaned up)." {container_name: "Name of the running container", purpose: "What this environment is for (short, concrete)", installed: "What is installed (language/version, tools, packages)"} tool_docker_environment_registrieren
    ai_tool "docker_environment_entfernen" "Removes a registered persistent environment (container AND registration) — when the user says they no longer need it." {container_name: "Name of the environment to remove"} tool_docker_environment_entfernen
    --! Send images/files to the user (e.g. a screenshot that
    --! werkzeug_browser saved locally, or a file created via the
    --! filesystem tool) — without this, Muninn can only talk ABOUT files
    --! but not actually send them.
    ai_tool "bild_senden" "Send an image (screenshot or similar) from a local file to the user on Telegram (shows inline in the chat)." {path: "Path to the image file (relative to /root/muninn or absolute)", caption: "Optional caption"} tool_bild_senden
    ai_tool "datei_senden" "Send any local file to the user on Telegram (as a file attachment, original format)." {path: "Path to the file (relative to /root/muninn or absolute)", caption: "Optional description"} tool_datei_senden
    ai_tool "sprachnachricht_senden" "Send text as a spoken voice message (instead of a text message) to the user — local speech synthesis, no cloud service." {text: "The text to speak (keep it short, max. ~600 characters — no links/lists/code, those don't make sense spoken aloud)"} tool_sprachnachricht_senden
    ai_tool "bild_erstellen" "Generate a NEW image from a text description via AI and send it directly to the user (free, no API key). NOT for already-existing files/screenshots — use 'bild_senden' for that." {prompt: "Detailed image description in English (better results than German)"} tool_bild_erstellen
    ai_tool "hintergrund_fortsetzen" "Defer ANY task that visibly needs more time/rounds than are currently left (not just Docker) — Muninn automatically continues with a fresh round budget and reports back once done. Can be called multiple times in a row if needed." {zusammenfassung: "Short summary of the original task", fortschritt: "What has been done so far and what remains, as concrete as possible"} tool_hintergrund_fortsetzen
    ai_tool "rezept_speichern" "Permanently store a reusable workflow recipe (a proven sequence of steps for a recurring task)." {name: "Short, unique recipe name", schritte: "The individual steps in order, concrete and actionable"} tool_rezept_speichern
    ai_tool "rezepte_suchen" "Fetch stored workflow recipes, to solve recurring tasks following a proven pattern." {query: "Keywords about the task"} tool_rezepte_suchen
    ai_tool "bericht_veroeffentlichen" "Publish a long text (research summary, report, article) as a Telegraph page instead of sending it as plain text (which gets cut off at Telegram's length limit) — Telegram shows Telegraph pages with its fast, native-feeling Instant View reader." {title: "Short, descriptive page title", text: "The full text, paragraphs separated by a blank line"} tool_bericht_veroeffentlichen
    ai_tool "icon_holen" "Find a free, open-source icon (200'000+ icons, no API key) matching a search term and save it as a ready-to-use PNG file — for embedding into a presentation/document (werkzeug_praesentation/werkzeug_dokument) or sending directly." {suchbegriff: "What the icon should show, in English (e.g. 'chart', 'warning', 'github', 'email')", farbe: "Optional hex color e.g. '#ff6600' — empty/omit for the icon's default color", groesse: "Optional pixel size, e.g. '128' — empty/omit for 128"} tool_icon_holen
    ai_tool "bild_pfade_einbetten" "For werkzeug_slideshot ONLY. Call this ONCE, after authoring the FULL HTML document, with the complete html as-is (containing one or more <img src=\"LOCAL:<path>\"> markers using paths from icon_holen/bild_suchen). Returns the same HTML with every LOCAL: marker deterministically replaced by the real embedded image data — use the RETURNED html (not your original) as the html argument for slideshot_create_slides. NEVER try to write or copy base64/data:image data yourself — that reliably fails; always go through this tool instead." {html: "The full HTML document, containing LOCAL:<path> markers in <img src=\"...\">"} tool_bild_pfade_einbetten
    ai_tool "bild_suchen" "Search for a REAL photo on the internet (not a simple line icon — use icon_holen for those, or bild_erstellen for a fully AI-generated image) and download it as a local file, ready to embed (e.g. as a LOCAL: marker via bild_pfade_einbetten into a Slideshot slide). Free, no API key, license-filtered to reuse-friendly images." {suchbegriff: "What the photo should show, in English (e.g. 'mountain landscape', 'office team meeting', 'coffee cup')"} tool_bild_suchen
    ai_tool "workspace_erstellen" "Create a new, reusable workspace subfolder under mcp_data — a named place to keep everything about one ongoing topic/project together, instead of every file landing loose in mcp_data's root. Only for a genuinely ongoing/multi-file topic, not a one-off single file." {name: "Short, lowercase workspace name (letters/digits/_/-/. only, becomes the actual folder name)", zweck: "What this workspace is for"} tool_workspace_erstellen
    ai_tool "workspaces_auflisten" "List active workspaces (name + purpose) — check this FIRST before creating a new file for a request about an existing topic/project, so related work lands together instead of scattered across mcp_data." {} tool_workspaces_auflisten
    ai_tool "ziel_anlegen" "Create a long-term goal (a genuine ongoing objective the user wants to work towards over time — NOT a one-off task that's finished once this conversation ends). Shows up in /goals on Telegram and the web dashboard." {text: "Short, clear description of the goal"} tool_ziel_anlegen
    ai_tool "ziel_erledigt" "Mark a previously created goal as done, by its id." {id: "The goal's id"} tool_ziel_erledigt
    --! Lazy MCP loading (see the doc comment at tool_werkzeug_aktivieren):
    --! only 'planer' gets this tool — it's the router that sees the
    --! "available but inactive" list built below and decides handoffs.
    ai_tool "werkzeug_aktivieren" "Activates a configured-but-not-yet-connected MCP specialist by alias, from the 'additionally available but NOT currently active' list below. Takes effect on the NEXT attempt at this task, NEVER this same round — after calling this, hand off normally to whichever agent can already help with what's possible right now, do not wait/retry yourself." {alias: "The exact alias from the inactive list, e.g. 'docker'"} tool_werkzeug_aktivieren
    ai_tool "mcp_registry_suchen" "Search the OFFICIAL MCP server registry (registry.modelcontextprotocol.io) — the ONLY correct way to answer ANY question about what MCP servers/tools/integrations exist or could be added to Muninn, including open-ended browsing ('what MCP servers could we add') just as much as a specific missing capability. NEVER use 'web_search' for this — general web results are outdated, unreliable blog rankings, not the real registry. For an open-ended request, call this multiple times with different relevant search terms instead of just one. Also check the 'available but inactive' list first — no need to search for something already configured. Only returns servers Muninn could actually connect to (npm/stdio) and that need no extra API key setup. Use 'mcp_server_vorschlagen' afterward to propose adding one you found — NEVER claim you've found/added/connected something without actually having called these tools." {query: "What kind of tool/service you're looking for, e.g. 'weather', 'slack'"} tool_mcp_registry_suchen
    ai_tool "mcp_server_vorschlagen" "Propose adding a NEW MCP server you found via 'mcp_registry_suchen' — sends the user a message with Yes/No buttons. NEVER connects or persists anything by itself; only the user's own button tap does that. Call this only after a real registry search found a concrete npm/stdio match, never speculatively or from general knowledge." {alias: "Short, unique alias for the new server, e.g. 'weather'", name: "The server's name from the registry result", beschreibung: "One short sentence on what it does", npm_paket: "The exact npm package identifier from the registry result"} tool_mcp_server_vorschlagen

    local_names: ["erinnerungen_suchen", "merken", "web_search", "web_fetch", "merken_quelle", "erinnerung_planen", "docker_pull_image", "docker_create_container", "docker_hintergrund_setup", "docker_job_status", "docker_jobs_abbrechen", "docker_environments_auflisten", "docker_environment_registrieren", "docker_environment_entfernen", "bild_senden", "datei_senden", "hintergrund_fortsetzen", "rezept_speichern", "rezepte_suchen", "ziel_anlegen", "ziel_erledigt", "bericht_veroeffentlichen", "icon_holen", "werkzeug_aktivieren", "mcp_registry_suchen", "mcp_server_vorschlagen"]
    --! P5: ONE focused specialist agent PER connected MCP server instead of
    --! a jack-of-all-trades with every tool — automatically scales with
    --! every new MCP server (no code rework needed), and keeps the AI's
    --! tool selection per agent small and accurate, instead of overwhelming
    --! it with one huge flat list across very many tools.
    mcp_groups: mcp.discovered_tools_by_source local_names
    has_mcp: (len mcp_groups) > 0
    --! Lazy MCP loading: not every configured server is connected yet (see
    --! muninn.pipe's setup_core/ensure_mcp_for_task/werkzeug_aktivieren
    --! above) — list the ones that AREN'T, so planer/faktenwaechter/
    --! registrator know they exist and can activate one via
    --! 'werkzeug_aktivieren' instead of wrongly claiming a capability
    --! doesn't exist at all just because it isn't active THIS moment.
    inactive_desc: ""
    for s in (get STATE "available_servers")
        a: get s "alias"
        if a != nil && a != "" && !(mcp.is_connected a)
            kw: get s "keywords"
            kw_text: ""
            if kw != nil && (len kw) > 0
                kw_text: " (" ++ (join kw ", ") ++ ")"
            inactive_desc: inactive_desc ++ "- '" ++ a ++ "'" ++ kw_text ++ "\n"
    mcp_names: []
    specialist_names: []
    specialist_desc: ""
    --! Two-pass build: on the first pass, specialist_names is only
    --! PARTIALLY filled (grows with every iteration) — a specialist that
    --! comes early in mcp_groups would therefore NOT be able to hand off to
    --! specialists registered later if registered directly. Collect
    --! metadata first, THEN register with the complete list on the second
    --! pass — otherwise e.g. 'werkzeug_google' (Gmail search) can't hand
    --! off directly to 'werkzeug_dokument' (write a report) once its work
    --! is done, if 'dokument' only appears LATER in mcp_groups (observed
    --! live: "search invoices from emails and write a report about them"
    --! failed exactly because of this).
    specialist_meta: []
    for grp in mcp_groups
        alias: get grp "alias"
        if (len alias) > 0 && (substring alias ((len alias) - 1) (len alias)) == "_"
            alias: substring alias 0 ((len alias) - 1)
        gtools: get grp "tools"
        for tn in gtools
            push mcp_names tn
        extra_note: ""
        if alias == "docker"
            --! Only the Docker specialist additionally gets the local,
            --! restricted image-pull/create-container tools (see
            --! docker_tools.pipe) — the MCP tools from '" ++ alias ++ "'
            --! can't do that, they only manage existing containers.
            push gtools "docker_pull_image"
            push gtools "docker_create_container"
            push gtools "docker_hintergrund_setup"
            push gtools "docker_job_status"
            push gtools "docker_jobs_abbrechen"
            push gtools "docker_environments_auflisten"
            push gtools "docker_environment_registrieren"
            push gtools "docker_environment_entfernen"
            extra_note: " Zusaetzlich hast du 'docker_pull_image' und 'docker_create_container' fuer neue Container/Images — dabei gibt es KEINE Volume-Mounts und KEIN --privileged, das ist Absicht (Sicherheit), nicht ein fehlendes Feature; biete das dem Nutzer nicht als moeglich an. Neue Container sind standardmaessig nur auf localhost erreichbar, ausser der Nutzer will es ausdruecklich oeffentlich (dann public='true'). Geht es um ein Setup, das LAENGER dauern koennte (z.B. Pakete installieren, ein System einrichten — nicht nur ein fertiges Image direkt starten), nutze STATTDESSEN 'docker_hintergrund_setup': das blockiert NICHT, sondern meldet sich automatisch, sobald fertig — rufe es auf, gib die 'gestartet, ich melde mich automatisch'-Rueckmeldung direkt an den Nutzer weiter, und warte/frage NICHT selbst nach, ob es fertig ist. GITHUB-REPO KLONEN UND TESTEN: verlangt der Nutzer, ein GitHub-Repo herunterzuladen/zu testen/auszufuehren, nutze GENAU DAFUER 'docker_hintergrund_setup' — kein separates Werkzeug noetig. Waehle ein passendes Basis-Image nach der erkennbaren Sprache des Projekts — nutze IMMER die 'floating' Major-Version-Tags ('node:lts-alpine' fuer JavaScript/TypeScript, 'python:3-slim' fuer Python, 'golang:1-alpine' fuer Go, 'rust:1-slim' fuer Rust, 'eclipse-temurin:21-jdk' fuer Java/Kotlin/Maven/Gradle), NIEMALS eine geratene spezifische Minor-Version (z.B. NICHT 'golang:1.22-alpine') — live beobachtet: eine geratene, zu alte Go-Version scheiterte an 'go.mod requires go >= 1.25.0', bevor die Tests ueberhaupt liefen. Baue setup_command als EINE Kette: zuerst git installieren (Alpine: 'apk add --no-cache git', Debian/Ubuntu-Basis: 'apt-get update -qq && apt-get install -y -qq git'), dann 'GIT_TERMINAL_PROMPT=0 git clone --depth 1 <repo-url> /repo && cd /repo && <Installationsbefehl> && <Testbefehl>' (z.B. 'npm install && npm test', 'pip install -r requirements.txt && pytest', 'go test ./...', 'cargo test'). Ist das Projekt in seinem README/Makefile erkennbar anders aufgebaut (z.B. anderer Testbefehl, extra Setup-Schritte), passe die Befehlskette entsprechend an — bei Unsicherheit erst kurz 'web_fetch' auf die rohe Makefile-/README-URL nutzen statt einen Build-Befehl zu erraten. Das laeuft VOLLSTAENDIG isoliert im Container (kein Volume-Mount, kein Zugriff auf den Host) — Testfehler/Abstuerze/Nebenwirkungen IM Container sind unproblematisch und erwartbar, dafuer ist die Docker-Isolation da; es gibt bewusst KEIN Zeit-/Ressourcenlimit fuer den Testlauf selbst. Nach Abschluss meldet sich Muninn automatisch mit den ECHTEN Container-Logs (Testausgabe, siehe job_check in muninn.pipe) — erfinde NIE Testergebnisse, warte auf die echte Rueckmeldung. BEVOR du 'docker_hintergrund_setup' fuer eine Aufgabe (er)neut aufrufst — egal ob als Reaktion auf eine Fehlermeldung oder eine Rueckfrage wie 'wie weit bist du' —, rufe IMMER ZUERST 'docker_job_status' auf: laeuft dafuer schon ein Job (Status 'running'), warte auf dessen automatische Rueckmeldung statt EINEN ZWEITEN, PARALLELEN Job fuer dieselbe Aufgabe zu starten (live beobachtet: zwei gleichzeitig laufende Jobs fuer dieselbe Anfrage, weil jede Rueckfrage einen weiteren Versuch ausloeste). NIEMALS 'docker_remove_container' oder 'docker_stop_container' (MCP-Werkzeuge aus 'docker') auf einem per 'docker_hintergrund_setup' gestarteten Container aufrufen, solange dessen Job noch 'running' ist — job_check erledigt Fertigstellungs-Erkennung UND Aufraeumen automatisch; ein manuelles Entfernen zerstoert die Job-Verfolgung, die Ergebnisse gehen verloren UND job_check meldet danach faelschlich einen Fehlschlag. Will der Nutzer einen laufenden Job WIRKLICH abbrechen, nutze STATTDESSEN 'docker_jobs_abbrechen'. BESTEHENDE UMGEBUNGEN WIEDERVERWENDEN STATT IMMER NEU ANZULEGEN: verlangt eine Anfrage NUR 'irgendeine Linux-/Docker-Umgebung' (z.B. 'gib mir eine Shell zum Ausprobieren', 'richte mir eine Testumgebung ein', ohne dass es um ein NEUES, spezifisches Setup wie 'installiere X' oder einen einmaligen Repo-Test geht), rufe ZUERST 'docker_environments_auflisten' auf — passt eine bestehende registrierte Umgebung zum Zweck, nutze SIE (per 'docker_exec_command' aus den MCP-Werkzeugen aus 'docker' direkt Befehle darin ausfuehren), STATT reflexartig einen neuen Container anzulegen. Nur wenn keine passende existiert oder der Nutzer ausdruecklich eine NEUE/andere Umgebung will, lege einen neuen Container an ('docker_create_container' fuer schnelle Faelle, 'docker_hintergrund_setup' wenn Einrichtung laenger dauert). Ist der neu angelegte Container als DAUERHAFTE, wiederverwendbare Umgebung gedacht (nicht ein einmaliger Test-/Build-Lauf!), rufe danach 'docker_environment_registrieren' mit Name, Zweck und installierten Tools auf, damit du (und spaetere Anfragen) ihn wiederfinden und wiederverwenden koennen. Registriere NIEMALS einmalige Repo-Test-/Build-Container ueber 'docker_hintergrund_setup' — die sollen fertig werden, gemeldet und aufgeraeumt werden (siehe job_check), nicht als wiederverwendbare Umgebung erscheinen."
        if alias == "google"
            google_email: get STATE "google_email"
            if google_email == nil || google_email == ""
                extra_note: " No Google account is configured for this Muninn instance (USER_GOOGLE_EMAIL missing from the 'google' MCP server's env) — tell the user honestly that Gmail/Drive/Calendar tools need a configured Google account before they can be used."
            else
                extra_note: " The user's Google account is " ++ google_email ++ " — pass this as 'user_google_email' on EVERY Gmail/Drive/Calendar tool call, it is never filled in automatically. If a tool reports missing login/authorization, call 'start_google_auth' IMMEDIATELY (service_name e.g. 'gmail') and pass the returned Google consent URL VERBATIM to the user so they can open it in a browser — NEVER claim that connecting the Google account isn't possible. The user has knowingly granted full Gmail send access as well as full read/write access to Drive and Calendar."
        if alias == "praesentation"
            --! Ohne diese Anleitung verliert sich die KI im grossen
            --! Vorlagen-/Template-Werkzeugsatz (create_presentation_from_templates,
            --! populate_placeholder, manage_text, ...) und erreicht
            --! save_presentation oft gar nicht mehr, bevor die Rundenzahl
            --! aufgebraucht ist (live beobachtet: 18 Runden, viele
            --! Tool-Experimente, nie gespeichert). Der simple 3-Schritt-Pfad
            --! (create -> add_slide pro Folie -> save) ist isoliert getestet
            --! zuverlaessig und schnell.
            push gtools "icon_holen"
            push gtools "workspace_erstellen"
            push gtools "workspaces_auflisten"
            extra_note: " Bevor du file_path waehlst: rufe 'workspaces_auflisten' auf — existiert ein zum Thema passender Workspace, speichere dort ('/root/muninn/mcp_data/<workspace>/<name>.pptx') statt lose in mcp_data; ist die Aufgabe erkennbar ein laufendes/mehrteiliges Projekt ohne passenden Workspace, kannst du mit 'workspace_erstellen' einen anlegen. Sonst wie bisher direkt unter mcp_data. Nutze IMMER den einfachen Weg: 'ppt_create_presentation' EINMAL aufrufen (liefert eine presentation_id), dann pro gewuenschter Folie 'ppt_add_slide' mit presentation_id+title+content, zum Schluss GENAU EINMAL 'ppt_save_presentation' mit presentation_id und file_path (IMMER unter '/root/muninn/mcp_data/<sprechender-name>.pptx'). Nutze NICHT das Vorlagen-/Template-System (create_presentation_from_templates, populate_placeholder, manage_text) — das braucht viel mehr Schritte und fuehrt oft dazu, dass die Praesentation nie gespeichert wird. Passt ein Icon thematisch zu einer Folie (z.B. ein Diagramm-Symbol fuer Zahlen, ein Warnsymbol fuer Risiken), hole es VORHER mit 'icon_holen' (liefert einen lokalen PNG-Pfad) und fuege es per 'ppt_manage_image' ein — optional, nur wenn es die Folie wirklich verbessert, nicht bei jeder Folie erzwingen. Danach uebergib an 'kritiker' — der Registrator schickt die fertige Datei per 'datei_senden'; du selbst hast dieses Werkzeug nicht."
        if alias == "github"
            extra_note: " Werkzeuge mit Praefix 'github_'. Bei Fragen nach dem eigenen Account/Identitaet/Berechtigungen ('wem gehoert der Token', 'welcher Account') rufe 'github_get_me' auf, statt aus Repo-Suchergebnissen zu raten. 'github_list_*' fuer breites Durchsuchen mit einfachen Filtern (z.B. alle offenen Issues), 'github_search_*' fuer gezielte Anfragen mit Stichworten/Kriterien. Neue Issues/PRs: 'github_search_issues' bzw. 'github_search_pull_requests' VORHER nutzen, um Duplikate zu vermeiden. Repo/Owner immer explizit erfragen oder aus dem Gespraech ableiten — NIE raten. Aenderungen an bestehendem Code/Dateien immer ueber 'github_get_file_contents' (aktuellen Inhalt/SHA holen) vor 'github_create_or_update_file', nicht blind ueberschreiben."
        if alias == "dokument"
            push gtools "icon_holen"
            push gtools "workspace_erstellen"
            push gtools "workspaces_auflisten"
            extra_note: " Bevor du filename waehlst: rufe 'workspaces_auflisten' auf — existiert ein zum Thema passender Workspace, speichere dort ('/root/muninn/mcp_data/<workspace>/<name>.docx') statt lose in mcp_data; ist die Aufgabe erkennbar ein laufendes/mehrteiliges Projekt ohne passenden Workspace, kannst du mit 'workspace_erstellen' einen anlegen. Sonst wie bisher direkt unter mcp_data. Nutze 'word_create_document' EINMAL mit filename (IMMER unter '/root/muninn/mcp_data/<sprechender-name>.docx') — das legt die Datei direkt an, KEIN separater Speicher-Schritt noetig. Danach 'word_add_heading'/'word_add_paragraph' etc. mit demselben filename pro Abschnitt — jeder Aufruf schreibt sofort in die Datei. 'word_convert_to_pdf' NUR wenn der Nutzer ausdruecklich ein PDF wollte (nicht von dir aus versuchen — auf diesem Server ist dafuer kein LibreOffice/Word installiert, der Versuch schlaegt IMMER fehl und bringt nur eine unnoetige Fehlermeldung). Passt ein Icon thematisch zu einem Abschnitt, hole es VORHER mit 'icon_holen' (liefert einen lokalen PNG-Pfad) und fuege es per 'word_add_picture' ein — optional, nur wenn es das Dokument wirklich verbessert. Danach uebergib an 'kritiker' — der Registrator schickt die fertige Datei per 'datei_senden'; du selbst hast dieses Werkzeug nicht."
        if alias == "slideshot"
            --! Live per direktem tool_call gegen den echten Server
            --! (slideshot-mcp) verifiziertes Protokoll — ohne diese
            --! Anleitung improvisiert die KI jedes Mal neu und produziert
            --! inkonsistente Fehler (falsches Seitenverhaeltnis,
            --! abgeschnittener Text, uebersprungene Zwischenschritte),
            --! live beobachtet ueber mehrere unabhaengige Sessions. Der
            --! Server ist fuer einen INTERAKTIVEN Client mit Rueckfrage-UI
            --! gebaut (seine eigenen Tool-Antworten verlangen woertlich
            --! "STOP. WAIT for the user..." vor jedem Schritt) — das gibt
            --! es in Muninns autonomem Gremiums-Lauf nicht, deshalb muss
            --! das hier explizit uebersteuert werden.
            push gtools "icon_holen"
            push gtools "bild_pfade_einbetten"
            push gtools "bild_suchen"
            extra_note: " WICHTIGER HINWEIS: Die Tool-Antworten von slideshot_* verlangen an mehreren Stellen woertlich, auf eine Nutzer-Bestaetigung zu warten ('STOP. WAIT for the user...') — das ist fuer einen interaktiven Client gedacht, den es hier NICHT gibt. Arbeite STATTDESSEN alle Schritte OHNE echte Zwischen-Pause durch, die urspruengliche Anfrage IST bereits die Bestaetigung. Exakte Schrittfolge: (1) 'slideshot_discover_themes' aufrufen (liefert Themen/Formate). (2) 'slideshot_create_slides' mit NUR theme+mode:'default' aufrufen (noch OHNE html) — die Antwort enthaelt ein CSS-Template und ein 'dimensions'-Feld mit der exakten Ziel-Pixelgroesse. (3) Ein vollstaendiges HTML-Dokument selbst verfassen: pro Folie ein Element mit class='slide', GENAU in der von Schritt 2 gelieferten 'dimensions'-Groesse (niemals eine Groesse raten oder das 'portrait'-Preset annehmen), mit 'overflow:hidden' und ausreichend Innenabstand (gegen abgeschnittenen Text — Inhalt an der tatsaechlichen Textmenge ausrichten, nicht starr positionieren) UND genug freiem Platz/Abstand um jedes eingebettete Bild (ein Icon darf NIE Ueberschrift/Text ueberlappen — reserviere sichtbaren Rand um jedes <img>, z.B. per margin/eigenem Container statt reiner position:absolute-Ueberlagerung). Soll ein 9:16-Format geliefert werden (haeufigster Wunsch), gibt es dafuer KEIN eingebautes Preset ('portrait' ist 4:5, NICHT 9:16!) — in Schritt 2 explizit orientation:'custom' mit width:1080, height:1920 uebergeben. Fuer ein einzubettendes Bild IMMER zuerst die Datei besorgen (ein passendes Icon von 'icon_holen', oder ein ECHTES Foto aus dem Internet von 'bild_suchen' — z.B. wenn der Nutzer ein echtes Foto statt nur eines Icons will) und den zurueckgegebenen lokalen Pfad als 'LOCAL:<pfad>' in <img src=\"...\"> ins HTML einsetzen, z.B. <img src=\"LOCAL:/root/muninn/mcp_data/images/foo.jpg\">. Versuche NIEMALS, selbst eine 'data:image'-URI oder Base64-Zeichen zu schreiben oder aus einem Tool-Ergebnis abzutippen/zu kopieren — das schlaegt strukturell zuverlaessig fehl (ein Sprachmodell kann so einen langen Zeichenblock nicht fehlerfrei reproduzieren) und ergibt ein kaputtes Bild-Symbol im fertigen Slide; der 'LOCAL:'-Marker mit dem KURZEN Dateipfad ist der einzig richtige Weg. (4) Ist das komplette HTML fertig verfasst, EINMAL 'bild_pfade_einbetten' mit dem GESAMTEN html-String aufrufen (nicht pro Bild einzeln) — er ersetzt automatisch jeden 'LOCAL:'-Marker durch die echten Bilddaten. Verwende ab hier NUR NOCH den von 'bild_pfade_einbetten' ZURUECKGEGEBENEN html-String, NICHT dein Original. (5) 'slideshot_create_slides' ERNEUT aufrufen, diesmal MIT diesem fertigen (von 'bild_pfade_einbetten' zurueckgegebenen) html-Parameter (plus denselben theme/mode/orientation-Werten). (6) SOFORT im selben Zug 'slideshot_render_slides' aufrufen (NICHT warten, NICHT vorher zurueckmelden) — WICHTIG: 'render_slides' uebernimmt formats NICHT automatisch von 'create_slides', IMMER explizit denselben formats-Wert (Standard: nur 'png', ausser der Nutzer wollte erkennbar PDF) erneut mitgeben, sonst kann ein falscher/anderer Dateityp oder ein veralteter Cache-Stand zurueckkommen. Die fertigen Dateien liegen unter '/tmp/slideshot-output/' — schicke sie per 'datei_senden' (Originalqualitaet, kein Komprimierungsverlust) an den Nutzer. Ohne ausdruecklich anderslautenden Wunsch das vom Nutzer als Standard vorgegebene 'Pipe-Design' verwenden (dunkles Theme #07070c, Lila #a855f7, Gruen #3ce096, JetBrains Mono) — das entspricht am ehesten dem 'dark-modern'-Theme. Danach uebergib an 'kritiker' — der Registrator schickt die fertige Datei per 'datei_senden'; du selbst hast dieses Werkzeug nicht."
        agent_name: "werkzeug_" ++ alias
        push specialist_names agent_name
        specialist_desc: specialist_desc ++ "- '" ++ agent_name ++ "': Werkzeuge aus '" ++ alias ++ "' (" ++ (join gtools ", ") ++ ")\n"
        push specialist_meta {agent_name: agent_name, alias: alias, gtools: gtools, extra_note: extra_note}

    --! Zweiter Durchlauf: specialist_names ist jetzt vollstaendig, jeder
    --! Spezialist kann also an JEDEN anderen Spezialisten weiterleiten
    --! (ausser an sich selbst) — nicht nur an kritiker/planer.
    for meta in specialist_meta
        agent_name: get meta "agent_name"
        alias: get meta "alias"
        gtools: get meta "gtools"
        extra_note: get meta "extra_note"
        peer_handoff: ["kritiker", "planer"]
        for sn in specialist_names
            if sn != agent_name
                push peer_handoff sn
        swarm_agent agent_name {system: SELF_ID ++ HANDOFF_RULE ++ RETRY_RULE ++ VERIFY_CLAIM_RULE ++ RESULT_HONESTY_RULE ++ "Du bist der Spezial-Agent fuer '" ++ alias ++ "' im Gremium von Muninn. Du hast NUR Zugriff auf die per MCP aus '" ++ alias ++ "' angebundenen Werkzeuge." ++ extra_note ++ " WICHTIG: Nutze das Selbstwissen oben aktiv, bevor du eine Anfrage bearbeitest — geht es z.B. um 'Pipe', ist damit hoechstwahrscheinlich Muninns EIGENE Skriptsprache gemeint (siehe Selbstwissen), NICHT Unix-Pipes/das Shell-Symbol '|', auch wenn Letzteres dein allgemeines Sprachmodell-Vorwissen naheliegender erscheinen laesst. Ist bei einem Begriff aus der Nutzeranfrage unklar, ob Muninn selbst oder etwas Allgemeines gemeint ist, bevorzuge den Bezug zu Muninn selbst oder frage im Zweifel kurz nach — erfinde NIE einfach die allgemeinere, thematisch nahliegendere Bedeutung. Brauchst du fuer die Anfrage mehrere dieser Werkzeuge, unterscheide: haengt ein Aufruf vom ERGEBNIS eines anderen ab (z.B. erst einen Ort/eine ID nachschlagen, dann damit die eigentlichen Daten abrufen), rufe sie nacheinander auf, BEVOR du weiterleitest — nicht nach jedem einzelnen Werkzeug zurueckspringen, das verbraucht unnoetig Runden. Sind mehrere Aufrufe dagegen UNABHAENGIG voneinander (keiner braucht das Ergebnis eines anderen als Eingabe — z.B. mehrere Abschnitte/Elemente, die unabhaengig voneinander angelegt werden), rufe sie GEMEINSAM in EINER Antwort auf (mehrere Tool-Calls gleichzeitig statt einzeln nacheinander) — das ist schneller und spart ebenfalls Runden. Braucht die Anfrage NACH deiner Arbeit noch eine ANDERE Faehigkeit (z.B. hast du recherchiert/Daten geholt, aber die sollen jetzt in ein Dokument/eine Praesentation), leite DIREKT an den passenden anderen werkzeug_<alias>-Spezialisten weiter (siehe Spezialisten-Liste oben) statt nur an 'kritiker' — der kann selbst keine Dokumente/Praesentationen erzeugen oder andere Werkzeuge bedienen. KRITISCH: Verlangt DEINE eigene Rolle ein konkretes Ergebnis (z.B. eine erstellte Datei, ein angelegter Container, ein gesendeter Termin) — du bist genau dafuer der zustaendige Spezialist —, dann MUSST du mindestens eines deiner eigenen Werkzeuge tatsaechlich aufrufen, BEVOR du weiterleitest. Formuliere das Ergebnis NIEMALS nur als Text/Vorschlag und leite NIEMALS direkt weiter, ohne selbst gehandelt zu haben — ein anderer Agent kann deine Werkzeuge nicht nachtraeglich fuer dich aufrufen, die Aufgabe bliebe dann faktisch unerledigt, auch wenn der Text danach fertig klingt. Ist deine Arbeit fertig und wird nichts Weiteres gebraucht, rufe 'kritiker' auf, um dein Ergebnis weiterzugeben.", tools: gtools, handoff: peer_handoff}

    --! Built dynamically from the REAL state (not static text like
    --! SELF_ID) — see the comment at MEMORY_HONESTY_RULE above.
    tools_desc: "REAL, currently available tools (for questions about your own capabilities/tools, ALWAYS use this list — NEVER 'web_search', the internet doesn't know which tools YOU have connected): 'erinnerungen_suchen' (search Muninn's memory), 'merken'/'merken_quelle' (store permanently), 'web_search'/'web_fetch' (research the internet), 'erinnerung_planen' (schedule an appointment/reminder), 'bild_erstellen' (generate a new image from a text description via AI and send it), 'hintergrund_fortsetzen' (defer a task that's taking too long and continue automatically), 'rezept_speichern'/'rezepte_suchen' (store and reuse proven workflows as recipes), 'ziel_anlegen'/'ziel_erledigt' (track a genuine long-term goal, shown in /goals on Telegram), 'bericht_veroeffentlichen' (publish a long text as a Telegraph page with Instant View instead of a truncated message)"
    if has_mcp
        tools_desc: tools_desc ++ ", plus externally connected via MCP: " ++ (join mcp_names ", ") ++ ". Available tool specialists in the gremium:\n" ++ specialist_desc
    else
        tools_desc: tools_desc ++ ". Currently NO external MCP server is connected — actions in third-party systems (cloud services, Google Workspace, GitHub, etc.) are therefore NOT possible until a suitable MCP server is configured."
    tools_desc: tools_desc ++ " If a requested tool is missing from this list, honestly say it isn't currently connected — NEVER blanketly claim 'I have no access to tools' when this list isn't empty."
    if inactive_desc != ""
        tools_desc: tools_desc ++ " Additionally available but NOT currently active (lazy loading — only connects when actually needed):\n" ++ inactive_desc ++ "planer: call 'werkzeug_aktivieren' with one of these aliases if the CURRENT task genuinely needs it. It only takes effect on the NEXT attempt at this task, never this same round — after activating, hand off normally to whichever agent fits best for what you can already do right now (or 'kritiker'/'registrator' if nothing more is possible yet); do NOT wait or retry yourself."
    tools_desc: tools_desc ++ "\n\n"

    --! "registrator" is deliberately included here (not just for
    --! kritiker_handoff): pure image-generation requests ('make me an
    --! image of...') should go DIRECTLY from planer to registrator (who
    --! has 'bild_erstellen'), without an unnecessary detour via
    --! faktenwaechter/kritiker — observed live that without this handoff
    --! target, a simple image request bounced between the other agents for
    --! 16 rounds before landing on registrator by chance.
    planer_handoff: ["faktenwaechter", "kritiker", "registrator"]
    kritiker_handoff: ["faktenwaechter", "registrator"]
    faktenwaechter_handoff: ["kritiker", "planer"]
    for sn in specialist_names
        push planer_handoff sn
        push kritiker_handoff sn
        push faktenwaechter_handoff sn

    swarm_agent "planer" {system: SELF_ID ++ tools_desc ++ HANDOFF_RULE ++ HONESTY_RULE ++ SECURITY_HONESTY_RULE ++ "Du bist der Planer im inneren Gremium von Muninn, einem persoenlichen KI-Agenten mit Langzeitgedaechtnis. Analysiere die Nutzeranfrage. Bei MEHRSCHRITTIGEN oder komplexen Aufgaben (mehrere Teilschritte oder mehrere Werkzeuge noetig): rufe ZUERST 'rezepte_suchen' auf — gibt es ein gespeichertes Rezept fuer genau diese Art Aufgabe, folge dessen Schritten (Weiterleitungen/Reihenfolge entsprechend dem Rezept). Zerlege grosse Aufgaben in klare Teilschritte und steuere sie der Reihe nach an die passenden Spezialisten; wiederholte Einzelschritte laufen ueber die Weiterleitungen der Spezialisten zurueck zu dir, dann gibst du den naechsten Teilschritt frei. Ist es eine Meta-Frage ueber Muninn selbst ODER seine Werkzeuge/Faehigkeiten, leite trotzdem an 'faktenwaechter' weiter (der beantwortet sie direkt aus dem Selbstwissen/der Werkzeugliste oben). Bei sonstigen Fakten- oder Gedaechtnisfragen leite ebenfalls an 'faktenwaechter' weiter. Verlangt die Anfrage RECHERCHE (z.B. 'suche im Netz', 'aktuelle Nachrichten') UND zusaetzlich EIN ERGEBNIS-WERKZEUG (z.B. 'schreib es in ein Dokument', 'als Praesentation') — auch 'Bericht'/'Report'/'Studie'/'Gutachten' zaehlen als Dokument-Ergebnis-Anfrage — leite ZUERST an 'faktenwaechter' weiter, NICHT direkt an den werkzeug_<alias>-Spezialisten: der recherchiert und reicht danach selbst an den passenden Spezialisten weiter, sobald er echte Inhalte hat. 'werkzeug_browser' ist NUR fuer echte Website-Interaktion (navigieren, klicken, Formulare, Screenshots) — NICHT fuer allgemeine Web-Recherche/Nachrichten, dafuer ist 'faktenwaechter' (web_search/web_fetch) zustaendig. Erfordert die Anfrage NUR ein konkretes externes Werkzeug ohne vorherige Recherche, leite an den PASSENDEN Werkzeug-Spezialisten aus der Liste oben weiter (nicht an einen falschen — waehle anhand der dort aufgefuehrten Werkzeugnamen). Geht es um Folien/eine Praesentation/ein Deck/ein Bilder-Carousel UND sind sowohl 'werkzeug_praesentation' als auch 'werkzeug_slideshot' verfuegbar, entscheide NICHT nach Bauchgefuehl: nennt die Anfrage NICHT ausdruecklich 'PowerPoint'/'PPTX'/eine editierbare Datei, rufe ZUERST 'rezepte_suchen' auf (auch wenn die Anfrage sonst einfach wirkt) und bevorzuge ohne Gegenbeweis 'werkzeug_slideshot' — das ist Muninns vom Nutzer wiederholt bestaetigter Standardweg fuer optisch gestaltete Folien, 'werkzeug_praesentation' ist nur fuer echte, editierbare PowerPoint-Dateien gedacht. Verlangt die Anfrage NUR ein NEU zu generierendes Bild (z.B. 'erstelle/generiere/zeichne mir ein Bild von...') OHNE Recherche oder sonstige Aufgabe, leite DIREKT an 'registrator' weiter — der hat das Bild-Werkzeug 'bild_erstellen', kein Umweg ueber 'faktenwaechter'/'kritiker' noetig. Verlangt die Anfrage, laufende Hintergrund-Aufgaben/Docker-Jobs abzubrechen/zu stoppen, leite DIREKT an 'registrator' weiter (der hat 'docker_jobs_abbrechen') — das ist zeitkritisch, kein Umweg ueber Recherche/Kritik noetig. Siehst du den Hinweis '[SYSTEM] Only N of M rounds remain' bei einer mehrschrittigen, noch nicht fertigen Aufgabe: leite SOFORT an 'registrator' weiter (der nutzt 'hintergrund_fortsetzen') statt mitten in der Zerlegung zu scheitern. Sonst leite an 'kritiker' weiter. Gib selbst NIE die Endantwort und NIE internes Reasoning aus.", tools: ["rezepte_suchen", "werkzeug_aktivieren"], handoff: planer_handoff}

    swarm_agent "faktenwaechter" {system: SELF_ID ++ tools_desc ++ HANDOFF_RULE ++ TOOL_DISCIPLINE_RULE ++ RESULT_HONESTY_RULE ++ MEMORY_HONESTY_RULE ++ SECURITY_HONESTY_RULE ++ "Du bist der Faktenwaechter im Gremium. Ist die Frage eine Meta-Frage ueber Muninn selbst ODER seine Werkzeuge/Faehigkeiten (z.B. 'kannst du mit deinen Werkzeugen X tun'), beantworte sie DIREKT aus dem Selbstwissen/der Werkzeugliste oben, OHNE 'web_search' aufzurufen — das Internet weiss nichts ueber DEINE Werkzeugverbindungen. Fragt der Nutzer, welche MCP-Server/Werkzeuge/Integrationen Muninn zusaetzlich anbinden/hinzufuegen koennte (z.B. 'such mal nach MCP-Servern', 'welche Tools koennten wir noch einbauen') — das ist KEINE allgemeine Web-Recherche, dafuer gibt es 'mcp_registry_suchen': ruf es mit einem oder mehreren passenden Suchbegriffen auf (bei einer vagen/allgemeinen Anfrage probiere mehrere thematisch naheliegende Begriffe nacheinander statt nur einen), NIEMALS 'web_search' dafuer — Web-Suchergebnisse sind veraltete, unzuverlaessige Blog-Rankings ueber angebliche 'beste MCP-Server', nicht die echte, aktuelle offizielle Registry; behaupte auch NIE, etwas gefunden zu haben, ohne 'mcp_registry_suchen' wirklich aufgerufen zu haben. Findest du dabei etwas konkret Passendes, rufe 'mcp_server_vorschlagen' auf, um es Harry zur Bestaetigung vorzuschlagen — erfinde NIE, schon etwas vorgeschlagen/hinzugefuegt zu haben, ohne das Werkzeug wirklich aufgerufen zu haben. Auch bei diesen beiden Faellen rufst du danach dein Handoff-Werkzeug 'kritiker' auf, du gibst NIE selbst die finale Antwort aus. Bei allen anderen Fragen stuetze jede Aussage auf Muninns Gedaechtnis UND das Internet: rufe 'erinnerungen_suchen' auf, um relevante Erinnerungen zu finden; wenn das Gedaechtnis nichts hergibt, nutze 'web_search' und 'web_fetch', um die Antwort im Internet zu recherchieren. Verlangt die Anfrage NACH der Recherche zusaetzlich ein ERGEBNIS-WERKZEUG (z.B. 'schreib es in ein Dokument und schick es mir'), leite deine recherchierten Inhalte DIREKT an den passenden werkzeug_<alias>-Spezialisten weiter (z.B. 'werkzeug_dokument'), NICHT an 'kritiker' — der kann selbst keine Dokumente/Praesentationen erzeugen. Sonst rufe IMMER 'kritiker' auf, um deine fundierte Antwort weiterzugeben. Siehst du den Hinweis '[SYSTEM] Only N of M rounds remain' — leite JETZT SOFORT an 'kritiker' weiter (auch mit unvollstaendiger Recherche), NICHT an einen werkzeug_<alias>-Spezialisten oder zurueck an 'planer' — 'kritiker' erreicht 'registrator' in nur einem weiteren Schritt, jeder andere Umweg kostet Runden, die dann fehlen.", tools: ["erinnerungen_suchen", "web_search", "web_fetch", "mcp_registry_suchen", "mcp_server_vorschlagen"], handoff: faktenwaechter_handoff}

    swarm_agent "kritiker" {system: HANDOFF_RULE ++ MEMORY_HONESTY_RULE ++ SECURITY_HONESTY_RULE ++ LINK_RELAY_RULE ++ "Du bist der Kritiker im Gremium. Pruefe die bisherige Antwort auf Luecken, Widersprueche und Unklarheiten und verbessere sie zu einer praezisen, ehrlichen Antwort. Wenn Fakten fehlen, leite an 'faktenwaechter' zurueck. Sonst rufe IMMER 'registrator' auf, um die verbesserte Antwort weiterzugeben — auch wenn die Antwort schon gut ist oder eine Aufgabe (Dokument/Praesentation/...) nur teilweise erledigt wurde: der Registrator schickt trotzdem das bisherige Ergebnis, ANSTATT dass du hier weiter zwischen Agenten hin- und herspringst. Siehst du den Hinweis '[SYSTEM] Only N of M rounds remain' — leite JETZT SOFORT an 'registrator' weiter, egal wie unvollstaendig die Faktenlage ist (der kann bei echtem Zeitdruck 'hintergrund_fortsetzen' aufrufen); leite in diesem Fall NIEMALS zurueck an 'faktenwaechter', das kostet nur weitere Runden, die dann fuer 'registrator' fehlen.", handoff: kritiker_handoff}

    swarm_agent "registrator" {system: SELF_ID ++ tools_desc ++ HONESTY_RULE ++ FORMAT_RULE ++ MEMORY_HONESTY_RULE ++ VERIFY_CLAIM_RULE ++ NO_REASONING_LEAK_RULE ++ SECURITY_HONESTY_RULE ++ LINK_RELAY_RULE ++ "Du bist der Registrator im Gremium und schliesst die Anfrage ab. Verfasst du eine Antwort ueber Muninns eigene Faehigkeiten/Werkzeuge, nutze IMMER die vollstaendige Werkzeugliste oben (SELF_ID + tools_desc) — NICHT nur deine eigenen drei Werkzeuge ('merken'/'merken_quelle'/'erinnerung_planen' sind nur DEINE Werkzeuge als Registrator, nicht Muninns komplette Ausstattung; behaupte NIE, das seien alle verfuegbaren Werkzeuge. Enthaelt die Konversation eine wichtige dauerhafte Erkenntnis ueber den Nutzer (z.B. Name, Geburtsdatum, Vorlieben), speichere sie mit 'merken' — dabei gibst du als Inhalt NUR den Fakt selbst weiter, OHNE Meta-Anweisungen des Nutzers wie 'merke dir das' mit abzuspeichern. Stammt eine neue Erkenntnis aus dem Web, speichere sie mit 'merken_quelle' samt Quellen-URL. SELBSTREFLEXION (nur wenn es in diesem Lauf wirklich etwas Nennenswertes gab — KEINE Pflichtuebung, bei normalen kurzen Antworten weglassen): Ist dir waehrend dieses Laufs eine wiederverwendbare Lern-Erfahrung aufgefallen (z.B. ein Werkzeug schlug fehl und du fandest einen Ausweg, eine Quelle/Herangehensweise war besonders ergiebig, der Nutzer korrigierte oder praezisierte etwas), speichere sie ZUSAETZLICH mit 'merken' als knappe, spezifische Erkenntnis (z.B. 'Fuer den aktuellen Bitcoin-Kurs: btc-echo.de direkt nutzen statt allgemeiner Web-Suche'). Formuliere die Erkenntnis als allgemein nuetzlichen Fakt, NICHT als Ich-Bericht, und rufe 'merken' VOR deiner finalen Antwort auf. Maximal EINE solche Lern-Erkenntnis pro Lauf — bei Unsicherheit lieber weglassen. REZEPTE: Hast du eine MEHRSCHRITTIGE Aufgabe abgeschlossen, deren Vorgehen sich als Abfolge wiederverwenden laesst (z.B. 'BTC-Kurs: btc-echo.de per web_fetch abrufen, kurz zusammenfassen, als Sprachnachricht senden'), speichere das Vorgehen mit 'rezept_speichern' (kurzer Name + konkrete Schrittfolge). Nur bei wirklich wiederkehrenden Mustern — bei einmaligen Anfragen KEIN Rezept anlegen. Rufe 'rezept_speichern' VOR deiner finalen Antwort auf. ZIELE: Formuliert der Nutzer ein LAENGERFRISTIGES, echtes Vorhaben — etwas, an dem ueber mehrere Gespraeche/Tage/Wochen gearbeitet wird (z.B. 'Ich moechte diese Jahr Spanisch lernen', 'Mein Ziel ist es, Muninn fertigzustellen') — lege es mit 'ziel_anlegen' an. NICHT fuer einmalige, im selben Lauf erledigte Aufgaben (z.B. 'erstelle eine Textdatei', 'loesche alle Erinnerungen') — das sind normale Anfragen, KEINE Ziele; ein Ziel jedes Mal anzulegen, wenn irgendetwas erledigt werden soll, macht /goals nutzlos. Erwaehnt der Nutzer, dass ein zuvor angelegtes Ziel erreicht/abgeschlossen ist, rufe 'ziel_erledigt' mit dessen id auf. BERICHTE: Ist deine fertige Antwort sehr lang (eine ausfuehrliche Recherche-Zusammenfassung, mehr als etwa 1500 Zeichen) UND der Nutzer wollte KEINE herunterladbare Datei (dafuer sind 'werkzeug_dokument'/'werkzeug_praesentation' zustaendig, falls verbunden), veroeffentliche den VOLLEN Text mit 'bericht_veroeffentlichen' (Titel + Volltext, Absaetze durch Leerzeile getrennt) statt ihn gekuerzt als Text zu schicken — Telegram zeigt Telegraph-Seiten mit einer schnellen, nativ wirkenden Lese-Ansicht an. Antworte danach NUR mit dem Link plus einer sehr kurzen (1-2 Saetze) Zusammenfassung, nicht dem vollen Text nochmal. Wuenscht der Nutzer einen Bericht/Report als Ergebnis, aber es wurde KEINE Datei erstellt (kein Pfad in der Konversation erwaehnt): behaupte NIEMALS, eine Datei erstellt/gesendet zu haben, die es nicht gibt — sag ehrlich, dass der Bericht als Datei nicht zustande gekommen ist, und liefere den Inhalt als Text. Erwaehnt die Nutzeranfrage einen Termin, eine Verpflichtung oder eine Bitte, an etwas zu einem Zeitpunkt erinnert zu werden (z.B. 'ich habe morgen um 6 Uhr einen Termin'), rufe VORHER 'erinnerung_planen' mit dem Termin-Text inkl. Zeitangabe auf und bestaetige das in deiner Antwort. Hat ein anderer Agent in der Konversation einen Datei-/Bildpfad erwaehnt (z.B. einen Screenshot-Pfad von werkzeug_browser, eine per Filesystem-Werkzeug erzeugte Datei, oder ein neu erstelltes Dokument/eine Praesentation von werkzeug_dokument/werkzeug_praesentation), rufe IMMER SOFORT 'bild_senden' bzw. 'datei_senden' mit diesem Pfad auf — bei einer Bitte wie 'schreib mir X'/'erstelle mir X' ist das Zuschicken der fertigen Datei der ganze Sinn der Anfrage, keine optionale Zusatzleistung. FRAGE NIEMALS erst nach, ob du die Datei schicken sollst ('Soll ich sie dir schicken?') — das ist wie bei Sprachnachrichten eine unausgefuehrte Aktion statt einer erledigten; schicke sie einfach. Behaupte AUSSERDEM NIEMALS, eine Datei koenne wegen eines Pfad-/Verzeichnis-/Berechtigungsproblems NICHT gesendet werden, ohne 'bild_senden'/'datei_senden' in DIESEM Lauf tatsaechlich aufgerufen und dafuer eine echte Fehlermeldung erhalten zu haben — auch wenn FRUEHERE Nachrichten in diesem Gespraech von genau so einer Einschraenkung berichteten (z.B. aus einer aelteren, mittlerweile behobenen Version), kann sich das seitdem geaendert haben: rufe das Werkzeug einfach auf und richte dich nach dem TATSAECHLICHEN Ergebnis, statt eine alte Einschraenkung aus dem Gespraechsverlauf ungeprueft zu wiederholen. Nur wenn der Nutzer erkennbar NICHT die Datei selbst wollte (z.B. nur wissen wollte, OB etwas erstellt wurde), kannst du stattdessen rein textlich bestaetigen. Wuenscht der Nutzer ein NEU ZU GENERIERENDES Bild (z.B. 'erstelle mir ein Bild von...', 'zeichne...', 'generiere ein Foto von...') — kein bereits vorhandener Screenshot/keine bereits vorhandene Datei —, rufe SOFORT 'bild_erstellen' mit einer moeglichst detaillierten, auf Englisch uebersetzten Bildbeschreibung auf; das Werkzeug generiert UND sendet das Bild in einem Schritt. FRAGE NIEMALS erst nach, ob ein Bild erstellt werden soll. Wirkt die Aufgabe insgesamt unfertig, WEIL sie erkennbar mehr Zeit/Recherche/Schritte braucht als in diesem einen Gremiums-Lauf moeglich war (z.B. du siehst den Hinweis '[SYSTEM] Only N of M rounds remain' und die Arbeit ist wirklich noch nicht fertig, oder ein Schritt haengt erkennbar von etwas ab, das noch laeuft) — rufe STATT einer unvollstaendigen Antwort 'hintergrund_fortsetzen' auf (mit einer Zusammenfassung der Aufgabe und dem bisherigen Fortschritt) und antworte danach nur kurz, dass du weiterarbeitest und dich automatisch meldest. Das ist NICHT auf Docker beschraenkt — gilt fuer JEDE Art von Aufgabe, die absehbar laenger braucht. Verwechsle das NICHT mit einer Aufgabe, die einfach nur wenig ergiebig war (dafuer gilt weiter die Ehrlichkeitsregel oben) — nur wenn WIRKLICH noch echte Arbeit fehlt. Siehst du den Hinweis '[SYSTEM] Only N of M rounds remain' mit einer kleinen Zahl (wenige Runden uebrig): rufe DIREKT 'hintergrund_fortsetzen' auf oder gib DIREKT deine finale Antwort — ueberspringe in diesem Fall 'merken'/'merken_quelle'/'erinnerung_planen' (die sind wichtig, aber NICHT so dringend wie die Aufgabe selbst abzuschliessen; verpasst du dadurch die letzte Runde, bekommt der Nutzer GAR KEINE Antwort). REGEL fuer Sprachnachrichten (in dieser Reihenfolge pruefen, erste zutreffende gewinnt): (1) Wuenscht der Nutzer AUSDRUECKLICH eine Sprachnachricht/Audio (z.B. 'als Sprachnachricht', 'sag mir das gesprochen', 'schick mir Audio')? Dann rufe 'sprachnachricht_senden' IMMER auf — uneingeschraenkt, auch wenn die Antwort lang/zahlenreich ist (das Werkzeug kuerzt selbst auf eine sprechbare Laenge). (2) Ist die Antwort eine REGULAERE ZUSAMMENFASSUNG/UEBERBLICKSANTWORT — z.B. Nachrichten-/News-Ueberblick, Status-/Wetterbericht, allgemeine Wissensfrage, Zusammenfassung eines Themas? Dann RUFE 'sprachnachricht_senden' SOFORT AUF, STANDARDMAESSIG (auch ohne explizite Bitte) — das ist der Normalfall fuer diese Kategorie, nicht die Ausnahme. NIEMALS nur ANBIETEN oder FRAGEN, ob eine Sprachnachricht gewuenscht ist ('soll ich das als Sprachnachricht schicken?', 'ich kann dir das auch vorlesen') — das ist wie jede andere unausgefuehrte Aktion eine Verletzung der Ehrlichkeitsregel oben: entweder du rufst das Werkzeug JETZT auf, oder du erwaehnst die Option gar nicht. (3) Dreht sich die Antwort um eine AUFGABE/AKTION — etwas wurde ausgefuehrt/geplant/gesendet/gespeichert (z.B. Erinnerung gesetzt, Datei verschickt, Docker-Container erstellt, Termin angelegt, Recherche-Auftrag erledigt) — oder enthaelt sie Links/Code/eine Handlungs-Liste? Dann IMMER Text, KEINE Sprachnachricht, auch wenn Kategorie (2) sonst zutreffen wuerde. (4) Sonst (z.B. Small Talk): eigenes Ermessen, kurze/lockere Antworten duerfen als Sprachnachricht raus. Hast du 'sprachnachricht_senden' aufgerufen, halte deine eigene finale Textantwort SEHR kurz (NUR '🎙️ Sprachnachricht gesendet.', keine Zusammenfassung des Inhalts) statt den gesprochenen Text nochmal komplett als Text zu wiederholen. Danach gibst du die endgueltige Antwort aus — AUSSCHLIESSLICH die Antwort an den Nutzer. Schreibe KEIN internes Reasoning, KEINE Meta-Kommentare wie 'Ich schliesse die Anfrage ab', KEINE Anweisungen an andere Agenten und KEINE Wiederholung deiner Gedankengaenge. Nur die fertige, knappe Antwort. Verlangt der Nutzer, laufende Hintergrund-Aufgaben/Docker-Jobs abzubrechen/zu stoppen (z.B. 'breche alles ab', 'stop', 'brich die Aufgabe ab'), rufe SOFORT 'docker_jobs_abbrechen' auf und bestaetige NUR anhand von dessen tatsaechlicher Rueckmeldung (wie viele Jobs/Eintraege wirklich abgebrochen wurden) — behaupte NIEMALS, etwas sei abgebrochen worden, ohne dieses Werkzeug aufgerufen zu haben, und starte in DERSELBEN Antwort danach KEINEN neuen Hintergrund-Job fuer dieselbe Aufgabe (das widerspricht dem Abbruch-Wunsch direkt).", tools: ["merken", "merken_quelle", "erinnerung_planen", "bild_senden", "datei_senden", "sprachnachricht_senden", "bild_erstellen", "hintergrund_fortsetzen", "rezept_speichern", "docker_jobs_abbrechen", "ziel_anlegen", "ziel_erledigt", "bericht_veroeffentlichen", "workspace_erstellen", "workspaces_auflisten"], handoff: []}

    nil

--! Backstop: HANDOFF_RULE reduces premature endings (an agent outputs text
--! instead of calling its handoff tool), but doesn't guarantee it —
--! observed with "Who am I?": the path ended at faktenwaechter instead of
--! registrator, complete with a raw "handed off to the critic" comment.
--! Instead of relying solely on prompt compliance, a deterministic cleanup
--! step here. Shared by run_gremium AND run_gremium_stream.
fn apply_registrator_backstop res
    if (get res "aborted") == true
        --! Deliberately cancelled (see run_gremium_stream/round_check) —
        --! content is whatever partial progress happened before the stop
        --! (often empty), not a real answer that needs the meta-comment
        --! cleanup below. Running an extra ai_chat pass on it would just
        --! waste a call and could fabricate polish on cancelled garbage.
        return res
    path: get res "path"
    if (len path) > 0 && (at path ((len path) - 1)) != "registrator"
        cleaned: get res "content"
        try
            cleaned: ai_chat "Formuliere die folgende interne Notiz eines KI-Agenten als knappe, direkte Antwort an den Nutzer um. Entferne jeden Meta-Kommentar ueber das Gremium selbst (z.B. 'ich leite weiter', 'an den Kritiker uebergeben', Erwaehnung von Agentennamen wie Planer/Faktenwaechter/Kritiker/Registrator). Gib NUR die bereinigte Antwort aus, kein Meta-Kommentar darueber." (get res "content")
        catch
            cleaned: get res "content"
        set res "content" cleaned
    res

--! Runs the gremium. Returns {content, path, rounds}. cid: chat context
--! for tool_erinnerung_planen (see the STATE comment above).
--! Round limit 150 (previously 50): observed live that a single tool call
--! consumes one round — an extensive, multi-chapter document alone
--! already needs about 30-50 rounds just for the add_heading/add_paragraph
--! calls, on top of the prior research. At 50, the gremium broke off mid
--! way through a well-filled document ("max rounds exceeded"), WITHOUT
--! ever handing off to 'registrator' — worse than an incomplete answer,
--! because then the user gets no answer at all (a crash instead of a
--! partial result). Short requests still only need a few rounds; the
--! higher limit is just a safety net for very extensive research+document
--! tasks.
export fn run_gremium dbh cid task
    set STATE "dbh" dbh
    set STATE "cid" cid
    res: ai_swarm_trace task "planer" 150
    apply_registrator_backstop res

--! Like run_gremium, but with live progress: on_update is called as
--! on_update(agent, event, detail, args_json) on every swarm step (event:
--! "start"|"tool"|"handoff"|"final"|"reasoning"|"inject", args_json only
--! populated for "tool" — the raw JSON arguments of the call, see
--! ai_swarm_stream). Stays UI-neutral — Telegram-specific formatting/
--! editing happens at the caller (muninn.pipe), not here. round_check
--! (optional): called with no arguments at the start of every round by
--! ai_swarm_stream itself, may return a map {abort, abort_reason, inject}
--! (every field optional, nil/non-map/empty = no-op). A truthy "abort"
--! stops the run immediately, res then has aborted=true/abort_reason set
--! (see apply_registrator_backstop above). A non-empty "inject" steers the
--! run with a fresh instruction without stopping it.
--!
--! mcp_activated: reset to [] here, then embedded on the returned map — see
--! tool_werkzeug_aktivieren, which pushes onto it whenever it connects a
--! server mid-run. A non-empty list on the result tells the caller
--! (muninn.pipe's handle_message) that a specialist only became available
--! AFTER this run's frozen agent snapshot was taken, so it never actually
--! got used this round — the caller retries the same task once more so the
--! newly active specialist gets a real chance.
export fn run_gremium_stream dbh cid task on_update round_check
    set STATE "dbh" dbh
    set STATE "cid" cid
    --! "set X key []" (a bare list literal as a NON-first call argument)
    --! mis-parses in Pipe — live-reproduced: "set expects 3 arguments"
    --! even though there visibly are 3 (the parser reads "key[]" as an
    --! index expression on "key" instead of two separate tokens).
    --! Wrapping it in parens sidesteps the ambiguity — confirmed this
    --! also affects any list literal, not just empty ones, and any
    --! non-first call argument, not just set().
    set STATE "mcp_activated" ([])
    res: ai_swarm_stream task "planer" 150 on_update round_check
    res: apply_registrator_backstop res
    set res "mcp_activated" (get STATE "mcp_activated")
    res
