--! web.pipe — web research: search (DDG + Wikipedia), page fetch, research
--! orchestration. Free (no API key): DDG Instant Answer + DDG HTML full-text
--! + Wikipedia.

--! Combined search: DDG Instant Answer + Wikipedia.
--! Deliberately not called "web_search", to avoid shadowing the builtin of the same name.
export fn web_lookup query
    out: []
    try
        r1: web_search query
        for r in r1
            push out r
    catch
        nil
    try
        r2: wiki_search query
        for r in r2
            push out r
    catch
        nil
    out

--! Clean up HTML entities and whitespace.
export fn html_clean s
    s: replace_all s "&nbsp;" " "
    s: replace_all s "&amp;" "&"
    s: replace_all s "&lt;" "<"
    s: replace_all s "&gt;" ">"
    s: replace_all s "&quot;" "\""
    s: replace_all s "&#x27;" "'"
    s: replace_all s "&#39;" "'"
    s: replace_all s "&#x2F;" "/"
    s: replace_all s "&#x2D;" "-"
    s: regex_replace "[ \t]+" " " s
    s: regex_replace "\n[ \n]*\n+" "\n" s
    trim s

--! Reduce HTML to plain flowing text (strip tags, script/style).
export fn strip_html html
    t: html
    t: regex_replace "(?s)<script[^>]*>.*?</script>" " " t
    t: regex_replace "(?s)<style[^>]*>.*?</style>" " " t
    t: regex_replace "<[^>]+>" " " t
    html_clean t

--! Parse DDG HTML full-text search results (title + URL + snippet).
export fn parse_ddg body
    t: replace_all body "<b>" " "
    t: replace_all t "</b>" " "
    t: replace_all t "<i>" " "
    t: replace_all t "</i>" " "
    t: replace_all t "<em>" " "
    t: replace_all t "</em>" " "
    t: replace_all t "<strong>" " "
    t: replace_all t "</strong>" " "
    titles: []
    urls: []
    parts: split t "result__a"
    i: 1
    while i < (len parts)
        p: at parts i
        gt: split p ">"
        if (len gt) >= 2
            ta: split (at gt 1) "</a"
            push titles (html_clean (at ta 0))
            u0: at gt 0
            u1: split u0 "uddg="
            if (len u1) >= 2
                u2: split (at u1 1) "&"
                push urls (url_decode (at u2 0))
            else
                push urls ""
        i: i + 1
    snippets: []
    sp: split t "result__snippet"
    j: 1
    while j < (len sp)
        pg: split (at sp j) ">"
        if (len pg) >= 2
            sa: split (at pg 1) "</a"
            push snippets (html_clean (at sa 0))
        j: j + 1
    out: []
    k: 0
    while k < (len titles)
        item: {}
        set item "title" (at titles k)
        u: ""
        if k < (len urls)
            u: at urls k
        set item "url" u
        sn: ""
        if k < (len snippets)
            sn: at snippets k
        set item "snippet" sn
        push out item
        k: k + 1
    out

--! Full-text search via the DDG HTML endpoint (best effort, no key).
export fn web_search_full query
    url: "https://html.duckduckgo.com/html/?q=" ++ (url_encode query)
    hdrs: {}
    set hdrs "User-Agent" "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36"
    body: ""
    try
        r: http_request "GET" url hdrs
        body: get r "body"
    catch
        body: ""
    if body == ""
        return []
    parse_ddg body

--! Raw HTTP GET body (empty on error). Shared base for web_fetch/web_fetch_raw.
fn fetch_body url
    hdrs: {}
    set hdrs "User-Agent" "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36"
    body: ""
    try
        r: http_request "GET" url hdrs
        body: get r "body"
    catch
        body: ""
    body

--! Fetch a page and reduce it to plain text (truncated, for quick lookups).
export fn web_fetch url
    body: fetch_body url
    if body == ""
        return ""
    t: strip_html body
    if (len t) > 4000
        t: substring t 0 4000
    t

--! Like web_fetch, but WITHOUT truncation — for document ingestion (P2),
--! where the full text is needed (gets chunked afterward).
export fn web_fetch_raw url
    body: fetch_body url
    if body == ""
        return ""
    strip_html body

--! Deduplicates results by URL.
fn dedup results
    seen: {}
    out: []
    for r in results
        u: get r "url"
        if u != nil && u != ""
            if (get seen u) == nil
                set seen u true
                push out r
    out

--! Filters junk results (DDG "No results", Wikipedia search pages, empty URLs).
fn filter_junk results
    out: []
    for r in results
        t: get r "title"
        u: get r "url"
        if t == "No results"
            continue
        if u == nil || u == ""
            continue
        if contains u "duckduckgo.com/?q="
            continue
        if contains u "duckduckgo.com/y.js"
            continue
        if contains u "bing.com/aclick"
            continue
        if contains u "Special:Search"
            continue
        push out r
    out

--! Returns the k cleanest search results (lookup + DDG full-text, junk filtered).
export fn web_results query k
    results: filter_junk (dedup (web_lookup query))
    if (len results) < k
        extra: filter_junk (web_search_full query)
        for e in extra
            if (len results) < k
                push results e
    results

--! Research orchestration: search -> fetch top N -> condense -> sources.
--! Returns {context, sources}.
export fn research query
    results: web_results query 5
    ctx: ""
    sources: []
    i: 0
    while i < 3 && i < (len results)
        r: at results i
        u: get r "url"
        if u != nil && u != ""
            text: web_fetch u
            if text != ""
                s: ""
                try
                    s: summarize text
                catch
                    s: substring text 0 800
                ctx: ctx ++ "[" ++ (to_str (i + 1)) ++ "] " ++ s ++ "\n\n"
                push sources u
            else
                push sources u
        i: i + 1
    out: {}
    set out "context" ctx
    set out "sources" sources
    out

--! Searches Iconify (api.iconify.design, iconify.design) for icon ids
--! matching query — 200'000+ free, open-source icons across 200+ sets
--! (Material Design Icons, Font Awesome, Tabler, ...), no API key, no
--! account. Returns a list of icon ids like "mdi:github" (empty on
--! error/no results).
export fn web_icon_search query limit
    url: "https://api.iconify.design/search?query=" ++ (url_encode query) ++ "&limit=" ++ (to_str limit)
    hdrs: {}
    r: nil
    try
        r: http_request "GET" url hdrs
    catch
        return []
    j: nil
    try
        j: parse_json (get r "body")
    catch
        return []
    if j == nil
        return []
    icons: get j "icons"
    if icons == nil
        return []
    icons

--! Fetches one icon as raw SVG text, in the given color and size (both
--! optional — nil/"" for the icon's defaults, i.e. currentColor/1em).
--! icon_id: e.g. "mdi:github" (from web_icon_search). Returns nil on error
--! or if icon_id isn't in the expected "prefix:name" shape.
export fn web_icon_svg icon_id color size
    parts: split icon_id ":"
    if (len parts) != 2
        return nil
    prefix: at parts 0
    name: at parts 1
    url: "https://api.iconify.design/" ++ prefix ++ "/" ++ name ++ ".svg"
    qs: []
    if color != nil && color != ""
        push qs ("color=" ++ (url_encode color))
    if size != nil && size != ""
        push qs ("width=" ++ (url_encode size))
        push qs ("height=" ++ (url_encode size))
    if (len qs) > 0
        url: url ++ "?" ++ (join qs "&")
    hdrs: {}
    r: nil
    try
        r: http_request "GET" url hdrs
    catch
        return nil
    if (get r "status") != 200
        return nil
    get r "body"

--! Creates a new Telegraph (telegra.ph) account and returns its
--! access_token, or nil on any error. Call once and persist the token
--! (see tool_bericht_veroeffentlichen in swarm.pipe) — every subsequent
--! page publishes under the same account. short_name/author_name are
--! shown on telegra.ph itself, not to Muninn's users. Takes an unused
--! argument (Pipe convention for a callable with no real parameters, see
--! e.g. cur_dbh in swarm.pipe — calling a function with zero arguments
--! only references its value, it doesn't invoke it).
export fn web_telegraph_account _
    hdrs: {}
    r: nil
    try
        r: http_request "GET" "https://api.telegra.ph/createAccount?short_name=Muninn&author_name=Muninn" hdrs
    catch
        return nil
    j: nil
    try
        j: parse_json (get r "body")
    catch
        return nil
    if j == nil || (get j "ok") != true
        return nil
    get (get j "result") "access_token"

--! Publishes a Telegraph page and returns its URL, or nil on any error.
--! Telegraph (telegra.ph) is Telegram's own simple publishing platform —
--! every page it hosts automatically gets Instant View (Telegram's fast,
--! native-feeling in-app reader) when linked in a chat, unlike regular
--! web pages, which only get Instant View if the target SITE has a
--! registered template (out of a bot's control). Text is split into
--! paragraphs on blank lines, each becoming one <p> node (see Telegraph's
--! Node content format) — no other formatting is attempted, so **/*
--! markdown-style emphasis shows up literally rather than rendered.
export fn web_telegraph_publish access_token title text
    nodes: []
    for para in (split text "\n\n")
        p: trim para
        if p != ""
            node: {}
            set node "tag" "p"
            set node "children" ([p])
            push nodes node
    if (len nodes) == 0
        return nil
    body: {}
    set body "access_token" access_token
    set body "title" title
    set body "author_name" "Muninn"
    set body "content" nodes
    hdrs: {}
    set hdrs "Content-Type" "application/json"
    r: nil
    try
        r: http_request "POST" "https://api.telegra.ph/createPage" hdrs (to_json body)
    catch e
        print ("Telegraph publish request failed: " ++ (to_str e))
        return nil
    j: nil
    try
        j: parse_json (get r "body")
    catch e2
        print ("Telegraph publish: bad response: " ++ (to_str (get r "body")))
        return nil
    if j == nil || (get j "ok") != true
        print ("Telegraph publish rejected: " ++ (to_str j))
        return nil
    get (get j "result") "url"
