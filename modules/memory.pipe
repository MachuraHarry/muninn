--! memory.pipe — Muninn's persistent "soul".
--! All memory lives in a sqlite file; the soul is restored without any AI
--! call. Incoming messages are classified and condensed.
import "sqlite"

DB_PATH: "muninn.db"
LOCK_PATH: "muninn.db.lock"

--! Only log ONCE per module INSTANCE whether embed() fundamentally fails
--! (e.g. because embed() strictly needs OPENAI_API_KEY, which Muninn
--! deliberately doesn't set — DeepSeek-only policy) — otherwise this would
--! get logged again on EVERY add_memory/retrieve_context (the most frequent
--! path in the whole system), pure log bloat with no new information after
--! the first time. Note: every file that imports "modules/memory.pipe" gets
--! its OWN module instance with its own EMBED_STATE (confirmed Pipe quirk,
--! see the sqlite shadowing bug earlier in this session) — in the real
--! process, 6 files import memory.pipe directly or indirectly (muninn.pipe,
--! swarm.pipe, docker_tools.pipe, scheduler.pipe, dashboard.pipe,
--! executor.pipe), so the warning can appear up to ~6x instead of exactly
--! once — still far less than on every individual add_memory call.
EMBED_STATE: {warned: false}

--! Opens the database and creates the schema (idempotent).
--! path: optional file path (e.g. ":memory:"); nil = DB_PATH.
export fn init_db path
    p: DB_PATH
    if path != nil && path != ""
        p: path
    h: db_open p
    db_exec h "CREATE TABLE IF NOT EXISTS meta (mkey TEXT PRIMARY KEY, mval TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS memories (id INTEGER PRIMARY KEY AUTOINCREMENT, content TEXT, kind TEXT, importance INTEGER DEFAULT 0, source TEXT, ts TEXT, tags TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS threads (id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT, state TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS goals (id INTEGER PRIMARY KEY AUTOINCREMENT, text TEXT, status TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS events (id INTEGER PRIMARY KEY AUTOINCREMENT, chat_id TEXT, msg TEXT, kind TEXT, ts TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS embeddings (memory_id INTEGER PRIMARY KEY, vec TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS entities (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT UNIQUE, kind TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS relations (id INTEGER PRIMARY KEY AUTOINCREMENT, from_id INTEGER, to_id INTEGER, rel TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS messages (id INTEGER PRIMARY KEY AUTOINCREMENT, thread_id INTEGER, chat_id TEXT, role TEXT, content TEXT, ts TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS cost_log (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id INTEGER, ts TEXT, cost_usd REAL, tokens INTEGER, calls INTEGER, cache_hits INTEGER, cache_misses INTEGER)"
    db_exec h "CREATE TABLE IF NOT EXISTS error_log (id INTEGER PRIMARY KEY AUTOINCREMENT, tag TEXT, message TEXT, ts TEXT)"
    h

--! Closes the database and persists the changes to the file.
export fn close h
    db_close h

--! Opens the (file) database with an exclusive lock against other Muninn
--! processes (Telegram loop, dashboard, consolidation — all of which can
--! run concurrently). Needed because the pure-Pipe sqlite module loads a
--! snapshot into memory on open and atomically writes back the ENTIRE file
--! on close, with no cross-process lock of its own: two processes that open/
--! write/close "concurrently" (even just seconds apart) can otherwise
--! silently overwrite each other's committed writes (reproduced live). For
--! ":memory:" databases (tests) this is irrelevant — use without a lock
--! there. Returns {h, lock}; ALWAYS use together with close_locked.
export fn open_locked path
    lock: file_lock LOCK_PATH
    out: {}
    set out "h" (init_db path)
    set out "lock" lock
    out

--! Closes a database opened with open_locked and releases the lock again
--! (order matters: close/commit the db first, then unlock — otherwise a
--! waiting process could read before the commit).
export fn close_locked handle
    close (get handle "h")
    file_unlock (get handle "lock")

--! Sets a meta key (INSERT or UPDATE).
export fn meta_set h key value
    rows: db_query h ("SELECT mkey FROM meta WHERE mkey = '" ++ (sql_escape key) ++ "'")
    if (len rows) > 0
        db_exec h ("UPDATE meta SET mval = '" ++ (sql_escape value) ++ "' WHERE mkey = '" ++ (sql_escape key) ++ "'")
    else
        db_exec h ("INSERT INTO meta (mkey, mval) VALUES ('" ++ (sql_escape key) ++ "', '" ++ (sql_escape value) ++ "')")

--! Reads a meta key (or "").
export fn meta_get h key
    rows: db_query h ("SELECT mval FROM meta WHERE mkey = '" ++ (sql_escape key) ++ "'")
    if (len rows) > 0
        get (at rows 0) "mval"
    else
        ""

--! New session ID (sequential, counted via meta) — a "session" here is
--! one process run of `pipe muninn.pipe` (start until restart/crash),
--! because ai_cost/ai_tokens are purely in-process counters that start
--! back at 0 on every restart. Call once at startup.
export fn next_session_id h
    cur: meta_get h "session_counter"
    n: 0
    if cur != nil && cur != ""
        n: to_num cur
    n: n + 1
    meta_set h "session_counter" (to_str n)
    n

--! User settings (/settings in muninn.pipe): stored per chat via the
--! existing meta table (its own key namespace "settings:<chat_id>:<key>")
--! instead of a new table — saves a migration, meta already exists for
--! exactly this (arbitrary key-value pairs). Unknown/empty value -> default
--! instead of an error, so a chat with no settings ever set still runs
--! normally with the default values.
export fn setting_get h chat_id key default
    v: meta_get h ("settings:" ++ (to_str chat_id) ++ ":" ++ key)
    if v == nil || v == ""
        default
    else
        v

export fn setting_set h chat_id key value
    meta_set h ("settings:" ++ (to_str chat_id) ++ ":" ++ key) value

--! Next value when cycling through a setting in the Telegram menu (see
--! handle_callback in muninn.pipe). Pure value rotation without DB access,
--! so it stays reusable for building the display labels too.
export fn setting_cycle key cur
    if key == "style"
        if cur == "knapp"
            "normal"
        else
            if cur == "normal"
                "ausfuehrlich"
            else
                "knapp"
    else
        if key == "sprache"
            if cur == "de"
                "en"
            else
                "de"
        else
            if key == "proaktiv"
                if cur == "on"
                    "off"
                else
                    "on"
            else
                if key == "gedaechtnis"
                    if cur == "locker"
                        "normal"
                    else
                        if cur == "normal"
                            "streng"
                        else
                            "locker"
                else
                    cur

--! Display text for a setting value in the Telegram menu.
export fn setting_label key value
    if key == "style"
        if value == "knapp"
            "Brief"
        else
            if value == "ausfuehrlich"
                "Detailed"
            else
                "Normal"
    else
        if key == "sprache"
            if value == "en"
                "English"
            else
                "German"
        else
            if key == "proaktiv"
                if value == "on"
                    "On"
                else
                    "Off"
            else
                if key == "gedaechtnis"
                    if value == "locker"
                        "Relaxed (forgets slowly)"
                    else
                        if value == "streng"
                            "Strict (forgets quickly)"
                        else
                            "Normal"
                else
                    value

--! Builds a "[SYSTEM]" note for style/language from the chat settings,
--! prepended to the gremium task (see the run_gremium(_stream) call sites in
--! muninn.pipe/dashboard.pipe) — the agent prompts themselves are static
--! (init_gremium only runs ONCE at startup), so this gets injected here
--! instead, following the same pattern as the existing round-budget note in
--! swarm.go. Empty ("") for pure default settings, no noise.
export fn settings_prompt_prefix h chat_id
    style: setting_get h chat_id "style" "normal"
    sprache: setting_get h chat_id "sprache" "de"
    p: ""
    if sprache == "en"
        p: p ++ "[SYSTEM] Reply in this entire conversation in ENGLISH instead of German, regardless of the language of the user's request. "
    if style == "knapp"
        p: p ++ "[SYSTEM] The user wants brief replies — keep it short, essentials only, no long explanations. "
    else
        if style == "ausfuehrlich"
            p: p ++ "[SYSTEM] The user wants detailed replies — explain background/context where useful, instead of just the brief core statement. "
    if p == ""
        p
    else
        p ++ "\n\n"

--! Whether proactive (unsolicited) messages are allowed for this chat
--! (self-initiative, proactive calendar reminders — see sched_tick in
--! muninn.pipe). The daily briefing is deliberately EXCLUDED from this: the
--! user explicitly activated it themselves via /briefing, so it's already
--! opt-in and not an unsolicited surprise.
export fn setting_proaktiv_enabled h chat_id
    (setting_get h chat_id "proaktiv" "on") == "on"

--! decay/forget days for consolidate_memories, controlled via the
--! "gedaechtnis" setting. "normal" matches the previous fixed values
--! (14/30) — deliberately unchanged by this function, so default behavior
--! stays the same if nobody touches the setting.
export fn setting_consolidate_days h chat_id
    g: setting_get h chat_id "gedaechtnis" "normal"
    out: {}
    if g == "locker"
        set out "decay" 30
        set out "forget" 60
    else
        if g == "streng"
            set out "decay" 7
            set out "forget" 14
        else
            set out "decay" 14
            set out "forget" 30
    out

--! Writes a cost snapshot (cumulative values of the running process per
--! ai_cost/ai_tokens, not as a delta). Only call when something has changed
--! since the last snapshot (caller's responsibility, see muninn.pipe) —
--! otherwise the table grows needlessly.
export fn log_cost h session_id cost_usd tokens calls cache_hits cache_misses
    db_exec h ("INSERT INTO cost_log (session_id, ts, cost_usd, tokens, calls, cache_hits, cache_misses) VALUES (" ++ (to_str session_id) ++ ", '" ++ (sql_escape (now_ts 0)) ++ "', " ++ (to_str cost_usd) ++ ", " ++ (to_str tokens) ++ ", " ++ (to_str calls) ++ ", " ++ (to_str cache_hits) ++ ", " ++ (to_str cache_misses) ++ ")")
    nil

--! Aggregates cost_log into a summary: total cost/tokens/calls across all
--! sessions (sum of each session's maxima, since the values are monotonically
--! increasing counters PER SESSION) plus a list per session {session_id,
--! cost_usd, tokens, calls, cache_hits, cache_misses, first_ts, last_ts},
--! newest first. Aggregation deliberately done in Pipe instead of via SQL
--! GROUP BY/MAX (the pure-Pipe sqlite engine has elsewhere already silently
--! ignored undocumented SQL functions, see the add_memory comment further
--! below — hence computed verifiably in Pipe itself here).
export fn cost_summary h
    rows: db_query h "SELECT session_id, ts, cost_usd, tokens, calls, cache_hits, cache_misses FROM cost_log ORDER BY id ASC"
    sessions: {}
    order: []
    for r in rows
        sid: to_str (get r "session_id")
        existing: get sessions sid
        if existing == nil
            fresh: {session_id: (get r "session_id"), cost_usd: 0, tokens: 0, calls: 0, cache_hits: 0, cache_misses: 0, first_ts: (get r "ts"), last_ts: (get r "ts")}
            set sessions sid fresh
            push order sid
            existing: fresh
        if (get r "cost_usd") > (get existing "cost_usd")
            set existing "cost_usd" (get r "cost_usd")
        if (get r "tokens") > (get existing "tokens")
            set existing "tokens" (get r "tokens")
        if (get r "calls") > (get existing "calls")
            set existing "calls" (get r "calls")
        if (get r "cache_hits") > (get existing "cache_hits")
            set existing "cache_hits" (get r "cache_hits")
        if (get r "cache_misses") > (get existing "cache_misses")
            set existing "cache_misses" (get r "cache_misses")
        set existing "last_ts" (get r "ts")
    total_cost: 0
    total_tokens: 0
    total_calls: 0
    per_session: []
    for sid in order
        s: get sessions sid
        total_cost: total_cost + (get s "cost_usd")
        total_tokens: total_tokens + (get s "tokens")
        total_calls: total_calls + (get s "calls")
        push per_session s
    reversed: []
    i: (len per_session) - 1
    while i >= 0
        push reversed (at per_session i)
        i: i - 1
    out: {}
    set out "total_cost_usd" total_cost
    set out "total_tokens" total_tokens
    set out "total_calls" total_calls
    set out "session_count" (len order)
    set out "sessions" reversed
    out

--! SQL safety escape for strings in single quotes.
export fn sql_escape s
    replace_all s "'" "''"

--! Thin pass-throughs to db_exec/db_query for modules that can't import
--! their own "sqlite" — the sqlite module exports a function 'exec(handle,
--! sql)' that SILENTLY overrides the global exec() builtin (process
--! execution) as soon as "sqlite" (bare or aliased with 'as') is imported in
--! the same file scope (reproduced live: see the docker_tools.pipe comment).
--! docker_tools.pipe needs both real exec() and DB access to the SAME handle
--! as mem.open_locked/init_db (a separately aliased "sqlite" module there
--! creates its own, incompatible handle registry — "Invalid database
--! handle" when accessed with a handle created elsewhere) — these two
--! pass-throughs solve both, without docker_tools.pipe having to import
--! "sqlite" itself.
export fn raw_exec h sql
    db_exec h sql

export fn raw_query h sql
    db_query h sql

--! Current timestamp in SQLite's "datetime('now')" format (sortable string).
--! Note: the pure-Pipe sqlite module does NOT evaluate `datetime('now')` as
--! a function — the literal string "now" ends up in the column. So we build
--! the timestamp here ourselves from Pipe's own now/format_time builtins and
--! pass it along like any other string value.
export fn now_ts _
    format_time now "2006-01-02 15:04:05"

--! Stores a memory (kind: one of memory/task/fact/question; importance 1-5).
--! Computes an embedding and stores it for RAG search. Returns the id.
--! Prevents duplicates for "permanent" (permanent user facts like "I am
--! Harry..."): the same content (case and whitespace don't matter) is not
--! inserted again, only its importance is raised — otherwise the same
--! memory piles up repeatedly on repeated statements, without improving
--! retrieval quality. Other kinds (especially "document" — ingest_document
--! deliberately stores multiple chunks, even identical-content ones) are
--! NOT affected by this.
export fn add_memory h content kind importance source tags
    if kind == "permanent"
        --! Normalization MUST happen in Pipe, not in SQL: the pure-Pipe
        --! sqlite module (~/.pipe/modules/sqlite.pipe, eval_expr/"func") only
        --! knows count/sum/avg/min/max as functions — lower()/trim() in a
        --! WHERE clause fall back to the unchanged raw value (the same class
        --! of limitation as the datetime('now') workaround in now_ts above).
        norm: lower (trim content)
        candidates: db_query h "SELECT id, content, importance FROM memories WHERE kind = 'permanent'"
        for c in candidates
            if (lower (trim (get c "content"))) == norm
                eid: get c "id"
                eimp: get c "importance"
                newimp: eimp
                if importance > eimp
                    newimp: importance
                if newimp > 5
                    newimp: 5
                db_exec h ("UPDATE memories SET importance = " ++ (to_str newimp) ++ ", ts = '" ++ (sql_escape (now_ts 0)) ++ "' WHERE id = " ++ (to_str eid))
                return eid
    db_exec h ("INSERT INTO memories (content, kind, importance, source, ts, tags) VALUES ('" ++ (sql_escape content) ++ "', '" ++ (sql_escape kind) ++ "', " ++ (to_str importance) ++ ", '" ++ (sql_escape source) ++ "', '" ++ (sql_escape (now_ts 0)) ++ "', '" ++ (sql_escape tags) ++ "')")
    rid: get (at (db_query h "SELECT max(id) AS mid FROM memories") 0) "mid"
    vec: nil
    try
        vec: embed content
    catch e
        --! Silently degrades to keyword-only search (see retrieve_context)
        --! — works, but worse. Log ONCE per process run (see EMBED_STATE
        --! above), so a permanently broken embedding doesn't go unnoticed,
        --! without spamming on every add_memory.
        if (get EMBED_STATE "warned") == false
            print ("embed() failed (memories will be stored without embeddings from now on, keyword search only): " ++ (to_str e))
            log_error h "embed" (to_str e)
            set EMBED_STATE "warned" true
        vec: nil
    if vec != nil
        db_exec h ("INSERT INTO embeddings (memory_id, vec) VALUES (" ++ (to_str rid) ++ ", '" ++ (sql_escape (to_json vec)) ++ "')")
    auto_link h content
    rid

--! Logs an incoming event (for audit/debug).
export fn log_event h chat_id text kind
    db_exec h ("INSERT INTO events (chat_id, msg, kind, ts) VALUES ('" ++ (sql_escape chat_id) ++ "', '" ++ (sql_escape text) ++ "', '" ++ (sql_escape kind) ++ "', '" ++ (sql_escape (now_ts 0)) ++ "')")

--! Document ingestion (P2): bring URLs/uploaded text files into the
--! knowledge base. PDFs/binary formats are deliberately out of scope — Pipe
--! is a dependency-free binary with no PDF library; a connected MCP server
--! with extraction would be the natural path for that (P1).

--! Splits a long text into chunks of up to max_len characters, preferring
--! paragraph boundaries (blank line), otherwise hard-cut. Pure function (no
--! AI/network), deterministically testable.
export fn chunk_text text max_len
    text: trim text
    out: []
    if text == ""
        return out
    paras: split text "\n\n"
    cur: ""
    for p0 in paras
        p: trim p0
        if p != ""
            if cur == ""
                fits: (len p) <= max_len
            else
                fits: ((len cur) + (len p) + 2) <= max_len
            if fits
                if cur == ""
                    cur: p
                else
                    cur: cur ++ "\n\n" ++ p
            else
                if cur != ""
                    push out cur
                    cur: ""
                if (len p) <= max_len
                    cur: p
                else
                    i: 0
                    while i < (len p)
                        push out (substring p i (i + max_len))
                        i: i + max_len
    if cur != ""
        push out cur
    out

--! Takes document content already available as text (from a URL or an
--! uploaded file) into the knowledge base: splits it into chunks and stores
--! each as its own memory (kind "document", incl. embedding for RAG and
--! auto-linking via add_memory). max_chunks limits cost/duration for very
--! large documents (further chunks are discarded). Returns {chunks_total,
--! chunks_ingested}.
export fn ingest_document h text source title max_chunks
    chunks: chunk_text text 1200
    total: len chunks
    n: total
    if n > max_chunks
        n: max_chunks
    i: 0
    while i < n
        tag: title ++ " [" ++ (to_str (i + 1)) ++ "/" ++ (to_str total) ++ "]"
        add_memory h (at chunks i) "document" 2 source tag
        i: i + 1
    out: {}
    set out "chunks_total" total
    set out "chunks_ingested" n
    out

--! Counts entities and relations in the knowledge graph (status/debug).
export fn graph_counts h
    e: get (at (db_query h "SELECT COUNT(*) AS c FROM entities") 0) "c"
    r: get (at (db_query h "SELECT COUNT(*) AS c FROM relations") 0) "c"
    out: {}
    set out "entities" e
    set out "relations" r
    out

--! Number of active threads (status/debug, web dashboard P3).
export fn active_thread_count h
    get (at (db_query h "SELECT COUNT(*) AS c FROM threads WHERE state = 'active'") 0) "c"

--! Memories WITH id for management (web dashboard P3). Without q: the n
--! most important. With q: simple LIKE keyword search over content, newest
--! first (no embedding ranking — good enough for a quick management list;
--! retrieve_context remains responsible for actual content questions).
--! q: keyword filter (LIKE over content) or nil/"". kind: exact kind filter
--! or nil/"". Both combinable.
export fn list_memories h q kind limit
    conds: []
    if q != nil && q != ""
        push conds ("content LIKE '%" ++ (sql_escape q) ++ "%'")
    if kind != nil && kind != ""
        push conds ("kind = '" ++ (sql_escape kind) ++ "'")
    where_sql: ""
    if (len conds) > 0
        where_sql: " WHERE " ++ (join conds " AND ")
    order_sql: " ORDER BY importance DESC, id DESC"
    if q != nil && q != ""
        order_sql: " ORDER BY id DESC"
    db_query h ("SELECT id, content, kind, importance, ts, tags FROM memories" ++ where_sql ++ order_sql ++ " LIMIT " ++ (to_str limit))

--! Deletes a memory incl. its embedding (web dashboard P3).
export fn delete_memory h id
    db_exec h ("DELETE FROM memories WHERE id = " ++ (to_str id))
    db_exec h ("DELETE FROM embeddings WHERE memory_id = " ++ (to_str id))
    "ok"

--! Fetches the N most important memories (high importance first).
export fn top_memories h n
    db_query h ("SELECT content, kind, importance, ts, tags FROM memories ORDER BY importance DESC, id DESC LIMIT " ++ (to_str n))

--! Counts memories (test helper).
export fn memory_count h
    rows: db_query h "SELECT COUNT(*) AS c FROM memories"
    get (at rows 0) "c"

--! Fetches the N most recent events (audit/debug).
export fn recent_events h n
    db_query h ("SELECT chat_id, msg, kind, ts FROM events ORDER BY id DESC LIMIT " ++ (to_str n))

--! Creates a goal and returns the id.
export fn add_goal h text
    db_exec h ("INSERT INTO goals (text, status) VALUES ('" ++ (sql_escape text) ++ "', 'open')")
    get (at (db_query h "SELECT max(id) AS mid FROM goals") 0) "mid"

--! The n most recent goals (web dashboard P3). "text" is a SQL type keyword
--! in the pure-Pipe sqlite module — an unqualified SELECT of a column named
--! "text" fails to parse (INSERT/CREATE TABLE tolerate the name, a bare
--! "SELECT text" doesn't); table-qualified ("goals.text") works.
export fn list_goals h limit
    db_query h ("SELECT id, goals.text AS goal_text, status FROM goals ORDER BY id DESC LIMIT " ++ (to_str limit))

--! Sets a goal's status (e.g. "open"/"done", web dashboard P3).
export fn set_goal_status h id status
    db_exec h ("UPDATE goals SET status = '" ++ (sql_escape status) ++ "' WHERE id = " ++ (to_str id))

--! Sets a memory's importance directly (web dashboard P3, manual curation
--! alongside automatic consolidation).
export fn set_importance h id importance
    db_exec h ("UPDATE memories SET importance = " ++ (to_str importance) ++ " WHERE id = " ++ (to_str id))

--! Adjusts the importance of ALL memories whose content exactly matches
--! `content` (feedback learning P4: 👍/👎 on a stored answer). delta is
--! clamped to 1..5. Returns the number of memories changed.
export fn adjust_by_content h content delta
    rows: db_query h ("SELECT id, importance FROM memories WHERE content = '" ++ (sql_escape content) ++ "'")
    changed: 0
    for m in rows
        imp: (get m "importance") + delta
        if imp < 1
            imp: 1
        if imp > 5
            imp: 5
        db_exec h ("UPDATE memories SET importance = " ++ (to_str imp) ++ " WHERE id = " ++ (to_str (get m "id")))
        changed: changed + 1
    changed

--! Episodic memory (P2): one thread per chat, managed in "threads" (title =
--! chat_id as a string, state = active/closed) — the table was created
--! earlier but unused. Messages live chronologically in "messages".

--! Returns the id of a chat's active thread (creates a new one if needed).
export fn active_thread h chat_id
    cid: to_str chat_id
    rows: db_query h ("SELECT id FROM threads WHERE title = '" ++ (sql_escape cid) ++ "' AND state = 'active'")
    if (len rows) > 0
        get (at rows 0) "id"
    else
        db_exec h ("INSERT INTO threads (title, state) VALUES ('" ++ (sql_escape cid) ++ "', 'active')")
        get (at (db_query h "SELECT max(id) AS mid FROM threads") 0) "mid"

--! Closes a chat's active thread (e.g. via /reset) — the next active_thread
--! call creates a fresh thread without the old history.
export fn close_thread h chat_id
    db_exec h ("UPDATE threads SET state = 'closed' WHERE title = '" ++ (sql_escape (to_str chat_id)) ++ "' AND state = 'active'")

--! Adds a message to a thread. role: "user" or "assistant".
export fn add_message h thread_id chat_id role content
    db_exec h ("INSERT INTO messages (thread_id, chat_id, role, content, ts) VALUES (" ++ (to_str thread_id) ++ ", '" ++ (sql_escape (to_str chat_id)) ++ "', '" ++ (sql_escape role) ++ "', '" ++ (sql_escape content) ++ "', '" ++ (sql_escape (now_ts 0)) ++ "')")

--! The last n messages of a thread, chronologically (oldest first).
export fn thread_history h thread_id n
    rows: db_query h ("SELECT role, content FROM messages WHERE thread_id = " ++ (to_str thread_id) ++ " ORDER BY id DESC LIMIT " ++ (to_str n))
    out: []
    i: (len rows) - 1
    while i >= 0
        push out (at rows i)
        i: i - 1
    out

--! Formats a thread history (list of {role, content}) as prompt text.
export fn format_history rows
    out: ""
    for r in rows
        who: "User"
        if (get r "role") == "assistant"
            who: "Muninn"
        out: out ++ who ++ ": " ++ (get r "content") ++ "\n"
    out

--! Consolidation ("dream", P2): periodic cleanup/condensing job. Not
--! automatically scheduled (no scheduler before P4) — call manually via
--! `pipe muninn.pipe consolidate` or via an external cron.

--! Timestamp string n days before now, in the same format as now_ts (for
--! age comparisons as a simple string WHERE condition).
export fn cutoff_ts days_ago
    format_time (now - (days_ago * 86400)) "2006-01-02 15:04:05"

--! Structured error log for self-diagnosis (see muninn.pipe: sched_tick
--! "selbstdiagnose"). Complements (does NOT replace) the existing print()
--! calls at the same sites — journalctl remains the complete, chronological
--! record, error_log is a COUNTABLE subset, persistent across restarts, for
--! automated evaluation. "tag" MUST be a stable, short identifier (e.g.
--! "run_gremium_stream"), NOT the variable error message itself — otherwise
--! error_summary can't group anything together. Deliberately best-effort: a
--! failed log write attempt must never itself throw an error (otherwise
--! error logging could itself generate new errors).
export fn log_error h tag message
    try
        db_exec h ("INSERT INTO error_log (tag, message, ts) VALUES ('" ++ (sql_escape tag) ++ "', '" ++ (sql_escape message) ++ "', '" ++ (sql_escape (now_ts 0)) ++ "')")
    catch e
        nil

--! Error frequency per tag over the last 'days' days, sorted descending by
--! count — basis for the daily self-diagnosis.
export fn error_summary h days
    cut: cutoff_ts days
    db_query h ("SELECT tag, COUNT(*) as cnt, MAX(ts) as last_ts FROM error_log WHERE ts > '" ++ (sql_escape cut) ++ "' GROUP BY tag ORDER BY cnt DESC")

--! Cleans up error_log entries older than 'days' days, part of
--! consolidate() — otherwise the table grows unbounded.
export fn prune_error_log h days
    cut: cutoff_ts days
    db_exec h ("DELETE FROM error_log WHERE ts < '" ++ (sql_escape cut) ++ "'")

--! Condenses due threads (closed, or active but with no new message for
--! inactive_days) into one summary memory each (kind "summary") and then
--! deletes their raw messages. Rows with the legacy sentinel value "now"
--! (see the now_ts comment) count as unknown age and only become due via
--! the "closed" state, never via inactivity.
export fn consolidate_threads h inactive_days
    cutoff: cutoff_ts inactive_days
    threads: db_query h "SELECT id, state FROM threads WHERE state = 'closed' OR state = 'active'"
    done: 0
    for t in threads
        tid: get t "id"
        eligible: (get t "state") == "closed"
        if !eligible
            last: db_query h ("SELECT MAX(ts) AS last_ts FROM messages WHERE thread_id = " ++ (to_str tid))
            if (len last) > 0
                lts: get (at last 0) "last_ts"
                if lts != nil && lts != "now" && lts < cutoff
                    eligible: true
        if eligible
            msgs: db_query h ("SELECT role, content FROM messages WHERE thread_id = " ++ (to_str tid) ++ " ORDER BY id ASC")
            if (len msgs) > 0
                text: format_history msgs
                summary: ""
                try
                    summary: summarize text
                catch e
                    summary: substring text 0 800
                add_memory h ("Conversation summary: " ++ summary) "summary" 2 "consolidation" ("thread-" ++ (to_str tid))
                db_exec h ("DELETE FROM messages WHERE thread_id = " ++ (to_str tid))
                done: done + 1
            db_exec h ("UPDATE threads SET state = 'archived' WHERE id = " ++ (to_str tid))
    done

--! Lowers the importance of old, non-"permanent" memories by 1 per run and
--! forgets (deletes) them once they've reached importance 0 AND are older
--! than forget_after_days. "permanent" (explicit "remember that...") stays
--! untouched — that's deliberately permanent knowledge. Rows with the legacy
--! sentinel "now" are skipped (age unknown).
export fn consolidate_memories h decay_after_days forget_after_days
    decay_cut: cutoff_ts decay_after_days
    forget_cut: cutoff_ts forget_after_days
    rows: db_query h "SELECT id, importance, ts FROM memories WHERE kind != 'permanent'"
    decayed: 0
    forgotten: 0
    for m in rows
        ts: get m "ts"
        if ts != nil && ts != "now"
            mid: get m "id"
            imp: get m "importance"
            if imp <= 0 && ts < forget_cut
                db_exec h ("DELETE FROM memories WHERE id = " ++ (to_str mid))
                db_exec h ("DELETE FROM embeddings WHERE memory_id = " ++ (to_str mid))
                forgotten: forgotten + 1
            else
                if imp > 0 && ts < decay_cut
                    db_exec h ("UPDATE memories SET importance = " ++ (to_str (imp - 1)) ++ " WHERE id = " ++ (to_str mid))
                    decayed: decayed + 1
    out: {}
    set out "decayed" decayed
    set out "forgotten" forgotten
    out

--! Main entry point of consolidation: condense threads after 3 days of
--! inactivity, age non-permanent memories by 1 step starting at decay_days,
--! permanently forget them at importance 0 starting at forget_days. The
--! previous fixed default was 14/30 — now controllable via the "gedaechtnis"
--! setting (see setting_consolidate_days), callers without chat context
--! (e.g. the CLI cron mode) still simply pass 14/30 directly.
export fn consolidate h decay_days forget_days
    threads_summarized: consolidate_threads h 3
    mres: consolidate_memories h decay_days forget_days
    prune_error_log h 30
    out: {}
    set out "threads_summarized" threads_summarized
    set out "memories_decayed" (get mres "decayed")
    set out "memories_forgotten" (get mres "forgotten")
    out

--! Classifies an incoming message into a category via AI.
--! Fallback (no AI): simple rule-based classification.
export fn classify_input text
    try
        classify text (["permanent", "reminder", "fleeting", "task", "goal", "question"])
    catch e
        rule_classify text

--! Rule-based classification (deterministic, no AI) — for tests and fallback.
--! "erinnere" (remind) means a time-based reminder (P4); "merke"/"denke an"
--! (remember) a permanent memory — the two used to be one ("permanent").
export fn rule_classify text
    t: lower text
    if contains t "erinnere"
        "reminder"
    else
        if contains t "merke" || contains t "denke an" || contains t "notiere"
            "permanent"
        else
            if contains t "erledige" || contains t "to-do" || contains t "aufgabe" || contains t "mache" || contains t "lege" || contains t "erstelle" || contains t "schreibe" || contains t "anlegen" || contains t "erstellen"
                "task"
            else
                if contains t "ziel" || contains t "erreichen" || contains t "wollen"
                    "goal"
                else
                    "question"

--! Condenses text via AI into a short form (fallback: unchanged).
export fn condense text
    try
        summarize text
    catch e
        text

--! Condenses an (answer) text into a short fact for remembering (fix: the
--! "remember" function previously stored raw answers verbatim, sometimes
--! polluted with gremium reasoning). AI shortening with a deterministic
--! fallback to the first 300 characters (instead of the complete text).
export fn condense_fact text
    try
        summarize text
    catch e
        substring text 0 300

--! Stopword check (German + English).
fn is_stop t
    stops: split "a an the and or but if of in on at to for with about into is are was were be been being do does did doing how what which who this that these those it its as from by can could should would will not no nor your you we they he she has have had i me my them their there here when where why then than so too very just also using use der die das den dem des ein eine einer einem eines und oder aber wenn von im auf an zu zur zum für mit über ist sind war waren bin bist sein wird werden wie was welche wer dieser diese dieses es ich du er sie wir ihr man nicht kein keine auch als aus bei nach nur schon noch dann da hier dort warum wann" " "
    contains stops t

--! Splits text into relevant lowercase tokens (without stopwords).
fn tokenize text
    low: lower text
    cleaned: regex_replace "[^a-z0-9äöüß_]+" " " low
    parts: split cleaned " "
    out: []
    for t in parts
        if (len t) > 1 && (not (is_stop t))
            push out t
    out

--! Document frequency: for each token, how many texts it appears in.
fn build_df contents
    df: {}
    for c in contents
        toks: tokenize c
        seen: {}
        for t in toks
            if (get seen t) == nil
                set seen t true
                cur: get df t
                if cur == nil
                    set df t 1
                else
                    set df t (cur + 1)
    df

--! TF-IDF-like term weight (float, so the division doesn't collapse to an integer).
fn term_weight t df n
    dfv: get df t
    if dfv == nil
        dfv: 1.0
    (n + 1.0) / (dfv + 1.0)

fn keyword_denom terms df n
    sum: 0
    for t in terms
        sum: sum + (term_weight t df n)
    sum

fn keyword_score content_lower terms df n
    score: 0
    for t in terms
        if contains content_lower t
            score: score + (term_weight t df n)
    score

--! RAG: hybrid search (keyword TF-IDF + semantic embedding).
--! DeepSeek only provides 128-dim lexical embeddings → keyword dominates (0.75).
--! With real embeddings (>300 dim, e.g. OpenAI) semantics takes over (0.7).
export fn retrieve_context h query k
    if query == nil || query == ""
        return []
    rows: db_query h "SELECT id, content, importance, kind FROM memories ORDER BY id DESC"
    if (len rows) == 0
        return []
    vecs: db_query h "SELECT memory_id, vec FROM embeddings"
    vecmap: {}
    for v in vecs
        set vecmap (to_str (get v "memory_id")) (get v "vec")
    contents: []
    for r in rows
        push contents (get r "content")
    n: len contents
    terms: tokenize query
    df: build_df contents
    kw_denom: keyword_denom terms df n
    qvec: nil
    try
        qvec: embed query
    catch e
        qvec: nil
    sem_w: 0.25
    kw_w: 0.75
    if qvec != nil
        if (len qvec) > 300
            sem_w: 0.7
            kw_w: 0.3
    scored: []
    --! CRITICAL BUG (found live: "Who am I?" found "no entry" despite the
    --! identity being stored multiple times): kw_denom is 0 when ALL query
    --! tokens are stopwords ("who"/"am"/"I" are all in is_stop) — then kw
    --! stays 0 for EVERY memory. sem is ALWAYS 0, since embed() fundamentally
    --! fails without OPENAI_API_KEY (see EMBED_STATE above). In this case the
    --! score is IDENTICALLY 0 for ALL 249+ memories — the "if (len out) == 0"
    --! fallback below never kicked in, because the top-k selection, despite
    --! uniformly 0 points, still isn't empty (sorted_by, on a total tie,
    --! simply returns the first k entries in input order, here: the NEWEST
    --! memories by id DESC) — so the gremium was handed completely arbitrary
    --! recent memories as "context", never the actually stored identity.
    --! any_signal now explicitly tracks whether ANY memory had a REAL (> 0)
    --! score — only then is the scored list used at all, otherwise the
    --! fallback now actually kicks in.
    any_signal: false
    for r in rows
        c: get r "content"
        kw: 0
        if kw_denom > 0
            kw: (keyword_score (lower c) terms df n) / kw_denom
        sem: 0
        if qvec != nil
            vj: get vecmap (to_str (get r "id"))
            if vj != nil
                cv: nil
                try
                    cv: parse_json vj
                catch e2
                    cv: nil
                if cv != nil
                    sem: cosine_sim qvec cv
        score: (sem * sem_w) + (kw * kw_w)
        if score > 0
            any_signal: true
        push scored {content: c, score: score, kind: (get r "kind")}
    out: []
    if any_signal
        ordered: sorted_by scored (fn x: (0 - (get x "score")))
        i: 0
        while i < k && i < (len ordered)
            item: at ordered i
            c: get item "content"
            --! Provenance marking: "fact" & co. are AI research results or
            --! task logs, NOT statements the user made about themselves —
            --! without this marking the gremium otherwise mistakes them for
            --! user preferences (observed: an old AfD research result was
            --! misread, on "What am I interested in?", as a "clear signal of
            --! political interest", even though it was just earlier research
            --! for a DIFFERENT question). "permanent"/"document" stay
            --! unmarked: those are explicit user statements or self-taught
            --! content.
            k2: get item "kind"
            if k2 != "permanent" && k2 != "document"
                c: "[earlier research/log entry, NOT a statement by the user] " ++ c
            push out c
            i: i + 1
    if (len out) == 0
        --! Fallback: questions like "Who am I?" consist almost entirely of
        --! stopwords (who/am/I, see is_stop) and therefore ALWAYS yield 0
        --! keyword hits, no matter what's stored. Without real embeddings
        --! (DeepSeek doesn't support them, OPENAI_API_KEY optional/empty, see
        --! comment above) there would otherwise be no signal path to
        --! permanent facts — so fall back here to the most important
        --! permanent memories instead of returning "nothing found".
        perm: db_query h ("SELECT content FROM memories WHERE kind = 'permanent' ORDER BY importance DESC, id DESC LIMIT " ++ (to_str k))
        for r in perm
            push out (get r "content")
    else
        --! Live bug (P10, follow-up finding): the stopword fallback above
        --! alone was NOT enough — the gremium often freely rephrases the
        --! search query on the tool call (e.g. "Who am I?" -> "user identity
        --! name personal data"), which can well set any_signal to true (some
        --! other, less important memory happens to match a word), WITHOUT
        --! the actual identity (phrased in completely different lexical
        --! terms: "I am Harry Machura, born...") ever showing up in the
        --! result. So here we ALWAYS mix in the most important "permanent"
        --! memory, if one exists and it isn't already included — by
        --! definition those are explicit, permanent core facts about the
        --! user (name, birthdate, preferences), exactly what identity/self
        --! questions typically search for. ONLY from k>=2: at k=1 the caller
        --! explicitly wants EXACTLY the one best match, which a blanket
        --! identity merge must not overwrite (caught live as a test
        --! regression: a k=1 match with a genuine word-overlap hit was
        --! wrongly replaced by another "permanent" memory that was merely
        --! coincidentally older/newer).
        if k >= 2
            top_perm: db_query h "SELECT content FROM memories WHERE kind = 'permanent' ORDER BY importance DESC, id DESC LIMIT 1"
            if (len top_perm) > 0
                perm_content: get (at top_perm 0) "content"
                already_present: false
                for c in out
                    if c == perm_content
                        already_present: true
                if !already_present
                    if (len out) < k
                        push out perm_content
                    else
                        set out (k - 1) perm_content
    out

--! All stored workflow recipes (kind "rezept"), most important first.
--! Deliberately without embedding search: recipes are rare and short — the
--! AI should pick the right one itself from the small list.
export fn recipes h
    rows: db_query h "SELECT content FROM memories WHERE kind = 'rezept' ORDER BY importance DESC, id DESC LIMIT 10"
    out: []
    for r in rows
        push out (get r "content")
    out

--! Pure keyword search (deterministic, without embedding).
export fn keyword_retrieve h query k
    terms: tokenize query
    rows: db_query h "SELECT content FROM memories ORDER BY importance DESC, id DESC"
    out: []
    for r in rows
        c: get r "content"
        lc: lower c
        for t in terms
            if contains lc t
                if !(contains out c)
                    if (len out) < k
                        push out c
    out

--! Knowledge graph: creates an entity (or returns its id). kind: node/place/person/...
export fn add_entity h name kind
    rows: db_query h ("SELECT id FROM entities WHERE name = '" ++ (sql_escape name) ++ "'")
    if (len rows) > 0
        get (at rows 0) "id"
    else
        db_exec h ("INSERT INTO entities (name, kind) VALUES ('" ++ (sql_escape name) ++ "', '" ++ (sql_escape kind) ++ "')")
        get (at (db_query h "SELECT max(id) AS mid FROM entities") 0) "mid"

--! Knowledge graph: links two entities via a relation (deduplicated: the
--! same (from, to, rel) combination is not created twice — important, since
--! auto_link (P2) can repeatedly extract the same relationship across
--! multiple memories).
export fn add_relation h from_name to_name rel
    a: add_entity h from_name "node"
    b: add_entity h to_name "node"
    existing: db_query h ("SELECT id FROM relations WHERE from_id = " ++ (to_str a) ++ " AND to_id = " ++ (to_str b) ++ " AND rel = '" ++ (sql_escape rel) ++ "'")
    if (len existing) == 0
        db_exec h ("INSERT INTO relations (from_id, to_id, rel) VALUES (" ++ (to_str a) ++ ", " ++ (to_str b) ++ ", '" ++ (sql_escape rel) ++ "')")
    "ok"

--! Knowledge graph: all neighbors of an entity (with relation and target name).
export fn neighbors_of h name
    rows: db_query h ("SELECT r.rel, e2.name AS target FROM entities e1 JOIN relations r ON r.from_id = e1.id JOIN entities e2 ON e2.id = r.to_id WHERE e1.name = '" ++ (sql_escape name) ++ "'")
    rows

--! Auto entities (P2): writes entities/relations from an already-available
--! extraction result (map with "entities"/"relations") into the knowledge
--! graph. Kept separate from auto_link so this processing is
--! deterministically testable without AI.
export fn apply_extraction h extraction
    if extraction == nil
        return nil
    ents: get extraction "entities"
    if ents != nil
        for e in ents
            n: get e "name"
            k: get e "kind"
            if n != nil && n != ""
                if k == nil || k == ""
                    k: "node"
                add_entity h n k
    rels: get extraction "relations"
    if rels != nil
        for r in rels
            f: get r "from"
            t: get r "to"
            rl: get r "rel"
            if f != nil && f != "" && t != nil && t != "" && rl != nil && rl != ""
                add_relation h f t rl
    nil

--! Extracts named entities + their relationships from a text via AI and
--! automatically links them in the knowledge graph (best-effort: without an
--! AI provider or on errors nothing happens, the caller is not interrupted).
export fn auto_link h text
    if text == nil || (trim text) == ""
        return nil
    try
        j: ai_chat_json "Extract named entities (people, places, organizations, things, concepts) and their relationships from the text. Respond exclusively as a JSON object with 'entities' (list of objects with 'name' and 'kind') and 'relations' (list of objects with 'from', 'to' and 'rel'). Only entities clearly named in the text, no guessing. With no recognizable entities: {\"entities\": [], \"relations\": []}." text
        apply_extraction h j
    catch e
        nil
