--! memory.pipe — Muninns persistente "Seele".
--! Alles Gedächtnis liegt in einer sqlite-Datei; die Seele wird ohne KI-Call
--! wiederhergestellt. Eingehende Nachrichten werden klassifiziert und verdichtet.
import "sqlite"

DB_PATH: "muninn.db"
LOCK_PATH: "muninn.db.lock"

--! Öffnet die Datenbank und legt das Schema an (idempotent).
--! path: optionaler Dateipfad (z.B. ":memory:"); nil = DB_PATH.
export fn init_db path
    p: DB_PATH
    if path != nil && path != ""
        p: path
    h: db_open p
    db_exec h "CREATE TABLE IF NOT EXISTS meta (mkey TEXT PRIMARY KEY, mval TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS memories (id INTEGER PRIMARY KEY AUTOINCREMENT, content TEXT, kind TEXT, importance INTEGER DEFAULT 0, source TEXT, ts TEXT, tags TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS threads (id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT, state TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS goals (id INTEGER PRIMARY KEY AUTOINCREMENT, text TEXT, status TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS events (id INTEGER PRIMARY KEY AUTOINCREMENT, chat_id TEXT, msg TEXT, kind TEXT, ts TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS embeddings (memory_id INTEGER PRIMARY KEY, vec TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS entities (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT UNIQUE, kind TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS relations (id INTEGER PRIMARY KEY AUTOINCREMENT, from_id INTEGER, to_id INTEGER, rel TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS messages (id INTEGER PRIMARY KEY AUTOINCREMENT, thread_id INTEGER, chat_id TEXT, role TEXT, content TEXT, ts TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS cost_log (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id INTEGER, ts TEXT, cost_usd REAL, tokens INTEGER, calls INTEGER, cache_hits INTEGER, cache_misses INTEGER)"
    h

--! Schließt die Datenbank und persistiert die Änderungen auf die Datei.
export fn close h
    db_close h

--! Oeffnet die (Datei-)Datenbank exklusiv gesperrt gegen andere Muninn-
--! Prozesse (Telegram-Loop, Dashboard, Konsolidierung — alle koennen
--! gleichzeitig laufen). Noetig, weil das reine-Pipe-sqlite-Modul beim
--! Oeffnen einen Snapshot in den Speicher laedt und beim Schliessen die
--! GESAMTE Datei atomar zurueckschreibt, ohne eigene prozessuebergreifende
--! Sperre: zwei Prozesse, die "gleichzeitig" (auch nur Sekunden auseinander)
--! oeffnen/schreiben/schliessen, koennen sich sonst gegenseitig committete
--! Schreibvorgaenge stillschweigend ueberschreiben (live reproduziert). Fuer
--! ":memory:"-Datenbanken (Tests) ist das irrelevant — dort ohne Lock nutzen.
--! Liefert {h, lock}; IMMER zusammen mit close_locked verwenden.
export fn open_locked path
    lock: file_lock LOCK_PATH
    out: {}
    set out "h" (init_db path)
    set out "lock" lock
    out

--! Schliesst eine mit open_locked geoeffnete Datenbank und gibt die Sperre
--! wieder frei (Reihenfolge wichtig: erst db schliessen/committen, dann
--! entsperren — sonst koennte ein wartender Prozess vor dem Commit lesen).
export fn close_locked handle
    close (get handle "h")
    file_unlock (get handle "lock")

--! Setzt einen Meta-Schlüssel (INSERT oder UPDATE).
export fn meta_set h key value
    rows: db_query h ("SELECT mkey FROM meta WHERE mkey = '" ++ (sql_escape key) ++ "'")
    if (len rows) > 0
        db_exec h ("UPDATE meta SET mval = '" ++ (sql_escape value) ++ "' WHERE mkey = '" ++ (sql_escape key) ++ "'")
    else
        db_exec h ("INSERT INTO meta (mkey, mval) VALUES ('" ++ (sql_escape key) ++ "', '" ++ (sql_escape value) ++ "')")

--! Liest einen Meta-Schlüssel (oder "").
export fn meta_get h key
    rows: db_query h ("SELECT mval FROM meta WHERE mkey = '" ++ (sql_escape key) ++ "'")
    if (len rows) > 0
        get (at rows 0) "mval"
    else
        ""

--! Neue Session-ID (fortlaufend über meta gezählt) — ein "Session" ist hier
--! ein Prozesslauf von `pipe muninn.pipe` (Start bis Neustart/Absturz), weil
--! ai_cost/ai_tokens reine In-Prozess-Zaehler sind, die bei jedem Neustart
--! wieder bei 0 anfangen. Beim Start einmal aufrufen.
export fn next_session_id h
    cur: meta_get h "session_counter"
    n: 0
    if cur != nil && cur != ""
        n: to_num cur
    n: n + 1
    meta_set h "session_counter" (to_str n)
    n

--! Schreibt einen Kosten-Schnappschuss (kumulierte Werte des laufenden
--! Prozesses laut ai_cost/ai_tokens, nicht als Delta). Nur aufrufen, wenn
--! sich seit dem letzten Schnappschuss etwas geaendert hat (Aufrufer-
--! Verantwortung, siehe muninn.pipe) — sonst waechst die Tabelle unnoetig.
export fn log_cost h session_id cost_usd tokens calls cache_hits cache_misses
    db_exec h ("INSERT INTO cost_log (session_id, ts, cost_usd, tokens, calls, cache_hits, cache_misses) VALUES (" ++ (to_str session_id) ++ ", '" ++ (sql_escape (now_ts 0)) ++ "', " ++ (to_str cost_usd) ++ ", " ++ (to_str tokens) ++ ", " ++ (to_str calls) ++ ", " ++ (to_str cache_hits) ++ ", " ++ (to_str cache_misses) ++ ")")
    nil

--! Aggregiert cost_log zu einer Zusammenfassung: Gesamtkosten/-tokens/-calls
--! ueber alle Sessions (Summe der jeweiligen Session-Maxima, da die Werte
--! PRO SESSION monoton steigende Zaehler sind) plus eine Liste pro Session
--! {session_id, cost_usd, tokens, calls, cache_hits, cache_misses, first_ts,
--! last_ts}, neueste zuerst. Aggregation bewusst in Pipe statt per SQL
--! GROUP BY/MAX (die reine-Pipe-sqlite-Engine hat an anderer Stelle bereits
--! nicht dokumentierte SQL-Funktionen stillschweigend ignoriert, siehe
--! add_memory-Kommentar weiter unten — hier daher lieber verifizierbar in
--! Pipe selbst gerechnet).
export fn cost_summary h
    rows: db_query h "SELECT session_id, ts, cost_usd, tokens, calls, cache_hits, cache_misses FROM cost_log ORDER BY id ASC"
    sessions: {}
    order: []
    for r in rows
        sid: to_str (get r "session_id")
        existing: get sessions sid
        if existing == nil
            fresh: {session_id: (get r "session_id"), cost_usd: 0, tokens: 0, calls: 0, cache_hits: 0, cache_misses: 0, first_ts: (get r "ts"), last_ts: (get r "ts")}
            set sessions sid fresh
            push order sid
            existing: fresh
        if (get r "cost_usd") > (get existing "cost_usd")
            set existing "cost_usd" (get r "cost_usd")
        if (get r "tokens") > (get existing "tokens")
            set existing "tokens" (get r "tokens")
        if (get r "calls") > (get existing "calls")
            set existing "calls" (get r "calls")
        if (get r "cache_hits") > (get existing "cache_hits")
            set existing "cache_hits" (get r "cache_hits")
        if (get r "cache_misses") > (get existing "cache_misses")
            set existing "cache_misses" (get r "cache_misses")
        set existing "last_ts" (get r "ts")
    total_cost: 0
    total_tokens: 0
    total_calls: 0
    per_session: []
    for sid in order
        s: get sessions sid
        total_cost: total_cost + (get s "cost_usd")
        total_tokens: total_tokens + (get s "tokens")
        total_calls: total_calls + (get s "calls")
        push per_session s
    reversed: []
    i: (len per_session) - 1
    while i >= 0
        push reversed (at per_session i)
        i: i - 1
    out: {}
    set out "total_cost_usd" total_cost
    set out "total_tokens" total_tokens
    set out "total_calls" total_calls
    set out "session_count" (len order)
    set out "sessions" reversed
    out

--! SQL-Sicherheits-Escape für Strings in einfachen Anführungszeichen.
export fn sql_escape s
    replace_all s "'" "''"

--! Aktueller Zeitstempel im SQLite-"datetime('now')"-Format (sortierbarer String).
--! Hinweis: das reine-Pipe-sqlite-Modul wertet `datetime('now')` NICHT als
--! Funktion aus — es landet woertlich der String "now" in der Spalte. Deshalb
--! bauen wir den Zeitstempel hier selbst aus Pipes eigenen now/format_time-
--! Builtins und uebergeben ihn wie jeden anderen String-Wert.
export fn now_ts _
    format_time now "2006-01-02 15:04:05"

--! Merkt eine Erinnerung (kind: one of memory/task/fact/question; importance 1-5).
--! Berechnet ein Embedding und speichert es für die RAG-Suche. Liefert die id.
--! Verhindert Dubletten bei "permanent" (dauerhafte Nutzerfakten wie "Ich bin
--! Harry..."): derselbe Inhalt (Groß-/Kleinschreibung und Whitespace egal) wird
--! nicht erneut eingefuegt, sondern nur in der Wichtigkeit angehoben — sonst
--! haeuft sich bei wiederholten Aussagen dieselbe Erinnerung mehrfach an, ohne
--! dass die Retrieval-Qualitaet steigt. Andere kinds (v.a. "document" —
--! ingest_document speichert bewusst mehrere Chunks, auch inhaltsgleiche) sind
--! davon NICHT betroffen.
export fn add_memory h content kind importance source tags
    if kind == "permanent"
        --! Normalisierung MUSS in Pipe passieren, nicht in SQL: das reine-Pipe-
        --! sqlite-Modul (~/.pipe/modules/sqlite.pipe, eval_expr/"func") kennt nur
        --! count/sum/avg/min/max als Funktionen — lower()/trim() im WHERE fallen
        --! auf den unveraenderten Rohwert zurueck (dieselbe Klasse Einschraenkung
        --! wie beim datetime('now')-Workaround bei now_ts oben).
        norm: lower (trim content)
        candidates: db_query h "SELECT id, content, importance FROM memories WHERE kind = 'permanent'"
        for c in candidates
            if (lower (trim (get c "content"))) == norm
                eid: get c "id"
                eimp: get c "importance"
                newimp: eimp
                if importance > eimp
                    newimp: importance
                if newimp > 5
                    newimp: 5
                db_exec h ("UPDATE memories SET importance = " ++ (to_str newimp) ++ ", ts = '" ++ (sql_escape (now_ts 0)) ++ "' WHERE id = " ++ (to_str eid))
                return eid
    db_exec h ("INSERT INTO memories (content, kind, importance, source, ts, tags) VALUES ('" ++ (sql_escape content) ++ "', '" ++ (sql_escape kind) ++ "', " ++ (to_str importance) ++ ", '" ++ (sql_escape source) ++ "', '" ++ (sql_escape (now_ts 0)) ++ "', '" ++ (sql_escape tags) ++ "')")
    rid: get (at (db_query h "SELECT max(id) AS mid FROM memories") 0) "mid"
    vec: nil
    try
        vec: embed content
    catch e
        vec: nil
    if vec != nil
        db_exec h ("INSERT INTO embeddings (memory_id, vec) VALUES (" ++ (to_str rid) ++ ", '" ++ (sql_escape (to_json vec)) ++ "')")
    auto_link h content
    rid

--! Protokolliert ein eingehendes Ereignis (für Audit/Debug).
export fn log_event h chat_id text kind
    db_exec h ("INSERT INTO events (chat_id, msg, kind, ts) VALUES ('" ++ (sql_escape chat_id) ++ "', '" ++ (sql_escape text) ++ "', '" ++ (sql_escape kind) ++ "', '" ++ (sql_escape (now_ts 0)) ++ "')")

--! Dokument-Ingestion (P2): URLs/hochgeladene Textdateien in die Wissensbasis
--! aufnehmen. PDFs/Binärformate sind bewusst außen vor — Pipe ist ein
--! dependency-freies Binary ohne PDF-Bibliothek; dafür wäre ein angebundener
--! MCP-Server mit Extraktion der naheliegende Weg (P1).

--! Zerlegt einen langen Text in Chunks von bis zu max_len Zeichen, bevorzugt an
--! Absatzgrenzen (Leerzeile), sonst hart geschnitten. Reine Funktion (kein
--! KI/Netz), deterministisch testbar.
export fn chunk_text text max_len
    text: trim text
    out: []
    if text == ""
        return out
    paras: split text "\n\n"
    cur: ""
    for p0 in paras
        p: trim p0
        if p != ""
            if cur == ""
                fits: (len p) <= max_len
            else
                fits: ((len cur) + (len p) + 2) <= max_len
            if fits
                if cur == ""
                    cur: p
                else
                    cur: cur ++ "\n\n" ++ p
            else
                if cur != ""
                    push out cur
                    cur: ""
                if (len p) <= max_len
                    cur: p
                else
                    i: 0
                    while i < (len p)
                        push out (substring p i (i + max_len))
                        i: i + max_len
    if cur != ""
        push out cur
    out

--! Nimmt einen bereits als Text vorliegenden Dokumentinhalt (von einer URL oder
--! einer hochgeladenen Datei) in die Wissensbasis auf: zerlegt ihn in Chunks
--! und speichert jeden als eigene Erinnerung (kind "document", inkl. Embedding
--! fuer RAG und Auto-Verknuepfung ueber add_memory). max_chunks begrenzt
--! Kosten/Dauer bei sehr grossen Dokumenten (weitere Chunks werden verworfen).
--! Liefert {chunks_total, chunks_ingested}.
export fn ingest_document h text source title max_chunks
    chunks: chunk_text text 1200
    total: len chunks
    n: total
    if n > max_chunks
        n: max_chunks
    i: 0
    while i < n
        tag: title ++ " [" ++ (to_str (i + 1)) ++ "/" ++ (to_str total) ++ "]"
        add_memory h (at chunks i) "document" 2 source tag
        i: i + 1
    out: {}
    set out "chunks_total" total
    set out "chunks_ingested" n
    out

--! Zaehlt Entitaeten und Relationen im Wissensgraphen (Status/Debug).
export fn graph_counts h
    e: get (at (db_query h "SELECT COUNT(*) AS c FROM entities") 0) "c"
    r: get (at (db_query h "SELECT COUNT(*) AS c FROM relations") 0) "c"
    out: {}
    set out "entities" e
    set out "relations" r
    out

--! Anzahl aktiver Threads (Status/Debug, Web-Dashboard P3).
export fn active_thread_count h
    get (at (db_query h "SELECT COUNT(*) AS c FROM threads WHERE state = 'active'") 0) "c"

--! Erinnerungen MIT id fuer Verwaltung (Web-Dashboard P3). Ohne q: die n
--! wichtigsten. Mit q: einfache LIKE-Stichwortsuche ueber content, neueste
--! zuerst (kein Embedding-Ranking — fuer eine schnelle Verwaltungsliste reicht
--! das; fuer inhaltliche Fragen bleibt retrieve_context zustaendig).
--! q: Stichwortfilter (LIKE ueber content) oder nil/"". kind: exakter kind-Filter
--! oder nil/"". Beide kombinierbar.
export fn list_memories h q kind limit
    conds: []
    if q != nil && q != ""
        push conds ("content LIKE '%" ++ (sql_escape q) ++ "%'")
    if kind != nil && kind != ""
        push conds ("kind = '" ++ (sql_escape kind) ++ "'")
    where_sql: ""
    if (len conds) > 0
        where_sql: " WHERE " ++ (join conds " AND ")
    order_sql: " ORDER BY importance DESC, id DESC"
    if q != nil && q != ""
        order_sql: " ORDER BY id DESC"
    db_query h ("SELECT id, content, kind, importance, ts, tags FROM memories" ++ where_sql ++ order_sql ++ " LIMIT " ++ (to_str limit))

--! Loescht eine Erinnerung inkl. ihres Embeddings (Web-Dashboard P3).
export fn delete_memory h id
    db_exec h ("DELETE FROM memories WHERE id = " ++ (to_str id))
    db_exec h ("DELETE FROM embeddings WHERE memory_id = " ++ (to_str id))
    "ok"

--! Holt die N wichtigsten Erinnerungen (hohe Importance zuerst).
export fn top_memories h n
    db_query h ("SELECT content, kind, importance, ts, tags FROM memories ORDER BY importance DESC, id DESC LIMIT " ++ (to_str n))

--! Zählt Erinnerungen (Test-Helfer).
export fn memory_count h
    rows: db_query h "SELECT COUNT(*) AS c FROM memories"
    get (at rows 0) "c"

--! Holt die N jüngsten Ereignisse (Audit/Debug).
export fn recent_events h n
    db_query h ("SELECT chat_id, msg, kind, ts FROM events ORDER BY id DESC LIMIT " ++ (to_str n))

--! Legt ein Ziel an und liefert die id.
export fn add_goal h text
    db_exec h ("INSERT INTO goals (text, status) VALUES ('" ++ (sql_escape text) ++ "', 'offen')")
    get (at (db_query h "SELECT max(id) AS mid FROM goals") 0) "mid"

--! Die n juengsten Ziele (Web-Dashboard P3). "text" ist ein SQL-Typ-Schluesselwort
--! im reinen-Pipe-sqlite-Modul — ein unqualifizierter SELECT einer Spalte namens
--! "text" scheitert am Parser (INSERT/CREATE TABLE vertragen den Namen, ein
--! bloßes "SELECT text" nicht); tabellenqualifiziert ("goals.text") geht.
export fn list_goals h limit
    db_query h ("SELECT id, goals.text AS goal_text, status FROM goals ORDER BY id DESC LIMIT " ++ (to_str limit))

--! Setzt den Status eines Ziels (z.B. "offen"/"erledigt", Web-Dashboard P3).
export fn set_goal_status h id status
    db_exec h ("UPDATE goals SET status = '" ++ (sql_escape status) ++ "' WHERE id = " ++ (to_str id))

--! Setzt die Importance einer Erinnerung direkt (Web-Dashboard P3, manuelle
--! Kuratierung neben der automatischen Konsolidierung).
export fn set_importance h id importance
    db_exec h ("UPDATE memories SET importance = " ++ (to_str importance) ++ " WHERE id = " ++ (to_str id))

--! Passt die Importance ALLER Erinnerungen an, deren content exakt `content`
--! entspricht (Feedback-Lernen P4: 👍/👎 auf einer gespeicherten Antwort). delta
--! wird auf 1..5 geclampft. Liefert die Anzahl geänderter Erinnerungen.
export fn adjust_by_content h content delta
    rows: db_query h ("SELECT id, importance FROM memories WHERE content = '" ++ (sql_escape content) ++ "'")
    changed: 0
    for m in rows
        imp: (get m "importance") + delta
        if imp < 1
            imp: 1
        if imp > 5
            imp: 5
        db_exec h ("UPDATE memories SET importance = " ++ (to_str imp) ++ " WHERE id = " ++ (to_str (get m "id")))
        changed: changed + 1
    changed

--! Episodisches Gedaechtnis (P2): ein Thread pro Chat, in "threads" (title = chat_id
--! als String, state = aktiv/geschlossen) verwaltet — die Tabelle war zuvor angelegt,
--! aber ungenutzt. Nachrichten liegen chronologisch in "messages".

--! Liefert die id des aktiven Threads eines Chats (legt bei Bedarf einen neuen an).
export fn active_thread h chat_id
    cid: to_str chat_id
    rows: db_query h ("SELECT id FROM threads WHERE title = '" ++ (sql_escape cid) ++ "' AND state = 'active'")
    if (len rows) > 0
        get (at rows 0) "id"
    else
        db_exec h ("INSERT INTO threads (title, state) VALUES ('" ++ (sql_escape cid) ++ "', 'active')")
        get (at (db_query h "SELECT max(id) AS mid FROM threads") 0) "mid"

--! Schliesst den aktiven Thread eines Chats (z.B. per /reset) — die naechste
--! active_thread-Anfrage legt einen frischen Thread ohne den alten Verlauf an.
export fn close_thread h chat_id
    db_exec h ("UPDATE threads SET state = 'closed' WHERE title = '" ++ (sql_escape (to_str chat_id)) ++ "' AND state = 'active'")

--! Fuegt eine Nachricht zu einem Thread hinzu. role: "user" oder "assistant".
export fn add_message h thread_id chat_id role content
    db_exec h ("INSERT INTO messages (thread_id, chat_id, role, content, ts) VALUES (" ++ (to_str thread_id) ++ ", '" ++ (sql_escape (to_str chat_id)) ++ "', '" ++ (sql_escape role) ++ "', '" ++ (sql_escape content) ++ "', '" ++ (sql_escape (now_ts 0)) ++ "')")

--! Die letzten n Nachrichten eines Threads, chronologisch (aeltester zuerst).
export fn thread_history h thread_id n
    rows: db_query h ("SELECT role, content FROM messages WHERE thread_id = " ++ (to_str thread_id) ++ " ORDER BY id DESC LIMIT " ++ (to_str n))
    out: []
    i: (len rows) - 1
    while i >= 0
        push out (at rows i)
        i: i - 1
    out

--! Formatiert eine Thread-Historie (Liste von {role, content}) als Prompt-Text.
export fn format_history rows
    out: ""
    for r in rows
        who: "Nutzer"
        if (get r "role") == "assistant"
            who: "Muninn"
        out: out ++ who ++ ": " ++ (get r "content") ++ "\n"
    out

--! Konsolidierung ("Traum", P2): periodischer Aufraeum-/Verdichtungsjob.
--! Nicht automatisch geplant (kein Scheduler vor P4) — manuell via
--! `pipe muninn.pipe consolidate` oder per externem Cron aufzurufen.

--! Zeitstempel-String n Tage vor jetzt, im selben Format wie now_ts (fuer
--! Alters-Vergleiche als einfache String-WHERE-Bedingung).
export fn cutoff_ts days_ago
    format_time (now - (days_ago * 86400)) "2006-01-02 15:04:05"

--! Verdichtet faellige Threads (geschlossen, oder aktiv aber seit
--! inactive_days ohne neue Nachricht) zu je einer Zusammenfassungs-Erinnerung
--! (kind "summary") und loescht danach deren Rohnachrichten. Zeilen mit dem
--! Legacy-Sentinel-Wert "now" (siehe now_ts-Kommentar) gelten als unbekannt alt
--! und werden nur ueber den "closed"-Zustand faellig, nie ueber Inaktivitaet.
export fn consolidate_threads h inactive_days
    cutoff: cutoff_ts inactive_days
    threads: db_query h "SELECT id, state FROM threads WHERE state = 'closed' OR state = 'active'"
    done: 0
    for t in threads
        tid: get t "id"
        eligible: (get t "state") == "closed"
        if !eligible
            last: db_query h ("SELECT MAX(ts) AS last_ts FROM messages WHERE thread_id = " ++ (to_str tid))
            if (len last) > 0
                lts: get (at last 0) "last_ts"
                if lts != nil && lts != "now" && lts < cutoff
                    eligible: true
        if eligible
            msgs: db_query h ("SELECT role, content FROM messages WHERE thread_id = " ++ (to_str tid) ++ " ORDER BY id ASC")
            if (len msgs) > 0
                text: format_history msgs
                summary: ""
                try
                    summary: summarize text
                catch e
                    summary: substring text 0 800
                add_memory h ("Gespraechs-Zusammenfassung: " ++ summary) "summary" 2 "consolidation" ("thread-" ++ (to_str tid))
                db_exec h ("DELETE FROM messages WHERE thread_id = " ++ (to_str tid))
                done: done + 1
            db_exec h ("UPDATE threads SET state = 'archived' WHERE id = " ++ (to_str tid))
    done

--! Senkt die Importance alter, nicht-"permanent"er Erinnerungen um 1 pro Lauf
--! und vergisst (loescht) sie, sobald sie bei Importance 0 angekommen UND
--! aelter als forget_after_days sind. "permanent" (explizites "merke dir ...")
--! bleibt unangetastet — das ist bewusst dauerhaftes Wissen. Zeilen mit dem
--! Legacy-Sentinel "now" werden uebersprungen (Alter unbekannt).
export fn consolidate_memories h decay_after_days forget_after_days
    decay_cut: cutoff_ts decay_after_days
    forget_cut: cutoff_ts forget_after_days
    rows: db_query h "SELECT id, importance, ts FROM memories WHERE kind != 'permanent'"
    decayed: 0
    forgotten: 0
    for m in rows
        ts: get m "ts"
        if ts != nil && ts != "now"
            mid: get m "id"
            imp: get m "importance"
            if imp <= 0 && ts < forget_cut
                db_exec h ("DELETE FROM memories WHERE id = " ++ (to_str mid))
                db_exec h ("DELETE FROM embeddings WHERE memory_id = " ++ (to_str mid))
                forgotten: forgotten + 1
            else
                if imp > 0 && ts < decay_cut
                    db_exec h ("UPDATE memories SET importance = " ++ (to_str (imp - 1)) ++ " WHERE id = " ++ (to_str mid))
                    decayed: decayed + 1
    out: {}
    set out "decayed" decayed
    set out "forgotten" forgotten
    out

--! Haupt-Einstieg der Konsolidierung: Threads nach 3 Tagen Inaktivitaet
--! verdichten, nicht-permanente Erinnerungen ab 14 Tagen um 1 Stufe altern
--! lassen, ab 30 Tagen bei Importance 0 endgueltig vergessen.
export fn consolidate h
    threads_summarized: consolidate_threads h 3
    mres: consolidate_memories h 14 30
    out: {}
    set out "threads_summarized" threads_summarized
    set out "memories_decayed" (get mres "decayed")
    set out "memories_forgotten" (get mres "forgotten")
    out

--! Klassifiziert eine eingehende Nachricht via KI in eine Kategorie.
--! Fallback (kein AI): einfache Regel-Klassifikation.
export fn classify_input text
    try
        classify text (["permanent", "reminder", "fleeting", "task", "goal", "question"])
    catch e
        rule_classify text

--! Regelbasierte Klassifikation (deterministisch, ohne KI) — für Tests und Fallback.
--! "erinnere" meint eine zeitbasierte Erinnerung (P4); "merke"/"denke an" eine
--! dauerhafte Erinnerung — die beiden waren zuvor eins ("permanent").
export fn rule_classify text
    t: lower text
    if contains t "erinnere"
        "reminder"
    else
        if contains t "merke" || contains t "denke an" || contains t "notiere"
            "permanent"
        else
            if contains t "erledige" || contains t "to-do" || contains t "aufgabe" || contains t "mache" || contains t "lege" || contains t "erstelle" || contains t "schreibe" || contains t "anlegen" || contains t "erstellen"
                "task"
            else
                if contains t "ziel" || contains t "erreichen" || contains t "wollen"
                    "goal"
                else
                    "question"

--! Verdichtet Text via KI auf eine Kurzform (Fallback: unverändert).
export fn condense text
    try
        summarize text
    catch e
        text

--! Verdichtet eine (Antwort-)Text zu einem kurzen Fakt fürs Merken (Fix: die
--! "Merken"-Funktion speicherte zuvor rohe, teils mit Gremium-Reasoning
--! verschmutzte Antworten wörtlich). KI-Kürzung mit deterministischem
--! Fallback auf die ersten 300 Zeichen (statt des kompletten Texts).
export fn condense_fact text
    try
        summarize text
    catch e
        substring text 0 300

--! Stoppwort-Prüfung (Deutsch + Englisch).
fn is_stop t
    stops: split "a an the and or but if of in on at to for with about into is are was were be been being do does did doing how what which who this that these those it its as from by can could should would will not no nor your you we they he she has have had i me my them their there here when where why then than so too very just also using use der die das den dem des ein eine einer einem eines und oder aber wenn von im auf an zu zur zum für mit über ist sind war waren bin bist sein wird werden wie was welche wer dieser diese dieses es ich du er sie wir ihr man nicht kein keine auch als aus bei nach nur schon noch dann da hier dort warum wann" " "
    contains stops t

--! Zerlegt Text in relevante Kleinschreibungs-Tokens (ohne Stoppwörter).
fn tokenize text
    low: lower text
    cleaned: regex_replace "[^a-z0-9äöüß_]+" " " low
    parts: split cleaned " "
    out: []
    for t in parts
        if (len t) > 1 && (not (is_stop t))
            push out t
    out

--! Dokumenthäufigkeit: für jeden Token, in wie vielen Texten er vorkommt.
fn build_df contents
    df: {}
    for c in contents
        toks: tokenize c
        seen: {}
        for t in toks
            if (get seen t) == nil
                set seen t true
                cur: get df t
                if cur == nil
                    set df t 1
                else
                    set df t (cur + 1)
    df

--! TF-IDF-artiges Termgewicht (Float, damit die Division nicht ganzzahlig kollabiert).
fn term_weight t df n
    dfv: get df t
    if dfv == nil
        dfv: 1.0
    (n + 1.0) / (dfv + 1.0)

fn keyword_denom terms df n
    sum: 0
    for t in terms
        sum: sum + (term_weight t df n)
    sum

fn keyword_score content_lower terms df n
    score: 0
    for t in terms
        if contains content_lower t
            score: score + (term_weight t df n)
    score

--! RAG: hybride Suche (Keyword-TF-IDF + semantisches Embedding).
--! DeepSeek liefert nur 128-dim lexikalische Embeddings → Keyword dominiert (0.75).
--! Bei echten Embeddings (>300 dim, z.B. OpenAI) übernimmt Semantik (0.7).
export fn retrieve_context h query k
    if query == nil || query == ""
        return []
    rows: db_query h "SELECT id, content, importance, kind FROM memories ORDER BY id DESC"
    if (len rows) == 0
        return []
    vecs: db_query h "SELECT memory_id, vec FROM embeddings"
    vecmap: {}
    for v in vecs
        set vecmap (to_str (get v "memory_id")) (get v "vec")
    contents: []
    for r in rows
        push contents (get r "content")
    n: len contents
    terms: tokenize query
    df: build_df contents
    kw_denom: keyword_denom terms df n
    qvec: nil
    try
        qvec: embed query
    catch e
        qvec: nil
    sem_w: 0.25
    kw_w: 0.75
    if qvec != nil
        if (len qvec) > 300
            sem_w: 0.7
            kw_w: 0.3
    scored: []
    for r in rows
        c: get r "content"
        kw: 0
        if kw_denom > 0
            kw: (keyword_score (lower c) terms df n) / kw_denom
        sem: 0
        if qvec != nil
            vj: get vecmap (to_str (get r "id"))
            if vj != nil
                cv: nil
                try
                    cv: parse_json vj
                catch e2
                    cv: nil
                if cv != nil
                    sem: cosine_sim qvec cv
        score: (sem * sem_w) + (kw * kw_w)
        push scored {content: c, score: score, kind: (get r "kind")}
    ordered: sorted_by scored (fn x: (0 - (get x "score")))
    out: []
    i: 0
    while i < k && i < (len ordered)
        item: at ordered i
        c: get item "content"
        --! Herkunfts-Kennzeichnung: "fact" & Co sind KI-Recherche-Ergebnisse oder
        --! Task-Protokolle, KEINE Aussagen des Nutzers ueber sich selbst — ohne
        --! diese Markierung haelt das Gremium sie sonst faelschlich fuer
        --! Nutzerpraeferenzen (beobachtet: eine alte AfD-Recherche wurde bei
        --! "Wofuer interessiere ich mich?" als "klares Signal fuer politisches
        --! Interesse" fehlinterpretiert, obwohl es nur eine fruehere Recherche
        --! zu einer ANDEREN Frage war). "permanent"/"document" bleiben
        --! unmarkiert: das sind explizite Nutzeraussagen bzw. selbst gelehrte
        --! Inhalte.
        k2: get item "kind"
        if k2 != "permanent" && k2 != "document"
            c: "[fruehere Recherche/Protokoll, KEINE Aussage des Nutzers] " ++ c
        push out c
        i: i + 1
    if (len out) == 0
        --! Fallback: Fragen wie "Wer bin ich?" bestehen fast nur aus Stoppwoertern
        --! (wer/bin/ich, siehe is_stop) und liefern daher IMMER 0 Keyword-Treffer,
        --! egal was gespeichert ist. Ohne echte Embeddings (DeepSeek unterstuetzt
        --! keine, OPENAI_API_KEY optional/leer, siehe Kommentar oben) gibt es sonst
        --! keinen Signalweg zu dauerhaften Fakten — daher hier auf die wichtigsten
        --! dauerhaften Erinnerungen zurueckfallen statt "nichts gefunden" zu liefern.
        perm: db_query h ("SELECT content FROM memories WHERE kind = 'permanent' ORDER BY importance DESC, id DESC LIMIT " ++ (to_str k))
        for r in perm
            push out (get r "content")
    out

--! Reine Stichwort-Suche (deterministisch, ohne Embedding).
export fn keyword_retrieve h query k
    terms: tokenize query
    rows: db_query h "SELECT content FROM memories ORDER BY importance DESC, id DESC"
    out: []
    for r in rows
        c: get r "content"
        lc: lower c
        for t in terms
            if contains lc t
                if !(contains out c)
                    if (len out) < k
                        push out c
    out

--! Wissensgraph: legt eine Entität an (oder liefert ihre id). kind: node/place/person/...
export fn add_entity h name kind
    rows: db_query h ("SELECT id FROM entities WHERE name = '" ++ (sql_escape name) ++ "'")
    if (len rows) > 0
        get (at rows 0) "id"
    else
        db_exec h ("INSERT INTO entities (name, kind) VALUES ('" ++ (sql_escape name) ++ "', '" ++ (sql_escape kind) ++ "')")
        get (at (db_query h "SELECT max(id) AS mid FROM entities") 0) "mid"

--! Wissensgraph: verknüpft zwei Entitäten über eine Relation (dedupliziert:
--! dieselbe (from, to, rel)-Kombination wird nicht doppelt angelegt — wichtig,
--! da auto_link (P2) dieselbe Beziehung über mehrere Erinnerungen hinweg immer
--! wieder extrahieren kann).
export fn add_relation h from_name to_name rel
    a: add_entity h from_name "node"
    b: add_entity h to_name "node"
    existing: db_query h ("SELECT id FROM relations WHERE from_id = " ++ (to_str a) ++ " AND to_id = " ++ (to_str b) ++ " AND rel = '" ++ (sql_escape rel) ++ "'")
    if (len existing) == 0
        db_exec h ("INSERT INTO relations (from_id, to_id, rel) VALUES (" ++ (to_str a) ++ ", " ++ (to_str b) ++ ", '" ++ (sql_escape rel) ++ "')")
    "ok"

--! Wissensgraph: alle Nachbarn einer Entität (mit Relation und Zielname).
export fn neighbors_of h name
    rows: db_query h ("SELECT r.rel, e2.name AS target FROM entities e1 JOIN relations r ON r.from_id = e1.id JOIN entities e2 ON e2.id = r.to_id WHERE e1.name = '" ++ (sql_escape name) ++ "'")
    rows

--! Auto-Entitäten (P2): schreibt Entitaeten/Relationen aus einem bereits
--! vorliegenden Extraktions-Ergebnis (Map mit "entities"/"relations") in den
--! Wissensgraphen. Von auto_link getrennt, damit diese Verarbeitung ohne KI
--! deterministisch testbar ist.
export fn apply_extraction h extraction
    if extraction == nil
        return nil
    ents: get extraction "entities"
    if ents != nil
        for e in ents
            n: get e "name"
            k: get e "kind"
            if n != nil && n != ""
                if k == nil || k == ""
                    k: "node"
                add_entity h n k
    rels: get extraction "relations"
    if rels != nil
        for r in rels
            f: get r "from"
            t: get r "to"
            rl: get r "rel"
            if f != nil && f != "" && t != nil && t != "" && rl != nil && rl != ""
                add_relation h f t rl
    nil

--! Extrahiert benannte Entitaeten + ihre Beziehungen aus einem Text via KI und
--! verknuepft sie automatisch im Wissensgraph (best-effort: ohne KI-Provider
--! oder bei Fehlern passiert nichts, der Aufrufer wird nicht unterbrochen).
export fn auto_link h text
    if text == nil || (trim text) == ""
        return nil
    try
        j: ai_chat_json "Extrahiere benannte Entitaeten (Personen, Orte, Organisationen, Dinge, Konzepte) und ihre Beziehungen aus dem Text. Antworte ausschliesslich als JSON-Objekt mit 'entities' (Liste von Objekten mit 'name' und 'kind') und 'relations' (Liste von Objekten mit 'from', 'to' und 'rel'). Nur eindeutig im Text genannte Entitaeten, keine Vermutungen. Ohne erkennbare Entitaeten: {\"entities\": [], \"relations\": []}." text
        apply_extraction h j
    catch e
        nil
