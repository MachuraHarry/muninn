--! docker_tools.pipe — deliberately restricted Docker extension (pull an
--! image, create a container), in addition to the "docker" MCP server
--! (which only manages EXISTING containers/images, see swarm.pipe comment).
--!
--! Security decision (agreed with the user): full Docker MCP servers with
--! pull_image/create_container exist (e.g. afstanton/docker_mcp), but ship
--! with their authors' own warning that they're "inherently unsafe" — host
--! volume mounts in a container are effectively root access to the host.
--! This module covers the concrete need (spin up a web server container)
--! WITHOUT that capability:
--!   - Volume mounts are possible ONLY for one, explicitly named
--!     mcp_data/ workspace at a time (see volume_flag below) — a
--!     container can NEVER reach any other host path (system files,
--!     .env, other workspaces). Added later, on the user's own request,
--!     specifically so a Docker job can work with real project files
--!     instead of running fully blind — still nowhere near an arbitrary
--!     host mount.
--!   - NO --privileged, NO --network=host, NO freely choosable extra Docker
--!     flags — the command is built from a FIXED template, only validated
--!     values get substituted in.
--!   - Port binding defaults to 127.0.0.1 ONLY (not publicly reachable) —
--!     a deliberately safe default, so a freshly set-up web server doesn't
--!     immediately hang unprotected on the network.
--!   - Image name/container name/ports are checked against strict, ANCHORED
--!     regexes (^...$, not just "contains") before being inserted into the
--!     exec() command. exec() tokenizes via splitShellWords and calls the
--!     program DIRECTLY (no "sh -c", see pipe/pkg/object/builtins_sandbox.go)
--!     — the regex check is still needed to prevent argument injection
--!     (e.g. an "image name" like "nginx --privileged", which would
--!     otherwise be passed through as an extra Docker flag).
--! Needs "docker" in the sandbox exec_whitelist (added automatically, since
--! the "docker" MCP server runs via npx and "docker" itself isn't called
--! through MCP but directly here via exec() — hence added separately in
--! setup_sandbox, see muninn.pipe).
--! IMPORTANT: "sqlite" is DELIBERATELY NOT imported here (neither bare nor
--! aliased) — two reasons, both reproduced live:
--! 1) The sqlite module itself exports a function 'exec(handle, sql)',
--!    which SILENTLY SHADOWS the global exec() builtin (process execution)
--!    as soon as "sqlite" is imported in the same file scope
--!    ("at: Index must be a number" — the command string got wrongly
--!    interpreted as a database handle). docker_tools.pipe calls exec()
--!    heavily, so it can't risk that.
--! 2) A SEPARATE (even aliased) "sqlite" import creates its own handle
--!    registry, incompatible with the rest of the app — a handle created
--!    here would be invalid in the rest of the app and vice versa ("Invalid
--!    database handle").
--! Instead: mem.raw_exec/mem.raw_query (thin pass-throughs in memory.pipe,
--! which already bare-imports "sqlite" and never calls exec() itself —
--! unproblematic there, and all DB handles stay compatible since it's the
--! SAME sqlite module instance as everywhere else in the app).
import "modules/memory.pipe" as mem

--! Docker image name: registry/namespace/name:tag, common characters only.
--! Deliberately kept simple (better to reject a few exotic, valid image
--! names than a complex regex with an overlooked loophole). No spaces, no
--! leading hyphen (could otherwise pass as an extra Docker flag) — that's
--! the security-relevant part, not the full Docker naming grammar.
export fn valid_image_name s
    regex_match "^[a-z0-9][a-z0-9._/-]*(:[a-zA-Z0-9._-]+)?$" s

--! Container/resource name: common Docker characters, must start
--! alphanumeric.
export fn valid_identifier s
    regex_match "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$" s

--! Port number as a plain string, 1-65535.
export fn valid_port s
    if !(regex_match "^[0-9]{1,5}$" s)
        return false
    n: to_num s
    n >= 1 && n <= 65535

fn docker_exec cmd_str
    r: exec cmd_str
    out: get r "output"
    if (get r "status") != 0
        "Error (status " ++ (to_str (get r "status")) ++ "): " ++ out
    else
        if out == "" || out == nil
            "OK"
        else
            out

--! Job tracking for long background setups (see tool_docker_setup_starten
--! below): 'docker run -d' returns as soon as the container has STARTED,
--! not when its setup script finishes. This table tracks which container
--! belongs to which user request, so the scheduler (job_check, see
--! sched_tick in muninn.pipe) can periodically check whether the actual
--! work is done yet.
export fn init_docker_jobs h
    mem.raw_exec h "CREATE TABLE IF NOT EXISTS docker_jobs (id INTEGER PRIMARY KEY AUTOINCREMENT, chat_id TEXT, container_name TEXT, description TEXT, status TEXT, created TEXT, finished TEXT, result TEXT)"
    nil

--! Creates a new job (status 'running'). Returns the id.
export fn create_job h chat_id container_name description
    init_docker_jobs h
    mem.raw_exec h ("INSERT INTO docker_jobs (chat_id, container_name, description, status, created, finished, result) VALUES ('" ++ (mem.sql_escape (to_str chat_id)) ++ "', '" ++ (mem.sql_escape container_name) ++ "', '" ++ (mem.sql_escape description) ++ "', 'running', '" ++ (mem.sql_escape (mem.now_ts 0)) ++ "', '', '')")
    get (at (mem.raw_query h "SELECT max(id) AS mid FROM docker_jobs") 0) "mid"

--! Updates a job to 'done'/'failed' including result/logs.
export fn update_job h id status result
    mem.raw_exec h ("UPDATE docker_jobs SET status = '" ++ (mem.sql_escape status) ++ "', result = '" ++ (mem.sql_escape result) ++ "', finished = '" ++ (mem.sql_escape (mem.now_ts 0)) ++ "' WHERE id = " ++ (to_str id))

--! The most recently started STILL-RUNNING job for this chat, or nil —
--! used by tool_docker_hintergrund_setup to deterministically REFUSE a
--! duplicate job instead of relying on the AI to remember to check first.
--! The prompt-only rule ("call docker_job_status before starting another
--! job") was live-observed to NOT be reliable — reproduced again in a
--! single conversation, four separate background jobs
--! (pipe-workspace-*/pipe-compile-*/pipe-helloworld/pipe-komplex-test)
--! for what was really one ongoing "set up a Pipe workspace" task, one
--! new job per follow-up message instead of continuing/checking the
--! existing one.
export fn running_job_for_chat h chat_id
    init_docker_jobs h
    rows: mem.raw_query h ("SELECT id, container_name, description, created FROM docker_jobs WHERE chat_id = '" ++ (mem.sql_escape (to_str chat_id)) ++ "' AND status = 'running' ORDER BY id DESC LIMIT 1")
    if (len rows) > 0
        at rows 0
    else
        nil

--! Reads a job (nil if not found).
export fn get_job h id
    rows: mem.raw_query h ("SELECT id, chat_id, container_name, description, status, result FROM docker_jobs WHERE id = " ++ (to_str id))
    if (len rows) > 0
        at rows 0
    else
        nil

--! Tool: shows the status of this chat's most recently started background
--! Docker jobs. ALWAYS check this before calling docker_hintergrund_setup
--! again for a task that a job COULD already be running for — live
--! observed: the AI would start another attempt on every follow-up
--! question/failure, sometimes running two jobs for the same task in
--! parallel (see the prompt hint in swarm.pipe).
export fn tool_docker_job_status h chat_id
    rows: mem.raw_query h ("SELECT container_name, description, status, created FROM docker_jobs WHERE chat_id = '" ++ (mem.sql_escape (to_str chat_id)) ++ "' ORDER BY id DESC LIMIT 5")
    if (len rows) == 0
        return "No background Docker jobs started yet."
    out: "Recent background Docker jobs (newest first):\n"
    for r in rows
        out: out ++ "- " ++ (get r "container_name") ++ " (" ++ (get r "created") ++ "): " ++ (get r "status") ++ " — " ++ (get r "description") ++ "\n"
    out

--! Actively cancels ONE running background job: removes the container
--! (best-effort via 'docker rm -f', regardless of whether it still exists)
--! and marks the job as 'cancelled'. CRITICAL: this is what FIRST provides
--! a real cancellation mechanism at all — before, the AI could only delete
--! a container via the raw MCP Docker tools (docker_remove_container),
--! WITHOUT job_check ever finding out: the next tick would then find
--! "container no longer found", report that as a failure AND suggest
--! trying again — even though the user had explicitly cancelled (observed
--! live, see the comment at cancel_all_running below). The 'cancelled'
--! status is recognized by refresh_job_status/sched_tick as a terminal
--! state (no failure, no follow-up question, no message to the user).
export fn cancel_job h id
    job: get_job h id
    if job == nil
        return false
    if (get job "status") == "running"
        name: get job "container_name"
        exec ("docker rm -f " ++ name)
        update_job h id "cancelled" "Cancelled by the user."
    true

--! Cancels ALL running background Docker jobs of a chat (see /stop in
--! muninn.pipe AND the AI tool 'docker_jobs_abbrechen' in swarm.pipe —
--! /stop is the RELIABLE, deterministic path that NEVER depends on an AI
--! decision; the AI tool is only a safety net for natural-language requests
--! mid-conversation). Observed live: on "cancel all tasks", the AI claimed
--! twice that everything was cancelled — but immediately started a new
--! background job right in the same breath, because there simply was no
--! tool that performed a real, verifiable cancellation action; the AI could
--! only CLAIM to cancel. Returns the list of cancelled job ids.
export fn cancel_all_running h chat_id
    rows: mem.raw_query h ("SELECT id FROM docker_jobs WHERE chat_id = '" ++ (mem.sql_escape (to_str chat_id)) ++ "' AND status = 'running'")
    ids: []
    for r in rows
        jid: get r "id"
        cancel_job h jid
        push ids jid
    ids

--! docker_environments: durable, REUSABLE Docker environments — the
--! deliberate counterpart to docker_jobs, which tracks ONE-OFF background
--! tasks (test a repo, install a package — meant to finish and get cleaned
--! up). Without this registry, the AI had no way of knowing what's
--! installed in an already-running container or what it's for, and would
--! reflexively spin up a NEW container for every request that needed "some
--! Linux" instead of reusing an existing one (user observation).
export fn init_docker_environments h
    mem.raw_exec h "CREATE TABLE IF NOT EXISTS docker_environments (id INTEGER PRIMARY KEY AUTOINCREMENT, chat_id TEXT, container_name TEXT, purpose TEXT, installed TEXT, created TEXT, status TEXT)"
    nil

--! Tool: registers a container as a durable, reusable environment — NOT for
--! one-off test/build jobs via docker_hintergrund_setup (the docker_jobs
--! table already tracks those; those cases should NOT be reused, see the
--! comment above).
export fn tool_docker_environment_registrieren h chat_id container_name purpose installed
    if !(valid_identifier container_name)
        return "Rejected: '" ++ container_name ++ "' is not a valid container name."
    init_docker_environments h
    mem.raw_exec h ("INSERT INTO docker_environments (chat_id, container_name, purpose, installed, created, status) VALUES ('" ++ (mem.sql_escape (to_str chat_id)) ++ "', '" ++ (mem.sql_escape container_name) ++ "', '" ++ (mem.sql_escape purpose) ++ "', '" ++ (mem.sql_escape installed) ++ "', '" ++ (mem.sql_escape (mem.now_ts 0)) ++ "', 'active')")
    "Environment '" ++ container_name ++ "' registered: " ++ purpose

--! Tool: lists this chat's active registered durable environments — always
--! check this FIRST before creating a new container for a request that
--! needs a Linux/Docker environment, to see whether a suitable one already
--! exists.
export fn tool_docker_environments_auflisten h chat_id
    init_docker_environments h
    rows: mem.raw_query h ("SELECT container_name, purpose, installed FROM docker_environments WHERE chat_id = '" ++ (mem.sql_escape (to_str chat_id)) ++ "' AND status = 'active' ORDER BY id DESC")
    if (len rows) == 0
        return "No durable Docker environments registered."
    out: "Registered durable Docker environments:\n"
    for r in rows
        out: out ++ "- " ++ (get r "container_name") ++ ": " ++ (get r "purpose") ++ " (installed: " ++ (get r "installed") ++ ")\n"
    out

--! Tool: removes a registered environment (container AND registration) —
--! e.g. when the user explicitly says they no longer need a durable
--! environment.
export fn tool_docker_environment_entfernen h chat_id container_name
    if !(valid_identifier container_name)
        return "Rejected: '" ++ container_name ++ "' is not a valid container name."
    init_docker_environments h
    rows: mem.raw_query h ("SELECT id FROM docker_environments WHERE chat_id = '" ++ (mem.sql_escape (to_str chat_id)) ++ "' AND container_name = '" ++ (mem.sql_escape container_name) ++ "' AND status = 'active'")
    if (len rows) == 0
        return "No active environment named '" ++ container_name ++ "' is registered."
    exec ("docker rm -f " ++ container_name)
    mem.raw_exec h ("UPDATE docker_environments SET status = 'removed' WHERE chat_id = '" ++ (mem.sql_escape (to_str chat_id)) ++ "' AND container_name = '" ++ (mem.sql_escape container_name) ++ "'")
    "Environment '" ++ container_name ++ "' removed."

--! Checks the REAL Docker container state and updates the job to
--! 'done'/'failed' including logs once the container has actually finished
--! — 'docker run -d' only returns the START (see the init_docker_jobs file
--! comment above), WITHOUT this active check the status would stay
--! 'running' forever (update_job was never called anywhere before this
--! fix — every background job would NEVER have reported itself done).
--! Called by sched_tick (job_check in muninn.pipe) on EVERY tick, as long
--! as the job is still 'running'. container_name comes exclusively from
--! names already validated at creation time (valid_identifier in
--! tool_docker_setup_starten) — safe to insert directly into exec(), as
--! elsewhere in this file. Returns the (possibly updated) job, or nil if
--! not found.
export fn refresh_job_status h id
    job: get_job h id
    if job == nil
        return nil
    if (get job "status") != "running"
        return job
    name: get job "container_name"
    ins: exec ("docker inspect --format {{.State.Running}}|{{.State.ExitCode}} " ++ name)
    if (get ins "status") != 0
        --! Container no longer found (e.g. removed by hand) — close it out
        --! as failed instead of staying 'running' forever.
        update_job h id "failed" ("Container '" ++ name ++ "' no longer found: " ++ (trim (get ins "output")))
        return get_job h id
    parts: split (trim (get ins "output")) "|"
    running: (len parts) > 0 && (at parts 0) == "true"
    if running
        return job
    exit_code: "0"
    if (len parts) > 1
        exit_code: at parts 1
    --! Capped at the last 200 lines — a pure readability/cost decision for
    --! display (the test run ITSELF runs to completion fully unrestricted),
    --! not a security restriction.
    logs_r: exec ("docker logs --tail 200 " ++ name)
    logs: trim (get logs_r "output")
    if logs == ""
        logs: "(no output)"
    status: "done"
    if exit_code != "0"
        status: "failed (exit code " ++ exit_code ++ ")"
    update_job h id status logs
    --! Logs/result are already saved in docker_jobs — no reason to leave
    --! the stopped container lying around.
    exec ("docker rm " ++ name)
    get_job h id

--! Tool: download an image from Docker Hub (or another registry).
export fn tool_docker_pull_image image
    if !(valid_image_name image)
        return "Rejected: '" ++ image ++ "' is not a valid image name."
    docker_exec ("docker pull " ++ image)

--! Builds a " -v /root/muninn/mcp_data/<workspace>:/workspace" flag for a
--! docker run command, or "" if no workspace was given. The container-side
--! path is ALWAYS the fixed "/workspace" (never AI-controllable) — keeps
--! setup_command scripts predictable ("cd /workspace && ..."). Reuses
--! valid_identifier — the SAME check swarm.pipe's tool_workspace_erstellen
--! already applies, so this can only ever resolve inside mcp_data/, never
--! an arbitrary host path. Auto-creates the workspace directory if it
--! doesn't exist yet (mirrors tool_workspace_erstellen's own make_dir) —
--! no separate "must already exist" round-trip needed. Returns nil (a
--! rejection signal, distinct from the "" no-mount case) for an invalid
--! name — the caller must check for nil and reject the whole call.
fn volume_flag workspace
    if workspace == nil || (trim workspace) == ""
        return ""
    if !(valid_identifier workspace)
        return nil
    make_dir ("/root/muninn/mcp_data/" ++ workspace)
    " -v /root/muninn/mcp_data/" ++ workspace ++ ":/workspace"

--! Tool: starts a new, running container from a (possibly previously
--! pulled) image. NO --privileged, NO --network=host, and the only
--! possible volume mount is the single named mcp_data/ workspace via
--! 'workspace' (see volume_flag above; "" for no mount at all) — see the
--! file comment above. host_port/container_port are REQUIRED (no
--! container without an explicit, deliberate port mapping). public: "true"
--! binds to all interfaces, otherwise (default, and for any other value)
--! 127.0.0.1 only.
export fn tool_docker_create_container image name host_port container_port public workspace
    if !(valid_image_name image)
        return "Rejected: '" ++ image ++ "' is not a valid image name."
    if !(valid_identifier name)
        return "Rejected: '" ++ name ++ "' is not a valid container name."
    if !(valid_port host_port)
        return "Rejected: '" ++ host_port ++ "' is not a valid host port (1-65535)."
    if !(valid_port container_port)
        return "Rejected: '" ++ container_port ++ "' is not a valid container port (1-65535)."
    vol: volume_flag workspace
    if vol == nil
        return "Rejected: '" ++ (to_str workspace) ++ "' is not a valid workspace name."
    bind: "127.0.0.1:"
    if public == "true"
        bind: ""
    cmd: "docker run -d --name " ++ name ++ vol ++ " -p " ++ bind ++ host_port ++ ":" ++ container_port ++ " " ++ image
    res: docker_exec cmd
    hint: " (only reachable on localhost — 127.0.0.1:" ++ host_port ++ ")"
    if public == "true"
        hint: " (publicly reachable on port " ++ host_port ++ " — deliberately chosen!)"
    if vol != ""
        hint: hint ++ " (workspace '" ++ workspace ++ "' mounted at /workspace)"
    res ++ hint

--! Safely escapes free text as ONE single argv token for 'sh -c "<...>"'.
--! IMPORTANT: exec() tokenizes via splitShellWords (see
--! pipe/pkg/object/sandbox.go) directly into argv, WITHOUT a real shell — a
--! double quote in user text could otherwise end the token early and smuggle
--! the rest in as ADDITIONAL, separate argv elements at the HOST level (e.g.
--! extra 'docker run' flags). Double backslashes FIRST, THEN escape quotes —
--! order matters, otherwise freshly inserted escape backslashes would
--! themselves get escaped again.
fn shell_quote s
    s: replace_all s "\\" "\\\\"
    s: replace_all s "\"" "\\\""
    s

--! Tool: starts a container and runs ONE free-form setup/install command
--! inside it that may take longer (e.g. package installation) — unlike
--! tool_docker_create_container, which only starts a FINISHED image
--! directly. 'docker run -d' returns as soon as the container has STARTED,
--! NOT when setup_command is done — the setup keeps running in the
--! background on the Docker daemon, independent of the Muninn process
--! (survives even a restart). The caller (swarm.pipe
--! tool_docker_hintergrund_setup) creates a job-tracking entry for this and
--! schedules a later check via the scheduler. setup_command is inevitably
--! free text (install commands need && / ; — that's intentional, but it
--! runs ISOLATED INSIDE THE CONTAINER, not on the host) — shell_quote only
--! prevents it from breaking out of its ONE host-side argv token. Same
--! limits as tool_docker_create_container: NO --privileged, NO
--! --network=host, everything via a fixed command template except the one
--! optional named-workspace mount (see volume_flag). The requested name ALWAYS automatically gets a timestamp
--! suffix appended — observed live: on a name collision (retry after a
--! failure), the AI kept inventing new names itself ("v3", "v4",
--! "pipe-test-new", "v5", ...), sometimes even running two jobs in parallel
--! for the same task. Collisions are structurally ruled out by the suffix;
--! the AI no longer has to invent unique names itself. Returns {ok, name,
--! message} instead of just a string — the caller (swarm.pipe
--! tool_docker_hintergrund_setup) needs the REAL (suffixed) name for job
--! tracking, not the originally requested one.
export fn tool_docker_setup_starten image name setup_command workspace
    if !(valid_image_name image)
        return {ok: false, name: nil, message: "Rejected: '" ++ image ++ "' is not a valid image name."}
    if !(valid_identifier name)
        return {ok: false, name: nil, message: "Rejected: '" ++ name ++ "' is not a valid container name."}
    if setup_command == nil || (trim setup_command) == ""
        return {ok: false, name: nil, message: "Rejected: no setup_command given."}
    vol: volume_flag workspace
    if vol == nil
        return {ok: false, name: nil, message: "Rejected: '" ++ (to_str workspace) ++ "' is not a valid workspace name."}
    base: name
    if (len base) > 50
        base: substring base 0 50
    final_name: base ++ "-" ++ (to_str now)
    cmd: "docker run -d --name " ++ final_name ++ vol ++ " " ++ image ++ " sh -c \"" ++ (shell_quote setup_command) ++ "\""
    res: docker_exec cmd
    if contains res "Error"
        return {ok: false, name: final_name, message: res}
    {ok: true, name: final_name, message: res}
