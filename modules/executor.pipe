--! executor.pipe — autonomous task executor with a plan library + feedback
--! loop. Lesson from the sandbox audit series: no raw shell/file builtins —
--! only registered, validating actions (store/graph/goal/retrieve/search/
--! fetch/research/mcp_call). mcp_call uses the Pipe builtin `tool_call` (P1),
--! which calls an MCP-connected tool directly by name — deterministic,
--! without needing the swarm/an AI tool-call loop for it.
import "sqlite"
import "modules/memory.pipe" as mem
import "modules/web.pipe" as web
import "modules/mcp.pipe" as mcp

--! Creates the plans table (idempotent).
export fn init_executor h
    db_exec h "CREATE TABLE IF NOT EXISTS plans (id INTEGER PRIMARY KEY AUTOINCREMENT, goal TEXT, steps TEXT, state TEXT, step_idx INTEGER, result TEXT, created TEXT, updated TEXT)"
    nil

--! Builds an empty step with the given action.
fn step action
    s: {}
    set s "action" action
    s

--! Deterministic plan library: known task kinds -> step list.
export fn plan_template kind goal
    out: []
    if kind == "permanent" || kind == "remember"
        s: step "store"
        set s "content" goal
        set s "kind" "permanent"
        set s "importance" 3
        push out s
    else
        if kind == "task"
            s1: step "store"
            set s1 "content" goal
            set s1 "kind" "task"
            set s1 "importance" 2
            push out s1
            s2: step "goal"
            set s2 "text" goal
            push out s2
        else
            if kind == "goal"
                s1: step "goal"
                set s1 "text" goal
                push out s1
    out

--! Executes a single step. Returns {ok, result|error}.
export fn exec_step h s
    action: get s "action"
    r: {}
    if action == "store"
        c: get s "content"
        k: get s "kind"
        imp: get s "importance"
        if imp == nil
            imp: 3
        if c == nil || k == nil
            set r "ok" false
            set r "error" "store needs content and kind"
            return r
        mem.add_memory h c k imp "executor" "plan"
        set r "ok" true
        set r "result" ("Remembered: " ++ c)
        return r
    if action == "goal"
        t: get s "text"
        if t == nil
            set r "ok" false
            set r "error" "goal needs text"
            return r
        gid: mem.add_goal h t
        set r "ok" true
        set r "result" ("Goal created (id " ++ (to_str gid) ++ ")")
        return r
    if action == "graph"
        f: get s "from"
        t: get s "to"
        rel: get s "rel"
        if f == nil || t == nil || rel == nil
            set r "ok" false
            set r "error" "graph needs from, to, rel"
            return r
        mem.add_relation h f t rel
        set r "ok" true
        set r "result" ("Linked: " ++ f ++ " -> " ++ t)
        return r
    if action == "retrieve"
        q: get s "query"
        if q == nil
            set r "ok" false
            set r "error" "retrieve needs query"
            return r
        ctx: mem.retrieve_context h q 3
        out: ""
        for c in ctx
            out: out ++ "- " ++ c ++ "\n"
        set r "ok" true
        set r "result" out
        return r
    if action == "search"
        q: get s "query"
        if q == nil
            set r "ok" false
            set r "error" "search needs query"
            return r
        results: web.web_results q 5
        out: ""
        for x in results
            out: out ++ "- " ++ (get x "title") ++ " (" ++ (get x "url") ++ ")\n"
        set r "ok" true
        set r "result" out
        return r
    if action == "fetch"
        u: get s "url"
        if u == nil
            set r "ok" false
            set r "error" "fetch needs url"
            return r
        text: web.web_fetch u
        if text == ""
            set r "ok" false
            set r "error" ("Page not reachable: " ++ u)
            return r
        set r "ok" true
        set r "result" text
        return r
    if action == "research"
        q: get s "query"
        if q == nil
            set r "ok" false
            set r "error" "research needs query"
            return r
        rr: web.research q
        set r "ok" true
        set r "result" (get rr "context")
        return r
    if action == "mcp_call"
        tname: get s "tool"
        if tname == nil
            set r "ok" false
            set r "error" "mcp_call needs tool"
            return r
        targs: get s "args"
        if targs == nil
            targs: {}
        try
            out: tool_call tname targs
            set r "ok" true
            set r "result" out
        catch e
            set r "ok" false
            set r "error" (to_str e)
        return r
    set r "ok" false
    set r "error" ("Unknown action: " ++ action)
    r

--! Creates a plan and returns the id.
fn create_plan h goal steps
    ts: mem.sql_escape (mem.now_ts 0)
    db_exec h ("INSERT INTO plans (goal, steps, state, step_idx, result, created, updated) VALUES ('" ++ (mem.sql_escape goal) ++ "', '" ++ (mem.sql_escape (to_json steps)) ++ "', 'running', 0, '', '" ++ ts ++ "', '" ++ ts ++ "')")
    get (at (db_query h "SELECT max(id) AS mid FROM plans") 0) "mid"

--! Updates the plan state (checkpoint).
fn update_plan h pid state idx result
    db_exec h ("UPDATE plans SET state = '" ++ (mem.sql_escape state) ++ "', step_idx = " ++ (to_str idx) ++ ", result = '" ++ (mem.sql_escape result) ++ "', updated = '" ++ (mem.sql_escape (mem.now_ts 0)) ++ "' WHERE id = " ++ (to_str pid))

--! Describes the 'mcp_call' action including currently available tools
--! (local + MCP) for the AI plan prompts. Empty if no tools are registered
--! (yet).
fn mcp_call_hint _
    tools: mcp.discovered_tool_names ([])
    if (len tools) == 0
        ""
    else
        " mcp_call needs 'tool' (tool name) and optionally 'args' (map). Available tools: " ++ (join tools ", ") ++ "."

--! Revises the plan after an error. Fallback: drop the failed step.
fn revise_steps h goal steps fail_idx error
    try
        j: ai_chat_json ("You revise a task plan. Respond ONLY as a JSON list of steps with 'action' (store, graph, goal, retrieve, search, fetch, research, or mcp_call) and the needed parameters. Avoid the failed step." ++ (mcp_call_hint 0)) ("Task: " ++ goal ++ ". Error: " ++ error)
        normalize_steps j
    catch
        drop_step steps fail_idx

--! Normalizes AI-produced steps into validated step maps (known actions only).
export fn normalize_steps raw
    out: []
    for e in raw
        a: get e "action"
        if a != nil
            valid: false
            if a == "store" || a == "graph" || a == "goal" || a == "retrieve" || a == "search" || a == "fetch" || a == "research" || a == "mcp_call"
                valid: true
            if valid
                push out e
    out

--! Deterministic fallback: drops the failed step.
fn drop_step steps fail_idx
    out: []
    i: 0
    while i < (len steps)
        if i != fail_idx
            push out (at steps i)
        i: i + 1
    out

--! Runs a plan with checkpoints and a feedback loop.
export fn run_plan h goal steps
    init_executor h
    pid: create_plan h goal steps
    execute_from h pid goal steps 0

--! Continues an already-created, running plan from its checkpoint (P4:
--! long-running goals with resume — the scheduler ticks open plans).
--! step_idx counts completed steps; that makes a resume idempotent.
export fn resume_plan h pid
    init_executor h
    rows: db_query h ("SELECT goal, steps, state, step_idx FROM plans WHERE id = " ++ (to_str pid))
    if (len rows) == 0
        f: {}
        set f "ok" false
        set f "error" "Plan not found"
        return f
    p: at rows 0
    if (get p "state") == "done" || (get p "state") == "failed"
        f2: {}
        set f2 "ok" false
        set f2 "error" "Plan is already complete"
        return f2
    steps: []
    try
        steps: parse_json (get p "steps")
    catch
        steps: []
    execute_from h pid (get p "goal") steps (get p "step_idx")

--! Shared step loop (run_plan/resume_plan): from step `start` to the end,
--! with a checkpoint after every success and a feedback loop on errors.
fn execute_from h pid goal steps start
    i: start
    errs: 0
    update_plan h pid "running" i ""
    while i < (len steps)
        s: at steps i
        r: exec_step h s
        if get r "ok"
            i: i + 1
            errs: 0
            update_plan h pid "running" i ""
        else
            errs: errs + 1
            if errs > 2
                revised: revise_steps h goal steps i (get r "error")
                if (len revised) <= i
                    update_plan h pid "failed" i (get r "error")
                    f: {}
                    set f "ok" false
                    set f "plan_id" pid
                    set f "error" (get r "error")
                    return f
                steps: revised
                errs: 0
                update_plan h pid "running" i ""
    update_plan h pid "done" i ""
    out: {}
    set out "ok" true
    set out "plan_id" pid
    set out "steps_done" i
    out

--! Continues all running (interrupted) plans — the scheduler's "goal_tick"
--! calls this periodically. Returns the number of plans resumed.
export fn resume_running_plans h
    init_executor h
    rows: db_query h "SELECT id FROM plans WHERE state = 'running'"
    resumed: 0
    for r in rows
        res: resume_plan h (get r "id")
        if get res "ok"
            resumed: resumed + 1
    resumed

--! Main entry point: derives a plan (template or AI) and runs it.
export fn execute_task h goal
    init_executor h
    kind: mem.rule_classify goal
    steps: plan_template kind goal
    if (len steps) == 0
        try
            j: ai_chat_json ("You break a task down into executable steps. Respond ONLY as a JSON list of steps with 'action' (store, graph, goal, retrieve, search, fetch, research, or mcp_call) and the needed parameters." ++ (mcp_call_hint 0)) goal
            steps: normalize_steps j
        catch
            steps: []
    if (len steps) == 0
        f: {}
        set f "ok" false
        set f "error" "No steps could be derived"
        return f
    run_plan h goal steps

--! Reads a plan's state (test/debug).
export fn plan_state h pid
    rows: db_query h ("SELECT id, goal, state, step_idx, result FROM plans WHERE id = " ++ (to_str pid))
    if (len rows) > 0
        at rows 0
    else
        nil

--! The n most recent plans (web dashboard P3).
export fn recent_plans h limit
    init_executor h
    db_query h ("SELECT id, goal, state, step_idx, updated FROM plans ORDER BY id DESC LIMIT " ++ (to_str limit))
