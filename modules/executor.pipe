--! executor.pipe — autonomer Task-Executor mit Plan-Bibliothek + Feedback-Loop.
--! Lehre aus der Sandbox-Audit-Reihe: keine rohen Shell-/Datei-Builtins — nur
--! registrierte, validierende Aktionen (store/graph/goal/retrieve/search/fetch/
--! research/mcp_call). mcp_call nutzt den Pipe-Builtin `tool_call` (P1), der ein
--! per MCP angebundenes Werkzeug direkt per Name aufruft — deterministisch, ohne
--! dass dafuer das Gremium/eine KI-Tool-Call-Schleife noetig waere.
import "sqlite"
import "modules/memory.pipe" as mem
import "modules/web.pipe" as web
import "modules/mcp.pipe" as mcp

--! Legt die plans-Tabelle an (idempotent).
export fn init_executor h
    db_exec h "CREATE TABLE IF NOT EXISTS plans (id INTEGER PRIMARY KEY AUTOINCREMENT, goal TEXT, steps TEXT, state TEXT, step_idx INTEGER, result TEXT, created TEXT, updated TEXT)"
    nil

--! Baut einen leeren Schritt mit gegebener Aktion.
fn step action
    s: {}
    set s "action" action
    s

--! Deterministische Plan-Bibliothek: bekannte Aufgabenarten -> Schrittliste.
export fn plan_template kind goal
    out: []
    if kind == "permanent" || kind == "remember"
        s: step "store"
        set s "content" goal
        set s "kind" "permanent"
        set s "importance" 3
        push out s
    else
        if kind == "task"
            s1: step "store"
            set s1 "content" goal
            set s1 "kind" "task"
            set s1 "importance" 2
            push out s1
            s2: step "goal"
            set s2 "text" goal
            push out s2
        else
            if kind == "goal"
                s1: step "goal"
                set s1 "text" goal
                push out s1
    out

--! Führt einen einzelnen Schritt aus. Liefert {ok, result|error}.
export fn exec_step h s
    action: get s "action"
    r: {}
    if action == "store"
        c: get s "content"
        k: get s "kind"
        imp: get s "importance"
        if imp == nil
            imp: 3
        if c == nil || k == nil
            set r "ok" false
            set r "error" "store braucht content und kind"
            return r
        mem.add_memory h c k imp "executor" "plan"
        set r "ok" true
        set r "result" ("Gemerkt: " ++ c)
        return r
    if action == "goal"
        t: get s "text"
        if t == nil
            set r "ok" false
            set r "error" "goal braucht text"
            return r
        gid: mem.add_goal h t
        set r "ok" true
        set r "result" ("Ziel angelegt (id " ++ (to_str gid) ++ ")")
        return r
    if action == "graph"
        f: get s "from"
        t: get s "to"
        rel: get s "rel"
        if f == nil || t == nil || rel == nil
            set r "ok" false
            set r "error" "graph braucht from, to, rel"
            return r
        mem.add_relation h f t rel
        set r "ok" true
        set r "result" ("Verknuepft: " ++ f ++ " -> " ++ t)
        return r
    if action == "retrieve"
        q: get s "query"
        if q == nil
            set r "ok" false
            set r "error" "retrieve braucht query"
            return r
        ctx: mem.retrieve_context h q 3
        out: ""
        for c in ctx
            out: out ++ "- " ++ c ++ "\n"
        set r "ok" true
        set r "result" out
        return r
    if action == "search"
        q: get s "query"
        if q == nil
            set r "ok" false
            set r "error" "search braucht query"
            return r
        results: web.web_results q 5
        out: ""
        for x in results
            out: out ++ "- " ++ (get x "title") ++ " (" ++ (get x "url") ++ ")\n"
        set r "ok" true
        set r "result" out
        return r
    if action == "fetch"
        u: get s "url"
        if u == nil
            set r "ok" false
            set r "error" "fetch braucht url"
            return r
        text: web.web_fetch u
        if text == ""
            set r "ok" false
            set r "error" ("Seite nicht abrufbar: " ++ u)
            return r
        set r "ok" true
        set r "result" text
        return r
    if action == "research"
        q: get s "query"
        if q == nil
            set r "ok" false
            set r "error" "research braucht query"
            return r
        rr: web.research q
        set r "ok" true
        set r "result" (get rr "context")
        return r
    if action == "mcp_call"
        tname: get s "tool"
        if tname == nil
            set r "ok" false
            set r "error" "mcp_call braucht tool"
            return r
        targs: get s "args"
        if targs == nil
            targs: {}
        try
            out: tool_call tname targs
            set r "ok" true
            set r "result" out
        catch e
            set r "ok" false
            set r "error" (to_str e)
        return r
    set r "ok" false
    set r "error" ("Unbekannte Aktion: " ++ action)
    r

--! Legt einen Plan an und liefert die id.
fn create_plan h goal steps
    ts: mem.sql_escape (mem.now_ts 0)
    db_exec h ("INSERT INTO plans (goal, steps, state, step_idx, result, created, updated) VALUES ('" ++ (mem.sql_escape goal) ++ "', '" ++ (mem.sql_escape (to_json steps)) ++ "', 'running', 0, '', '" ++ ts ++ "', '" ++ ts ++ "')")
    get (at (db_query h "SELECT max(id) AS mid FROM plans") 0) "mid"

--! Aktualisiert den Planzustand (Checkpoint).
fn update_plan h pid state idx result
    db_exec h ("UPDATE plans SET state = '" ++ (mem.sql_escape state) ++ "', step_idx = " ++ (to_str idx) ++ ", result = '" ++ (mem.sql_escape result) ++ "', updated = '" ++ (mem.sql_escape (mem.now_ts 0)) ++ "' WHERE id = " ++ (to_str pid))

--! Beschreibt die 'mcp_call'-Aktion inkl. aktuell verfuegbarer Werkzeuge (lokal + MCP)
--! fuer die KI-Plan-Prompts. Leer, wenn (noch) keine Werkzeuge registriert sind.
fn mcp_call_hint _
    tools: mcp.discovered_tool_names ([])
    if (len tools) == 0
        ""
    else
        " mcp_call braucht 'tool' (Werkzeugname) und optional 'args' (Map). Verfuegbare Werkzeuge: " ++ (join tools ", ") ++ "."

--! Revidiert den Plan nach einem Fehler. Fallback: fehlgeschlagenen Schritt streichen.
fn revise_steps h goal steps fail_idx error
    try
        j: ai_chat_json ("Du revidierst einen Aufgabenplan. Antworte ausschliesslich als JSON-Liste von Schritten mit 'action' (store, graph, goal, retrieve, search, fetch, research oder mcp_call) und den noetigen Parametern. Vermeide den fehlgeschlagenen Schritt." ++ (mcp_call_hint 0)) ("Aufgabe: " ++ goal ++ ". Fehler: " ++ error)
        normalize_steps j
    catch
        drop_step steps fail_idx

--! Normalisiert KI-Schritte in validierte Schritt-Maps (nur bekannte Aktionen).
export fn normalize_steps raw
    out: []
    for e in raw
        a: get e "action"
        if a != nil
            valid: false
            if a == "store" || a == "graph" || a == "goal" || a == "retrieve" || a == "search" || a == "fetch" || a == "research" || a == "mcp_call"
                valid: true
            if valid
                push out e
    out

--! Deterministischer Fallback: streicht den fehlgeschlagenen Schritt.
fn drop_step steps fail_idx
    out: []
    i: 0
    while i < (len steps)
        if i != fail_idx
            push out (at steps i)
        i: i + 1
    out

--! Führt einen Plan mit Checkpoints und Feedback-Loop aus.
export fn run_plan h goal steps
    init_executor h
    pid: create_plan h goal steps
    i: 0
    errs: 0
    while i < (len steps)
        update_plan h pid "running" i ""
        s: at steps i
        r: exec_step h s
        if get r "ok"
            i: i + 1
            errs: 0
        else
            errs: errs + 1
            if errs > 2
                revised: revise_steps h goal steps i (get r "error")
                if (len revised) <= i
                    update_plan h pid "failed" i (get r "error")
                    f: {}
                    set f "ok" false
                    set f "plan_id" pid
                    set f "error" (get r "error")
                    return f
                steps: revised
                errs: 0
    update_plan h pid "done" i ""
    out: {}
    set out "ok" true
    set out "plan_id" pid
    set out "steps_done" i
    out

--! Haupt-Einstieg: leitet einen Plan ab (Template oder KI) und führt ihn aus.
export fn execute_task h goal
    init_executor h
    kind: mem.rule_classify goal
    steps: plan_template kind goal
    if (len steps) == 0
        try
            j: ai_chat_json ("Du zerlegst eine Aufgabe in ausfuehrbare Schritte. Antworte ausschliesslich als JSON-Liste von Schritten mit 'action' (store, graph, goal, retrieve, search, fetch, research oder mcp_call) und den noetigen Parametern." ++ (mcp_call_hint 0)) goal
            steps: normalize_steps j
        catch
            steps: []
    if (len steps) == 0
        f: {}
        set f "ok" false
        set f "error" "Keine Schritte ableitbar"
        return f
    run_plan h goal steps

--! Liest den Zustand eines Plans (Test/Debug).
export fn plan_state h pid
    rows: db_query h ("SELECT id, goal, state, step_idx, result FROM plans WHERE id = " ++ (to_str pid))
    if (len rows) > 0
        at rows 0
    else
        nil
