--! dashboard.pipe — P3: web dashboard (chat, manage memories, goals,
--! knowledge graph, activity, tools). A separate channel alongside Telegram,
--! via pipe-web. Uses the same core functions from memory/swarm/executor/
--! web.pipe as muninn.pipe — only the command dispatcher for the web chat
--! (dashboard_reply) is a deliberately thin copy of muninn.pipe's
--! handle_message: there, the dispatcher is tightly interwoven with
--! Telegram-specific behavior (inline buttons, "typing" status), and a
--! shared extraction would have meant more risk to the already-live
--! Telegram channel than the ~40 lines of duplicated pure dispatch logic are
--! worth. The actual logic (gremium, executor, memory, research, ingestion)
--! still lives exclusively in the respective modules.
--!
--! Design: color palette taken 1:1 from pipe-lang.com (dark theme, purple
--! accents — that was explicitly requested), layout/components/typography
--! deliberately INDEPENDENT (sidebar navigation instead of a scroll page, no
--! gradient-text headings, no "terminal window" chat, system font instead of
--! the Google Font combination used on the site).
--!
--! Security: binds to localhost only by default (see muninn.pipe); optionally
--! secured via DASHBOARD_TOKEN (query param ?token=... or header
--! X-Dashboard-Token). A query-param token is NOT a full auth mechanism (ends
--! up in logs/browser history) — a public deployment needs a reverse proxy
--! with TLS + real authentication in front of it, not this token alone.
--!
--! Every request opens/closes its own DB handle (like Telegram's poll_once):
--! a db_open without a following db_close does not reliably persist writes to
--! the file (see Plan.md). pipe-web serializes requests internally (one mutex
--! per server), so this is concurrency-safe despite the many short-lived
--! handles. mem.open_locked/close_locked additionally guards every access
--! across processes against Telegram/consolidation (see comment there).
import "pipe-web"
import "sqlite"
import "modules/memory.pipe" as mem
import "modules/swarm.pipe" as grm
import "modules/executor.pipe" as exe
import "modules/web.pipe" as web

DASH_STATE: {token: nil}
DASH_CHAT_ID: "dashboard"

--! Checks the optional token (query param or header). Without a configured
--! token, the check is disabled (trusting the localhost bind).
fn auth_mw req
    tok: get DASH_STATE "token"
    if tok == nil || tok == ""
        return nil
    q: get req "query"
    supplied: nil
    if q != nil
        supplied: get q "token"
    if supplied == nil
        hdrs: get req "headers"
        if hdrs != nil
            supplied: get hdrs "X-Dashboard-Token"
    if supplied == tok
        nil
    else
        text 401 "Unauthorized — ?token=... or X-Dashboard-Token header required."

--! Forces no-cache headers on a pipe-web response map. Everything here is
--! live (chat, memories, status, ...) and must NEVER be cached by the browser
--! (or an intermediate proxy) — otherwise a user would silently see a stale
--! version after an update/change, with no "reload" noticing or fixing it.
fn no_cache resp
    hdrs: get resp "headers"
    if hdrs == nil
        hdrs: {}
    set hdrs "Cache-Control" "no-store, no-cache, must-revalidate, max-age=0"
    set hdrs "Pragma" "no-cache"
    set hdrs "Expires" "0"
    set resp "headers" hdrs
    resp

DASHBOARD_HTML: `<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Muninn</title>
<style>
:root{
  --bg:#07070c;--bg2:#0d0d16;--bg3:#141420;--card:#11111c;
  --fg:#e8e8f0;--fg2:#9090a8;--fg3:#606078;
  --accent:#a855f7;--accent2:#7c3aed;--green:#3ce096;--orange:#c084fc;--red:#fc5c7c;
  --border:#1e1e2e;
  --sans:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{background:var(--bg);color:var(--fg);font-family:var(--sans);font-size:14px;-webkit-text-size-adjust:100%}
/* --vh is set via JS from window.visualViewport.height (see script below,
   with window.innerHeight as a fallback) — on mobile browsers (especially
   iOS Safari), 100vh is often LARGER than the actually visible height
   (counts the collapsible address bar) AND changes live as the address bar
   shows/hides; visualViewport tracks that correctly at all times (100dvh is
   deliberately NOT also used — two competing mechanisms are harder to debug
   than one). overflow:hidden on body would, if the calculation is wrong,
   push parts of the page (e.g. the navigation) outside the visible area AND
   make them unreachable, since not scrollable — so body stays scrollable as
   a safety net. */
.app{display:flex;height:100vh;min-height:100vh}
.app{height:calc(var(--vh, 1vh) * 100)}

.sidebar{width:216px;flex-shrink:0;background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column}
.brand{padding:20px 18px 16px;font-weight:700;font-size:1.05rem;letter-spacing:-.2px;border-bottom:1px solid var(--border);color:var(--fg)}
.brand small{display:block;color:var(--fg3);font-weight:500;font-size:.65rem;text-transform:uppercase;letter-spacing:.09em;margin-top:4px}
.nav{flex:1;padding:10px 0;overflow-y:auto}
.nav-item{display:flex;align-items:center;gap:10px;width:100%;padding:9px 18px;background:none;border:none;border-left:3px solid transparent;color:var(--fg2);font-size:.83rem;font-family:var(--sans);text-align:left;cursor:pointer}
.nav-item:hover{color:var(--fg);background:rgba(255,255,255,.03)}
.nav-item.active{color:var(--fg);background:var(--bg3);border-left-color:var(--accent)}
.nav-item .ic{width:14px;text-align:center;color:var(--accent2);font-size:.9rem}
.sidebar-foot{padding:12px 18px;border-top:1px solid var(--border);font-size:.68rem;color:var(--fg3);display:flex;align-items:center;gap:7px}
.dot-live{width:6px;height:6px;border-radius:50%;background:var(--green);display:inline-block;flex-shrink:0}

.content{flex:1;display:flex;flex-direction:column;min-width:0;min-height:0}
.topbar{padding:15px 26px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;flex-shrink:0}
.topbar h1{font-size:.98rem;font-weight:700;display:flex;align-items:center;gap:9px;color:var(--fg)}
.topbar h1 .marker{width:7px;height:7px;background:var(--accent);border-radius:2px;display:inline-block;flex-shrink:0}
.stat-strip{display:flex;gap:18px;flex-wrap:wrap;max-width:100%;overflow-x:auto}
.stat-strip .s{font-size:.7rem;color:var(--fg3);white-space:nowrap}
.stat-strip .s b{color:var(--accent2);font-family:var(--mono);font-weight:600}
.view{flex:1;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:22px 26px}
.panel{display:none}
.panel.active{display:block}
#panel-chat.active{display:flex;flex-direction:column;height:100%}
.subhead{font-size:.7rem;color:var(--fg3);margin:22px 0 10px;text-transform:uppercase;letter-spacing:.08em}
.subhead:first-child{margin-top:0}

.row-item{display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap;padding:11px 14px;background:var(--card);border:1px solid var(--border);border-left:3px solid var(--border);border-radius:6px;margin-bottom:7px}
.row-item.acc-accent{border-left-color:var(--accent)}
.row-item.acc-green{border-left-color:var(--green)}
.row-item.acc-red{border-left-color:var(--red)}
.row-item.acc-orange{border-left-color:var(--orange)}
.row-main{flex:1;min-width:0}
.row-main .txt{color:var(--fg);word-break:break-word;line-height:1.55;font-size:.85rem}
.row-meta{color:var(--fg3);font-size:.66rem;font-family:var(--mono);margin-top:6px;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.tag{display:inline-block;background:var(--bg3);color:var(--accent2);border-radius:4px;padding:2px 6px;font-size:.62rem;font-family:var(--mono)}
.row-actions{display:flex;gap:5px;flex-shrink:0;align-items:center}
.btn-icon{background:none;border:1px solid var(--border);border-radius:5px;color:var(--fg2);cursor:pointer;padding:3px 8px;font-size:.75rem;font-family:var(--mono);line-height:1.4}
.btn-icon:hover{border-color:var(--accent);color:var(--fg)}
.btn-icon.danger:hover{border-color:var(--red);color:var(--red)}

.toolbar{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap}
.toolbar input, .toolbar select{background:var(--bg2);border:1px solid var(--border);border-radius:6px;padding:8px 11px;color:var(--fg);font-family:var(--sans);font-size:.82rem;outline:none}
.toolbar input{flex:1;min-width:160px}
.toolbar input:focus, .toolbar select:focus{border-color:var(--accent)}
.btn{background:var(--accent);color:#fff;border:none;border-radius:6px;padding:8px 16px;font-weight:600;font-size:.82rem;cursor:pointer;font-family:var(--sans)}
.btn:hover{background:#8e72fc}
.btn-secondary{background:var(--bg3);color:var(--fg);border:1px solid var(--border)}
.btn-secondary:hover{border-color:var(--accent);background:var(--bg3)}
.empty{color:var(--fg3);font-size:.82rem;padding:22px 0;text-align:center}

.chat-wrap{display:flex;flex-direction:column;height:100%}
.chatlog{flex:1;overflow-y:auto;padding-bottom:14px}
.msg{margin-bottom:12px;max-width:75%;font-size:.85rem}
.msg.user{margin-left:auto}
.bubble{display:inline-block;padding:9px 13px;white-space:pre-wrap;line-height:1.55}
.msg.user .bubble{background:var(--accent2);color:#fff;border-radius:9px 9px 2px 9px}
.msg.bot .bubble{background:var(--card);border:1px solid var(--border);color:var(--fg);border-radius:9px 9px 9px 2px}
.chat-input{display:flex;gap:8px;padding-top:12px;border-top:1px solid var(--border)}
.chat-input input{flex:1;background:var(--bg2);border:1px solid var(--border);border-radius:6px;padding:10px 13px;color:var(--fg);font-family:var(--sans);font-size:.85rem;outline:none}
.chat-input input:focus{border-color:var(--accent)}
.chat-hint{color:var(--fg3);font-size:.67rem;margin-top:9px;font-family:var(--mono)}

/* Mobile: the sidebar becomes a bottom tab bar (an established app pattern)
   instead of just narrowing — genuinely different behavior per breakpoint,
   not the same page navigation just smaller. */
@media (max-width:760px){
  .app{flex-direction:column}
  .sidebar{
    order:2;width:100%;height:60px;flex-shrink:0;flex-direction:row;
    border-right:none;border-top:1px solid var(--border);
    padding-bottom:env(safe-area-inset-bottom,0);
  }
  .brand,.sidebar-foot{display:none}
  .nav{flex:1;display:flex;flex-direction:row;padding:0;overflow-y:visible}
  .nav-item{flex:1;flex-direction:column;justify-content:center;gap:3px;padding:6px 2px;border-left:none;border-top:3px solid transparent;font-size:.62rem}
  .nav-item.active{border-left-color:transparent;border-top-color:var(--accent)}
  .nav-item .ic{width:auto;font-size:1.15rem}
  .content{order:1;min-height:0}

  .topbar{padding:12px 16px;flex-direction:column;align-items:flex-start;gap:8px}
  .view{padding:16px}
  .stat-strip{width:100%}

  .row-item{padding:12px}
  .row-actions{margin-left:auto}

  /* 16px prevents iOS Safari from auto-zooming in when focusing an input
     field with a smaller font size. */
  .toolbar input,.toolbar select,.chat-input input,.btn,.btn-secondary{font-size:16px}
  .toolbar input{min-width:0}
  .btn-icon{padding:6px 10px;font-size:.85rem}

  .msg{max-width:88%}
}

/* Very narrow devices: drop the labels under the icons, icon + active state
   (color) only — too cramped otherwise with 6 tabs. */
@media (max-width:420px){
  .nav-item span:not(.ic){display:none}
  .nav-item .ic{font-size:1.3rem}
}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
<div class="brand">Muninn<small>Memory Dashboard</small></div>
<nav class="nav" id="navlist">
<button class="nav-item active" data-panel="chat" data-title="Chat"><span class="ic">▤</span><span>Chat</span></button>
<button class="nav-item" data-panel="memories" data-title="Memories"><span class="ic">◈</span><span>Memories</span></button>
<button class="nav-item" data-panel="goals" data-title="Goals"><span class="ic">◎</span><span>Goals</span></button>
<button class="nav-item" data-panel="graph" data-title="Knowledge Graph"><span class="ic">◇</span><span>Knowledge Graph</span></button>
<button class="nav-item" data-panel="activity" data-title="Activity"><span class="ic">≡</span><span>Activity</span></button>
<button class="nav-item" data-panel="tools" data-title="Tools"><span class="ic">⚙</span><span>Tools</span></button>
<button class="nav-item" data-panel="costs" data-title="Costs"><span class="ic">$</span><span>Costs</span></button>
</nav>
<div class="sidebar-foot"><span class="dot-live"></span><span>connected</span></div>
</aside>
<div class="content">
<div class="topbar">
<h1 id="panel-title"><span class="marker"></span>Chat</h1>
<div class="stat-strip" id="stat-strip"></div>
</div>
<div class="view">

<section class="panel active" id="panel-chat">
<div class="chat-wrap">
<div class="chatlog" id="chatlog"></div>
<div class="chat-input">
<input id="chat-in" type="text" placeholder="Message or command...">
<button class="btn" onclick="sendChat()">Send</button>
</div>
<div class="chat-hint">/status · /reset · /consolidate · /graph &lt;name&gt; · /learn &lt;URL&gt;</div>
</div>
</section>

<section class="panel" id="panel-memories">
<div class="toolbar">
<input id="mem-q" type="text" placeholder="Search memories...">
<select id="mem-kind">
<option value="">all kinds</option>
<option value="permanent">permanent</option>
<option value="fact">fact</option>
<option value="task">task</option>
<option value="document">document</option>
<option value="summary">summary</option>
</select>
<button class="btn btn-secondary" onclick="loadMemories()">Filter</button>
</div>
<div id="mem-list"></div>
</section>

<section class="panel" id="panel-goals">
<div class="toolbar">
<button class="btn btn-secondary" onclick="loadGoals()">Refresh</button>
</div>
<div id="goals-list"></div>
</section>

<section class="panel" id="panel-graph">
<div class="toolbar">
<input id="graph-q" type="text" placeholder="Entity, e.g. Harry">
<button class="btn" onclick="loadGraph()">Query</button>
</div>
<div id="graph-list"></div>
</section>

<section class="panel" id="panel-activity">
<div class="subhead">Events</div>
<div id="events-list"></div>
<div class="subhead">Plans (Executor)</div>
<div id="plans-list"></div>
</section>

<section class="panel" id="panel-tools">
<div id="tools-list"></div>
</section>

<section class="panel" id="panel-costs">
<div id="costs-summary" class="subhead"></div>
<div class="subhead">Sessions</div>
<div id="costs-list"></div>
</section>

</div>
</div>
</div>
<script>
function setVhVar(){
  var h = (window.visualViewport && window.visualViewport.height) || window.innerHeight;
  document.documentElement.style.setProperty('--vh', (h * 0.01) + 'px');
}
setVhVar();
window.addEventListener('resize', setVhVar);
window.addEventListener('orientationchange', setVhVar);
if (window.visualViewport){
  window.visualViewport.addEventListener('resize', setVhVar);
  window.visualViewport.addEventListener('scroll', setVhVar);
}

function qtoken(){
  var params = new URLSearchParams(window.location.search);
  return params.get('token') || '';
}
function withToken(url){
  var t = qtoken();
  if(!t) return url;
  var sep = url.indexOf('?') === -1 ? '?' : '&';
  return url + sep + 'token=' + encodeURIComponent(t);
}
function escapeHtml(s){
  var d = document.createElement('div');
  d.textContent = s == null ? '' : String(s);
  return d.innerHTML;
}
function apiGet(path){
  return fetch(withToken(path), {cache: 'no-store'}).then(function(r){ return r.json(); });
}
function apiPost(path, body){
  return fetch(withToken(path), {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body || {})}).then(function(r){ return r.json(); });
}

var panelLoaders = {
  memories: loadMemories,
  goals: loadGoals,
  graph: function(){},
  activity: loadActivity,
  tools: loadTools,
  costs: loadCosts
};

document.getElementById('navlist').addEventListener('click', function(e){
  var btn = e.target.closest('.nav-item');
  if(!btn) return;
  document.querySelectorAll('.nav-item').forEach(function(b){ b.classList.remove('active'); });
  btn.classList.add('active');
  var name = btn.getAttribute('data-panel');
  document.querySelectorAll('.panel').forEach(function(p){ p.classList.remove('active'); });
  document.getElementById('panel-' + name).classList.add('active');
  document.getElementById('panel-title').innerHTML = '<span class="marker"></span>' + btn.getAttribute('data-title');
  if(panelLoaders[name]) panelLoaders[name]();
});

function loadStatus(){
  apiGet('api/status').then(function(d){
    var el = document.getElementById('stat-strip');
    el.innerHTML =
      '<span class="s"><b>' + d.memories + '</b> memories</span>' +
      '<span class="s"><b>' + d.entities + '</b> entities</span>' +
      '<span class="s"><b>' + d.relations + '</b> relations</span>' +
      '<span class="s"><b>' + d.tools + '</b> tools</span>';
  });
}

function addMsg(role, text){
  var log = document.getElementById('chatlog');
  var div = document.createElement('div');
  div.className = 'msg ' + role;
  var b = document.createElement('div');
  b.className = 'bubble';
  b.textContent = text;
  div.appendChild(b);
  log.appendChild(div);
  log.scrollTop = log.scrollHeight;
  return b;
}
function sendChat(){
  var input = document.getElementById('chat-in');
  var msg = input.value.trim();
  if(!msg) return;
  addMsg('user', msg);
  input.value = '';
  var bubble = addMsg('bot', '…');
  apiPost('api/chat', {message: msg})
    .then(function(d){ bubble.textContent = d.reply || '(no reply)'; loadStatus(); })
    .catch(function(){ bubble.textContent = 'Request failed.'; });
}
document.getElementById('chat-in').addEventListener('keydown', function(e){ if(e.key === 'Enter') sendChat(); });

function memItemHtml(m){
  return '<div class="row-item acc-accent"><div class="row-main">' +
    '<div class="txt"><span class="tag">' + escapeHtml(m.kind) + '</span> ' + escapeHtml(m.content) + '</div>' +
    '<div class="row-meta"><span>importance ' + m.importance + '</span><span>' + escapeHtml(m.ts) + '</span></div>' +
    '</div><div class="row-actions">' +
    '<button class="btn-icon" title="Importance +1" onclick="bumpImportance(' + m.id + ',' + m.importance + ',1)">▲</button>' +
    '<button class="btn-icon" title="Importance -1" onclick="bumpImportance(' + m.id + ',' + m.importance + ',-1)">▼</button>' +
    '<button class="btn-icon danger" title="Delete" onclick="deleteMemory(' + m.id + ')">✕</button>' +
    '</div></div>';
}
function loadMemories(){
  var q = document.getElementById('mem-q').value.trim();
  var kind = document.getElementById('mem-kind').value;
  var url = 'api/memories?limit=30';
  if(q) url += '&q=' + encodeURIComponent(q);
  if(kind) url += '&kind=' + encodeURIComponent(kind);
  apiGet(url).then(function(d){
    var el = document.getElementById('mem-list');
    var items = d.memories || [];
    if(items.length === 0){ el.innerHTML = '<div class="empty">No memories found.</div>'; return; }
    el.innerHTML = items.map(memItemHtml).join('');
  });
}
function bumpImportance(id, current, delta){
  apiPost('api/memories/importance', {id: id, importance: current + delta}).then(function(){ loadMemories(); });
}
function deleteMemory(id){
  apiPost('api/memories/delete', {id: id}).then(function(){ loadMemories(); loadStatus(); });
}

function goalItemHtml(g){
  var done = g.status === 'done';
  var acc = done ? 'acc-green' : 'acc-orange';
  var next = done ? 'open' : 'done';
  var label = done ? 'reopen' : 'done';
  return '<div class="row-item ' + acc + '"><div class="row-main">' +
    '<div class="txt">' + escapeHtml(g.goal_text) + '</div>' +
    '<div class="row-meta"><span class="tag">' + escapeHtml(g.status) + '</span></div>' +
    '</div><div class="row-actions">' +
    '<button class="btn-icon" onclick="toggleGoal(' + g.id + ',\'' + next + '\')">' + label + '</button>' +
    '</div></div>';
}
function loadGoals(){
  apiGet('api/goals').then(function(d){
    var el = document.getElementById('goals-list');
    var items = d.goals || [];
    if(items.length === 0){ el.innerHTML = '<div class="empty">No goals yet.</div>'; return; }
    el.innerHTML = items.map(goalItemHtml).join('');
  });
}
function toggleGoal(id, status){
  apiPost('api/goals/toggle', {id: id, status: status}).then(function(){ loadGoals(); });
}

function loadGraph(){
  var name = document.getElementById('graph-q').value.trim();
  if(!name) return;
  apiGet('api/graph?name=' + encodeURIComponent(name)).then(function(d){
    var el = document.getElementById('graph-list');
    var n = d.neighbors || [];
    if(n.length === 0){ el.innerHTML = '<div class="empty">No connections found.</div>'; return; }
    el.innerHTML = n.map(function(x){
      return '<div class="row-item acc-accent"><div class="row-main"><div class="txt">' + escapeHtml(x.rel) + ' → ' + escapeHtml(x.target) + '</div></div></div>';
    }).join('');
  });
}

function eventItemHtml(e){
  return '<div class="row-item"><div class="row-main">' +
    '<div class="txt">' + escapeHtml(e.msg) + '</div>' +
    '<div class="row-meta"><span class="tag">' + escapeHtml(e.kind) + '</span><span>chat ' + escapeHtml(e.chat_id) + '</span><span>' + escapeHtml(e.ts) + '</span></div>' +
    '</div></div>';
}
function planAccent(state){
  if(state === 'done') return 'acc-green';
  if(state === 'failed') return 'acc-red';
  return 'acc-orange';
}
function planItemHtml(p){
  return '<div class="row-item ' + planAccent(p.state) + '"><div class="row-main">' +
    '<div class="txt">' + escapeHtml(p.goal) + '</div>' +
    '<div class="row-meta"><span class="tag">' + escapeHtml(p.state) + '</span><span>step ' + p.step_idx + '</span><span>' + escapeHtml(p.updated) + '</span></div>' +
    '</div></div>';
}
function loadActivity(){
  apiGet('api/activity').then(function(d){
    var evEl = document.getElementById('events-list');
    var events = d.events || [];
    evEl.innerHTML = events.length === 0 ? '<div class="empty">No events yet.</div>' : events.map(eventItemHtml).join('');
    var plEl = document.getElementById('plans-list');
    var plans = d.plans || [];
    plEl.innerHTML = plans.length === 0 ? '<div class="empty">No plans yet.</div>' : plans.map(planItemHtml).join('');
  });
}

function toolItemHtml(t){
  return '<div class="row-item acc-accent"><div class="row-main">' +
    '<div class="txt"><span class="tag">' + escapeHtml(t.source) + '</span> ' + escapeHtml(t.name) + '</div>' +
    '<div class="row-meta"><span>' + escapeHtml(t.description) + '</span></div>' +
    '</div></div>';
}
function loadTools(){
  apiGet('api/tools').then(function(d){
    var el = document.getElementById('tools-list');
    var items = d.tools || [];
    if(items.length === 0){ el.innerHTML = '<div class="empty">No tools registered.</div>'; return; }
    el.innerHTML = items.map(toolItemHtml).join('');
  });
}

function costItemHtml(s){
  return '<div class="row-item acc-accent"><div class="row-main">' +
    '<div class="txt">Session ' + escapeHtml(s.session_id) + ' — $' + escapeHtml(s.cost_usd) + '</div>' +
    '<div class="row-meta"><span>' + escapeHtml(s.tokens) + ' tokens · ' + escapeHtml(s.calls) + ' calls · ' + escapeHtml(s.cache_hits) + ' cache hits</span>' +
    '<span>' + escapeHtml(s.first_ts) + ' to ' + escapeHtml(s.last_ts) + '</span></div>' +
    '</div></div>';
}
function loadCosts(){
  apiGet('api/costs').then(function(d){
    var sumEl = document.getElementById('costs-summary');
    var listEl = document.getElementById('costs-list');
    var sessions = d.sessions || [];
    if(sessions.length === 0){
      sumEl.textContent = 'No costs recorded yet.';
      listEl.innerHTML = '';
      return;
    }
    sumEl.innerHTML = '<b>$' + escapeHtml(d.total_cost_usd) + '</b> total across ' + escapeHtml(d.session_count) + ' sessions · ' + escapeHtml(d.total_tokens) + ' tokens · ' + escapeHtml(d.total_calls) + ' AI calls';
    listEl.innerHTML = sessions.map(costItemHtml).join('');
  });
}

loadStatus();
</script>
</body>
</html>`

fn page_handler req
    no_cache (html 200 DASHBOARD_HTML)

--! All handlers use mem.open_locked/close_locked instead of init_db/close
--! directly — otherwise a concurrently running Telegram process could
--! silently overwrite the dashboard's writes (or vice versa) (see
--! open_locked comment in memory.pipe, reproduced live). Slow, DB-independent
--! work (network fetch in learn_handler) deliberately runs BEFORE the lock,
--! so the lock isn't held longer than necessary.

fn status_handler req
    hl: mem.open_locked nil
    h: get hl "h"
    n: mem.memory_count h
    gc: mem.graph_counts h
    ta: mem.active_thread_count h
    tools: 0
    try
        tools: len (mcp_tools)
    catch e
        tools: 0
    mem.close_locked hl
    no_cache (ok {memories: n, entities: (get gc "entities"), relations: (get gc "relations"), threads_active: ta, tools: tools})

fn chat_handler req
    body: json_body req
    msg: get body "message"
    hl: mem.open_locked nil
    reply: dashboard_reply (get hl "h") msg
    mem.close_locked hl
    no_cache (ok {reply: reply})

fn memories_handler req
    q: get (get req "query") "q"
    kind: get (get req "query") "kind"
    limitv: get (get req "query") "limit"
    limit: 30
    if limitv != nil
        limit: to_num limitv
    hl: mem.open_locked nil
    rows: mem.list_memories (get hl "h") q kind limit
    mem.close_locked hl
    no_cache (ok {memories: rows})

fn memories_delete_handler req
    body: json_body req
    id: get body "id"
    hl: mem.open_locked nil
    mem.delete_memory (get hl "h") id
    mem.close_locked hl
    no_cache (ok {ok: true})

fn memories_importance_handler req
    body: json_body req
    id: get body "id"
    importance: get body "importance"
    hl: mem.open_locked nil
    mem.set_importance (get hl "h") id importance
    mem.close_locked hl
    no_cache (ok {ok: true})

fn goals_handler req
    hl: mem.open_locked nil
    rows: mem.list_goals (get hl "h") 30
    mem.close_locked hl
    no_cache (ok {goals: rows})

fn goals_toggle_handler req
    body: json_body req
    id: get body "id"
    newstatus: get body "status"
    hl: mem.open_locked nil
    mem.set_goal_status (get hl "h") id newstatus
    mem.close_locked hl
    no_cache (ok {ok: true})

fn graph_handler req
    name: get (get req "query") "name"
    if name == nil || name == ""
        return (no_cache (ok {neighbors: []}))
    hl: mem.open_locked nil
    n: mem.neighbors_of (get hl "h") name
    mem.close_locked hl
    no_cache (ok {neighbors: n})

fn activity_handler req
    hl: mem.open_locked nil
    h: get hl "h"
    ev: mem.recent_events h 20
    pl: exe.recent_plans h 10
    mem.close_locked hl
    no_cache (ok {events: ev, plans: pl})

fn tools_handler req
    tools: []
    try
        tools: mcp_tools
    catch e
        tools: []
    no_cache (ok {tools: tools})

fn costs_handler req
    hl: mem.open_locked nil
    s: mem.cost_summary (get hl "h")
    mem.close_locked hl
    no_cache (ok s)

fn learn_handler req
    body: json_body req
    url: get body "url"
    if url == nil || url == ""
        return (no_cache (json 400 {error: "url missing"}))
    content: web.web_fetch_raw url
    if content == nil || content == ""
        return (no_cache (ok {error: "Page not reachable or empty"}))
    hl: mem.open_locked nil
    res: mem.ingest_document (get hl "h") content url url 20
    mem.close_locked hl
    no_cache (ok res)

--! Detects a /graph request in the web chat and returns the entity name (or "").
fn dash_graph_query low tnorm
    if (len low) >= 7
        if (substring low 0 7) == "/graph "
            return (trim (substring tnorm 7 (len tnorm)))
    ""

--! Detects a /learn request in the web chat and returns the URL (or "").
fn dash_learn_query low tnorm
    if (len low) >= 7
        if (substring low 0 7) == "/learn "
            return (trim (substring tnorm 7 (len tnorm)))
    ""

--! Detects a /search request in the web chat and returns the search term (or "").
fn dash_search_query low tnorm
    if (len low) >= 8
        if (substring low 0 8) == "/search "
            return (trim (substring tnorm 8 (len tnorm)))
    ""

--! Thin command dispatcher for the web chat (see module comment above for
--! the deliberate distinction from muninn.pipe's Telegram handle_message).
fn dashboard_reply h text
    if text == nil
        return ""
    tnorm: trim text
    if tnorm == ""
        return ""
    low: lower tnorm
    if low == "/status" || low == "status"
        n: mem.memory_count h
        gc: mem.graph_counts h
        return ("Memories: " ++ (to_str n) ++ " · Knowledge graph: " ++ (to_str (get gc "entities")) ++ " entities, " ++ (to_str (get gc "relations")) ++ " relations")
    if low == "/reset"
        mem.close_thread h DASH_CHAT_ID
        return "Conversation history reset."
    if low == "/consolidate"
        cdays: mem.setting_consolidate_days h DASH_CHAT_ID
        res: mem.consolidate h (get cdays "decay") (get cdays "forget")
        return ("Consolidation: " ++ (to_str (get res "threads_summarized")) ++ " threads condensed, " ++ (to_str (get res "memories_decayed")) ++ " memories decayed, " ++ (to_str (get res "memories_forgotten")) ++ " forgotten.")
    gname: dash_graph_query low tnorm
    if gname != ""
        n: mem.neighbors_of h gname
        if (len n) == 0
            return ("No connections found for '" ++ gname ++ "'.")
        out: gname ++ ":\n"
        for x in n
            out: out ++ "• " ++ (get x "rel") ++ " → " ++ (get x "target") ++ "\n"
        return out
    lurl: dash_learn_query low tnorm
    if lurl != ""
        dtext: web.web_fetch_raw lurl
        if dtext == nil || dtext == ""
            return "Page not reachable or empty."
        res: mem.ingest_document h dtext lurl lurl 20
        return ("Learned from " ++ lurl ++ ": " ++ (to_str (get res "chunks_ingested")) ++ " of " ++ (to_str (get res "chunks_total")) ++ " chunks stored.")
    sq: dash_search_query low tnorm
    if sq != ""
        rr: web.research sq
        ctx: get rr "context"
        if ctx == nil || ctx == ""
            return "No usable results found."
        answer: ""
        try
            answer: ai_chat "You are a precise research assistant. Answer the question using the researched context, briefly and factually." ("Question: " ++ sq ++ "\n\nContext:\n" ++ ctx)
        catch e
            print ("Dashboard research ai_chat failed: " ++ (to_str e))
            mem.log_error h "dashboard_research_ai_chat" (to_str e)
            answer: ctx
        return answer
    --! From here on: ONE shared path for the entire free-form conversation
    --! (previously here, as in muninn.pipe, a pre-classification into
    --! permanent/task/goal/question — the same inconsistency issue applied
    --! here 1:1, see its expansion note at the time of the rework). The
    --! gremium has full tools (remember, schedule_reminder, web_search/fetch,
    --! MCP) and decides for itself.
    mem.log_event h DASH_CHAT_ID tnorm "chat"
    tid: mem.active_thread h DASH_CHAT_ID
    hist: mem.thread_history h tid 6
    task: tnorm
    if (len hist) > 0
        task: "Conversation so far (oldest first):\n" ++ (mem.format_history hist) ++ "\nCurrent message: " ++ tnorm
    task: (mem.settings_prompt_prefix h DASH_CHAT_ID) ++ task
    answer: ""
    try
        r: grm.run_gremium h DASH_CHAT_ID task
        answer: get r "content"
    catch e
        --! As in muninn.pipe's handle_message: without this log, a real
        --! gremium crash looked identical to "the AI doesn't know".
        print ("Dashboard run_gremium failed: " ++ (to_str e))
        mem.log_error h "dashboard_run_gremium" (to_str e)
        answer: ""
    mem.add_message h tid DASH_CHAT_ID "user" tnorm
    if answer == nil || answer == ""
        ctx: mem.retrieve_context h tnorm 3
        if (len ctx) > 0
            reply: "Here's what I remember about that:\n"
            for c in ctx
                reply: reply ++ "• " ++ c ++ "\n"
            mem.add_message h tid DASH_CHAT_ID "assistant" reply
            return reply
        fallback: "I don't have anything on that yet."
        mem.add_message h tid DASH_CHAT_ID "assistant" fallback
        return fallback
    mem.add_message h tid DASH_CHAT_ID "assistant" answer
    answer

--! Starts the dashboard server (blocking). bind e.g. "127.0.0.1:8787".
export fn start bind token
    set DASH_STATE "token" token
    a: app "Muninn Dashboard"
    use a auth_mw
    route_get a "/" page_handler
    route_get a "/api/status" status_handler
    post a "/api/chat" chat_handler
    route_get a "/api/memories" memories_handler
    post a "/api/memories/delete" memories_delete_handler
    post a "/api/memories/importance" memories_importance_handler
    route_get a "/api/goals" goals_handler
    post a "/api/goals/toggle" goals_toggle_handler
    route_get a "/api/graph" graph_handler
    route_get a "/api/activity" activity_handler
    route_get a "/api/tools" tools_handler
    route_get a "/api/costs" costs_handler
    post a "/api/learn" learn_handler
    print ("Muninn dashboard: http://" ++ bind ++ "/")
    if token != nil && token != ""
        print "Access requires ?token=... or X-Dashboard-Token header."
    listen a bind
    while true
        sleep 60000
