--! dashboard.pipe — P3: Web-Dashboard (Chat, Erinnerungen verwalten,
--! Wissensgraph, Status). Ein eigener Kanal neben Telegram, ueber pipe-web.
--! Nutzt dieselben Kernfunktionen aus memory/swarm/executor/web.pipe wie
--! muninn.pipe — nur die Kommando-Weiche fuer den Web-Chat (dashboard_reply)
--! ist eine eigene, bewusst duenne Kopie von muninn.pipes handle_message:
--! dort ist die Weiche eng mit Telegram-spezifischem Verhalten (Inline-Buttons,
--! "typing"-Status) verwoben, eine gemeinsame Extraktion haette an dieser
--! Stelle mehr Risiko für den bereits live laufenden Telegram-Kanal bedeutet,
--! als der Duplizierung von ~40 Zeilen reiner Weichen-Logik wert ist. Die
--! eigentliche Logik (Gremium, Executor, Gedaechtnis, Recherche, Ingestion)
--! liegt weiterhin ausschliesslich in den jeweiligen Modulen.
--!
--! Sicherheit: bindet standardmaessig nur an localhost (siehe muninn.pipe);
--! optional per DASHBOARD_TOKEN abgesichert (Query-Param ?token=... oder
--! Header X-Dashboard-Token). Ein Query-Param-Token ist KEIN vollwertiger
--! Auth-Mechanismus (landet in Logs/Browser-Historie) — fuer eine oeffentliche
--! Bereitstellung gehoert ein Reverse-Proxy mit TLS + echter Authentifizierung
--! davor, nicht dieser Token allein.
--!
--! Jeder Request oeffnet/schliesst sein eigenes DB-Handle (wie Telegrams
--! poll_once): ein db_open ohne folgenden db_close persistiert Schreibvorgaenge
--! nicht zuverlaessig auf die Datei (siehe Plan.md). pipe-web serialisiert
--! Requests intern (ein Mutex pro Server), daher ist das trotz vieler
--! kurzlebiger Handles nebenlaeufigkeitssicher.
import "pipe-web"
import "sqlite"
import "modules/memory.pipe" as mem
import "modules/swarm.pipe" as grm
import "modules/executor.pipe" as exe
import "modules/web.pipe" as web

DASH_STATE: {token: nil}
DASH_CHAT_ID: "dashboard"

--! Prueft das optionale Token (Query-Param oder Header). Ohne konfiguriertes
--! Token ist die Pruefung deaktiviert (Vertrauen auf den localhost-Bind).
fn auth_mw req
    tok: get DASH_STATE "token"
    if tok == nil || tok == ""
        return nil
    q: get req "query"
    supplied: nil
    if q != nil
        supplied: get q "token"
    if supplied == nil
        hdrs: get req "headers"
        if hdrs != nil
            supplied: get hdrs "X-Dashboard-Token"
    if supplied == tok
        nil
    else
        text 401 "Unauthorized — ?token=... oder X-Dashboard-Token-Header erforderlich."

DASHBOARD_HTML: `<!doctype html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Muninn — Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#07070c;--bg2:#0d0d16;--bg3:#141420;--card:#11111c;--fg:#e8e8f0;--fg2:#9090a8;--fg3:#606078;--accent:#a855f7;--accent2:#7c3aed;--green:#3ce096;--red:#fc5c7c;--border:#1e1e2e;--radius:10px;--mono:'JetBrains Mono',monospace;--sans:'Inter',system-ui,-apple-system,sans-serif}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--fg);font-family:var(--sans);line-height:1.6}
.container{max-width:1000px;margin:0 auto;padding:0 20px}
nav{position:sticky;top:0;z-index:10;background:rgba(7,7,12,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);padding:14px 0}
nav .container{display:flex;justify-content:space-between;align-items:center}
.logo{font-weight:800;font-size:1.15rem;color:var(--accent);text-decoration:none}
.logo span{color:var(--fg2);font-weight:500;font-size:.8rem;margin-left:10px}
main{padding:32px 0 60px}
h2{font-size:1rem;font-weight:700;margin-bottom:14px;letter-spacing:-.2px}
h2 span{background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
section{margin-bottom:34px}
.grid-4{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px}
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:16px}
.card .num{font-size:1.5rem;font-weight:700;background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.card .label{color:var(--fg3);font-size:.68rem;text-transform:uppercase;letter-spacing:.5px;margin-top:2px}
.term{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;box-shadow:0 16px 48px rgba(0,0,0,.4)}
.term-bar{background:var(--bg3);padding:8px 14px;display:flex;align-items:center;gap:6px;border-bottom:1px solid var(--border)}
.term-bar .dot{width:9px;height:9px;border-radius:50%;display:inline-block}
.term-title{margin-left:8px;color:var(--fg2);font-size:.7rem;font-family:var(--mono)}
#chatlog{height:340px;overflow-y:auto;padding:16px}
.msg{margin-bottom:14px;max-width:85%;font-size:.86rem}
.msg.user{margin-left:auto}
.bubble{display:inline-block;padding:9px 13px;border-radius:10px;white-space:pre-wrap;line-height:1.5;text-align:left}
.msg.user .bubble{background:var(--accent2);color:#fff}
.msg.bot .bubble{background:var(--bg3);color:var(--fg);border:1px solid var(--border)}
.chat-input{display:flex;gap:8px;padding:12px;border-top:1px solid var(--border);background:var(--bg3)}
.chat-input input{flex:1;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:10px 12px;color:var(--fg);font-family:var(--sans);font-size:.86rem;outline:none}
.chat-input input:focus{border-color:var(--accent)}
button.send{background:var(--accent);color:#fff;border:none;border-radius:8px;padding:0 18px;font-weight:600;font-size:.84rem;cursor:pointer}
button.send:hover{background:#8e72fc}
.panel{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:18px}
.row{display:flex;gap:8px;margin-bottom:14px}
.row input{flex:1;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:9px 12px;color:var(--fg);font-family:var(--sans);font-size:.84rem;outline:none}
.row input:focus{border-color:var(--accent)}
.row button{background:var(--bg3);color:var(--fg);border:1px solid var(--border);border-radius:8px;padding:0 16px;font-weight:600;font-size:.82rem;cursor:pointer}
.row button:hover{border-color:var(--accent)}
.mem-item{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--border);font-size:.82rem}
.mem-item:last-child{border-bottom:none}
.mem-content{flex:1;color:var(--fg);word-break:break-word}
.mem-meta{color:var(--fg3);font-size:.66rem;font-family:var(--mono);margin-top:3px}
.badge{display:inline-block;background:var(--bg3);color:var(--accent2);border-radius:4px;padding:1px 6px;font-size:.63rem;font-family:var(--mono);margin-right:6px}
.del{background:none;border:none;color:var(--red);cursor:pointer;font-size:.76rem;flex-shrink:0}
.del:hover{text-decoration:underline}
.empty{color:var(--fg3);font-size:.82rem;text-align:center;padding:18px 0}
footer{text-align:center;color:var(--fg3);font-size:.74rem;padding:24px 0;border-top:1px solid var(--border)}
footer a{color:var(--accent2);text-decoration:none}
</style>
</head>
<body>
<nav><div class="container">
<a class="logo" href="/">Muninn<span>Dashboard</span></a>
</div></nav>
<main class="container">

<section>
<div class="grid-4" id="status-cards"></div>
</section>

<section>
<h2><span>Chat</span></h2>
<div class="term">
<div class="term-bar"><span class="dot" style="background:#fc5c5c"></span><span class="dot" style="background:#febc2e"></span><span class="dot" style="background:#28c840"></span><span class="term-title">muninn</span></div>
<div id="chatlog"></div>
<div class="chat-input">
<input id="chat-in" type="text" placeholder="Frag Muninn etwas, oder /status, /graph Harry, /learn https://...">
<button class="send" onclick="sendChat()">Senden</button>
</div>
</div>
</section>

<section>
<h2><span>Erinnerungen</span></h2>
<div class="panel">
<div class="row">
<input id="mem-q" type="text" placeholder="Suche...">
<button onclick="loadMemories()">Suchen</button>
</div>
<div id="mem-list"></div>
</div>
</section>

<section>
<h2><span>Wissensgraph</span></h2>
<div class="panel">
<div class="row">
<input id="graph-q" type="text" placeholder="Entität, z.B. Harry">
<button onclick="loadGraph()">Abfragen</button>
</div>
<div id="graph-list"></div>
</div>
</section>

</main>
<footer>Muninn — Odins Rabe des Gedächtnisses, gebaut in <a href="https://pipe-lang.com" target="_blank">Pipe</a>.</footer>
<script>
function qtoken(){
  var params = new URLSearchParams(window.location.search);
  return params.get('token') || '';
}
function withToken(url){
  var t = qtoken();
  if(!t) return url;
  var sep = url.indexOf('?') === -1 ? '?' : '&';
  return url + sep + 'token=' + encodeURIComponent(t);
}
function escapeHtml(s){
  var d = document.createElement('div');
  d.textContent = s == null ? '' : s;
  return d.innerHTML;
}
function cardHtml(num, label){
  return '<div class="card"><div class="num">' + num + '</div><div class="label">' + label + '</div></div>';
}
function loadStatus(){
  fetch(withToken('/api/status')).then(function(r){return r.json();}).then(function(d){
    var el = document.getElementById('status-cards');
    el.innerHTML = cardHtml(d.memories, 'Erinnerungen') + cardHtml(d.entities + ' / ' + d.relations, 'Entitäten / Relationen') + cardHtml(d.tools, 'Werkzeuge') + cardHtml(d.threads_active, 'Aktive Threads');
  });
}
function addMsg(role, text){
  var log = document.getElementById('chatlog');
  var div = document.createElement('div');
  div.className = 'msg ' + role;
  var b = document.createElement('div');
  b.className = 'bubble';
  b.textContent = text;
  div.appendChild(b);
  log.appendChild(div);
  log.scrollTop = log.scrollHeight;
  return b;
}
function sendChat(){
  var input = document.getElementById('chat-in');
  var msg = input.value.trim();
  if(!msg) return;
  addMsg('user', msg);
  input.value = '';
  var bubble = addMsg('bot', '…');
  fetch(withToken('/api/chat'), {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({message: msg})})
    .then(function(r){return r.json();})
    .then(function(d){ bubble.textContent = d.reply || '(keine Antwort)'; loadMemories(); loadStatus(); })
    .catch(function(){ bubble.textContent = 'Fehler bei der Anfrage.'; });
}
document.getElementById('chat-in').addEventListener('keydown', function(e){ if(e.key === 'Enter') sendChat(); });

function memItemHtml(m){
  return '<div class="mem-item"><div><div class="mem-content"><span class="badge">' + escapeHtml(m.kind) + '</span>' + escapeHtml(m.content) + '</div><div class="mem-meta">Importance ' + m.importance + ' · ' + escapeHtml(m.ts) + '</div></div><button class="del" onclick="deleteMemory(' + m.id + ')">Löschen</button></div>';
}
function loadMemories(){
  var q = document.getElementById('mem-q').value.trim();
  var url = '/api/memories?limit=20';
  if(q) url += '&q=' + encodeURIComponent(q);
  fetch(withToken(url)).then(function(r){return r.json();}).then(function(d){
    var el = document.getElementById('mem-list');
    var items = d.memories || [];
    if(items.length === 0){ el.innerHTML = '<div class="empty">Keine Erinnerungen gefunden.</div>'; return; }
    el.innerHTML = items.map(memItemHtml).join('');
  });
}
function deleteMemory(id){
  fetch(withToken('/api/memories/delete'), {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({id: id})}).then(function(){ loadMemories(); loadStatus(); });
}
function loadGraph(){
  var name = document.getElementById('graph-q').value.trim();
  if(!name) return;
  fetch(withToken('/api/graph?name=' + encodeURIComponent(name))).then(function(r){return r.json();}).then(function(d){
    var el = document.getElementById('graph-list');
    var n = d.neighbors || [];
    if(n.length === 0){ el.innerHTML = '<div class="empty">Keine Verknüpfungen gefunden.</div>'; return; }
    el.innerHTML = n.map(function(x){ return '<div class="mem-item"><div class="mem-content">' + escapeHtml(x.rel) + ' → ' + escapeHtml(x.target) + '</div></div>'; }).join('');
  });
}
loadStatus();
loadMemories();
</script>
</body>
</html>`

fn page_handler req
    html 200 DASHBOARD_HTML

--! Alle Handler nutzen mem.open_locked/close_locked statt init_db/close direkt
--! — sonst koennte ein gleichzeitig laufender Telegram-Prozess Schreibvorgaenge
--! des Dashboards (oder umgekehrt) stillschweigend ueberschreiben (siehe
--! open_locked-Kommentar in memory.pipe, live reproduziert). Langsame,
--! DB-unabhaengige Arbeit (Netzwerk-Fetch in learn_handler) laeuft bewusst
--! VOR dem Lock, damit die Sperre nicht laenger als noetig gehalten wird.

fn status_handler req
    hl: mem.open_locked nil
    h: get hl "h"
    n: mem.memory_count h
    gc: mem.graph_counts h
    ta: mem.active_thread_count h
    tools: 0
    try
        tools: len (mcp_tools)
    catch e
        tools: 0
    mem.close_locked hl
    ok {memories: n, entities: (get gc "entities"), relations: (get gc "relations"), threads_active: ta, tools: tools}

fn chat_handler req
    body: json_body req
    msg: get body "message"
    hl: mem.open_locked nil
    reply: dashboard_reply (get hl "h") msg
    mem.close_locked hl
    ok {reply: reply}

fn memories_handler req
    q: get (get req "query") "q"
    limitv: get (get req "query") "limit"
    limit: 20
    if limitv != nil
        limit: to_num limitv
    hl: mem.open_locked nil
    rows: mem.list_memories (get hl "h") q limit
    mem.close_locked hl
    ok {memories: rows}

fn memories_delete_handler req
    body: json_body req
    id: get body "id"
    hl: mem.open_locked nil
    mem.delete_memory (get hl "h") id
    mem.close_locked hl
    ok {ok: true}

fn graph_handler req
    name: get (get req "query") "name"
    if name == nil || name == ""
        return (ok {neighbors: []})
    hl: mem.open_locked nil
    n: mem.neighbors_of (get hl "h") name
    mem.close_locked hl
    ok {neighbors: n}

fn learn_handler req
    body: json_body req
    url: get body "url"
    if url == nil || url == ""
        return (json 400 {error: "url fehlt"})
    content: web.web_fetch_raw url
    if content == nil || content == ""
        return (ok {error: "Seite nicht abrufbar oder leer"})
    hl: mem.open_locked nil
    res: mem.ingest_document (get hl "h") content url url 20
    mem.close_locked hl
    ok res

--! Erkennt eine /graph-Anfrage im Web-Chat und liefert den Entitätsnamen (oder "").
fn dash_graph_query low tnorm
    if (len low) >= 7
        if (substring low 0 7) == "/graph "
            return (trim (substring tnorm 7 (len tnorm)))
    ""

--! Erkennt eine /learn-Anfrage im Web-Chat und liefert die URL (oder "").
fn dash_learn_query low tnorm
    if (len low) >= 7
        if (substring low 0 7) == "/learn "
            return (trim (substring tnorm 7 (len tnorm)))
    ""

--! Erkennt eine /search-Anfrage im Web-Chat und liefert den Suchbegriff (oder "").
fn dash_search_query low tnorm
    if (len low) >= 8
        if (substring low 0 8) == "/search "
            return (trim (substring tnorm 8 (len tnorm)))
    ""

--! Duenne Kommando-Weiche fuer den Web-Chat (siehe Modul-Kommentar oben zur
--! bewussten Abgrenzung von muninn.pipes Telegram-handle_message).
fn dashboard_reply h text
    if text == nil
        return ""
    tnorm: trim text
    if tnorm == ""
        return ""
    low: lower tnorm
    if low == "/status" || low == "status"
        n: mem.memory_count h
        gc: mem.graph_counts h
        return ("Erinnerungen: " ++ (to_str n) ++ " · Wissensgraph: " ++ (to_str (get gc "entities")) ++ " Entitäten, " ++ (to_str (get gc "relations")) ++ " Relationen")
    if low == "/reset"
        mem.close_thread h DASH_CHAT_ID
        return "Gespraechsverlauf zurueckgesetzt."
    if low == "/consolidate"
        res: mem.consolidate h
        return ("Konsolidierung: " ++ (to_str (get res "threads_summarized")) ++ " Threads verdichtet, " ++ (to_str (get res "memories_decayed")) ++ " Erinnerungen gealtert, " ++ (to_str (get res "memories_forgotten")) ++ " vergessen.")
    gname: dash_graph_query low tnorm
    if gname != ""
        n: mem.neighbors_of h gname
        if (len n) == 0
            return ("Keine Verknüpfungen zu '" ++ gname ++ "' gefunden.")
        out: gname ++ ":\n"
        for x in n
            out: out ++ "• " ++ (get x "rel") ++ " → " ++ (get x "target") ++ "\n"
        return out
    lurl: dash_learn_query low tnorm
    if lurl != ""
        dtext: web.web_fetch_raw lurl
        if dtext == nil || dtext == ""
            return "Seite nicht abrufbar oder leer."
        res: mem.ingest_document h dtext lurl lurl 20
        return ("Gelernt aus " ++ lurl ++ ": " ++ (to_str (get res "chunks_ingested")) ++ " von " ++ (to_str (get res "chunks_total")) ++ " Abschnitten gespeichert.")
    sq: dash_search_query low tnorm
    if sq != ""
        rr: web.research sq
        ctx: get rr "context"
        if ctx == nil || ctx == ""
            return "Keine brauchbaren Ergebnisse gefunden."
        answer: ""
        try
            answer: ai_chat "Du bist ein präziser Recherche-Assistent. Beantworte die Frage anhand des recherchierten Kontexts, kurz und faktentreu." ("Frage: " ++ sq ++ "\n\nKontext:\n" ++ ctx)
        catch e
            answer: ctx
        return answer
    kind: mem.classify_input tnorm
    mem.log_event h DASH_CHAT_ID tnorm kind
    if kind == "permanent"
        mem.add_memory h tnorm "permanent" 3 "dashboard" "nutzer"
        return ("Notiert: " ++ tnorm)
    if kind == "task" || kind == "goal"
        res: exe.execute_task h tnorm
        if get res "ok"
            return ("Erledigt (" ++ (to_str (get res "steps_done")) ++ " Schritte).")
        return ("Plan fehlgeschlagen: " ++ (get res "error"))
    if kind == "question"
        tid: mem.active_thread h DASH_CHAT_ID
        hist: mem.thread_history h tid 6
        task: tnorm
        if (len hist) > 0
            task: "Bisheriger Gespraechsverlauf (aeltester zuerst):\n" ++ (mem.format_history hist) ++ "\nAktuelle Frage: " ++ tnorm
        answer: ""
        try
            r: grm.run_gremium h task
            answer: get r "content"
        catch e
            answer: ""
        mem.add_message h tid DASH_CHAT_ID "user" tnorm
        if answer == nil || answer == ""
            ctx: mem.retrieve_context h tnorm 3
            if (len ctx) > 0
                reply: "Dazu erinnere ich mich an:\n"
                for c in ctx
                    reply: reply ++ "• " ++ c ++ "\n"
                mem.add_message h tid DASH_CHAT_ID "assistant" reply
                return reply
            fallback: "Dazu fällt mir noch nichts ein."
            mem.add_message h tid DASH_CHAT_ID "assistant" fallback
            return fallback
        mem.add_message h tid DASH_CHAT_ID "assistant" answer
        return answer
    "Verstanden. (" ++ kind ++ ")"

--! Startet den Dashboard-Server (blockierend). bind z.B. "127.0.0.1:8787".
export fn start bind token
    set DASH_STATE "token" token
    a: app "Muninn Dashboard"
    use a auth_mw
    route_get a "/" page_handler
    route_get a "/api/status" status_handler
    post a "/api/chat" chat_handler
    route_get a "/api/memories" memories_handler
    post a "/api/memories/delete" memories_delete_handler
    route_get a "/api/graph" graph_handler
    post a "/api/learn" learn_handler
    print ("Muninn-Dashboard: http://" ++ bind ++ "/")
    if token != nil && token != ""
        print "Zugriff nur mit ?token=... oder X-Dashboard-Token-Header."
    listen a bind
    while true
        sleep 60000
