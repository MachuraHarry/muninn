--! telegram.pipe — Telegram Bot API client (Long-Polling), rein HTTP.
--! Basis: https://core.telegram.org/bots/api
--! Token wird nie im Code abgelegt — immer als Parameter durchgereicht.
--! Pipe-Map-Literale erlauben nur bare Identifier als Keys; Telegram braucht
--! String-Keys (chat_id, text, ...), daher wird jeder Request-Body mit `set` aufgebaut.

--! Baut eine Fehler-Rückgabe-Map auf (ok: false).
fn err_map status body
    m: {}
    set m "ok" false
    set m "status" status
    set m "body" body
    m

--! Generischer POST: liefert das parse_json-Ergebnis (Map mit "ok").
export fn tel_post token method body_map
    url: "https://api.telegram.org/bot" ++ token ++ "/" ++ method
    hdrs: {}
    set hdrs "Content-Type" "application/json"
    body: to_json body_map
    r: http_request "POST" url hdrs body
    status: get r "status"
    j: nil
    try
        j: parse_json (get r "body")
    catch e
        j: nil
    if j == nil
        return (err_map status (get r "body"))
    if status != 200
        return (err_map status j)
    j

--! Generischer GET mit Query-Parametern (query ist eine Liste von [key, value]-Paaren).
--! Listenliterale als Funktionsargument werden in Klammern gesetzt: ([]).
export fn tel_get token method query
    qs: ""
    for pair in query
        k: at pair 0
        v: at pair 1
        sep: "?"
        if (len qs) > 0
            sep: "&"
        qs: qs ++ sep ++ k ++ "=" ++ (urlencode v)
    url: "https://api.telegram.org/bot" ++ token ++ "/" ++ method ++ qs
    r: http_request "GET" url
    j: nil
    try
        j: parse_json (get r "body")
    catch e
        j: nil
    if j == nil
        return (err_map (get r "status") (get r "body"))
    j

--! Primitive URL-Encoding für Query-Parameter.
fn urlencode s
    s: replace_all s "%" "%25"
    s: replace_all s "&" "%26"
    s: replace_all s "=" "%3D"
    s: replace_all s "+" "%2B"
    s: replace_all s " " "%20"
    s

--! Bot-Info: {"ok": true, "result": {...}}
export fn tel_get_me token
    tel_get token "getMe" ([])

--! Offene Updates (Long-Polling). Liefert die result-Liste (oder []).
export fn tel_get_updates token offset timeout
    query: [["timeout", (to_str timeout)]]
    if offset != nil
        query: [["offset", (to_str offset)], ["timeout", (to_str timeout)]]
    j: tel_get token "getUpdates" query
    if get j "ok"
        get j "result"
    else
        []

--! Normalisiert vom LLM erzeugtes Markdown auf Telegrams "Markdown"-Parse-Mode
--! (V1): **fett**/__fett__ -> *fett* (V1 kennt nur einfache Sternchen/
--! Unterstriche fuer fett/kursiv, KEINE doppelten). LLMs schreiben aber
--! durchgehend CommonMark-Stil (**fett**) — ohne diese Normalisierung wuerden
--! Nutzer entweder woertliche Sternchen sehen (kein parse_mode) oder Telegram
--! lehnt die Nachricht als kaputte Entity ab.
fn tg_markdown text
    t: replace_all text "**" "*"
    t: replace_all t "__" "_"
    t

--! Sendet mit parse_mode "Markdown"; scheitert das (z.B. unausgewogene
--! Entities, die die Normalisierung oben nicht abdeckt), wird als Klartext
--! nachgesendet — so geht nie eine Antwort wegen eines Formatierungsfehlers
--! verloren, nur die Formatierung faellt in dem Fall weg.
fn tel_post_with_markdown token method m
    orig_text: get m "text"
    md: {}
    for k in (keys m)
        set md k (get m k)
    set md "text" (tg_markdown orig_text)
    set md "parse_mode" "Markdown"
    res: tel_post token method md
    if (get res "ok") == false
        res: tel_post token method m
    res

--! Sende eine Textnachricht in einen Chat.
export fn tel_send_message token chat_id text
    m: {}
    set m "chat_id" chat_id
    set m "text" text
    tel_post_with_markdown token "sendMessage" m

--! Bearbeite eine gesendete Nachricht.
export fn tel_edit_message_text token chat_id message_id text
    m: {}
    set m "chat_id" chat_id
    set m "message_id" message_id
    set m "text" text
    tel_post token "editMessageText" m

--! Lösche eine Nachricht.
export fn tel_delete_message token chat_id message_id
    m: {}
    set m "chat_id" chat_id
    set m "message_id" message_id
    tel_post token "deleteMessage" m

--! "Schreibt gerade"-Status.
export fn tel_send_chat_action token chat_id action
    m: {}
    set m "chat_id" chat_id
    set m "action" action
    tel_post token "sendChatAction" m

--! Baut einen Inline-Keyboard-Button.
export fn tel_button text data
    b: {}
    set b "text" text
    set b "callback_data" data
    b

--! Sendet Text mit Inline-Tastatur (kb = Liste von Button-Reihen).
export fn tel_send_message_kb token chat_id text kb
    m: {}
    set m "chat_id" chat_id
    set m "text" text
    if kb != nil
        rm: {}
        set rm "inline_keyboard" kb
        set m "reply_markup" rm
    tel_post_with_markdown token "sendMessage" m

--! Beantwortet einen Callback-Query (schließt den Lade-Spinner).
export fn tel_answer_callback token cbid text
    m: {}
    set m "callback_query_id" cbid
    if text != nil && text != ""
        set m "text" text
    tel_post token "answerCallbackQuery" m

--! Löst eine file_id zu einem herunterladbaren file_path auf (oder nil).
export fn tel_get_file token file_id
    j: tel_get token "getFile" ([["file_id", file_id]])
    if get j "ok"
        get (get j "result") "file_path"
    else
        nil

--! Lädt eine Datei über Telegrams File-API herunter (Rohinhalt als String).
export fn tel_download_file token file_path
    url: "https://api.telegram.org/file/bot" ++ token ++ "/" ++ file_path
    r: http_request "GET" url
    get r "body"
