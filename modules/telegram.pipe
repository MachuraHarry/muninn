--! telegram.pipe — Telegram Bot API client (long-polling), pure HTTP.
--! Reference: https://core.telegram.org/bots/api
--! The token is never stored in code — always passed through as a parameter.
--! Pipe map literals only allow bare identifiers as keys; Telegram needs
--! string keys (chat_id, text, ...), so every request body is built with `set`.

--! Builds an error-return map (ok: false).
fn err_map status body
    m: {}
    set m "ok" false
    set m "status" status
    set m "body" body
    m

--! Generic POST: returns the parse_json result (map with "ok").
export fn tel_post token method body_map
    url: "https://api.telegram.org/bot" ++ token ++ "/" ++ method
    hdrs: {}
    set hdrs "Content-Type" "application/json"
    body: to_json body_map
    r: http_request "POST" url hdrs body
    status: get r "status"
    j: nil
    try
        j: parse_json (get r "body")
    catch e
        j: nil
    if j == nil
        return (err_map status (get r "body"))
    if status != 200
        return (err_map status j)
    j

--! Generic GET with query parameters (query is a list of [key, value] pairs).
--! List literals as function arguments are wrapped in parens: ([]).
export fn tel_get token method query
    qs: ""
    for pair in query
        k: at pair 0
        v: at pair 1
        sep: "?"
        if (len qs) > 0
            sep: "&"
        qs: qs ++ sep ++ k ++ "=" ++ (urlencode v)
    url: "https://api.telegram.org/bot" ++ token ++ "/" ++ method ++ qs
    r: http_request "GET" url
    j: nil
    try
        j: parse_json (get r "body")
    catch e
        j: nil
    if j == nil
        return (err_map (get r "status") (get r "body"))
    j

--! Primitive URL encoding for query parameters.
fn urlencode s
    s: replace_all s "%" "%25"
    s: replace_all s "&" "%26"
    s: replace_all s "=" "%3D"
    s: replace_all s "+" "%2B"
    s: replace_all s " " "%20"
    s

--! Bot info: {"ok": true, "result": {...}}
export fn tel_get_me token
    tel_get token "getMe" ([])

--! Registers Telegram's native command menu (the "/" pop-up menu with
--! descriptions, also visible via the menu button next to the input field).
--! cmds: list of {command, description} — command WITHOUT a leading slash
--! (Telegram's requirement), description max 256 characters. Call once at
--! startup; Telegram remembers this server-side until it's set again.
export fn tel_set_my_commands token cmds
    list: []
    for c in cmds
        item: {}
        set item "command" (get c "command")
        set item "description" (get c "description")
        push list item
    m: {}
    set m "commands" list
    tel_post token "setMyCommands" m

--! Pending updates (long-polling). Returns the result list (or []).
export fn tel_get_updates token offset timeout
    query: [["timeout", (to_str timeout)]]
    if offset != nil
        query: [["offset", (to_str offset)], ["timeout", (to_str timeout)]]
    j: tel_get token "getUpdates" query
    if get j "ok"
        get j "result"
    else
        []

--! Converts CommonMark-style formatting (as the LLM naturally produces it:
--! **bold**, *italic*, `code`, [text](url)) into Telegram's HTML parse mode.
--! DELIBERATELY HTML instead of Telegram's own "Markdown" mode: that parser
--! is very strict about unbalanced/nested entities and failed often in
--! practice, silently falling back to plain text (the user then never saw
--! any formatting, with no visible error) — HTML only needs 3 characters
--! escaped (&, <, >) and is far more forgiving. Single-underscore italics
--! (_word_) is DELIBERATELY NOT converted: it collides too often with
--! technical terms like snake_case variable names, which come up a lot in
--! this bot's context. Order matters: escape first, THEN insert our own
--! tags — otherwise our own tags would get escaped too.
fn tg_html text
    t: regex_replace "&" "&amp;" text
    t: regex_replace "<" "&lt;" t
    t: regex_replace ">" "&gt;" t
    t: regex_replace "\\*\\*(.+?)\\*\\*" "<b>$1</b>" t
    t: regex_replace "__(.+?)__" "<b>$1</b>" t
    t: regex_replace "\\*(.+?)\\*" "<i>$1</i>" t
    t: regex_replace "`([^`]+)`" "<code>$1</code>" t
    t: regex_replace "\\[([^\\]]+)\\]\\(([^)]+)\\)" "<a href=\"$2\">$1</a>" t
    t

--! Sends with parse_mode "HTML" (see tg_html); if that still fails (e.g. an
--! edge case the normalization doesn't cover), retries as plain text — a
--! reply never gets lost due to a formatting error, only the formatting
--! itself is dropped in that case.
fn tel_post_with_markdown token method m
    orig_text: get m "text"
    md: {}
    for k in (keys m)
        set md k (get m k)
    set md "text" (tg_html orig_text)
    set md "parse_mode" "HTML"
    res: tel_post token method md
    if (get res "ok") == false
        res: tel_post token method m
    res

--! Send a text message to a chat.
export fn tel_send_message token chat_id text
    m: {}
    set m "chat_id" chat_id
    set m "text" text
    tel_post_with_markdown token "sendMessage" m

--! Truncates a string for log output (Telegram responses can be long).
export fn shorten_body s
    if s == nil
        return "nil"
    if (len s) > 500
        (substring s 0 500) ++ "…"
    else
        s

--! Uploads a local file via multipart/form-data to a Telegram endpoint
--! (sendPhoto/sendDocument need a real file upload, JSON isn't enough for
--! that). Pipe strings are byte-safe (read_file without "bytes" mode
--! returns the raw bytes losslessly as a string, verified), so the
--! multipart body can be assembled as a plain string and sent via
--! http_request(..., body_string) — Pipe has no dedicated multipart helper.
fn tel_upload token method field_name chat_id file_path caption
    content: read_file file_path
    if content == nil || content == ""
        return (err_map 0 ("File empty or unreadable: " ++ file_path))
    filename: file_path
    parts: split file_path "/"
    if (len parts) > 0
        filename: at parts ((len parts) - 1)
    boundary: "MuninnBoundary" ++ (to_str now) ++ (to_str (random_range 100000 999999))
    body: "--" ++ boundary ++ "\r\n"
    body: body ++ "Content-Disposition: form-data; name=\"chat_id\"\r\n\r\n" ++ (to_str chat_id) ++ "\r\n"
    if caption != nil && caption != ""
        body: body ++ "--" ++ boundary ++ "\r\n"
        body: body ++ "Content-Disposition: form-data; name=\"caption\"\r\n\r\n" ++ caption ++ "\r\n"
    body: body ++ "--" ++ boundary ++ "\r\n"
    body: body ++ "Content-Disposition: form-data; name=\"" ++ field_name ++ "\"; filename=\"" ++ filename ++ "\"\r\n"
    body: body ++ "Content-Type: application/octet-stream\r\n\r\n"
    body: body ++ content ++ "\r\n"
    body: body ++ "--" ++ boundary ++ "--\r\n"
    url: "https://api.telegram.org/bot" ++ token ++ "/" ++ method
    hdrs: {}
    set hdrs "Content-Type" ("multipart/form-data; boundary=" ++ boundary)
    print ("tel_upload " ++ method ++ " file=" ++ file_path ++ " size=" ++ (to_str (len content)) ++ " chat=" ++ (to_str chat_id))
    r: http_request "POST" url hdrs body
    status: get r "status"
    print ("tel_upload " ++ method ++ " http_status=" ++ (to_str status) ++ " response=" ++ (shorten_body (get r "body")))
    j: nil
    try
        j: parse_json (get r "body")
    catch e
        j: nil
    if j == nil
        return (err_map status (get r "body"))
    j

--! Sends a photo (JPEG/PNG/...) from a local file, optionally with a caption.
export fn tel_send_photo token chat_id file_path caption
    tel_upload token "sendPhoto" "photo" chat_id file_path caption

--! Sends an arbitrary file from the local filesystem, optionally with a caption.
export fn tel_send_document token chat_id file_path caption
    tel_upload token "sendDocument" "document" chat_id file_path caption

--! Sends a real voice-message bubble (not as a file attachment). file_path
--! MUST be Opus-in-OGG — Telegram's only format for sendVoice.
export fn tel_send_voice token chat_id file_path caption
    tel_upload token "sendVoice" "voice" chat_id file_path caption

--! Edits a sent message (with markdown, same fallback behavior as
--! tel_send_message — see tel_post_with_markdown).
export fn tel_edit_message_text token chat_id message_id text
    m: {}
    set m "chat_id" chat_id
    set m "message_id" message_id
    set m "text" text
    tel_post_with_markdown token "editMessageText" m

--! Like tel_edit_message_text, but with an inline keyboard (kb = list of
--! button rows, see tel_send_message_kb).
export fn tel_edit_message_text_kb token chat_id message_id text kb
    m: {}
    set m "chat_id" chat_id
    set m "message_id" message_id
    set m "text" text
    if kb != nil
        rm: {}
        set rm "inline_keyboard" kb
        set m "reply_markup" rm
    tel_post_with_markdown token "editMessageText" m

--! Delete a message.
export fn tel_delete_message token chat_id message_id
    m: {}
    set m "chat_id" chat_id
    set m "message_id" message_id
    tel_post token "deleteMessage" m

--! "Typing..." status.
export fn tel_send_chat_action token chat_id action
    m: {}
    set m "chat_id" chat_id
    set m "action" action
    tel_post token "sendChatAction" m

--! Reacts to a message with a single emoji -- used as an immediate "seen"
--! acknowledgment the instant a message arrives, before the gremium (which
--! can take a while, especially with tool calls) even starts. Best-effort:
--! not every chat/message supports reactions, callers should not treat a
--! failure here as fatal to handling the message itself.
export fn tel_set_message_reaction token chat_id message_id emoji
    r: {}
    set r "type" "emoji"
    set r "emoji" emoji
    m: {}
    set m "chat_id" chat_id
    set m "message_id" message_id
    set m "reaction" ([r])
    tel_post token "setMessageReaction" m

--! Builds an inline keyboard button.
export fn tel_button text data
    b: {}
    set b "text" text
    set b "callback_data" data
    b

--! Sends text with an inline keyboard (kb = list of button rows).
export fn tel_send_message_kb token chat_id text kb
    m: {}
    set m "chat_id" chat_id
    set m "text" text
    if kb != nil
        rm: {}
        set rm "inline_keyboard" kb
        set m "reply_markup" rm
    tel_post_with_markdown token "sendMessage" m

--! Answers a callback query (closes the loading spinner).
export fn tel_answer_callback token cbid text
    m: {}
    set m "callback_query_id" cbid
    if text != nil && text != ""
        set m "text" text
    tel_post token "answerCallbackQuery" m

--! Resolves a file_id to a downloadable file_path (or nil).
export fn tel_get_file token file_id
    j: tel_get token "getFile" ([["file_id", file_id]])
    if get j "ok"
        get (get j "result") "file_path"
    else
        nil

--! Downloads a file via Telegram's File API (raw content as a string).
export fn tel_download_file token file_path
    url: "https://api.telegram.org/file/bot" ++ token ++ "/" ++ file_path
    r: http_request "GET" url
    get r "body"
