--! mcp.pipe — MCP tool ecosystem (Plan.md P1): connects arbitrary external
--! tools via the Model Context Protocol. Servers are configured through the
--! MCP_SERVERS environment variable (JSON list), e.g.:
--!   [{"alias":"fs","type":"stdio","command":"npx",
--!     "args":["-y","@modelcontextprotocol/server-filesystem","/root/muninn/mcp_data"]},
--!    {"alias":"gh","type":"stdio","command":"npx",
--!     "args":["-y","@modelcontextprotocol/server-github"],
--!     "env":{"GITHUB_TOKEN":"env:GITHUB_TOKEN"}}]
CONNECTED: {}

--! "env:NAME" values are resolved at runtime from the real environment, so
--! secrets don't have to sit twice in .env. Every connection runs under the
--! "muninn" sandbox profile with an exec whitelist (only configured
--! commands) — lesson from the sandbox audit series: never give the AI
--! unrestricted exec.

--! Parses MCP_SERVERS (JSON list of server maps). Empty/invalid -> [] (MCP
--! stays disabled, no error and no exec/network needed).
export fn parse_mcp_config raw
    out: []
    if raw != nil && (trim raw) != ""
        try
            j: parse_json raw
            if (type_of j) == "LIST"
                out: j
            else
                print "WARNING: MCP server configuration is not a JSON array — ignored."
        catch e
            print ("WARNING: MCP server configuration is invalid JSON, ignored: " ++ (to_str e))
            out: []
    out

--! Last path segment of a command (for the exec whitelist), e.g. "npx".
fn cmd_basename cmd
    parts: split cmd "/"
    n: len parts
    if n == 0
        cmd
    else
        at parts (n - 1)

--! Unique command basenames of all stdio servers, for sandbox_profile.exec_whitelist.
export fn exec_whitelist_for servers
    seen: {}
    out: []
    for s in servers
        typ: get s "type"
        if typ == nil || typ == "stdio"
            cmd: get s "command"
            if cmd != nil && cmd != ""
                b: cmd_basename cmd
                if (get seen b) == nil
                    set seen b true
                    push out b
    out

--! Resolves an env map from the config. Values in the format "env:NAME" are
--! read from the real process environment (secrets stay out of the JSON config).
fn resolve_env raw_env
    out: {}
    if raw_env != nil
        for k in (keys raw_env)
            v: get raw_env k
            if (type_of v) == "STRING" && (len v) >= 4 && (substring v 0 4) == "env:"
                v: env (substring v 4 (len v))
            set out k v
    out

--! Resolves "env:NAME" values in ALL server envs. MUST be called BEFORE any
--! sandbox profile is active: once a profile is active, `env()` blocks any
--! name that looks like a secret (*KEY*/*TOKEN*/*SECRET*) as a safety
--! measure — and names like that typically sit behind "env:" (e.g.
--! "env:GITHUB_TOKEN"). Mutates the passed servers' env maps in place and
--! returns the same list.
export fn resolve_all_env servers
    for s in servers
        set s "env" (resolve_env (get s "env"))
    servers

--! Connects a stdio server. Pipe builtins are variadic without spread/apply,
--! hence the case split by argument count.
--!
--! BUG FOUND AND FIXED (live-diagnosed): this used to stop at n==6 and,
--! for n>=7, silently passed only the FIRST 7 elements of cargs to
--! mcp_use_stdio, dropping the rest with no error at all. That's not just
--! "fewer args than intended" — it TRUNCATES MID-FLAG, e.g. an args list
--! ending in ["--user-data-dir", "/some/path"] loses the path but KEEPS
--! the flag, so the child process receives "--user-data-dir" as its very
--! last argument with no value, which most CLI parsers treat as fatally
--! malformed input. Observed live against @playwright/mcp: the process
--! then exits before completing the MCP handshake, and the Go client
--! (pkg/mcp/client.go readLoop) reports this as "parse response:
--! unexpected end of JSON input" — a confusing, environment-sounding
--! error that has NOTHING to do with environment/PATH/permissions, only
--! with this silent truncation. No existing server config had ever
--! crossed 6 args elements before, so this sat latent until the
--! werkzeug_browser persistent-profile setup (--user-data-dir +
--! --output-dir) pushed it to 10. Extended generously past any
--! realistic real-world arg count; anything still beyond that now fails
--! LOUDLY via mcp_use_stdio's own "at least 1 argument" arity check
--! instead of silently mis-executing.
fn connect_stdio cmd cargs cenv alias
    n: len cargs
    if n == 0
        mcp_use_stdio cmd cenv alias
    else if n == 1
        mcp_use_stdio cmd (at cargs 0) cenv alias
    else if n == 2
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) cenv alias
    else if n == 3
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) cenv alias
    else if n == 4
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) (at cargs 3) cenv alias
    else if n == 5
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) (at cargs 3) (at cargs 4) cenv alias
    else if n == 6
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) (at cargs 3) (at cargs 4) (at cargs 5) cenv alias
    else if n == 7
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) (at cargs 3) (at cargs 4) (at cargs 5) (at cargs 6) cenv alias
    else if n == 8
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) (at cargs 3) (at cargs 4) (at cargs 5) (at cargs 6) (at cargs 7) cenv alias
    else if n == 9
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) (at cargs 3) (at cargs 4) (at cargs 5) (at cargs 6) (at cargs 7) (at cargs 8) cenv alias
    else if n == 10
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) (at cargs 3) (at cargs 4) (at cargs 5) (at cargs 6) (at cargs 7) (at cargs 8) (at cargs 9) cenv alias
    else if n == 11
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) (at cargs 3) (at cargs 4) (at cargs 5) (at cargs 6) (at cargs 7) (at cargs 8) (at cargs 9) (at cargs 10) cenv alias
    else if n == 12
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) (at cargs 3) (at cargs 4) (at cargs 5) (at cargs 6) (at cargs 7) (at cargs 8) (at cargs 9) (at cargs 10) (at cargs 11) cenv alias
    else if n == 13
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) (at cargs 3) (at cargs 4) (at cargs 5) (at cargs 6) (at cargs 7) (at cargs 8) (at cargs 9) (at cargs 10) (at cargs 11) (at cargs 12) cenv alias
    else if n == 14
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) (at cargs 3) (at cargs 4) (at cargs 5) (at cargs 6) (at cargs 7) (at cargs 8) (at cargs 9) (at cargs 10) (at cargs 11) (at cargs 12) (at cargs 13) cenv alias
    else if n == 15
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) (at cargs 3) (at cargs 4) (at cargs 5) (at cargs 6) (at cargs 7) (at cargs 8) (at cargs 9) (at cargs 10) (at cargs 11) (at cargs 12) (at cargs 13) (at cargs 14) cenv alias
    else
        raise ("connect_stdio: " ++ (to_str n) ++ " Programmargumente werden nicht unterstuetzt (Obergrenze 15) - modules/mcp.pipe:connect_stdio muss erweitert werden statt still abzuschneiden.")

--! Connects a single configured server (stdio or sse). Returns {alias, ok, error?}.
--! Marks CONNECTED[alias] on success — the ONLY place that does so (before,
--! only ensure_for_task set that after a successful call, but the eager
--! startup connect in setup_core went straight through connect_servers and
--! left CONNECTED empty; auto_servers_for_task then wrongly treated every
--! already-connected server as new and tried to reconnect it on every
--! matching message -> "alias already in use" error in the log on every
--! message that hit a server keyword).
fn connect_one idx s
    typ: get s "type"
    alias: get s "alias"
    if alias == nil || alias == ""
        alias: "srv" ++ (to_str idx)
    r: {alias: alias}
    try
        if typ == "sse"
            mcp_use_sse (get s "url") alias
        else
            cargs: get s "args"
            if cargs == nil
                cargs: []
            connect_stdio (get s "command") cargs (resolve_env (get s "env")) alias
        set r "ok" true
        set CONNECTED alias true
    catch e
        msg: to_str e
        if contains msg "already in use"
            --! Self-healing: "already in use" literally means the alias IS
            --! already connected at the Go level — the desired end state is
            --! already true, regardless of why CONNECTED[alias] here didn't
            --! already reflect that (live-observed: lazy loading's two
            --! independent connect triggers, ensure_mcp_for_task's keyword
            --! pre-match and werkzeug_aktivieren, can legitimately both
            --! decide the same alias is needed for two different messages).
            --! Treat as success and correct CONNECTED, instead of surfacing
            --! a scary, misleading "failed" for something that actually
            --! worked.
            set r "ok" true
            set CONNECTED alias true
        else
            set r "ok" false
            set r "error" msg
    r

--! Connects all configured servers. One failing server doesn't block the
--! others (best effort, every error is reported back).
export fn connect_servers servers
    out: []
    i: 0
    for s in servers
        push out (connect_one i s)
        i: i + 1
    out

--! Whether a server is currently successfully connected by alias.
export fn is_connected alias
    (get CONNECTED alias) == true

--! Selects MCP servers from a trusted auto-registry. An entry needs
--! `keywords` and the normal server configuration.
export fn auto_servers_for_task servers task
    out: []
    low: lower task
    for s in servers
        alias: get s "alias"
        matched: false
        words: get s "keywords"
        if words != nil
            for word in words
                if contains low (lower word)
                    matched: true
        if matched && alias != nil && (get CONNECTED alias) == nil
            push out s
    out

--! Connects matching registry servers once (CONNECTED is already maintained
--! by connect_one/connect_servers themselves, see comment there).
export fn ensure_for_task servers task
    selected: auto_servers_for_task servers task
    connect_servers selected

--! Names of all discovered MCP tools (local + remote), excluding the passed-in
--! (already ai_tool-registered) local names. Used to hand tools to the swarm's
--! per-server specialist agents.
--! Note: `mcp_tools` only returns local ai_tool entries if `mcp_server` was
--! called beforehand (Muninn doesn't do that) AND returns an error if no
--! tools are registered at all — both cases are caught best-effort as [], not
--! treated as an error.
export fn discovered_tool_names local_names
    out: []
    tools: []
    try
        tools: mcp_tools
    catch e
        tools: []
    for t in tools
        name: get t "name"
        if name != nil
            if name != "list_tools" && name != "tools/list" && !(contains local_names name)
                push out name
    out

--! Like discovered_tool_names, but grouped by origin server (the "source"
--! field from mcp_tools is the connection alias, e.g. "filesystem",
--! "github"). Basis for P5: one dedicated, focused specialist agent per MCP
--! server instead of a jack-of-all-trades with every tool — scales on its
--! own with every newly connected server, no code change needed in
--! swarm.pipe. Returns a list of {alias, tools} instead of a map, because
--! Pipe maps only allow bare identifiers as literal keys, while an MCP alias
--! can be an arbitrary string (set/get do work with arbitrary keys, but a
--! list is still the more robust, iteration-friendly form here).
export fn discovered_tools_by_source local_names
    groups: {}
    order: []
    tools: []
    try
        tools: mcp_tools
    catch e
        tools: []
    for t in tools
        name: get t "name"
        src: get t "source"
        if name != nil && src != nil
            if name != "list_tools" && name != "tools/list" && !(contains local_names name)
                existing: get groups src
                if existing == nil
                    set groups src ([])
                    push order src
                push (get groups src) name
    out: []
    for src in order
        push out {alias: src, tools: (get groups src)}
    out
