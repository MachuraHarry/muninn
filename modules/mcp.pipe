--! mcp.pipe — MCP-Tool-Ökosystem (Plan.md P1): beliebige externe Werkzeuge per
--! Model Context Protocol einbinden. Server werden per Umgebungsvariable
--! MCP_SERVERS konfiguriert (JSON-Liste), z.B.:
--!   [{"alias":"fs","type":"stdio","command":"npx",
--!     "args":["-y","@modelcontextprotocol/server-filesystem","/root/muninn/mcp_data"]},
--!    {"alias":"gh","type":"stdio","command":"npx",
--!     "args":["-y","@modelcontextprotocol/server-github"],
--!     "env":{"GITHUB_TOKEN":"env:GITHUB_TOKEN"}}]
CONNECTED: {}

--! "env:NAME"-Werte werden zur Laufzeit aus der echten Umgebung aufgelöst, damit
--! Secrets nicht doppelt in .env stehen müssen. Jede Verbindung läuft unter dem
--! Sandbox-Profil "muninn" mit exec-Whitelist (nur konfigurierte Kommandos) —
--! Lehre aus der Sandbox-Audit-Reihe: nie unbeschränkten exec an die KI.

--! Parst MCP_SERVERS (JSON-Liste von Server-Maps). Leer/ungueltig -> [] (MCP
--! bleibt deaktiviert, kein Fehler und kein exec/network noetig).
export fn parse_mcp_config raw
    out: []
    if raw != nil && (trim raw) != ""
        try
            j: parse_json raw
            if (type_of j) == "LIST"
                out: j
            else
                print "WARNUNG: MCP-Server-Konfiguration ist kein JSON-Array — ignoriert."
        catch e
            print ("WARNUNG: MCP-Server-Konfiguration ist ungueltiges JSON, ignoriert: " ++ (to_str e))
            out: []
    out

--! Letztes Pfadsegment eines Kommandos (für die exec-Whitelist), z.B. "npx".
fn cmd_basename cmd
    parts: split cmd "/"
    n: len parts
    if n == 0
        cmd
    else
        at parts (n - 1)

--! Eindeutige Kommando-Basenamen aller stdio-Server, für sandbox_profile.exec_whitelist.
export fn exec_whitelist_for servers
    seen: {}
    out: []
    for s in servers
        typ: get s "type"
        if typ == nil || typ == "stdio"
            cmd: get s "command"
            if cmd != nil && cmd != ""
                b: cmd_basename cmd
                if (get seen b) == nil
                    set seen b true
                    push out b
    out

--! Löst eine env-Map aus der Konfig auf. Werte im Format "env:NAME" werden aus
--! der echten Prozess-Umgebung gelesen (Secrets bleiben aus der JSON-Konfig raus).
fn resolve_env raw_env
    out: {}
    if raw_env != nil
        for k in (keys raw_env)
            v: get raw_env k
            if (type_of v) == "STRING" && (len v) >= 4 && (substring v 0 4) == "env:"
                v: env (substring v 4 (len v))
            set out k v
    out

--! Löst "env:NAME"-Werte in ALLEN Server-envs auf. MUSS aufgerufen werden, BEVOR
--! ein Sandbox-Profil aktiv ist: sobald irgendein Profil aktiv ist, blockiert
--! `env()` sicherheitshalber jeden Namen, der wie ein Secret aussieht
--! (*KEY*/*TOKEN*/*SECRET*) — und genau solche Namen stehen typischerweise hinter
--! "env:" (z.B. "env:GITHUB_TOKEN"). Mutiert die env-Maps der übergebenen Server
--! in place und liefert dieselbe Liste zurück.
export fn resolve_all_env servers
    for s in servers
        set s "env" (resolve_env (get s "env"))
    servers

--! Verbindet einen stdio-Server. Pipe-Builtins sind variadisch ohne Spread/Apply,
--! daher Fallunterscheidung nach Argumentzahl (bis zu 7 Programmargumente).
fn connect_stdio cmd cargs cenv alias
    n: len cargs
    if n == 0
        mcp_use_stdio cmd cenv alias
    else if n == 1
        mcp_use_stdio cmd (at cargs 0) cenv alias
    else if n == 2
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) cenv alias
    else if n == 3
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) cenv alias
    else if n == 4
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) (at cargs 3) cenv alias
    else if n == 5
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) (at cargs 3) (at cargs 4) cenv alias
    else if n == 6
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) (at cargs 3) (at cargs 4) (at cargs 5) cenv alias
    else
        mcp_use_stdio cmd (at cargs 0) (at cargs 1) (at cargs 2) (at cargs 3) (at cargs 4) (at cargs 5) (at cargs 6) cenv alias

--! Verbindet einen einzelnen konfigurierten Server (stdio oder sse). Liefert {alias, ok, error?}.
--! Markiert bei Erfolg CONNECTED[alias] — einzige Stelle, die das tut (vorher
--! setzte nur ensure_for_task das nach erfolgreichem Aufruf, der eager
--! Start-Connect in setup_core lief aber direkt ueber connect_servers und
--! liess CONNECTED leer; dadurch hielt auto_servers_for_task jeden schon
--! verbundenen Server faelschlich fuer neu und versuchte ihn bei jeder
--! passenden Nachricht erneut zu verbinden -> "alias already in use"-Fehler
--! im Log bei jeder Nachricht, die auf ein Server-Keyword traf).
fn connect_one idx s
    typ: get s "type"
    alias: get s "alias"
    if alias == nil || alias == ""
        alias: "srv" ++ (to_str idx)
    r: {alias: alias}
    try
        if typ == "sse"
            mcp_use_sse (get s "url") alias
        else
            cargs: get s "args"
            if cargs == nil
                cargs: []
            connect_stdio (get s "command") cargs (resolve_env (get s "env")) alias
        set r "ok" true
        set CONNECTED alias true
    catch e
        set r "ok" false
        set r "error" (to_str e)
    r

--! Verbindet alle konfigurierten Server. Ein fehlschlagender Server blockiert
--! die anderen nicht (best effort, jeder Fehler wird zurückgemeldet).
export fn connect_servers servers
    out: []
    i: 0
    for s in servers
        push out (connect_one i s)
        i: i + 1
    out

--! Ob ein Server per Alias aktuell erfolgreich verbunden ist.
export fn is_connected alias
    (get CONNECTED alias) == true

--! Waehlt MCP-Server aus einer vertrauenswuerdigen Auto-Registry. Ein Eintrag
--! braucht `keywords` und die normale Server-Konfiguration.
export fn auto_servers_for_task servers task
    out: []
    low: lower task
    for s in servers
        alias: get s "alias"
        matched: false
        words: get s "keywords"
        if words != nil
            for word in words
                if contains low (lower word)
                    matched: true
        if matched && alias != nil && (get CONNECTED alias) == nil
            push out s
    out

--! Verbindet passende Registry-Server einmalig (CONNECTED wird bereits von
--! connect_one/connect_servers selbst gepflegt, siehe dortiger Kommentar).
export fn ensure_for_task servers task
    selected: auto_servers_for_task servers task
    connect_servers selected

--! Namen aller entdeckten MCP-Tools (lokal + remote), ohne die übergebenen
--! (bereits als ai_tool registrierten) lokalen Namen. Für die Zuteilung an den
--! "werkzeugmeister"-Agenten im Gremium.
--! Hinweis: `mcp_tools` liefert lokale ai_tool-Eintraege nur, wenn zuvor `mcp_server`
--! aufgerufen wurde (Muninn tut das nicht) UND liefert einen Fehler, wenn ueberhaupt
--! keine Tools registriert sind — beides best-effort auf [] abgefangen, nicht als Fehler.
export fn discovered_tool_names local_names
    out: []
    tools: []
    try
        tools: mcp_tools
    catch e
        tools: []
    for t in tools
        name: get t "name"
        if name != nil
            if name != "list_tools" && name != "tools/list" && !(contains local_names name)
                push out name
    out

--! Wie discovered_tool_names, aber nach Herkunfts-Server gruppiert (das
--! "source"-Feld von mcp_tools ist der Verbindungs-Alias, z.B. "filesystem",
--! "github"). Grundlage fuer P5: ein eigener, fokussierter Spezial-Agent pro
--! MCP-Server statt ein Alleskoenner mit allen Werkzeugen — skaliert von
--! selbst mit jedem neu angebundenen Server, ohne Code-Aenderung in swarm.pipe.
--! Liefert eine Liste von {alias, tools} statt einer Map, weil Pipe-Maps nur
--! bare Identifier als Literal-Keys erlauben, ein MCP-Alias aber beliebiger
--! String sein kann (set/get funktionieren zwar mit beliebigen Keys, eine
--! Liste ist hier trotzdem die robustere, iterationsfreundlichere Form).
export fn discovered_tools_by_source local_names
    groups: {}
    order: []
    tools: []
    try
        tools: mcp_tools
    catch e
        tools: []
    for t in tools
        name: get t "name"
        src: get t "source"
        if name != nil && src != nil
            if name != "list_tools" && name != "tools/list" && !(contains local_names name)
                existing: get groups src
                if existing == nil
                    set groups src ([])
                    push order src
                push (get groups src) name
    out: []
    for src in order
        push out {alias: src, tools: (get groups src)}
    out
