--! live_status.pipe — renders the gremium's live-updating Telegram status
--! message (see make_swarm_updater in muninn.pipe) and the "📜 Verlauf"/
--! /trace views built on the same data: agent display names/icons, tool-call
--! icons and argument summaries, and the tree-formatting of accumulated
--! agent groups into one growing message. Extracted out of muninn.pipe
--! (which had grown past 2700 lines) — every function here is already
--! parameter-driven with no dependency on muninn.pipe's own top-level state
--! (tz_offset/all_mcp_servers/BOT_ID/...), only mem.meta_get/meta_set for
--! save_trace/format_trace, so this was the cleanest, lowest-risk slice to
--! split off first.
import "modules/memory.pipe" as mem

--! Mathematical Monospace A-Z / a-z (Unicode U+1D670-89 / U+1D68A-A3) —
--! built once via hex_decode+from_bytes of their raw UTF-8 bytes rather
--! than typing the astral characters directly into this source file (pipe
--! string literals have no \uNNNN escape, and typing 4-byte-UTF-8 glyphs by
--! hand in an edit risks a mistranscribed byte going in unnoticed — same
--! class of risk as the stray literal ESC byte caught earlier this
--! session). Used by to_math_mono for the "𝙷𝚎𝚒𝚖𝚍𝚊𝚕𝚕"-style styled agent
--! names in agent_icon_name.
MONO_UPPER: from_bytes (hex_decode "f09d99b0f09d99b1f09d99b2f09d99b3f09d99b4f09d99b5f09d99b6f09d99b7f09d99b8f09d99b9f09d99baf09d99bbf09d99bcf09d99bdf09d99bef09d99bff09d9a80f09d9a81f09d9a82f09d9a83f09d9a84f09d9a85f09d9a86f09d9a87f09d9a88f09d9a89")
MONO_LOWER: from_bytes (hex_decode "f09d9a8af09d9a8bf09d9a8cf09d9a8df09d9a8ef09d9a8ff09d9a90f09d9a91f09d9a92f09d9a93f09d9a94f09d9a95f09d9a96f09d9a97f09d9a98f09d9a99f09d9a9af09d9a9bf09d9a9cf09d9a9df09d9a9ef09d9a9ff09d9aa0f09d9aa1f09d9aa2f09d9aa3")
MONO_ALPHA_UPPER: "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
MONO_ALPHA_LOWER: "abcdefghijklmnopqrstuvwxyz"

--! Converts plain ASCII letters in s to their Mathematical Monospace
--! Unicode look-alikes (each is 4 UTF-8 bytes, hence the *4 offsets below —
--! substring is byte-indexed, see MONO_UPPER/MONO_LOWER); anything that
--! isn't A-Z/a-z (spaces, digits, punctuation) passes through unchanged.
export fn to_math_mono s
    out: ""
    i: 0
    n: len s
    while i < n
        ch: substring s i (i + 1)
        idx: index_of MONO_ALPHA_UPPER ch
        if idx >= 0
            out: out ++ (substring MONO_UPPER (idx * 4) (idx * 4 + 4))
        else
            idx2: index_of MONO_ALPHA_LOWER ch
            if idx2 >= 0
                out: out ++ (substring MONO_LOWER (idx2 * 4) (idx2 * 4 + 4))
            else
                out: out ++ ch
        i: i + 1
    out

--! Truncates a status snippet to n characters (for the live status line —
--! unlike shorten (4000 characters, for Telegram messages) deliberately
--! short here, so a single tool line doesn't blow up the whole status message.
export fn truncate_status s n
    if s == nil
        return ""
    if (len s) > n
        (substring s 0 n) ++ "…"
    else
        s

--! Extracts a short, human-readable snippet from a tool call's raw JSON
--! arguments (the actual search query/URL/etc., not just the tool name) —
--! for known local tools (see the ai_tool registrations in swarm.pipe)
--! targets the matching field specifically, otherwise best-effort takes
--! the first string field in the arguments (covers MCP tools with an
--! unknown schema).
fn tool_arg_summary tool_name args_json
    if args_json == nil || args_json == ""
        return ""
    a: nil
    try
        a: parse_json args_json
    catch
        a: nil
    if a == nil || (type_of a) != "MAP"
        return ""
    field: nil
    if tool_name == "web_search" || tool_name == "erinnerungen_suchen"
        field: get a "query"
    else if tool_name == "web_fetch"
        field: get a "url"
    else if tool_name == "erinnerung_planen"
        field: get a "text"
    else if tool_name == "merken" || tool_name == "merken_quelle"
        field: get a "content"
    else if tool_name == "docker_pull_image"
        field: get a "image"
    else if tool_name == "docker_create_container"
        field: get a "name"
    else if tool_name == "bild_senden" || tool_name == "datei_senden"
        field: get a "path"
    if field == nil
        for k in (keys a)
            v: get a k
            if field == nil && (type_of v) == "STRING" && v != ""
                field: v
    if field == nil || field == ""
        return ""
    truncate_status (to_str field) 70

--! Norse names for the tool specialists (werkzeug_<alias>) -- Muninn
--! itself is Odin's raven of memory, so the whole gremium got a matching
--! theme instead of generic role labels. Purely a DISPLAY-layer mapping
--! (see agent_display_name below) -- the actual internal alias/agent
--! identifiers used for routing/handoff (swarm.pipe) are untouched, so
--! this carries zero risk to existing handoff logic or stored recipes
--! (unlike renaming the identifiers themselves, deliberately out of scope).
--! Unknown/future aliases fall back to a generic icon + the alias itself.
fn werkzeug_display_name alias
    if alias == "filesystem"
        return {icon: "🔨", name: "Sindri"}
    if alias == "memory"
        return {icon: "📚", name: "Kvasir"}
    if alias == "denkwerkzeug"
        return {icon: "🤔", name: "Vili"}
    if alias == "browser"
        return {icon: "🐿️", name: "Ratatoskr"}
    if alias == "doku"
        return {icon: "📖", name: "Vör"}
    if alias == "docker"
        return {icon: "🔥", name: "Brokkr"}
    if alias == "zeit"
        return {icon: "⏳", name: "Skuld"}
    if alias == "google"
        return {icon: "📅", name: "Frigg"}
    if alias == "praesentation"
        return {icon: "🎨", name: "Iðunn"}
    if alias == "dokument"
        return {icon: "📝", name: "Fjalar"}
    if alias == "whisper"
        return {icon: "🎙️", name: "Sága"}
    if alias == "github"
        return {icon: "⚒️", name: "Eitri"}
    {icon: "🔧", name: alias}

--! Persists the path/round-count of a finished gremium run (see the
--! {content, path, rounds} shape returned by run_gremium/run_gremium_stream
--! — path and rounds used to be silently discarded after pulling out just
--! "content") so /trace can show it afterwards. One slot per chat (most
--! recent run only), stored via meta like other small persistent values.
export fn save_trace dbh cid res
    path: get res "path"
    if path == nil
        return nil
    trace: {}
    set trace "path" path
    set trace "rounds" (get res "rounds")
    mem.meta_set dbh ("last_trace:" ++ (to_str cid)) (to_json trace)

--! Formats a saved trace (see save_trace) as a short, named path for
--! /trace -- shared formatting so Telegram and any future caller (e.g. the
--! dashboard) show it identically.
export fn format_trace dbh cid
    raw: mem.meta_get dbh ("last_trace:" ++ (to_str cid))
    if raw == nil || raw == ""
        return nil
    trace: nil
    try
        trace: parse_json raw
    catch
        return nil
    if trace == nil
        return nil
    path: get trace "path"
    if path == nil || (len path) == 0
        return nil
    names: []
    for a in path
        d: agent_display_name a
        push names ((get d "icon") ++ " " ++ (get d "name"))
    rounds: get trace "rounds"
    suffix: " round"
    if rounds != 1
        suffix: " rounds"
    (join names " → ") ++ "\n" ++ (to_str rounds) ++ suffix

--! Display name + icon for any gremium agent (the 4 core roles, or a
--! werkzeug_<alias> specialist). Shared by agent_action_phrase (live
--! status) and the /trace command, so both always show the same names.
fn agent_display_name agent
    if agent == "planer"
        return {icon: "🧭", name: "Huginn"}
    if agent == "faktenwaechter"
        return {icon: "🔍", name: "Mimir"}
    if agent == "kritiker"
        return {icon: "🧐", name: "Heimdall"}
    if agent == "registrator"
        return {icon: "✍️", name: "Bragi"}
    if (len agent) > 9 && (substring agent 0 9) == "werkzeug_"
        return (werkzeug_display_name (substring agent 9 (len agent)))
    {icon: "🧠", name: agent}

--! Bare verb phrase for an agent's role, no icon/name (e.g. "is checking
--! facts and memory...") — composed into agent_group_header below.
--! Terse, lowercase terminal-status word per agent — no "is ...ing the
--! answer..." prose, this reads as a process/daemon status readout (see
--! agent_group_header/render_groups: the whole live tree is rendered
--! inside a Telegram code block for a hacker-terminal look, see the
--! comment on render_groups for why plain ASCII/no nested bold-italic).
export fn agent_verb_phrase agent
    if agent == "planer"
        return "planning"
    if agent == "faktenwaechter"
        return "fact-checking"
    if agent == "kritiker"
        return "reviewing"
    if agent == "registrator"
        return "finalizing"
    if agent == "werkzeug_browser"
        return "crawling"
    if (len agent) > 9 && (substring agent 0 9) == "werkzeug_"
        return "working[" ++ (substring agent 9 (len agent)) ++ "]"
    "thinking"

--! Icon + bracketed styled name for an agent, e.g. "🔍[𝙼𝚒𝚖𝚒𝚛]" (see
--! to_math_mono) — the shared identity fragment for the tree's group
--! header and a handoff line's target reference. No markdown bold (**)
--! here on purpose: the whole tree renders inside a ``` code block
--! (render_groups), where Telegram doesn't apply nested bold/italic at
--! all — plain brackets + the Mathematical Monospace styling read as the
--! emphasis instead, terminal-log style.
export fn agent_icon_name agent
    d: agent_display_name agent
    (get d "icon") ++ "[" ++ (to_math_mono (get d "name")) ++ "]"

--! Full-log group header: icon+name tag + "::" + status word (e.g.
--! "🔍[MIMIR] :: fact-checking") — a process-log line, not a sentence.
fn agent_group_header agent
    (agent_icon_name agent) ++ " :: " ++ (agent_verb_phrase agent)

--! Icon for a tool call, by tool name — keeps the tree scannable at a
--! glance instead of uniform text for everything. Falls back to a
--! generic wrench for anything not specifically known (the open-ended
--! universe of MCP specialist tool names, e.g. word_add_paragraph).
fn tool_icon tool_name
    if tool_name == "web_search"
        return "🔎"
    if tool_name == "web_fetch"
        return "🌐"
    if tool_name == "erinnerungen_suchen" || tool_name == "merken" || tool_name == "merken_quelle"
        return "🧠"
    if tool_name == "erinnerung_planen"
        return "⏰"
    if (len tool_name) > 7 && (substring tool_name 0 7) == "docker_"
        return "🐳"
    --! Playwright (werkzeug_browser, Ratatoskr) — pro Aktions-Art ein
    --! eigenes Icon statt eines generischen fuer alle browser_*-Tools,
    --! damit das Live-Update auf einen Blick zeigt WAS gerade passiert
    --! (navigieren vs. klicken vs. tippen vs. warten ...), nicht nur DASS
    --! gebrowst wird.
    if tool_name == "browser_navigate" || tool_name == "browser_navigate_back"
        return "🧭"
    if tool_name == "browser_tabs"
        return "🗂️"
    if tool_name == "browser_click" || tool_name == "browser_hover" || tool_name == "browser_drag" || tool_name == "browser_drop"
        return "🖱️"
    if tool_name == "browser_type" || tool_name == "browser_fill_form" || tool_name == "browser_press_key" || tool_name == "browser_select_option"
        return "⌨️"
    if tool_name == "browser_take_screenshot"
        return "📸"
    if tool_name == "browser_snapshot" || tool_name == "browser_find"
        return "🔍"
    if tool_name == "browser_wait_for"
        return "⏳"
    if tool_name == "browser_handle_dialog"
        return "💬"
    if tool_name == "browser_file_upload"
        return "📤"
    if tool_name == "browser_network_requests" || tool_name == "browser_network_request"
        return "📡"
    if tool_name == "browser_console_messages"
        return "🖥️"
    if tool_name == "browser_evaluate" || tool_name == "browser_run_code_unsafe"
        return "⚙️"
    if tool_name == "browser_resize"
        return "📐"
    if tool_name == "browser_close"
        return "🚪"
    if tool_name == "bild_senden"
        return "📷"
    if tool_name == "bild_erstellen"
        return "🎨"
    if tool_name == "datei_senden"
        return "📎"
    if tool_name == "sprachnachricht_senden"
        return "🎙️"
    if tool_name == "hintergrund_fortsetzen"
        return "⏳"
    if tool_name == "rezept_speichern" || tool_name == "rezepte_suchen"
        return "📋"
    if tool_name == "bericht_veroeffentlichen"
        return "📰"
    if tool_name == "icon_holen"
        return "🏷️"
    if tool_name == "ziel_anlegen"
        return "🎯"
    if tool_name == "ziel_erledigt"
        return "✅"
    "🔧"

--! Bare tool-call content (e.g. 🔎 web_search "Berlin population 2026")
--! for a "tool" event. Empty string if there is no detail (nothing to
--! show).
fn tool_call_detail_line detail args_json
    if detail == nil || detail == ""
        return ""
    line: (tool_icon detail) ++ " >> " ++ detail
    arg_hint: tool_arg_summary detail args_json
    if arg_hint != ""
        line: line ++ "(\"" ++ arg_hint ++ "\")"
    else
        line: line ++ "()"
    line

--! Bare content for a single "tool"/"reasoning"/"inject" progress event —
--! used both as the live status's line 2 and as a tree-branch entry in
--! the full run log (see make_swarm_updater). "start"/"handoff"/"final"
--! are handled directly there. "reasoning" is the model's actual
--! chain-of-thought for that round (only fires when the provider returns
--! one) — the real "watch them think" signal; "inject" reflects a
--! steering message a round_check fed into the run (see make_round_check),
--! so the full log shows the user's own nudge take effect. Empty string
--! means "nothing to show".
export fn swarm_transcript_line event detail args_json
    if event == "tool"
        return (tool_call_detail_line detail args_json)
    if event == "reasoning"
        return "// " ++ (truncate_status detail 150)
    if event == "inject"
        return "[USER] >> " ++ (truncate_status detail 150)
    ""

--! Extracts the optional "reason" note from a handoff tool call's raw
--! JSON arguments (see ai.ChatSwarm's "handoff" progress event and the
--! synthesized handoff tool's schema in swarmToolsFor, pipe repo) — ""
--! if the model didn't provide one (the field is optional).
export fn handoff_reason args_json
    if args_json == nil || args_json == ""
        return ""
    a: nil
    try
        a: parse_json args_json
    catch
        a: nil
    if a == nil || (type_of a) != "MAP"
        return ""
    r: get a "reason"
    if r == nil
        return ""
    truncate_status (to_str r) 80

--! Renders one agent group as a tree branch: its header
--! (agent_group_header) plus its collected entries, each a map
--! {text, handoff} (see make_swarm_updater) — "├─ " for every entry but
--! the last, "└─> " for a trailing handoff (points at the target it's
--! handing off to, ASCII arrow to match the terminal-log look), plain
--! "└─ " for any other trailing entry. No progress bar in here anymore —
--! it now lives in ONE persistent spot at the very bottom of the whole
--! message (see render_bottom_bar), not appended to whichever group
--! happens to be current.
fn render_group g
    header: agent_group_header (get g "agent")
    lines: get g "lines"
    n: len lines
    if n == 0
        return header
    rendered: []
    i: 0
    while i < n
        entry: at lines i
        connector: "├─ "
        if i == (n - 1)
            if (get entry "handoff") == true
                connector: "└─> "
            else
                connector: "└─ "
        push rendered (connector ++ (get entry "text"))
        i: i + 1
    header ++ "\n" ++ (join rendered "\n")

--! Joins accumulated agent groups (see make_swarm_updater) into the full
--! run tree — used both for the LIVE edited message while the gremium is
--! working, and again afterward for the standalone "📜 Verlauf" button
--! message. Plain text (no code-block wrapper — tried, felt too heavy/
--! boxed in Telegram, see live_status discussion) but keeps the terminal-
--! log VOCABULARY ([NAME]/::/>>///└─>). Kept under a safe character
--! budget (a bit below shorten's 4000), dropping the OLDEST groups first
--! with a leading marker when over it.
export fn render_groups groups
    budget: 3800
    kept: groups
    fn render_all gs
        rendered: []
        n: len gs
        i: 0
        while i < n
            push rendered (render_group (at gs i))
            i: i + 1
        join rendered "\n\n"
    text: render_all kept
    while (len text) > budget && (len kept) > 1
        kept: slice kept 1 (len kept)
        text: render_all kept
    if (len kept) < (len groups)
        text: "... (earlier steps hidden)\n\n" ++ text
    text

--! Renders a plan checklist (see tool_plan_vorschlagen/
--! tool_plan_schritt_markieren in swarm.pipe, resolve_plan_proposal/
--! make_swarm_updater in muninn.pipe): "○" not started yet, "◌" the step
--! currently being worked on, "●" a finished step — plain plan: [{text,
--! status}], status one of "offen"|"arbeitet"|"fertig".
export fn render_plan plan
    lines: []
    for p in plan
        sym: "○"
        if (get p "status") == "arbeitet"
            sym: "◍"
        else if (get p "status") == "fertig"
            sym: "●"
        push lines (sym ++ " " ++ (get p "text"))
    join lines "\n"

--! Progress bar for an already-computed percentage (0-100) — the caller
--! (make_swarm_updater) decides what the percentage MEANS: real step
--! completion when a plan is active (plan_progress_pct), or a coarse
--! pipeline-position checkpoint otherwise (stage_checkpoint/
--! stage_checkpoint_max). This used to compute round/max_rounds itself —
--! reverted, because max_rounds (150) is a pure safety ceiling almost no
--! real task gets remotely close to, so "how much of the safety budget is
--! used" read as near-zero for the vast majority of runs regardless of how
--! close to done they actually were. nil -> no bar at all (a finished
--! earlier group in the live tree, or a historical /trace-button replay
--! with no live pct to show). 10-block bar, e.g. "███▒▒▒▒▒▒▒[20%]".
export fn render_progress_bar pct
    if pct == nil
        return ""
    p: pct
    if p > 100
        p: 100
    if p < 0
        p: 0
    filled: p / 10
    bar: ""
    i: 0
    while i < 10
        if i < filled
            bar: bar ++ "█"
        else
            bar: bar ++ "▒"
        i: i + 1
    bar ++ "[" ++ (to_str p) ++ "%]"

--! Persistent bottom status bar: a horizontal rule followed by the
--! progress bar — always appended after the tree/checklist content (see
--! make_swarm_updater), in ONE fixed spot at the very end of the message,
--! instead of tacked onto whichever group/line happens to be current (the
--! previous approach — moved it here after Harry asked for a stable
--! bottom-anchored bar instead). Kept OUT of the text make_swarm_updater
--! compares for the dedup check / persists to last_run_log (append it only
--! right before sending, same reasoning as to_math_mono used to follow) —
--! callers that don't want a bar at all (the finished-run "📜 Verlauf"
--! replay) simply never call this. pct nil -> "" (render_progress_bar's
--! own nil-safety), so this is nil-safe too.
export fn render_bottom_bar pct
    bar: render_progress_bar pct
    if bar == ""
        return ""
    "\n____________________\n" ++ bar

--! Coarse pipeline "checkpoint" percentage for a non-plan run, based on
--! which agent is currently active. planer/kritiker/registrator are exact
--! matches — each only ever means itself in the fixed pipeline (see
--! swarm.pipe's planer_handoff/kritiker_handoff/faktenwaechter_handoff).
--! Everything else — faktenwaechter, or a dynamically-registered
--! werkzeug_<alias> tool specialist (name depends on which MCP servers are
--! connected, not worth enumerating) — shares one middle checkpoint.
--! registrator caps at 95, not 100: the live status message is DELETED and
--! replaced the instant the run finishes (see tel_finalize_after_tree in
--! muninn.pipe), so a live "100%" would flash for at most one edit cycle
--! right before the message vanishes — reads as a glitch, not a
--! completion. See stage_checkpoint_max for tracking the highest value
--! reached so far across a run (this function alone is NOT monotonic —
--! faktenwaechter/kritiker can be revisited, see swarm.go's isOscillating
--! guard).
export fn stage_checkpoint agent
    if agent == "planer"
        return 10
    if agent == "kritiker"
        return 75
    if agent == "registrator"
        return 95
    45

--! Combines stage_checkpoint with the highest checkpoint already reached
--! this run (previous, or nil for a fresh run) so the displayed percentage
--! never regresses if agents backtrack/oscillate (faktenwaechter<->kritiker
--! is possible and already round-limited on the Go side, see swarm.go's
--! isOscillating — but a naive per-event stage lookup alone isn't
--! monotonic).
export fn stage_checkpoint_max agent previous
    c: stage_checkpoint agent
    if previous != nil && previous > c
        previous
    else
        c

--! Percentage of an active plan's steps marked "fertig" (done) — same
--! plan: [{text, status}] shape as render_plan (status one of
--! "offen"|"arbeitet"|"fertig", see resolve_plan_proposal/
--! tool_plan_schritt_markieren in muninn.pipe/swarm.pipe). 100% is reached
--! exactly when the LAST item flips to "fertig", unlike round/max_rounds
--! which almost never got there. Empty/nil plan -> 0 (make_swarm_updater
--! only calls this when the plan is non-empty, but stay well-defined
--! rather than dividing by zero).
export fn plan_progress_pct plan
    if plan == nil || (len plan) == 0
        return 0
    done: 0
    for p in plan
        if (get p "status") == "fertig"
            done: done + 1
    (done * 100) / (len plan)

