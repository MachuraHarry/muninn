--! muninn.pipe — entry point: Muninn, the long-term AI agent.
--! Telegram bot (long-polling) + persistent sqlite "soul".
--! Usage:   pipe muninn.pipe             (production loop, Telegram)
--!          pipe muninn.pipe once        (one polling cycle, then exit — for testing)
--!          pipe muninn.pipe consolidate (consolidation, e.g. via cron)
--!          pipe muninn.pipe web         (web dashboard, see DASHBOARD_BIND/-TOKEN in .env)
import "modules/telegram.pipe" as tel
import "modules/memory.pipe" as mem
import "modules/swarm.pipe" as grm
import "modules/executor.pipe" as exe
import "modules/web.pipe" as web
import "modules/mcp.pipe" as mcp
import "modules/dashboard.pipe" as dash
import "modules/scheduler.pipe" as sched
import "modules/docker_tools.pipe" as dt

--! Loads KEY=VALUE lines from a .env file into a map.
--! Values are split at the FIRST "=" (not every one), so values that themselves
--! contain "=" (e.g. MCP_SERVERS JSON with URL query strings) aren't truncated.
fn load_env path
    env_map: {}
    if file_exists path
        lines: split (read_file path) "\n"
        for line in lines
            ln: trim line
            if (len ln) > 0
                if (at ln 0) != "#"
                    kv: split ln "="
                    if (len kv) >= 2
                        key: trim (at kv 0)
                        val: join (slice kv 1 (len kv)) "="
                        set env_map key (trim val)
    env_map

--! Value lookup: real environment variable first, then .env.
fn cfg_get cfg key
    v: env key
    if v != nil && v != ""
        return v
    get cfg key

--! Sets up the AI provider (DeepSeek). Muninn is meant to use only DeepSeek;
--! other provider variants are deliberately not allowed here. Once the
--! sandbox is active, `env()` blocks any name that looks like a secret
--! (*KEY*/*TOKEN*/*SECRET*) as a safety measure — so DEEPSEEK_API_KEY must
--! be read BEFORE set_sandbox.
fn setup_ai key
    ai_provider "deepseek" {thinking: false}
    if key != nil && key != ""
        ai_set_key "deepseek" key
    ai_model "deepseek-chat"
    --! Hard time limit PER INDIVIDUAL AI call: if the provider hangs (a slow
    --! or stuck stream/connection), the call used to block INDEFINITELY —
    --! and with it the entire single-threaded bot loop (Muninn then looked
    --! alive but stopped responding to anything; a restart was the only way
    --! out). With a timeout, the call instead throws an error that the
    --! existing try/catch paths catch and answer honestly. 120s is generous
    --! enough for long context/swarm calls, but prevents hanging forever.
    ai_timeout 120

--! Sandbox profiles are immutable and their name is assigned once (a
--! second sandbox_profile call with the same name fails with "already
--! exists") — so max_tool_calls does NOT count per message or gremium run,
--! but cumulatively over the ENTIRE process runtime since the last
--! restart. Observed live: after enough messages since the last restart,
--! an otherwise harmless request (research + a long document, many tool
--! calls) ran straight into a real "E_SANDBOX: max tool calls exceeded"
--! error, which the AI then reported as a mysterious "technical limit" and
--! got tangled up in repeated, self-contradicting recovery attempts — none
--! of which had anything to do with the AI provider. setup_sandbox
--! therefore gets a new, numbered profile name on every call
--! (SANDBOX_STATE.gen), so a fresh call (see the two run_gremium_stream
--! call sites) reliably resets the budget per message instead of
--! cumulatively over the process runtime. A mutable map instead of a bare
--! counter, because a bare reassignment of a top-level variable INSIDE a
--! function does not persist outward in Pipe (see COST_STATE for the same
--! pattern).
SANDBOX_STATE: {gen: 0}

--! Activates Muninn's sandbox profile (P1: tool sandboxing) fresh (see
--! SANDBOX_STATE above). fs stays "full", since pure-Pipe sqlite
--! persistence (muninn.db) needs file access; exec is only allowed when
--! MCP servers are configured, and then strictly limited to their
--! commands (lesson from the sandbox audit series: never give the AI
--! unrestricted exec). network stays open, since web research fetches
--! arbitrary result URLs; a fixed whitelist would break research.
fn setup_sandbox servers
    wl: mcp.exec_whitelist_for servers
    --! "docker" added to the whitelist: modules/docker_tools.pipe calls
    --! `docker pull`/`docker run` directly via exec() (not through the
    --! "docker" MCP server, which only manages existing containers). See
    --! the security comment in docker_tools.pipe — strictly validated
    --! arguments, no volume mount, no --privileged.
    push wl "docker"
    --! "tts_synth.sh" added to the whitelist: swarm.pipe (tts_synthesize)
    --! calls the fixed Piper->ffmpeg speech-synthesis pipeline directly via
    --! exec() (no MCP server for this). Fixed script path, no AI-controllable
    --! flags — only the two file paths are passed.
    push wl "tts_synth.sh"
    --! "systemd-notify" added to the whitelist: the main loop (see below)
    --! uses it to periodically check in with the systemd watchdog
    --! (WatchdogSec in muninn.service) — a purely trusted system command with
    --! no AI-controllable arguments, no MCP server needed for it.
    push wl "systemd-notify"
    --! "pdftotext" added to the whitelist: handle_document calls Poppler
    --! directly via exec() to learn uploaded PDFs into memory (see
    --! extract_pdf_text above) — no MCP server needed for it, the command is
    --! built entirely from a fixed template (only the already locally saved
    --! file path is inserted, see shell_quote).
    push wl "pdftotext"
    --! "rsvg-convert" added to the whitelist: tool_icon_holen (swarm.pipe)
    --! calls it directly via exec() to rasterize a fetched Iconify SVG into
    --! a PNG (python-docx/office-powerpoint-mcp-server's picture-insert
    --! tools only accept raster images, not SVG — confirmed against
    --! python-docx's add_picture, which shells out to Pillow) — no MCP
    --! server for this, fixed command template (only the already locally
    --! saved SVG/PNG paths are inserted, see shell_quote there).
    push wl "rsvg-convert"
    allow_exec: (len wl) > 0
    set SANDBOX_STATE "gen" ((get SANDBOX_STATE "gen") + 1)
    name: "muninn-" ++ (to_str (get SANDBOX_STATE "gen"))
    --! max_tool_calls applies to the ENTIRE gremium request (research +
    --! possible document creation together), reset per message since the fix
    --! above. 40 was too tight for that: observed live that research alone
    --! into a topic poorly documented on the web can already need 40+ tool
    --! calls (many failed attempts/refinements), BEFORE a single chapter was
    --! even written into the document — the limit then hit mid document
    --! creation, leaving the document only partially filled.
    --! timeout: 180 — a WATCHDOG against an exec() call that never returns.
    --! Reproduced live: at the user's request, the AI tried to start an HTTP
    --! server in the FOREGROUND via exec() — but exec() waits until the
    --! command itself finishes, and a permanently running server never
    --! finishes. Without a timeout this blocked the ENTIRE bot forever (Pipe
    --! is deliberately single-threaded), AND because the Telegram offset is
    --! only saved AFTER successful processing, Muninn immediately got stuck
    --! on the same message again on every restart. The interpreter itself
    --! already has an exec() timeout (sandbox.go/buildExecCommand,
    --! context.WithTimeout) — it just was never activated (Timeout: 0 =
    --! unlimited without this field). 180s generously covers the slowest
    --! legitimate case (docker_pull_image for a large, not-yet-cached image),
    --! while guaranteeing that NO exec() call can hang unboundedly anymore.
    --! MCP tool calls (e.g. whisper) already have their own 120s timeout in
    --! the MCP client itself (pkg/mcp/client.go, defaultCallTimeout) — only
    --! exec() had this gap.
    sandbox_profile name {fs: "full", network: true, exec: allow_exec, exec_whitelist: wl, ai: true, max_tool_calls: 150, timeout: 180, audit_log: true}
    set_sandbox name
    nil

fn ensure_mcp_for_task task dbh
    results: mcp.ensure_for_task mcp_auto_servers task
    for r in results
        if get r "ok"
            print ("MCP auto-connected: " ++ (get r "alias"))
        else
            print ("MCP auto-connect failed (" ++ (get r "alias") ++ "): " ++ (get r "error"))
            mem.log_error dbh ("mcp_autonom:" ++ (get r "alias")) (get r "error")
    if (len results) > 0
        grm.init_gremium 0
    nil

fn list_configured_mcp_aliases _
    names: []
    for s in all_mcp_servers
        alias: get s "alias"
        if alias != nil && alias != ""
            push names alias
    names

fn connected_mcp_tool_names _
    out: []
    try
        tools: mcp_tools
        for t in tools
            n: get t "name"
            if n != nil && n != ""
                push out n
    catch
        nil
    out

--! Checks whether a chat ID is allowed to be served (empty whitelist = allow all).
fn is_allowed cid allowed
    if allowed == nil || allowed == ""
        return true
    allow_list: split allowed ","
    for a in allow_list
        if (trim a) == (to_str cid)
            return true
    false

--! Greeting text.
fn greeting_text _
    "Muninn is online.\n\nYou can tell me something to remember (e.g. \"Remember that I like tea\"), give me a task (e.g. \"Handle the reporting\"), ask a question, or search the web (e.g. \"/search Odin Norse mythology\").\n\n/help for all commands."

--! Help text.
fn help_text _
    "/start      — greeting\n/help       — this help\n/status     — Muninn's state\n/costs      — AI running-cost summary (sessions, tokens, $)\n/list       — your most important memories\n/search     — search the web (e.g. /search Huginn and Muninn)\n/learn      — learn a document (e.g. /learn https://... or send me a .txt/.md file)\n/graph      — query the knowledge graph (e.g. /graph Harry)\n/remind     — schedule a reminder (e.g. /remind in 10 minutes about the break)\n/reminders  — show open reminders/briefings\n/goals      — show open goals, tap to mark done\n/trace      — see which of the gremium's Norse-named members handled your last request\n/briefing   — activate the daily morning briefing (/briefing stop to cancel)\n/reset      — reset conversation history (fresh context for follow-up questions)\n/consolidate — dream: condense old conversations, let memories decay/be forgotten\n/settings   — configure response style, language, proactive messages, memory aggressiveness\n/stop       — IMMEDIATELY cancel a gremium run currently in progress, plus all running background Docker jobs and scheduled continuations"

--! Status text (statistics from the soul).
fn status_text dbh
    n: mem.memory_count dbh
    tool_n: len (mcp_tools)
    gc: mem.graph_counts dbh
    "Muninn status:\n• Memories: " ++ (to_str n) ++ "\n• Knowledge graph: " ++ (to_str (get gc "entities")) ++ " entities, " ++ (to_str (get gc "relations")) ++ " relations\n• Provider: DeepSeek\n• Gremium: 4-5 agents (with web research + MCP tools)\n• Total tools (local + MCP): " ++ (to_str tool_n) ++ "\n• Executor: active\n• Web: DDG + Wikipedia"

--! /costs: AI-generated cost summary. The numbers themselves are computed
--! DETERMINISTICALLY from cost_log (mem.cost_summary) — the AI is only
--! given the task of phrasing these FIXED numbers readably; it must NOT
--! compute or estimate anything itself (otherwise risk of hallucinated
--! numbers, see the lessons from the rest of the gremium today).
fn costs_text dbh
    s: mem.cost_summary dbh
    sessions: get s "sessions"
    if (len sessions) == 0
        return "No costs recorded yet — this accumulates as the bot keeps running."
    lines: "Total across " ++ (to_str (get s "session_count")) ++ " sessions: $" ++ (to_str (get s "total_cost_usd")) ++ ", " ++ (to_str (get s "total_tokens")) ++ " tokens, " ++ (to_str (get s "total_calls")) ++ " AI calls.\n\nRecent sessions (newest first):\n"
    i: 0
    while i < 10 && i < (len sessions)
        sess: at sessions i
        lines: lines ++ "- Session " ++ (to_str (get sess "session_id")) ++ " (" ++ (get sess "first_ts") ++ " to " ++ (get sess "last_ts") ++ "): $" ++ (to_str (get sess "cost_usd")) ++ ", " ++ (to_str (get sess "tokens")) ++ " tokens, " ++ (to_str (get sess "calls")) ++ " calls, " ++ (to_str (get sess "cache_hits")) ++ " cache hits\n"
        i: i + 1
    summary: ""
    try
        summary: ai_chat "You are Muninn and you summarize running costs for your user. You are given ALREADY-COMPUTED numbers — take them over EXACTLY and verbatim, don't compute or estimate anything yourself, don't invent additional numbers. Write a short, natural summary in 3-5 sentences: total cost, how many sessions, a rough trend if visible (rising/falling/stable), and whether any session was noticeably expensive. Telegram formatting: single asterisks for bold, no headings." lines
    catch
        summary: ""
    if summary == nil || summary == ""
        return lines
    summary ++ "\n\n" ++ lines

--! List of the most important memories.
fn list_text dbh
    rows: mem.top_memories dbh 10
    if (len rows) == 0
        return "No memories saved yet."
    out: "Your most important memories:\n"
    for r in rows
        out: out ++ "• " ++ (get r "content") ++ "\n"
    out

--! Processes an incoming update (extracts text, handles non-text).
fn handle_update token cid msg dbh allowed uid
    txt: get msg "text"
    if txt == nil
        doc: get msg "document"
        if doc != nil
            handle_document token cid dbh doc
            return nil
        if (get msg "photo") != nil
            handle_photo token cid dbh msg
            return nil
        if (get msg "sticker") != nil
            tel.tel_send_message token cid "Nice sticker — but I only understand text."
            return nil
        if (get msg "voice") != nil
            handle_voice token cid dbh msg allowed uid
            return nil
        return nil
    handle_message token cid txt dbh allowed uid

--! Checks by filename/mime type whether a document is plain text (.txt/.md
--! or mime "text/..."). PDFs/binary formats return false here.
fn is_text_doc fname mime
    if mime != nil
        if contains mime "text/"
            return true
    low: lower fname
    if contains low ".txt"
        return true
    if contains low ".md"
        return true
    if contains low ".markdown"
        return true
    false

--! Checks by filename/mime type whether a document is a PDF.
fn is_pdf_doc fname mime
    if mime != nil
        if contains mime "application/pdf"
            return true
    contains (lower fname) ".pdf"

--! Escapes a path for embedding as ONE host-side argv token in an exec()
--! command string (see splitShellWords in pipe/pkg/object/sandbox.go: only
--! "\\" and "\"" are unescaped inside double quotes) — the same escaping
--! as shell_quote in docker_tools.pipe, duplicated locally here instead of
--! imported (docker_tools.pipe deliberately doesn't export it, see its
--! comment on the sqlite shadowing bug that an extra import here would
--! needlessly risk).
fn shell_quote s
    s: replace_all s "\\" "\\\\"
    s: replace_all s "\"" "\\\""
    s

--! Extracts plain text from a local PDF file via `pdftotext` (Poppler,
--! installed system-wide, no API key/cloud service — see setup_sandbox
--! for the exec whitelist entry). "-q" suppresses Poppler warnings (e.g.
--! about missing embedded fonts) — without it they end up IN THE MIDDLE
--! of the extracted text via exec()'s CombinedOutput. "-" as the output
--! path writes the text to stdout instead of a file. Returns nil if the
--! PDF has no text layer (e.g. pure image scans without OCR — Poppler
--! then returns empty output, no error) or pdftotext fails (corrupt/
--! encrypted file).
fn extract_pdf_text path dbh
    cmd: "pdftotext -q \"" ++ (shell_quote path) ++ "\" -"
    r: exec cmd
    if (get r "status") != 0
        msg: "Status " ++ (to_str (get r "status")) ++ ": " ++ path
        print ("pdftotext failed (" ++ msg ++ ")")
        mem.log_error dbh "pdftotext" msg
        return nil
    out: get r "output"
    if out == nil || (trim out) == ""
        return nil
    out

fn is_mcp_server_question low
    if !contains low "mcp"
        return false
    if contains low "server" || contains low "werkzeug" || contains low "verfuegbar" || contains low "verfugbar" || contains low "verfügbar" || contains low "welche" || contains low "tools"
        return true
    false

--! Only the filename part, no path traversal — Telegram's file_name comes
--! from the user/sender and must never go unchecked into a storage path.
fn safe_filename fname
    base: fname
    parts: split fname "/"
    if (len parts) > 0
        base: at parts ((len parts) - 1)
    base: replace_all base ".." ""
    if base == nil || base == ""
        base: "file"
    base

--! Processes an uploaded document (Telegram "document" message). EVERY
--! file is saved raw in the mcp_data folder (readable/editable for
--! tool_filesystem); plain text files are additionally learned directly
--! into memory (ingest_document), PDFs via pdftotext (see
--! extract_pdf_text above) — other binary formats are only saved.
--! Live status like with the gremium (see tel_finalize/swarm_transcript_line
--! below): ONE placeholder message is updated via editMessageText across
--! the processing steps, instead of silently answering only at the end —
--! for a PDF (download + extraction + learning) this can take a
--! noticeable while; without an intermediate status Muninn would look
--! stuck.
fn handle_document token cid dbh doc
    fname: get doc "file_name"
    if fname == nil
        fname: "document"
    mime: get doc "mime_type"
    tel.tel_send_chat_action token cid "typing"
    message_id: nil
    ph: tel.tel_send_message token cid "📄 Downloading document..."
    if (get ph "ok") == true
        message_id: get (get ph "result") "message_id"
    fpath: tel.tel_get_file token (get doc "file_id")
    if fpath == nil
        tel_finalize token cid message_id "Couldn't retrieve the file." nil
        return nil
    content: tel.tel_download_file token fpath
    if content == nil || content == ""
        tel_finalize token cid message_id "File was empty or unreadable." nil
        return nil
    safe_name: safe_filename fname
    save_path: "/root/muninn/mcp_data/" ++ safe_name
    write_file save_path content
    out: "Saved: " ++ safe_name ++ " (" ++ (to_str (len content)) ++ " bytes)."
    if is_text_doc fname mime
        tel.tel_edit_message_text token cid message_id "🧠 Learning the content..."
        res: mem.ingest_document dbh content ("telegram-datei:" ++ fname) fname 20
        out: out ++ "\nAlso learned as knowledge: " ++ (to_str (get res "chunks_ingested")) ++ " of " ++ (to_str (get res "chunks_total")) ++ " chunks."
    else
        if is_pdf_doc fname mime
            tel.tel_edit_message_text token cid message_id "📄 Extracting text from the PDF..."
            --! Fresh tool/exec budget needed (see the setup_sandbox comment at
            --! handle_voice) — a previous message pass in the same process might
            --! otherwise no longer have "pdftotext" on the active exec whitelist.
            setup_sandbox all_mcp_servers
            pdf_text: extract_pdf_text save_path dbh
            if pdf_text == nil
                out: out ++ "\nNo text could be extracted (possibly pure image scans without a text layer, encrypted, or corrupted) — not learned into memory."
            else
                tel.tel_edit_message_text token cid message_id "🧠 Learning the content..."
                res: mem.ingest_document dbh pdf_text ("telegram-pdf:" ++ fname) fname 20
                out: out ++ "\nText extracted and learned as knowledge: " ++ (to_str (get res "chunks_ingested")) ++ " of " ++ (to_str (get res "chunks_total")) ++ " chunks."
    tel_finalize token cid message_id out nil

--! Processes an uploaded photo (Telegram "photo" message) via ai_vision.
--! "photo" is a list of sizes sorted ascending — the last element is the
--! highest resolution. The bytes come back as raw bytes via Telegram's
--! File API; ai_vision explicitly accepts a bytes object for this (not a
--! string — a string would otherwise be interpreted as a local path/URL,
--! see resolveImageURL in pipe/pkg/object/builtins_vision.go), hence
--! to_bytes. DeepSeek's default model (deepseek-chat, see setup_ai) can't
--! handle images — briefly switch to the vision model for the call and
--! ALWAYS switch back afterward (try/catch), otherwise all subsequent
--! text replies would run on the wrong model.
fn handle_photo token cid dbh msg
    photos: get msg "photo"
    if photos == nil || (len photos) == 0
        tel.tel_send_message token cid "Couldn't read the photo."
        return nil
    largest: at photos ((len photos) - 1)
    caption: get msg "caption"
    prompt: "What can be seen in this image? Describe it briefly and check whether anything important or noteworthy is visible."
    if caption != nil && (trim caption) != ""
        prompt: caption
    tel.tel_send_chat_action token cid "typing"
    fpath: tel.tel_get_file token (get largest "file_id")
    if fpath == nil
        tel.tel_send_message token cid "Couldn't retrieve the image."
        return nil
    raw: tel.tel_download_file token fpath
    if raw == nil || raw == ""
        tel.tel_send_message token cid "Image was empty or unreadable."
        return nil
    answer: ""
    try
        ai_model "deepseek-v4-flash-vision-exp"
        answer: ai_vision (to_bytes raw) prompt
        ai_model "deepseek-chat"
    catch e
        ai_model "deepseek-chat"
        answer: "I couldn't analyze the image: " ++ (to_str e)
    tid: mem.active_thread dbh cid
    mem.add_message dbh tid cid "user" ("[Photo] " ++ prompt)
    mem.add_message dbh tid cid "assistant" answer
    kb: []
    row: []
    push row (tel.tel_button "💾 Remember" "save")
    push kb row
    tel.tel_send_message_kb token cid (shorten answer) kb
    nil

--! Processes an incoming voice message: downloads the OGG/Opus file,
--! transcribes it locally via whisper-transcribe-mcp (no API key, see
--! .env.example), and then passes the recognized text through
--! handle_message JUST LIKE a typed message — commands, reminders, and
--! the gremium therefore work identically via voice. If the "whisper"
--! MCP server isn't configured/connected, this honestly falls back to
--! asking the user to type instead (no pretending to have a capability
--! that isn't currently available).
fn handle_voice token cid dbh msg allowed uid
    voice: get msg "voice"
    tel.tel_send_chat_action token cid "typing"
    fpath: tel.tel_get_file token (get voice "file_id")
    if fpath == nil
        tel.tel_send_message token cid "Couldn't retrieve the voice message."
        return nil
    raw: tel.tel_download_file token fpath
    if raw == nil || raw == ""
        tel.tel_send_message token cid "Voice message was empty or unreadable."
        return nil
    --! Fresh tool budget for the transcription: tool_call runs under the
    --! CURRENTLY active sandbox profile and consumes its max_tool_calls
    --! quota. Through the normal message flow, these profiles were only
    --! reset before gremium runs (setup_sandbox), NEVER on the voice path —
    --! so the whisper call for a later voice message failed with
    --! "E_SANDBOX: max tool calls exceeded", while the first one still
    --! worked (fresh profile). As with the gremium call sites, set a fresh
    --! budget here before transcribing.
    setup_sandbox all_mcp_servers
    text: nil
    last_err: nil
    try
        b64: base64_encode raw
        res: tool_call "whisper_transcribe_base64" {audio_base64: b64, extension: "ogg", language: "de"}
        --! On an MCP error, tool_call returns raw text (not JSON, e.g. "mcp call
        --! transcribe_base64: ..."). Only parse it as a JSON object if it truly
        --! starts with "{"; otherwise record the raw text as the error reason.
        if (trim res) != nil && (len (trim res)) > 0 && (substring (trim res) 0 1) == "{"
            try
                j: parse_json res
                text: get j "text"
                if (get j "error") != nil
                    last_err: to_str (get j "error")
            catch e2
                last_err: to_str e2
        else
            last_err: to_str res
    catch e
        last_err: to_str e
    if text == nil || (trim text) == ""
        --! Log the real reason to the journal instead of silently swallowing it
        --! (the old empty catch gave NO clue why the transcription failed).
        --! Honestly tell the user that it failed.
        if last_err != nil
            print ("whisper_transcribe_base64 failed: " ++ last_err)
            mem.log_error dbh "whisper_transcribe" last_err
        tel.tel_send_message token cid "I can't understand voice messages right now (transcription unavailable or failed). Please type it instead."
        return nil
    handle_message token cid (trim text) dbh allowed uid

--! Processes an incoming text message and replies.
fn handle_message token cid text dbh allowed uid
    if text == nil
        return nil
    tnorm: trim text
    if tnorm == ""
        return nil
    low: lower tnorm
    if low == "/start" || low == "/hello" || low == "hallo" || low == "hi"
        tel.tel_send_message token cid (greeting_text 0)
        return nil
    if low == "/help" || low == "hilfe" || low == "help"
        tel.tel_send_message token cid (help_text 0)
        return nil
    if low == "/status"
        tel.tel_send_message token cid (status_text dbh)
        return nil
    if low == "/costs"
        tel.tel_send_chat_action token cid "typing"
        tel.tel_send_message token cid (shorten (costs_text dbh))
        return nil
    if low == "/list"
        tel.tel_send_message token cid (list_text dbh)
        return nil
    if low == "/goals"
        rows: mem.list_goals dbh 20
        open_rows: []
        for r in rows
            if (get r "status") != "done"
                push open_rows r
        if (len open_rows) == 0
            tel.tel_send_message token cid "No open goals right now. Muninn creates one automatically when you mention a genuine long-term objective (not a one-off task)."
        else
            kb: []
            for r in open_rows
                row: []
                push row (tel.tel_button ("✓ " ++ (truncate_status (get r "goal_text") 60)) ("goal_done:" ++ (to_str (get r "id"))))
                push kb row
            tel.tel_send_message_kb token cid "Open goals — tap one to mark it done:" kb
        return nil
    if low == "/trace"
        t: format_trace dbh cid
        if t == nil
            tel.tel_send_message token cid "No trace yet — ask me something first."
        else
            tel.tel_send_message token cid t
        return nil
    if low == "/reminders"
        rows: sched.list dbh cid
        if (len rows) == 0
            tel.tel_send_message token cid "No open reminders or briefings scheduled."
        else
            out: "Open reminders/briefings:\n"
            for r in rows
                out: out ++ "• [" ++ (get r "kind") ++ "] " ++ (get r "note") ++ " — on " ++ (format_time ((get r "due_ts") + tz_offset) "2006-01-02 15:04:05") ++ "\n"
            tel.tel_send_message token cid (shorten out)
        return nil
    if low == "/briefing stop"
        rows: sched.list dbh cid
        cancelled: 0
        for r in rows
            if (get r "kind") == "briefing"
                sched.cancel dbh (get r "id")
                cancelled: cancelled + 1
        if cancelled > 0
            tel.tel_send_message token cid "Daily briefing unsubscribed."
        else
            tel.tel_send_message token cid "No active briefing found."
        return nil
    if low == "/briefing"
        rows: sched.list dbh cid
        for r in rows
            if (get r "kind") == "briefing"
                sched.cancel dbh (get r "id")
        bt: parse_briefing_time briefing_time
        nsec: now
        first_due: sched.next_hhmm (get bt "hh") (get bt "mm") nsec tz_offset
        sched.schedule dbh "briefing" (to_str cid) "Daily briefing" first_due "daily"
        tel.tel_send_message token cid ("Daily briefing active — I'll check in next at " ++ (format_time (first_due + tz_offset) "15:04") ++ " (and daily after that).")
        return nil
    rq: remind_query low tnorm
    if rq != ""
        nsec2: now
        parsed: sched.parse_reminder rq nsec2 tz_offset
        sched.schedule dbh "reminder" (to_str cid) (get parsed "text") (get parsed "due") (get parsed "repeat")
        tel.tel_send_message token cid ("Noted — I'll remind you on " ++ (format_time ((get parsed "due") + tz_offset) "2006-01-02 15:04:05") ++ " about: " ++ (get parsed "text"))
        return nil
    if low == "/reset"
        mem.close_thread dbh cid
        tel.tel_send_message token cid "Conversation history reset — starting with a fresh context."
        return nil
    if low == "/consolidate"
        tel.tel_send_chat_action token cid "typing"
        cdays: mem.setting_consolidate_days dbh (to_str cid)
        res: mem.consolidate dbh (get cdays "decay") (get cdays "forget")
        tel.tel_send_message token cid ("Consolidation: " ++ (to_str (get res "threads_summarized")) ++ " threads condensed, " ++ (to_str (get res "memories_decayed")) ++ " memories decayed, " ++ (to_str (get res "memories_forgotten")) ++ " forgotten.")
        return nil
    if low == "/settings"
        tel.tel_send_message_kb token cid (settings_menu_text dbh cid) (settings_kb dbh cid)
        return nil
    if low == "/stop"
        --! Deterministic, WITHOUT AI involvement — deliberately so, see the
        --! comment at dt.cancel_all_running: the AI itself could previously only
        --! CLAIM a cancellation (no real tool for it), observed live as "all
        --! cancelled" followed immediately by a newly started background job.
        --! /stop guarantees that a cancellation ALWAYS takes effect immediately
        --! and reliably, independent of any AI decision — the only defensible
        --! basis for a stop request.
        tel.tel_send_chat_action token cid "typing"
        cancelled_jobs: dt.cancel_all_running dbh (to_str cid)
        n_sched: 0
        for r in (sched.list dbh (to_str cid))
            if (get r "kind") == "job_check" || (get r "kind") == "task_check"
                sched.cancel dbh (get r "id")
                n_sched: n_sched + 1
        if (len cancelled_jobs) == 0 && n_sched == 0
            tel.tel_send_message token cid "No background tasks were running — nothing to cancel."
        else
            tel.tel_send_message token cid ("Cancelled: " ++ (to_str (len cancelled_jobs)) ++ " running Docker background job(s) (container removed), " ++ (to_str n_sched) ++ " scheduled continuation(s) cancelled.")
        return nil
    if low == "/graph"
        tel.tel_send_message token cid "Please provide an entity: /graph <name>"
        return nil
    gname: graph_query low tnorm
    if gname != ""
        n: mem.neighbors_of dbh gname
        if (len n) == 0
            tel.tel_send_message token cid ("No connections found for '" ++ gname ++ "' in the knowledge graph.")
        else
            out: gname ++ ":\n"
            for x in n
                out: out ++ "• " ++ (get x "rel") ++ " → " ++ (get x "target") ++ "\n"
            tel.tel_send_message token cid (shorten out)
        return nil
    if low == "/search"
        tel.tel_send_message token cid "Please provide a search term: /search <term>"
        return nil
    sq: search_query low tnorm
    if sq != ""
        do_search token cid dbh sq
        return nil
    if low == "/learn"
        tel.tel_send_message token cid "Please provide a URL: /learn <URL> — or send me a .txt/.md file directly."
        return nil
    lurl: learn_query low tnorm
    if lurl != ""
        tel.tel_send_chat_action token cid "typing"
        dtext: web.web_fetch_raw lurl
        if dtext == nil || dtext == ""
            tel.tel_send_message token cid "Page not reachable or empty."
            return nil
        res: mem.ingest_document dbh dtext lurl lurl 20
        tel.tel_send_message token cid ("Learned from " ++ lurl ++ ": " ++ (to_str (get res "chunks_ingested")) ++ " of " ++ (to_str (get res "chunks_total")) ++ " chunks stored.")
        return nil
    if contains low "was kannst du"
        tel.tel_send_message token cid (capability_text 0)
        return nil
    if is_mcp_server_question low
        names: list_configured_mcp_aliases 0
        if (len names) == 0
            tel.tel_send_message token cid "No MCP servers are currently configured."
        else
            available: "Available MCP servers: " ++ (join names ", ") ++ "."
            tool_names: connected_mcp_tool_names 0
            if (len tool_names) > 0
                available: available ++ " Available tools: " ++ (join tool_names ", ") ++ "."
            tel.tel_send_message token cid available
        return nil
    --! From here on: ONE shared path for the entire free-form conversation.
    --! Previously there was a pre-classification here (rule-based + a
    --! context-free single-word AI call) into six isolated buckets
    --! (reminder/permanent/task/goal/fleeting/question), of which only
    --! "question" actually had tools, memory, and conversation history. That
    --! led to inconsistent behavior for identical text (depending on which
    --! bucket the AI hit on the next call) and to a "task" executor blindly
    --! inventing JSON steps with no context at all (see the Plan.md
    --! discussion). Now the gremium (already proven for "question": real
    --! tools, memory, history) ALWAYS gets the full context and decides for
    --! itself whether to remember something, schedule a reminder, do
    --! research, or simply answer.
    ensure_mcp_for_task tnorm dbh
    tel.tel_send_chat_action token cid "typing"
    tid: mem.active_thread dbh cid
    hist: mem.thread_history dbh tid 12
    task: tnorm
    if (len hist) > 0
        task: "Bisheriger Gespraechsverlauf (aeltester zuerst, ungekuerzt):\n" ++ (mem.format_history hist) ++ "\nAktuelle Nachricht: " ++ tnorm
    task: (mem.settings_prompt_prefix dbh (to_str cid)) ++ task
    mem.log_event dbh (to_str cid) tnorm "chat"
    --! Live status: send ONE placeholder message and keep updating it via
    --! editMessageText, instead of new message blocks or complete silence
    --! while the gremium works (see swarm_transcript_line/tel_finalize below,
    --! run_gremium_stream in swarm.pipe). (sendMessageDraft was tried here
    --! instead — reverted: it visibly made the message jump around in the
    --! chat instead of updating in place, worse than the plain edit-based
    --! version.)
    message_id: nil
    ph: tel.tel_send_message token cid "🧠 Thinking..."
    if (get ph "ok") == true
        message_id: get (get ph "result") "message_id"
    on_update: make_swarm_updater token cid message_id dbh
    round_check: make_round_check token cid allowed dbh uid
    setup_sandbox all_mcp_servers
    answer: ""
    crashed: false
    aborted: false
    abort_reason: ""
    try
        res: grm.run_gremium_stream dbh cid task on_update round_check
        if (get res "aborted") == true
            aborted: true
            abort_reason: get res "abort_reason"
        else
            answer: get res "content"
            save_trace dbh cid res
    catch e
        print ("run_gremium_stream failed (attempt 1): " ++ (to_str e))
        mem.log_error dbh "run_gremium_stream" (to_str e)
        --! ONE automatic retry: observed live that a real crash here is usually
        --! a TRANSIENT network error to the AI provider ("read: connection reset
        --! by peer" in the middle of a multi-part research task about Friedrich
        --! Merz) — a single network blip shouldn't ruin the ENTIRE task when a
        --! second attempt will likely go through. A fresh tool budget is needed,
        --! since the first (failed) attempt already consumed part of the old
        --! quota.
        setup_sandbox all_mcp_servers
        try
            res2: grm.run_gremium_stream dbh cid task on_update round_check
            if (get res2 "aborted") == true
                aborted: true
                abort_reason: get res2 "abort_reason"
            else
                answer: get res2 "content"
                save_trace dbh cid res2
        catch e2
            --! Without this log, a REAL gremium crash (e.g. max rounds exceeded,
            --! an interpreter error) looked identical to "the AI doesn't know" —
            --! both silently ended up in the same do_search fallback below. The
            --! journal log makes the difference visible.
            print ("run_gremium_stream failed (attempt 2, giving up): " ++ (to_str e2))
            mem.log_error dbh "run_gremium_stream" (to_str e2)
            answer: ""
            crashed: true
    mem.add_message dbh tid cid "user" tnorm
    if aborted
        --! An intentional /stop is not a crash — no retry happened for it
        --! (checked right after each attempt, before the crash path), and
        --! it must never fall through to the "answer is empty" research
        --! fallback below, which would otherwise start a whole new web
        --! search for the very task the user just asked to cancel.
        tel_finalize token cid message_id ("🛑 " ++ abort_reason) nil
        return nil
    if crashed
        --! A REAL crash (network/provider error, interpreter error, max rounds
        --! exceeded) is NOT the same as "the AI doesn't know" — for a longer
        --! task description (not just a short factual question), a blind web
        --! search of the entire, often multi-sentence task text would be
        --! pointless. Observed live: exactly that happened — after the network
        --! error, the Merz research task ended up verbatim as a DuckDuckGo
        --! search query and returned "no usable results" instead of honestly
        --! saying that something went technically wrong.
        tel_finalize token cid message_id "Something went technically wrong (e.g. a brief connection drop to the AI provider) — please send your request again and I'll retry." nil
        return nil
    if question_needs_research answer
        tel_finalize token cid message_id "No knowledge of that. Researching..." nil
        do_search token cid dbh tnorm
        return nil
    if answer == nil || answer == ""
        ctx: mem.retrieve_context dbh tnorm 3
        if (len ctx) > 0
            ctx_text: join ctx "\n\n"
            reply: ""
            try
                reply: ai_chat ((grm.self_context 0) ++ "You are Muninn, a personal AI assistant. Answer the question based on the following context, briefly and factually. If the context doesn't contain anything relevant, honestly say you don't know. Output only the answer, no internal reasoning.") ("Question: " ++ tnorm ++ "\n\nContext:\n" ++ ctx_text)
            catch e3
                print ("Context-fallback ai_chat failed: " ++ (to_str e3))
                mem.log_error dbh "context_fallback_ai_chat" (to_str e3)
                reply: ""
            if reply == nil || reply == ""
                reply: "Here's what I remember about that:\n"
                for c in ctx
                    reply: reply ++ "• " ++ c ++ "\n"
            mem.add_message dbh tid cid "assistant" reply
            tel_finalize token cid message_id reply nil
        else
            tel_finalize token cid message_id "No knowledge of that. Researching..." nil
            rr: web.research tnorm
            ctx2: get rr "context"
            srcs2: get rr "sources"
            if ctx2 == nil || ctx2 == ""
                fallback: "I couldn't find anything relevant online."
                mem.add_message dbh tid cid "assistant" fallback
                tel_finalize token cid message_id fallback nil
            else
                answer2: ""
                try
                    answer2: ai_chat ((grm.self_context 0) ++ "You are Muninn, a personal AI assistant. Answer the question based on the researched context, briefly and factually — the context comes from a WEB research on the topic of the question, NOT from research about Muninn itself. If the question is about Muninn's own capabilities/tools, use the self-knowledge above for that, not the web context. IMPORTANT: this call here is pure text summarization WITHOUT tool access — NEVER claim to currently be doing/researching/setting something up or initiating steps. If the request is an ACTION (e.g. 'set up X', 'create a container') rather than a knowledge question, briefly explain that you can do that via your real tools, and ask the user to send it again as a direct request. Output only the answer, no internal reasoning.") ("Question: " ++ tnorm ++ "\n\nContext:\n" ++ ctx2)
                catch e4
                    print ("Web-research-fallback ai_chat failed: " ++ (to_str e4))
                    mem.log_error dbh "web_fallback_ai_chat" (to_str e4)
                    answer2: ctx2
                if answer2 == nil || answer2 == ""
                    answer2: ctx2
                mem.add_memory dbh (mem.condense_fact answer2) "fact" 3 "web_research" "web"
                mem.add_message dbh tid cid "assistant" answer2
                src_text: ""
                for u in srcs2
                    src_text: src_text ++ "\n" ++ u
                full: (shorten answer2) ++ "\n— Sources:" ++ (shorten src_text)
                kb: []
                row: []
                push row (tel.tel_button "💾 Remember" "save")
                push row (tel.tel_button "🔍 Dig deeper" "more")
                push kb row
                row2: []
                push row2 (tel.tel_button "👍" "up")
                push row2 (tel.tel_button "👎" "down")
                push kb row2
                tel_finalize token cid message_id (shorten full) kb
    else
        mem.add_message dbh tid cid "assistant" answer
        kb: []
        row: []
        push row (tel.tel_button "💾 Remember" "save")
        push row (tel.tel_button "🔍 Dig deeper" "more")
        push kb row
        row2: []
        push row2 (tel.tel_button "👍" "up")
        push row2 (tel.tel_button "👎" "down")
        push kb row2
        row3: []
        push row3 (tel.tel_button "📜 Verlauf" "gremium_log")
        push kb row3
        tel_finalize_after_tree token cid message_id (shorten answer) kb

--! Truncates a status snippet to n characters (for the live status line —
--! unlike shorten (4000 characters, for Telegram messages) deliberately
--! short here, so a single tool line doesn't blow up the whole status message.
fn truncate_status s n
    if s == nil
        return ""
    if (len s) > n
        (substring s 0 n) ++ "…"
    else
        s

--! Extracts a short, human-readable snippet from a tool call's raw JSON
--! arguments (the actual search query/URL/etc., not just the tool name) —
--! for known local tools (see the ai_tool registrations in swarm.pipe)
--! targets the matching field specifically, otherwise best-effort takes
--! the first string field in the arguments (covers MCP tools with an
--! unknown schema).
fn tool_arg_summary tool_name args_json
    if args_json == nil || args_json == ""
        return ""
    a: nil
    try
        a: parse_json args_json
    catch
        a: nil
    if a == nil || (type_of a) != "MAP"
        return ""
    field: nil
    if tool_name == "web_search" || tool_name == "erinnerungen_suchen"
        field: get a "query"
    else if tool_name == "web_fetch"
        field: get a "url"
    else if tool_name == "erinnerung_planen"
        field: get a "text"
    else if tool_name == "merken" || tool_name == "merken_quelle"
        field: get a "content"
    else if tool_name == "docker_pull_image"
        field: get a "image"
    else if tool_name == "docker_create_container"
        field: get a "name"
    else if tool_name == "bild_senden" || tool_name == "datei_senden"
        field: get a "path"
    if field == nil
        for k in (keys a)
            v: get a k
            if field == nil && (type_of v) == "STRING" && v != ""
                field: v
    if field == nil || field == ""
        return ""
    truncate_status (to_str field) 70

--! Norse names for the tool specialists (werkzeug_<alias>) -- Muninn
--! itself is Odin's raven of memory, so the whole gremium got a matching
--! theme instead of generic role labels. Purely a DISPLAY-layer mapping
--! (see agent_display_name below) -- the actual internal alias/agent
--! identifiers used for routing/handoff (swarm.pipe) are untouched, so
--! this carries zero risk to existing handoff logic or stored recipes
--! (unlike renaming the identifiers themselves, deliberately out of scope).
--! Unknown/future aliases fall back to a generic icon + the alias itself.
fn werkzeug_display_name alias
    if alias == "filesystem"
        return {icon: "🔨", name: "Sindri"}
    if alias == "memory"
        return {icon: "📚", name: "Kvasir"}
    if alias == "denkwerkzeug"
        return {icon: "🤔", name: "Vili"}
    if alias == "browser"
        return {icon: "🐿️", name: "Ratatoskr"}
    if alias == "doku"
        return {icon: "📖", name: "Vör"}
    if alias == "docker"
        return {icon: "🔥", name: "Brokkr"}
    if alias == "zeit"
        return {icon: "⏳", name: "Skuld"}
    if alias == "google"
        return {icon: "📅", name: "Frigg"}
    if alias == "praesentation"
        return {icon: "🎨", name: "Iðunn"}
    if alias == "dokument"
        return {icon: "📝", name: "Fjalar"}
    if alias == "whisper"
        return {icon: "🎙️", name: "Sága"}
    if alias == "github"
        return {icon: "⚒️", name: "Eitri"}
    {icon: "🔧", name: alias}

--! Persists the path/round-count of a finished gremium run (see the
--! {content, path, rounds} shape returned by run_gremium/run_gremium_stream
--! — path and rounds used to be silently discarded after pulling out just
--! "content") so /trace can show it afterwards. One slot per chat (most
--! recent run only), stored via meta like other small persistent values.
fn save_trace dbh cid res
    path: get res "path"
    if path == nil
        return nil
    trace: {}
    set trace "path" path
    set trace "rounds" (get res "rounds")
    mem.meta_set dbh ("last_trace:" ++ (to_str cid)) (to_json trace)

--! Formats a saved trace (see save_trace) as a short, named path for
--! /trace -- shared formatting so Telegram and any future caller (e.g. the
--! dashboard) show it identically.
fn format_trace dbh cid
    raw: mem.meta_get dbh ("last_trace:" ++ (to_str cid))
    if raw == nil || raw == ""
        return nil
    trace: nil
    try
        trace: parse_json raw
    catch
        return nil
    if trace == nil
        return nil
    path: get trace "path"
    if path == nil || (len path) == 0
        return nil
    names: []
    for a in path
        d: agent_display_name a
        push names ((get d "icon") ++ " " ++ (get d "name"))
    rounds: get trace "rounds"
    suffix: " round"
    if rounds != 1
        suffix: " rounds"
    (join names " → ") ++ "\n" ++ (to_str rounds) ++ suffix

--! Display name + icon for any gremium agent (the 4 core roles, or a
--! werkzeug_<alias> specialist). Shared by agent_action_phrase (live
--! status) and the /trace command, so both always show the same names.
fn agent_display_name agent
    if agent == "planer"
        return {icon: "🧭", name: "Huginn"}
    if agent == "faktenwaechter"
        return {icon: "🔍", name: "Mimir"}
    if agent == "kritiker"
        return {icon: "🧐", name: "Heimdall"}
    if agent == "registrator"
        return {icon: "✍️", name: "Bragi"}
    if (len agent) > 9 && (substring agent 0 9) == "werkzeug_"
        return (werkzeug_display_name (substring agent 9 (len agent)))
    {icon: "🧠", name: agent}

--! Bare verb phrase for an agent's role, no icon/name (e.g. "is checking
--! facts and memory...") — composed into agent_group_header below.
fn agent_verb_phrase agent
    if agent == "planer"
        return "is planning the answer..."
    if agent == "faktenwaechter"
        return "is checking facts and memory..."
    if agent == "kritiker"
        return "is reviewing the answer..."
    if agent == "registrator"
        return "is writing the answer..."
    if (len agent) > 9 && (substring agent 0 9) == "werkzeug_"
        return "is working (" ++ (substring agent 9 (len agent)) ++ ")..."
    "is thinking..."

--! Icon + bold name for an agent, e.g. "🔍 **Mimir**" — the shared
--! identity fragment for the tree's group header and a handoff line's
--! target reference.
fn agent_icon_name agent
    d: agent_display_name agent
    (get d "icon") ++ " **" ++ (get d "name") ++ "**"

--! Full-log group header: icon + bold name + em-dash + verb phrase (e.g.
--! "🔍 **Mimir** — is checking facts and memory...") — the dash reads
--! better as a standalone tree-branch header than run into the phrase.
fn agent_group_header agent
    (agent_icon_name agent) ++ " — " ++ (agent_verb_phrase agent)

--! Icon for a tool call, by tool name — keeps the tree scannable at a
--! glance instead of uniform text for everything. Falls back to a
--! generic wrench for anything not specifically known (the open-ended
--! universe of MCP specialist tool names, e.g. word_add_paragraph).
fn tool_icon tool_name
    if tool_name == "web_search"
        return "🔎"
    if tool_name == "web_fetch"
        return "🌐"
    if tool_name == "erinnerungen_suchen" || tool_name == "erinnerung_planen" || tool_name == "merken" || tool_name == "merken_quelle"
        return "🧠"
    if (len tool_name) > 7 && (substring tool_name 0 7) == "docker_"
        return "🐳"
    if tool_name == "bild_senden" || tool_name == "datei_senden"
        return "📎"
    "🔧"

--! Bare tool-call content (e.g. 🔎 web_search "Berlin population 2026")
--! for a "tool" event. Empty string if there is no detail (nothing to
--! show).
fn tool_call_detail_line detail args_json
    if detail == nil || detail == ""
        return ""
    line: (tool_icon detail) ++ " " ++ detail
    arg_hint: tool_arg_summary detail args_json
    if arg_hint != ""
        line: line ++ " \"" ++ arg_hint ++ "\""
    line

--! Bare content for a single "tool"/"reasoning"/"inject" progress event —
--! used both as the live status's line 2 and as a tree-branch entry in
--! the full run log (see make_swarm_updater). "start"/"handoff"/"final"
--! are handled directly there. "reasoning" is the model's actual
--! chain-of-thought for that round (only fires when the provider returns
--! one) — the real "watch them think" signal; "inject" reflects a
--! steering message a round_check fed into the run (see make_round_check),
--! so the full log shows the user's own nudge take effect. Empty string
--! means "nothing to show".
fn swarm_transcript_line event detail args_json
    if event == "tool"
        return (tool_call_detail_line detail args_json)
    if event == "reasoning"
        return "💭 *" ++ (truncate_status detail 150) ++ "*"
    if event == "inject"
        return "💬 **You**: " ++ (truncate_status detail 150)
    ""

--! Extracts the optional "reason" note from a handoff tool call's raw
--! JSON arguments (see ai.ChatSwarm's "handoff" progress event and the
--! synthesized handoff tool's schema in swarmToolsFor, pipe repo) — ""
--! if the model didn't provide one (the field is optional).
fn handoff_reason args_json
    if args_json == nil || args_json == ""
        return ""
    a: nil
    try
        a: parse_json args_json
    catch
        a: nil
    if a == nil || (type_of a) != "MAP"
        return ""
    r: get a "reason"
    if r == nil
        return ""
    truncate_status (to_str r) 120

--! Renders one agent group as a tree branch: its header
--! (agent_group_header) plus its collected entries, each a map
--! {text, handoff} (see make_swarm_updater) — "├─ " for every entry but
--! the last, "└─▶ " for a trailing handoff (points at the target it's
--! handing off to), plain "└─ " for any other trailing entry.
fn render_group g
    header: agent_group_header (get g "agent")
    lines: get g "lines"
    n: len lines
    if n == 0
        return header
    rendered: []
    i: 0
    while i < n
        entry: at lines i
        connector: "├─ "
        if i == (n - 1)
            if (get entry "handoff") == true
                connector: "└─▶ "
            else
                connector: "└─ "
        push rendered (connector ++ (get entry "text"))
        i: i + 1
    header ++ "\n" ++ (join rendered "\n")

--! Joins accumulated agent groups (see make_swarm_updater) into the full
--! run tree — used both for the LIVE edited message while the gremium is
--! working, and again afterward for the standalone "📜 Verlauf" button
--! message. Kept under a safe character budget (a bit below shorten's
--! 4000, since many separate bold/icon runs each carry their own HTML-tag
--! overhead once tg_html converts the markdown here), dropping the OLDEST
--! groups first with a leading marker when over it.
fn render_groups groups
    budget: 3800
    kept: groups
    fn render_all gs
        rendered: []
        for g in gs
            push rendered (render_group g)
        join rendered "\n\n"
    text: render_all kept
    while (len text) > budget && (len kept) > 1
        kept: slice kept 1 (len kept)
        text: render_all kept
    if (len kept) < (len groups)
        text: "… (earlier steps hidden)\n\n" ++ text
    text

--! Builds the on_update closure for run_gremium_stream: renders the REAL,
--! growing tree live (render_groups — see it for the exact format), edited
--! in place into the same placeholder message as it grows, instead of a
--! compact teaser — the point is to actually watch the gremium work.
--! Groups every step by agent (render_group/render_groups) — a handoff is
--! recorded as the CLOSING branch of the group it happened in (agent = the
--! one handing off, per Go's onProgress; the target's own "start" opens
--! ITS OWN group next), carrying the optional "reason" note
--! (handoff_reason) so the tree shows not just THAT a handoff happened but
--! what it actually asked for. Telegram's native "typing..." chat action
--! is kept alive alongside it (re-sent every ~4s, independent of the text
--! throttle below) as an additional liveness cue in the chat header.
--!
--! Persists the full tree once on "final" to last_run_log:<cid> (mem meta,
--! same pattern as save_trace/format_trace for /trace) — NOT for display
--! here (the caller deletes this live message once the run finishes and
--! sends the real answer instead, see tel_finalize_after_tree; Telegram's
--! own message-removal animation reads like the tree getting shredded once
--! the work is done), but so the "📜 Verlauf" button attached to that new
--! answer message can show the whole tree again afterward, on demand
--! (handle_message/handle_callback's "gremium_log" branch).
--!
--! Edit throttle (about once/second, skip if text unchanged) unchanged
--! from before. message_id may be nil (placeholder send failed) — then
--! the text-editing half is a no-op (the typing action and log
--! persistence still happen). (sendMessageDraft was tried here instead of
--! the edit — reverted: live feedback was that it made the message
--! visibly jump around in the chat instead of updating calmly in place.)
fn make_swarm_updater token cid message_id dbh
    stream_state: {groups: [], last_text: "", last_ms: 0, last_typing_ms: 0}
    fn on_update agent event detail args_json
        ms: time_ms
        if (ms - (get stream_state "last_typing_ms")) >= 4000
            set stream_state "last_typing_ms" ms
            tel.tel_send_chat_action token cid "typing"
        groups: get stream_state "groups"
        if event == "final"
            if (len groups) > 0
                mem.meta_set dbh ("last_run_log:" ++ (to_str cid)) (to_json groups)
            return nil
        if event == "handoff"
            --! agent = the agent handing off (Go's onProgress passes
            --! "current"); detail = the target agent's name.
            if (len groups) > 0
                text: "hands off to " ++ (agent_icon_name detail)
                reason: handoff_reason args_json
                if reason != ""
                    text: text ++ ": \"" ++ reason ++ "\""
                push (get (at groups ((len groups) - 1)) "lines") {text: text, handoff: true}
        if event == "start"
            last_group: nil
            if (len groups) > 0
                last_group: at groups ((len groups) - 1)
            if last_group == nil || (get last_group "agent") != agent
                push groups {agent: agent, lines: []}
        if event == "tool" || event == "reasoning" || event == "inject"
            bare: swarm_transcript_line event detail args_json
            if bare != ""
                if (len groups) == 0
                    push groups {agent: agent, lines: []}
                push (get (at groups ((len groups) - 1)) "lines") {text: bare, handoff: false}
        if (len groups) == 0
            return nil
        text: render_groups groups
        if text == (get stream_state "last_text")
            return nil
        if (ms - (get stream_state "last_ms")) < 1000
            return nil
        set stream_state "last_text" text
        set stream_state "last_ms" ms
        if message_id != nil
            tel.tel_edit_message_text token cid message_id text
    on_update

--! Builds the round_check closure for run_gremium_stream (see its doc
--! comment in swarm.pipe): lets the user stop a running gremium call with
--! /stop, or steer it mid-run with a fresh text message, without
--! introducing any concurrency (Muninn's bot loop stays fully
--! single-threaded — the pure-Pipe sqlite module's handle registry and
--! Pipe's process-wide ActiveProfile are both unsynchronized, so real
--! background execution isn't safe yet). Checked at most once every 3s
--! (ai_swarm_stream calls this at the START of every round — cheap, but
--! no reason to hit Telegram's API more often than that).
--!
--! dbh MUST be the handle poll_once already has open — this function must
--! NEVER call mem.open_locked itself. poll_once holds its cross-process
--! file lock for the ENTIRE handle_update/handle_callback call chain
--! (which is where this runs, several calls deep inside
--! ai_swarm_stream's own round loop, bridged back into Pipe exactly like
--! on_update above); a second open_locked from in here would try to
--! re-acquire a lock this same process already holds and block forever.
--!
--! uid is the update_id of the message that triggered THIS gremium run.
--! poll_once only persists its advanced telegram_offset AFTER this whole
--! call chain returns, so every peek during the run would otherwise still
--! see its own triggering message and misread it as a fresh steering
--! message — injecting the task's own original text back into its own
--! conversation. Excluding update_ids <= uid (in addition to the last
--! persisted offset, whichever is higher) prevents that. A genuine text
--! steering message found here is marked consumed (mark_injected) so
--! poll_once's own later, normal pass never dispatches it a second time as
--! an independent message — the peek itself stays non-destructive (never
--! advances the real offset), so without that separate marker it would
--! surface there and start an unintended second gremium run. Non-text
--! messages arriving mid-run (photo/document/voice) fall back to the old
--! generic "still working" notice, once per run — injecting binary
--! content isn't feasible over this text-only channel, so they are NOT
--! marked consumed and flow through normally once the gremium is done.
fn make_round_check token cid allowed dbh uid
    state: {last_ms: 0, pending_ack_id: nil, injected_ids: [], acked_other: false}
    fn check
        ms: time_ms
        if (ms - (get state "last_ms")) < 3000
            return nil
        set state "last_ms" ms
        if (get state "pending_ack_id") != nil
            --! The ack for a PREVIOUS injection made by THIS closure: by the
            --! time we're allowed to run again (the 3s throttle above), at
            --! least one full round has already used it (ChatSwarm appends
            --! an injection to the conversation before that SAME round's
            --! model call) — safe to remove now, unconditionally, whether
            --! this call goes on to find /stop, a new injection, or nothing.
            tel.tel_delete_message token cid (get state "pending_ack_id")
            set state "pending_ack_id" nil
        floor: 0
        saved: mem.meta_get dbh "telegram_offset"
        if saved != nil && saved != ""
            floor: to_num saved
        if uid != nil && (uid + 1) > floor
            floor: uid + 1
        updates: []
        try
            updates: tel.tel_get_updates token floor 0
        catch
            updates: []
        for upd in updates
            this_uid: get upd "update_id"
            msg: get upd "message"
            if msg != nil && !(contains (get state "injected_ids") this_uid) && !(mem.was_injected dbh this_uid)
                chat: get msg "chat"
                if chat != nil && (is_allowed (get chat "id") allowed)
                    txt: get msg "text"
                    if txt != nil
                        low: lower (trim txt)
                        if low == "/stop"
                            return {abort: true, abort_reason: "Cancelled by /stop."}
                        push (get state "injected_ids") this_uid
                        mem.mark_injected dbh this_uid
                        ack: tel.tel_send_message token cid ("👀 Got it, working it in: *" ++ (truncate_status txt 200) ++ "*")
                        if (get ack "ok") == true
                            set state "pending_ack_id" (get (get ack "result") "message_id")
                        return {inject: txt}
                    else if (get state "acked_other") != true
                        set state "acked_other" true
                        tel.tel_send_message token cid "⏳ Still working on your last request — send /stop to cancel it, or just wait: I'll get to this one right after."
        nil
    check

--! Finalizes a live-status message with the end result: edits the
--! placeholder message referenced by message_id (optionally with keyboard
--! kb), but falls back to a new message if message_id is missing
--! (placeholder couldn't be sent) or the edit itself fails (e.g. the user
--! deleted the message) — so a finished answer is never lost.
fn tel_finalize token cid message_id text kb
    if message_id == nil
        if kb == nil
            return (tel.tel_send_message token cid text)
        return (tel.tel_send_message_kb token cid text kb)
    r: nil
    if kb == nil
        r: tel.tel_edit_message_text token cid message_id text
    else
        r: tel.tel_edit_message_text_kb token cid message_id text kb
    if (get r "ok") == false
        if kb == nil
            r: tel.tel_send_message token cid text
        else
            r: tel.tel_send_message_kb token cid text kb
    r

--! Like tel_finalize, but for the specific case of a genuine gremium
--! answer that followed a LIVE TREE (make_swarm_updater): instead of
--! editing the tree message into the answer, it DELETES the tree message
--! (Telegram's native message-removal animation reads like the tree
--! getting shredded once the work is done) and sends the answer as a
--! fresh message — the finished tree isn't meant to linger, its content
--! stays available afterward via the "📜 Verlauf" button on the new
--! answer message (last_run_log:<cid>, see the "gremium_log" callback
--! branch). message_id may be nil (placeholder send failed, nothing to
--! delete) — then this is just a plain send, same as tel_finalize.
fn tel_finalize_after_tree token cid message_id text kb
    if message_id != nil
        tel.tel_delete_message token cid message_id
    if kb == nil
        tel.tel_send_message token cid text
    else
        tel.tel_send_message_kb token cid text kb

--! Checks whether an AI answer represents an "I don't know" fallback that
--! calls for a web research.
fn question_needs_research answer
    if answer == nil || answer == ""
        return true
    trimmed: trim answer
    --! If the answer ends with a question mark, it's very likely a
    --! legitimate clarifying question (HONESTY_RULE: for a too-vague/
    --! context-dependent request, prefer asking over guessing) — NOT a case
    --! for a blind web search using the unchanged user text as the search
    --! term. Observed live: "What would you suggest?" (referred to the
    --! ongoing conversation context) triggered exactly that and searched the
    --! web verbatim for "what would you suggest" — pure dictionary/
    --! conjugation hits, completely beside the point.
    if (len trimmed) > 0 && (substring trimmed ((len trimmed) - 1) (len trimmed)) == "?"
        return false
    --! Only treat it as "gave up" below for SHORT answers — a longer,
    --! substantial answer that contains one of these phrases only in passing
    --! as part of a real explanation (e.g. "there's no information on that,
    --! but X is known...") is not a failed answer and shouldn't be discarded.
    if (len trimmed) > 300
        return false
    low: lower answer
    if contains low "ich weiß es nicht"
        return true
    if contains low "ich weiss es nicht"
        return true
    if contains low "weis es nicht"
        return true
    if contains low "kein wissen"
        return true
    if contains low "kein wissen darüber"
        return true
    if contains low "keine informationen"
        return true
    if contains low "keine relevanten informationen"
        return true
    if contains low "keine ahnung"
        return true
    if contains low "ich kenne keine"
        return true
    if contains low "ich kann dir nicht sagen"
        return true
    if contains low "ich weiss nichts"
        return true
    if contains low "ich weiß nichts"
        return true
    if contains low "konnte keine"
        return true
    if contains low "echtzeitdaten"
        return true
    if contains low "echtzeitzugriff"
        return true
    if contains low "keine echtzeit"
        return true
    if contains low "als sprachmodell"
        return true
    if contains low "kein internetzugriff"
        return true
    if contains low "keinen zugriff auf das internet"
        return true
    if contains low "kann ich nicht abrufen"
        return true
    if contains low "aktuell nicht bekannt"
        return true
    false

--! Returns a direct overview of capabilities instead of a factual answer.
fn capability_text _
    "I can help you with:\n• Answering questions and researching the web on my own when I lack the knowledge\n• Storing information with sources in my soul and finding it again later\n• Planning tasks and executing them via the executor\n• Managing goals and time-based reminders\n• Building knowledge graphs and documents (incl. PDFs — text is extracted and learned automatically)\n• Understanding and describing photos (just send one, optionally with a caption as a question)\n• Generating images on request (free AI image generator)\n• Cloning and testing GitHub repos (isolated Docker container, runs in the background)\n• Understanding voice messages (local transcription, no API key)\n• Using connected MCP tools in a controlled way\n• Working through Telegram and the web dashboard\n\nJust write a question or a concrete task."

--! Truncates text to the Telegram limit (4096 characters).
fn shorten s
    if s == nil
        return ""
    if (len s) > 4000
        (substring s 0 4000) ++ "…"
    else
        s

--! Runs a web research and replies with sources + buttons.
fn do_search token cid dbh query
    tel.tel_send_chat_action token cid "typing"
    tid: mem.active_thread dbh cid
    mem.add_message dbh tid cid "user" ("/search " ++ query)
    rr: web.research query
    ctx: get rr "context"
    srcs: get rr "sources"
    if ctx == nil || ctx == ""
        fallback: "No usable results found."
        mem.add_message dbh tid cid "assistant" fallback
        tel.tel_send_message token cid fallback
        return nil
    answer: ""
    try
        answer: ai_chat ((grm.self_context 0) ++ "You are a precise research assistant. Answer the question based on the researched context, briefly and factually. IMPORTANT: this call here is pure text summarization WITHOUT tool access — NEVER claim that you generally can't create/send documents/files (you very much can, just not in THIS call); if the question mentions that, just say instead that you need to be asked directly for that (not as a research request).") ("Question: " ++ query ++ "\n\nContext:\n" ++ ctx)
    catch e5
        print ("do_search ai_chat failed: " ++ (to_str e5))
        mem.log_error dbh "do_search_ai_chat" (to_str e5)
        answer: ctx
    mem.add_message dbh tid cid "assistant" answer
    src_text: ""
    for u in srcs
        src_text: src_text ++ "\n" ++ u
    full: (shorten answer) ++ "\n— Sources:" ++ (shorten src_text)
    kb: []
    row: []
    push row (tel.tel_button "💾 Remember" "save")
    push kb row
    tel.tel_send_message_kb token cid (shorten full) kb
    nil

--! Detects a search intent and returns the search term (or "").
fn search_query low tnorm
    if (len low) >= 8
        if (substring low 0 8) == "/search "
            return (trim (substring tnorm 8 (len tnorm)))
    if (len low) >= 6
        if (substring low 0 6) == "suche "
            return (trim (substring tnorm 6 (len tnorm)))
    if (len low) >= 12
        if (substring low 0 12) == "recherchiere "
            return (trim (substring tnorm 12 (len tnorm)))
    if (len low) >= 6
        if (substring low 0 6) == "finde "
            return (trim (substring tnorm 6 (len tnorm)))
    ""

--! Detects a /graph request and returns the entity name (or "").
fn graph_query low tnorm
    if (len low) >= 7
        if (substring low 0 7) == "/graph "
            return (trim (substring tnorm 7 (len tnorm)))
    ""

--! Detects a /learn request and returns the URL (or "").
fn learn_query low tnorm
    if (len low) >= 7
        if (substring low 0 7) == "/learn "
            return (trim (substring tnorm 7 (len tnorm)))
    ""

--! Detects a /remind OR a freely worded "remind me..." request and
--! returns the reminder instruction (or ""). Deliberately deterministic
--! instead of routed through the gremium tool 'erinnerung_planen': it was
--! observed that the AI, given "Remind me in 30 seconds...", output a
--! confirmation WITHOUT actually calling the tool — no entry in the
--! 'scheduled' table despite an "I've scheduled the reminder" reply. For
--! such an expectation-setting promise, this can't rely on the LLM
--! following through on a tool call. 'erinnerung_planen' remains
--! responsible for implicit cases (e.g. "I have an appointment
--! tomorrow...") that don't match this pattern.
fn remind_query low tnorm
    if (len low) >= 8
        if (substring low 0 8) == "/remind "
            return (trim (substring tnorm 8 (len tnorm)))
    if contains low "erinnere mich"
        return tnorm
    ""

--! /settings menu: display text + inline keyboard, the current values sit
--! directly on the buttons (tapping rotates to the next value, see
--! handle_callback below "settings_*"). Both functions read the same four
--! chat settings (see setting_get/setting_cycle/setting_label in
--! memory.pipe) — on every change the message is rebuilt via
--! tel_edit_message_text_kb, so the button immediately shows the new value.
fn settings_menu_text dbh cid
    style: mem.setting_get dbh (to_str cid) "style" "normal"
    sprache: mem.setting_get dbh (to_str cid) "sprache" "de"
    proaktiv: mem.setting_get dbh (to_str cid) "proaktiv" "on"
    gedaechtnis: mem.setting_get dbh (to_str cid) "gedaechtnis" "normal"
    "⚙️ Settings\n\nStyle: " ++ (mem.setting_label "style" style) ++ "\nLanguage: " ++ (mem.setting_label "sprache" sprache) ++ "\nProactive messages: " ++ (mem.setting_label "proaktiv" proaktiv) ++ "\nMemory: " ++ (mem.setting_label "gedaechtnis" gedaechtnis) ++ "\n\nTap a value to change it."

fn settings_kb dbh cid
    style: mem.setting_get dbh (to_str cid) "style" "normal"
    sprache: mem.setting_get dbh (to_str cid) "sprache" "de"
    proaktiv: mem.setting_get dbh (to_str cid) "proaktiv" "on"
    gedaechtnis: mem.setting_get dbh (to_str cid) "gedaechtnis" "normal"
    kb: []
    r1: []
    push r1 (tel.tel_button ("Style: " ++ (mem.setting_label "style" style)) "settings_style")
    push kb r1
    r2: []
    push r2 (tel.tel_button ("Language: " ++ (mem.setting_label "sprache" sprache)) "settings_sprache")
    push kb r2
    r3: []
    push r3 (tel.tel_button ("Proactive: " ++ (mem.setting_label "proaktiv" proaktiv)) "settings_proaktiv")
    push kb r3
    r4: []
    push r4 (tel.tel_button ("Memory: " ++ (mem.setting_label "gedaechtnis" gedaechtnis)) "settings_gedaechtnis")
    push kb r4
    r5: []
    push r5 (tel.tel_button "Done" "settings_done")
    push kb r5
    kb

--! Processes an inline button press (callback_query).
fn handle_callback token dbh cbq allowed uid
    cbid: get cbq "id"
    data: get cbq "data"
    msg: get cbq "message"
    chat: get msg "chat"
    cid: get chat "id"
    message_id: get msg "message_id"
    txt: get msg "text"
    tel.tel_answer_callback token cbid ""
    if data == "save"
        if txt != nil
            mem.add_memory dbh (mem.condense_fact txt) "fact" 3 "telegram" "user"
            tel.tel_send_message token cid "Saved in the soul."
        return nil
    if data == "gremium_log"
        --! The full tree of agent groups behind the "📜 Verlauf" button —
        --! persisted once per run by make_swarm_updater's "final" handler
        --! (last_run_log:<cid>), so the live status itself can stay down to
        --! just 2 lines while the detail is one tap away.
        raw: mem.meta_get dbh ("last_run_log:" ++ (to_str cid))
        groups: nil
        if raw != nil && raw != ""
            try
                groups: parse_json raw
            catch
                groups: nil
        if groups == nil || (len groups) == 0
            tel.tel_send_message token cid "No detailed log available for the last run."
        else
            tel.tel_send_message token cid ("📜 **Full run log:**\n\n" ++ (render_groups groups))
        return nil
    if data == "more"
        if txt != nil
            tel.tel_send_chat_action token cid "typing"
            message_id: nil
            ph: tel.tel_send_message token cid "🧠 Digging deeper..."
            if (get ph "ok") == true
                message_id: get (get ph "result") "message_id"
            on_update: make_swarm_updater token cid message_id dbh
            round_check: make_round_check token cid allowed dbh uid
            setup_sandbox all_mcp_servers
            res: grm.run_gremium_stream dbh cid ((mem.settings_prompt_prefix dbh (to_str cid)) ++ "Please dig deeper into this: " ++ txt) on_update round_check
            if (get res "aborted") == true
                tel_finalize token cid message_id ("🛑 " ++ (get res "abort_reason")) nil
            else
                a: get res "content"
                save_trace dbh cid res
                kb: []
                row: []
                push row (tel.tel_button "📜 Verlauf" "gremium_log")
                push kb row
                if a != nil && a != ""
                    tid: mem.active_thread dbh cid
                    mem.add_message dbh tid cid "assistant" a
                    tel_finalize_after_tree token cid message_id (shorten a) kb
                else
                    tel_finalize_after_tree token cid message_id "Unfortunately I couldn't dig up anything more." kb
        return nil
    if data == "up"
        if txt != nil
            n: mem.adjust_by_content dbh txt 1
            if n == 0
                mem.add_memory dbh (mem.condense_fact txt) "fact" 3 "telegram" "feedback"
                tel.tel_send_message token cid "Thanks! I'll remember that."
            else
                tel.tel_send_message token cid "Thanks! Importance increased."
        return nil
    if data == "down"
        if txt != nil
            mem.adjust_by_content dbh txt (-1)
            tel.tel_send_message token cid "Noted — I'll lower its importance."
        return nil
    --! /goals: a tapped goal is removed from the inline keyboard in place
    --! (not just a plain confirmation) — an already-answered callback_query
    --! (see tel_answer_callback above) can't be answered a second time, so
    --! the visual feedback here has to be the message edit itself.
    if (len data) > 10 && (substring data 0 10) == "goal_done:"
        gid: to_num (substring data 10 (len data))
        if gid != nil
            mem.set_goal_status dbh gid "done"
        old_kb: get (get msg "reply_markup") "inline_keyboard"
        new_kb: []
        if old_kb != nil
            for row in old_kb
                keep_row: []
                for btn in row
                    if (get btn "callback_data") != data
                        push keep_row btn
                if (len keep_row) > 0
                    push new_kb keep_row
        if (len new_kb) == 0
            tel.tel_edit_message_text token cid message_id "All goals done! 🎉"
        else
            tel.tel_edit_message_text_kb token cid message_id "Open goals — tap one to mark it done:" new_kb
        return nil
    --! /settings menu (see settings_menu_text/settings_kb above): each
    --! button rotates its OWN setting to the next value (setting_cycle in
    --! memory.pipe) and rebuilds the menu directly in the same message
    --! (editMessageText instead of a new message) — feels like a real toggle,
    --! no growing message history per click.
    if data == "settings_style" || data == "settings_sprache" || data == "settings_proaktiv" || data == "settings_gedaechtnis"
        key: substring data 9 (len data)
        cid_str: to_str cid
        deflt: "normal"
        if key == "sprache"
            deflt: "de"
        else
            if key == "proaktiv"
                deflt: "on"
        cur: mem.setting_get dbh cid_str key deflt
        nxt: mem.setting_cycle key cur
        mem.setting_set dbh cid_str key nxt
        tel.tel_edit_message_text_kb token cid message_id (settings_menu_text dbh cid) (settings_kb dbh cid)
        return nil
    if data == "settings_done"
        tel.tel_delete_message token cid message_id
        return nil
    tel.tel_send_message token cid "Unknown action."

--! Splits BRIEFING_TIME ("HH:MM") into {hh, mm}. Default 08:00.
fn parse_briefing_time raw
    hh: 8
    mm: 0
    if raw != nil && raw != ""
        p: split raw ":"
        if (len p) >= 2
            hh: to_num (trim (at p 0))
            mm: to_num (trim (at p 1))
    out: {}
    set out "hh" hh
    set out "mm" mm
    out

--! Unix seconds of "tomorrow 00:00" in the configured timezone (for
--! "appointments until the end of today" in the briefing enrichment below
--! — same day-boundary logic as next_hhmm in scheduler.pipe).
fn day_end_sec now_sec offset_sec
    shifted: now_sec + offset_sec
    day_start: shifted - (shifted % 86400)
    (day_start + 86400) - offset_sec

--! Calls the Google Calendar MCP tool for appointments in the time
--! window. Returns the text formatted by the tool (no raw JSON
--! available) or nil on any error (Google not connected, token expired —
--! testing-mode refresh tokens expire after 7 days, see README). Purely
--! best-effort: a failed proactive calendar check must never disrupt the
--! scheduler tick or another message.
fn calendar_events_text email time_min_sec time_max_sec
    if email == nil || email == ""
        return nil
    t_min: format_time time_min_sec "2006-01-02T15:04:05Z"
    t_max: format_time time_max_sec "2006-01-02T15:04:05Z"
    try
        return (tool_call "google_get_events" {user_google_email: email, calendar_id: "primary", time_min: t_min, time_max: t_max})
    catch e
        return nil

--! Parses a get_events response into [{id, line}, ...]. No raw JSON
--! available (only formatted text: '- "Title" (Starts: ...) ID: <id> |
--! Link: ...' per line) — so it searches line by line for 'ID: '. Fragile
--! against format changes in the MCP server, but more practical than the
--! alternative (no structured result available).
fn parse_calendar_events text
    out: []
    if text == nil || text == ""
        return out
    lines: split text "\n"
    for line in lines
        idx: index_of line "ID: "
        if idx >= 0
            rest: substring line (idx + 4) (len line)
            endidx: index_of rest " | Link"
            id: rest
            if endidx >= 0
                id: substring rest 0 endidx
            push out {id: (trim id), line: line}
    out

--! Meta key for the dedup list of already-reported calendar events
--! (format: "<id>:<unix_ts>,<id>:<unix_ts>,..."). Title+start time could
--! also have worked as a dedup key, but get_events includes a real event
--! ID in the text — more reliable than free-text matching.
NOTIFIED_CAL_KEY: "notified_calendar_events"

--! Same idea, for already-checked Gmail message ids (see email_notify_new
--! below) — a message only ever needs to be judged for importance ONCE,
--! whether or not it turned out worth a notification.
NOTIFIED_MAIL_KEY: "notified_gmail_messages"

--! Loads a dedup list stored under meta key `key` (see NOTIFIED_CAL_KEY/
--! NOTIFIED_MAIL_KEY), removes entries older than 24h (so the list doesn't
--! grow unbounded for daily recurring events/frequent mail checks).
fn load_notified_ids dbh key
    raw: mem.meta_get dbh key
    out: {}
    if raw != nil && raw != ""
        cutoff: now - 86400
        for p in (split raw ",")
            kv: split p ":"
            if (len kv) == 2
                ts: to_num (at kv 1)
                if ts > cutoff
                    set out (at kv 0) ts
    out

fn save_notified_ids dbh key idmap
    parts: []
    for id in (keys idmap)
        push parts (id ++ ":" ++ (to_str (get idmap id)))
    mem.meta_set dbh key (join parts ",")

--! Proactive calendar reminder: checks upcoming appointments within the
--! configured lead window (calendar_reminder_minutes) and reports new (not
--! yet reported) appointments once via Telegram — dedup via
--! load_notified_ids/save_notified_ids prevents repeats on every
--! 15-minute tick.
fn calendar_notify_new token dbh cid email window_minutes
    text: calendar_events_text email now (now + window_minutes * 60)
    events: parse_calendar_events text
    if (len events) == 0
        return nil
    notified: load_notified_ids dbh NOTIFIED_CAL_KEY
    changed: false
    for ev in events
        id: get ev "id"
        if (get notified id) == nil
            try
                tel.tel_send_message token (to_num cid) ("📅 Coming up: " ++ (get ev "line"))
            catch e6
                --! Still gets marked as "notified" (no repeat) — so it's
                --! important to at least log a failed send instead of
                --! losing it silently.
                print ("Failed to send calendar reminder: " ++ (to_str e6))
                mem.log_error dbh "calendar_reminder_send" (to_str e6)
            set notified id now
            changed: true
    if changed
        save_notified_ids dbh NOTIFIED_CAL_KEY notified

--! Calls the Gmail search MCP tool for messages newer than the given
--! window and extracts their message ids (no raw JSON available, only the
--! formatted text the MCP tool returns — same tradeoff as
--! calendar_events_text/parse_calendar_events). Purely best-effort: a
--! failed proactive check must never disrupt the scheduler tick.
fn gmail_new_message_ids email window_minutes
    if email == nil || email == ""
        return []
    query: "newer_than:" ++ (to_str (window_minutes + 5)) ++ "m"
    text: nil
    try
        text: tool_call "google_search_gmail_messages" {user_google_email: email, query: query, page_size: 15}
    catch e10
        return []
    if text == nil
        return []
    --! Searches for "Message ID: " ANYWHERE in the line, not as a prefix:
    --! the tool's actual output nests it ("  1. Message ID: <id>"), and
    --! also has "Thread ID: " lines right below it that a naive prefix
    --! check could confuse — index_of matches only the exact substring, so
    --! it can't accidentally hit those. Same approach as
    --! parse_calendar_events above for "ID: ".
    ids: []
    for line in (split text "\n")
        idx: index_of line "Message ID: "
        if idx >= 0
            push ids (trim (substring line (idx + 12) (len line)))
    ids

--! Proactive new-mail check: finds genuinely new messages (dedup via
--! load_notified_ids/save_notified_ids, same mechanism as
--! calendar_notify_new) and, if there are any, lets the AI judge whether
--! ANY of them are important enough to interrupt the user about — most new
--! mail is newsletters/marketing/notifications (live-checked against a
--! real inbox: even the most recent messages were mostly promotional), so
--! unconditionally notifying on every new message would just be noise.
--! Every new message gets marked as checked regardless of the verdict, so
--! it's never re-judged on the next tick.
fn email_notify_new token dbh cid email
    ids: gmail_new_message_ids email 65
    if (len ids) == 0
        return nil
    notified: load_notified_ids dbh NOTIFIED_MAIL_KEY
    new_ids: []
    for id in ids
        if (get notified id) == nil
            push new_ids id
    if (len new_ids) == 0
        return nil
    try
        content: tool_call "google_get_gmail_messages_content_batch" {user_google_email: email, message_ids: new_ids}
        if content != nil && content != ""
            verdict: ai_chat "You screen new emails for a personal assistant. Given the raw content of one or more new emails, decide: is ANY of them important or time-sensitive enough that the user should be interrupted about it right now (e.g. from a real person, needs a timely reply/action)? Newsletters, marketing, automated notifications, and routine confirmations are NOT important. If none of them are important, respond with EXACTLY the single word NOTHING and nothing else. Otherwise write a short, concrete notification (1-2 sentences per relevant email: sender, subject, what it's about) for ONLY the important one(s) — ignore the unimportant ones entirely." content
            if verdict != nil && (lower (trim verdict)) != "nothing" && (trim verdict) != ""
                tel.tel_send_message token (to_num cid) ("📬 " ++ (trim verdict))
    catch e11
        print ("Email importance check failed: " ++ (to_str e11))
        mem.log_error dbh "email_check_judge" (to_str e11)
    for id in new_ids
        set notified id now
    save_notified_ids dbh NOTIFIED_MAIL_KEY notified

--! Scheduler tick (P4): proactively fires due reminders/briefings — runs
--! in the bot loop after every poll, single-threaded (no goroutine/DB
--! conflict, see Plan.md). Briefings are only assembled from the soul at
--! fire time (always current, never a stale snapshot).
fn sched_tick token
    hl: mem.open_locked nil
    dbh: get hl "h"
    now_sec: now
    due: sched.due dbh now_sec
    for item in due
        kind: get item "kind"
        cid: get item "chat_id"
        msg: get item "note"
        if kind == "briefing"
            msg: sched.compose_briefing dbh
            if mcp.is_connected "google" && user_google_email != nil && user_google_email != ""
                evt: calendar_events_text user_google_email now_sec (day_end_sec now_sec tz_offset)
                if (len (parse_calendar_events evt)) > 0
                    msg: msg ++ "\n\n📅 Today's appointments:\n" ++ evt
        if kind == "calendar_check"
            if mem.setting_proaktiv_enabled dbh (to_str cid)
                calendar_notify_new token dbh cid user_google_email calendar_reminder_minutes
            sched.mark_fired dbh (get item "id") (get item "repeat") (get item "due_ts")
            continue
        if kind == "email_check"
            if mem.setting_proaktiv_enabled dbh (to_str cid)
                try
                    email_notify_new token dbh cid user_google_email
                catch e12
                    print ("email_check failed: " ++ (to_str e12))
                    mem.log_error dbh "email_check" (to_str e12)
            sched.mark_fired dbh (get item "id") (get item "repeat") (get item "due_ts")
            continue
        if kind == "goal_tick"
            resumed: exe.resume_running_plans dbh
            if resumed > 0
                tel.tel_send_message token (to_num cid) ("Progress: " ++ (to_str resumed) ++ " interrupted plans resumed.")
            sched.mark_fired dbh (get item "id") (get item "repeat") (get item "due_ts")
            continue
        if kind == "job_check"
            --! The note field carries the docker_jobs row ID (see
            --! grm.tool_docker_hintergrund_setup). A fresh tool/exec budget
            --! is needed BEFORE the first exec() call (refresh_job_status
            --! itself calls exec() — docker inspect/logs — see the
            --! setup_sandbox comment at handle_voice; this run starts
            --! outside the normal message flow, so it doesn't yet have a
            --! current sandbox profile for THIS request).
            setup_sandbox all_mcp_servers
            --! refresh_job_status checks the REAL Docker container state
            --! (docker inspect/logs) and only updates docker_jobs to
            --! 'done'/'failed' here — 'docker run -d' only returns the
            --! START, see the comment in docker_tools.pipe. If the container
            --! is still running, simply reschedule — NO Telegram spam on
            --! every tick, Muninn only checks in once it's actually finished.
            job: dt.refresh_job_status dbh (to_num (get item "note"))
            still_running: job != nil && (get job "status") == "running"
            if still_running
                sched.mark_fired dbh (get item "id") "5min" (get item "due_ts")
                continue
            --! Explicitly cancelled by the user (/stop or
            --! 'docker_jobs_abbrechen', see docker_tools.pipe cancel_job) —
            --! end cleanly and SILENTLY, no message, no follow-up question.
            --! This exact gap was missing before: without 'cancelled' as its
            --! own end state, a cancelled job ended up here as "container no
            --! longer found" and was reported as a failure, complete with a
            --! suggestion to retry — despite the user's explicit
            --! cancellation.
            if job != nil && (get job "status") == "cancelled"
                sched.cancel dbh (get item "id")
                continue
            beschreibung: "unknown"
            ergebnis: "Job not found."
            if job != nil
                beschreibung: get job "description"
                ergebnis: (get job "status") ++ ": " ++ (to_str (get job "result"))
            continuation: (mem.settings_prompt_prefix dbh (to_str cid)) ++ "A previously background-started Docker setup has finished. Description: " ++ beschreibung ++ ". Result (incl. container logs/test output, if available): " ++ ergebnis ++ ". Report to the user briefly and cleanly formatted what happened — for test runs: how many tests ran, passed/failed, the most important error message if failed. If the original task still needs a next step, initiate it directly (e.g. calling 'docker_hintergrund_setup' again)."
            res: grm.run_gremium dbh (to_num cid) continuation
            tel.tel_send_message token (to_num cid) (get res "content")
            sched.cancel dbh (get item "id")
            continue
        if kind == "task_check"
            --! Generic continuation (see grm.tool_hintergrund_fortsetzen) —
            --! unlike job_check above, there is NO cheap external status
            --! check here: the gremium simply gets a fresh round budget and
            --! continues working with the saved progress. If it's done NOW,
            --! it answers normally; if it's not done yet, it calls
            --! 'hintergrund_fortsetzen' again itself (which creates a NEW
            --! checkpoint + new scheduler entry) — THIS entry here is
            --! closed out in any case, the chain continues via the new entry.
            t: sched.get_background_task dbh (to_num (get item "note"))
            if t == nil
                sched.cancel dbh (get item "id")
                continue
            setup_sandbox all_mcp_servers
            continuation2: (mem.settings_prompt_prefix dbh (to_str cid)) ++ "You're continuing work on a previously deferred task. Original task: " ++ (get t "task") ++ ". Progress so far: " ++ (get t "progress") ++ ". Continue the work. If you're done NOW, clearly communicate the final result to the user. If you're NOT done yet, call 'hintergrund_fortsetzen' again with the updated progress."
            res2: grm.run_gremium dbh (to_num cid) continuation2
            tel.tel_send_message token (to_num cid) (get res2 "content")
            sched.cancel dbh (get item "id")
            continue
        if kind == "proaktiv"
            --! Proactive self-initiative (P4): Muninn was NOT addressed —
            --! the gremium decides for itself whether a message is
            --! worthwhile. Silence is a fully valid outcome here ("NOTHING"),
            --! otherwise the daily tick would spam the user with empty
            --! messages. Can be turned off via /settings ("Proactive
            --! messages") — the scheduler entry itself keeps running
            --! regardless (the next day gets rescheduled normally), only the
            --! actual gremium run + send is skipped while the setting is off.
            if mem.setting_proaktiv_enabled dbh (to_str cid)
                setup_sandbox all_mcp_servers
                prompt_proaktiv: "PROACTIVE IMPULSE (you were NOT addressed — decide for yourself whether a message to the user is worthwhile): use 'erinnerungen_suchen' to look into your memory: are there open/started tasks, interrupted work, upcoming appointments, or important developments on topics that matter to the user — something the user themselves would bring up? If there's something IMPORTANT: write the short, concrete message to the user; if you find a task you should revisit at a specific time, plan that yourself with 'erinnerung_planen' or 'hintergrund_fortsetzen'. If there's NOTHING worth mentioning: reply ONLY with the single word NOTHING, with no other characters."
                res_proaktiv: grm.run_gremium dbh (to_num cid) prompt_proaktiv
                content_proaktiv: get res_proaktiv "content"
                if content_proaktiv != nil && (lower (trim content_proaktiv)) != "nothing" && (trim content_proaktiv) != ""
                    tel.tel_send_message token (to_num cid) (shorten (trim content_proaktiv))
            sched.mark_fired dbh (get item "id") (get item "repeat") (get item "due_ts")
            continue
        if kind == "selbstdiagnose"
            --! Self-diagnosis: once a day, Muninn evaluates its own
            --! structured error log from the last 3 days (see
            --! mem.error_summary/log_error) and only speaks up if an error
            --! occurred repeatedly (>= 3x) — a single blip (e.g. a briefly
            --! unreachable MCP) is normal and not worth reporting, otherwise
            --! silence just like the self-initiative. Also toggleable via
            --! /settings ("Proactive messages").
            if mem.setting_proaktiv_enabled dbh (to_str cid)
                summary: mem.error_summary dbh 3
                auffaellig: []
                for row in summary
                    if (get row "cnt") >= 3
                        push auffaellig row
                if (len auffaellig) > 0
                    diag_msg: "⚠️ Self-diagnosis: these errors occurred repeatedly over the last 3 days, might be worth a look:\n"
                    for row in auffaellig
                        diag_msg: diag_msg ++ "• " ++ (get row "tag") ++ " (" ++ (to_str (get row "cnt")) ++ "x, last at " ++ (get row "last_ts") ++ ")\n"
                    tel.tel_send_message token (to_num cid) (shorten diag_msg)
            sched.mark_fired dbh (get item "id") (get item "repeat") (get item "due_ts")
            continue
        if cid != nil && cid != ""
            try
                tel.tel_send_message token (to_num cid) msg
            catch e7
                --! Still gets marked "done"/rescheduled (no retry) — so it's
                --! important to at least log a failed send instead of
                --! losing it silently.
                print ("Failed to send scheduler message (" ++ kind ++ "): " ++ (to_str e7))
                mem.log_error dbh ("scheduler_message_send:" ++ kind) (to_str e7)
        sched.mark_fired dbh (get item "id") (get item "repeat") (get item "due_ts")
    mem.close_locked hl
    nil

--! One polling cycle. Returns the last processed update_id. The DB lock
--! (mem.open_locked/close_locked) is deliberately NOT held around the
--! entire cycle, only around the actual DB accesses: tel_get_updates
--! waits via long-polling for up to `timeout` seconds for new messages —
--! if the lock were held the whole time, the web dashboard could almost
--! never reach the DB in the meantime. This way every channel only holds
--! the lock while it's actually processing something (see Plan.md on
--! concurrency). timeout (seconds) is dynamically capped by the P4
--! scheduler to "time until the next due task".
fn poll_once token offset allowed timeout
    hl: mem.open_locked nil
    dbh: get hl "h"
    if offset == nil
        saved: mem.meta_get dbh "telegram_offset"
        if saved != ""
            offset: to_num saved
    mem.close_locked hl
    updates: []
    try
        updates: tel.tel_get_updates token offset timeout
    catch e8
        --! Core piece of the poll loop — if this fails persistently (e.g.
        --! invalid token, Telegram unreachable), Muninn would otherwise
        --! stop receiving ANY messages with no clue why.
        print ("tel_get_updates failed: " ++ (to_str e8))
        updates: []
    hl2: mem.open_locked nil
    dbh2: get hl2 "h"
    for upd in updates
        uid: get upd "update_id"
        if uid != nil
            offset: uid + 1
        msg: get upd "message"
        if msg != nil
            chat: get msg "chat"
            if chat != nil
                cid: get chat "id"
                if (is_allowed cid allowed) && !(mem.was_injected dbh2 uid)
                    --! was_injected: a message a round_check already fed into
                    --! a swarm run as a steering interjection (see
                    --! make_round_check) must never ALSO be dispatched here as
                    --! a fresh, independent message — the peek that consumed
                    --! it never advances the real offset (deliberately
                    --! non-destructive), so without this check it would
                    --! surface again right here and start a second,
                    --! unintended gremium run for the same text.
                    try
                        handle_update token cid msg dbh2 allowed uid
                    catch e9
                        --! Catches ANY unexpected error from the ENTIRE message
                        --! processing (photo/voice/document/gremium/...) —
                        --! without this log, a real crash somewhere in there
                        --! looked identical to "Muninn just isn't responding",
                        --! with no clue where.
                        print ("handle_update failed: " ++ (to_str e9))
                        mem.log_error dbh2 "handle_update" (to_str e9)
        cq: get upd "callback_query"
        if cq != nil
            chat2: get (get cq "message") "chat"
            if chat2 != nil
                cid2: get chat2 "id"
                if is_allowed cid2 allowed
                    try
                        handle_callback token dbh2 cq allowed uid
                    catch e10
                        print ("handle_callback failed: " ++ (to_str e10))
                        mem.log_error dbh2 "handle_callback" (to_str e10)
    if offset != nil
        mem.meta_set dbh2 "telegram_offset" (to_str offset)
    mem.close_locked hl2
    offset

--! Shared, mutable cost state for maybe_log_cost (see the comment there
--! on Pipe's scoping rules — simply rebinding top-level variables does
--! NOT persist across function boundaries, a map does).
COST_STATE: {session_id: nil, last_calls: -1}

--! Sandbox + AI + MCP + gremium in one go, shared between Telegram and
--! web mode. Assumes secrets/config have already been read (before the
--! sandbox!) — see the comments at setup_ai/setup_sandbox.
fn setup_core mcp_servers deepseek_key
    setup_sandbox all_mcp_servers
    setup_ai deepseek_key
    mcp_results: mcp.connect_servers all_mcp_servers
    --! DB handle moved earlier (previously only opened after the connect
    --! loop, for session_id), so that an MCP server that fails on EVERY
    --! restart (e.g. an expired Google token) also ends up in the
    --! error_log — not just in the journal — and so shows up via
    --! self-diagnosis (sched_tick "selbstdiagnose") instead of only by
    --! chance during a journalctl glance.
    hl: mem.open_locked nil
    dbh0: get hl "h"
    for r in mcp_results
        if get r "ok"
            print ("MCP connected: " ++ (get r "alias"))
        else
            print ("MCP failed (" ++ (get r "alias") ++ "): " ++ (get r "error"))
            mem.log_error dbh0 ("mcp_connect_startup:" ++ (get r "alias")) (get r "error")
    --! MUST be set before init_gremium: the Google specialist builds its
    --! system prompt (incl. the configured email) only ONCE at startup,
    --! setting it later would have no effect.
    grm.set_google_email user_google_email
    grm.init_gremium 0
    grm.set_tz_offset tz_offset
    set COST_STATE "session_id" (mem.next_session_id dbh0)
    mem.close_locked hl
    nil

--! Writes a cost snapshot if something has changed since the last call
--! (ai_cost/ai_tokens are in-process counters over the ENTIRE runtime — a
--! log per empty poll cycle would be pure table bloat with no new
--! information).
fn maybe_log_cost _
    c: {}
    try
        c: ai_cost
    catch
        return nil
    calls: get c "calls"
    if calls == nil || calls == (get COST_STATE "last_calls")
        return nil
    tk: 0
    try
        tk: ai_tokens
    catch
        tk: 0
    hl: mem.open_locked nil
    mem.log_cost (get hl "h") (get COST_STATE "session_id") (get c "cost_usd") tk calls (get c "cache_hits") (get c "cache_misses")
    mem.close_locked hl
    set COST_STATE "last_calls" calls
    nil

--! Read CLI arguments.
avgs: args
once_mode: false
consolidate_mode: false
web_mode: false
if (len avgs) > 0
    if (at avgs 0) == "once"
        once_mode: true
    if (at avgs 0) == "consolidate"
        consolidate_mode: true
    if (at avgs 0) == "web"
        web_mode: true

--! All secrets/config values are read BEFORE sandbox activation (see
--! setup_ai/setup_sandbox): collected once by trusted startup code, then
--! only ever passed along as a value — never queried again via env().
cfg: load_env ".env"
configured_provider: lower (trim (cfg_get cfg "MUNINN_PROVIDER"))
if configured_provider != nil && configured_provider != "" && configured_provider != "deepseek"
    print ("Muninn only uses DeepSeek; MUNINN_PROVIDER='" ++ configured_provider ++ "' is ignored.")
deepseek_key: cfg_get cfg "DEEPSEEK_API_KEY"
if deepseek_key == nil || deepseek_key == ""
    print "WARNING: DEEPSEEK_API_KEY is missing — Muninn only uses DeepSeek and cannot generate AI responses."
dash_bind: cfg_get cfg "DASHBOARD_BIND"
dash_token: cfg_get cfg "DASHBOARD_TOKEN"
briefing_time: cfg_get cfg "BRIEFING_TIME"
tz_offset_raw: cfg_get cfg "MUNINN_TZ_OFFSET"
tz_offset: 0
if tz_offset_raw != nil && tz_offset_raw != ""
    tz_offset: to_num tz_offset_raw
--! For proactive calendar reminders (see calendar_notify_new/sched_tick
--! below). No separate .env key needed/no duplication — the address is
--! already in the "google" entry of MCP_AUTO_SERVERS (see .env.example),
--! taken directly from there (single source of truth).
calendar_reminder_minutes_raw: cfg_get cfg "CALENDAR_REMINDER_MINUTES"
calendar_reminder_minutes: 30
if calendar_reminder_minutes_raw != nil && calendar_reminder_minutes_raw != ""
    calendar_reminder_minutes: to_num calendar_reminder_minutes_raw
mcp_servers: mcp.parse_mcp_config (cfg_get cfg "MCP_SERVERS")
mcp_servers: mcp.resolve_all_env mcp_servers
mcp_auto_servers: mcp.parse_mcp_config (cfg_get cfg "MCP_AUTO_SERVERS")
mcp_auto_servers: mcp.resolve_all_env mcp_auto_servers
all_mcp_servers: []
for configured_server in mcp_servers
    push all_mcp_servers configured_server
for auto_server in mcp_auto_servers
    push all_mcp_servers auto_server
user_google_email: nil
for s in all_mcp_servers
    if (get s "alias") == "google"
        genv: get s "env"
        if genv != nil
            user_google_email: get genv "USER_GOOGLE_EMAIL"

--! consolidate mode (P2, "dream"): a one-off cleanup/condensing run, e.g.
--! via an external cron: `pipe muninn.pipe consolidate`. No scheduler in
--! Pipe itself before P4 — hence deliberately its own CLI mode instead of
--! a persistent loop. Needs no Telegram/MCP, only optionally AI for the
--! thread summary (fallback without AI: the first 800 characters of the
--! history, see consolidate_threads).
if consolidate_mode
    sandbox_profile "consolidate" {fs: "full", network: false, exec: false, ai: true, audit_log: true}
    set_sandbox "consolidate"
    setup_ai deepseek_key
    hl: mem.open_locked nil
    res: mem.consolidate (get hl "h") 14 30
    print ("Consolidation: " ++ (to_str (get res "threads_summarized")) ++ " threads condensed, " ++ (to_str (get res "memories_decayed")) ++ " memories decayed, " ++ (to_str (get res "memories_forgotten")) ++ " forgotten.")
    mem.close_locked hl
else
    if web_mode
        --! web mode (P3): dashboard instead of the Telegram loop.
        --! DASHBOARD_BIND (default: localhost only — deliberately not
        --! "0.0.0.0", see the dashboard.pipe comment on security) and
        --! optionally DASHBOARD_TOKEN from .env.
        setup_core mcp_servers deepseek_key
        bind: dash_bind
        if bind == nil || bind == ""
            bind: "127.0.0.1:8787"
        dash.start bind dash_token grm.run_gremium
    else
        tok: cfg_get cfg "TELEGRAM_BOT_TOKEN"
        allowed: cfg_get cfg "TELEGRAM_ALLOWED_CHAT_ID"
        setup_core mcp_servers deepseek_key
        --! Fuer das Gremiums-Werkzeug bild_senden/datei_senden (siehe swarm.pipe)
        --! — braucht den Bot-Token, um selbst an Telegram senden zu koennen.
        grm.set_token tok
        if tok == nil || tok == ""
            print "TELEGRAM_BOT_TOKEN is missing (env or .env). Aborting."
        else
            print "Muninn started."
            --! Proactive calendar reminders (see calendar_notify_new above):
            --! automatically active once Google is connected AND a fixed
            --! TELEGRAM_ALLOWED_CHAT_ID is configured — without a configured
            --! recipient there would be no clear target address for an
            --! unsolicited message, so deliberately no guessing. Idempotent:
            --! only registers if no "calendar_check" exists yet for this
            --! chat (otherwise duplicate scheduler entries would pile up on
            --! every restart).
            if mcp.is_connected "google" && allowed != nil && allowed != ""
                hlc: mem.open_locked nil
                dbhc: get hlc "h"
                has_check: false
                for e in (sched.list dbhc allowed)
                    if (get e "kind") == "calendar_check"
                        has_check: true
                if !has_check
                    sched.schedule dbhc "calendar_check" allowed "" (now + 60) "15min"
                    print "Proactive calendar reminders activated."
                mem.close_locked hlc
            --! Proactive new-mail check (see email_notify_new above): same
            --! idempotent registration pattern as calendar_check, just
            --! hourly instead of every 15min (a lightweight importance
            --! judgment runs per new message, no need to check as often as
            --! upcoming-appointment reminders).
            if mcp.is_connected "google" && allowed != nil && allowed != ""
                hle: mem.open_locked nil
                dbhe: get hle "h"
                has_email_check: false
                for e in (sched.list dbhe allowed)
                    if (get e "kind") == "email_check"
                        has_email_check: true
                if !has_email_check
                    sched.schedule dbhe "email_check" allowed "" (now + 120) "hourly"
                    print "Proactive email checks activated."
                mem.close_locked hle
            --! Daily proactive self-initiative (see sched_tick, kind
            --! "proaktiv"): once a day, Muninn looks into its memory on its
            --! own (open tasks, started work, topics) and only speaks up if
            --! there's something important — otherwise silence. Needs a
            --! fixed TELEGRAM_ALLOWED_CHAT_ID as the target address (like
            --! calendar_check above). Idempotent: only ONE "proaktiv" entry
            --! per chat, otherwise duplicate ticks would pile up on every
            --! restart.
            if allowed != nil && allowed != ""
                hlp: mem.open_locked nil
                dbhp: get hlp "h"
                has_proaktiv: false
                for e in (sched.list dbhp allowed)
                    if (get e "kind") == "proaktiv"
                        has_proaktiv: true
                if !has_proaktiv
                    proaktiv_due: sched.next_hhmm 12 0 now tz_offset
                    sched.schedule dbhp "proaktiv" allowed "" proaktiv_due "daily"
                    print "Daily proactive self-initiative activated."
                mem.close_locked hlp
            --! Daily self-diagnosis (see sched_tick, kind "selbstdiagnose"):
            --! once a day, Muninn checks its own structured error log
            --! (mem.error_summary, see the log_error call sites throughout
            --! the code) for repeated errors and only speaks up if something
            --! is above the threshold — otherwise silence (like the
            --! self-initiative). A different time than the briefing (08:00)
            --! and self-initiative (12:00), so proactive messages don't
            --! cluster. Idempotent like the two entries above.
            if allowed != nil && allowed != ""
                hld: mem.open_locked nil
                dbhd: get hld "h"
                has_diag: false
                for e in (sched.list dbhd allowed)
                    if (get e "kind") == "selbstdiagnose"
                        has_diag: true
                if !has_diag
                    diag_due: sched.next_hhmm 9 0 now tz_offset
                    sched.schedule dbhd "selbstdiagnose" allowed "" diag_due "daily"
                    print "Daily self-diagnosis activated."
                mem.close_locked hld
            try
                cmds: []
                push cmds {command: "start", description: "Greeting"}
                push cmds {command: "help", description: "Show all commands"}
                push cmds {command: "status", description: "Muninn's status"}
                push cmds {command: "costs", description: "AI running-cost summary"}
                push cmds {command: "list", description: "Most important memories"}
                push cmds {command: "search", description: "Search the web"}
                push cmds {command: "learn", description: "Learn a document/URL"}
                push cmds {command: "graph", description: "Query the knowledge graph"}
                push cmds {command: "remind", description: "Schedule a reminder"}
                push cmds {command: "reminders", description: "Open reminders/briefings"}
                push cmds {command: "briefing", description: "Daily briefing on/off"}
                push cmds {command: "reset", description: "Reset conversation history"}
                push cmds {command: "consolidate", description: "Dream: condense memory"}
                push cmds {command: "settings", description: "Configure style, language, proactivity, memory"}
                push cmds {command: "stop", description: "Cancel all background jobs immediately"}
                tel.tel_set_my_commands tok cmds
            catch
                nil
            off: nil
            if once_mode
                print "once mode: one cycle"
                off: poll_once tok off allowed 25
                print "once cycle done."
            else
                while true
                    try
                        timeout: 25
                        hl0: mem.open_locked nil
                        dbh0: get hl0 "h"
                        nxt: sched.next_due_ms dbh0 (now)
                        mem.close_locked hl0
                        if nxt != nil && nxt < 25000
                            timeout: nxt / 1000
                            if timeout < 1
                                timeout: 1
                        off: poll_once tok off allowed timeout
                        sched_tick tok
                        maybe_log_cost 0
                    catch e
                        print ("Cycle error — retrying: " ++ (to_str e))
                    --! systemd watchdog heartbeat: deliberately OUTSIDE the
                    --! try/catch above, so that even a caught cycle error
                    --! still counts as "still alive, still iterating" — only
                    --! a genuine hang (no code running at all anymore, see
                    --! the comment at WatchdogSec in muninn.service) makes
                    --! this call not happen. try/catch here: best-effort, no
                    --! NOTIFY_SOCKET set (e.g. a manual test run outside
                    --! systemd) must not stop the main loop.
                    try
                        exec "systemd-notify WATCHDOG=1"
                    catch
                        nil
