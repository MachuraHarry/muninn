--! muninn.pipe — Einstiegspunkt: Muninn, der Langzeit-KI-Agent.
--! Telegram-Bot (Long-Polling) + persistente sqlite-"Seele".
--! Aufruf:  pipe muninn.pipe             (Produktions-Loop, Telegram)
--!          pipe muninn.pipe once        (ein Polling-Zyklus, dann exit — zum Testen)
--!          pipe muninn.pipe consolidate (Konsolidierung, z.B. per Cron)
--!          pipe muninn.pipe web         (Web-Dashboard, siehe DASHBOARD_BIND/-TOKEN in .env)
import "modules/telegram.pipe" as tel
import "modules/memory.pipe" as mem
import "modules/swarm.pipe" as grm
import "modules/executor.pipe" as exe
import "modules/web.pipe" as web
import "modules/mcp.pipe" as mcp
import "modules/dashboard.pipe" as dash
import "modules/scheduler.pipe" as sched

--! Lädt KEY=VALUE-Zeilen aus einer .env-Datei in eine Map.
--! Werte werden am ERSTEN "=" getrennt (nicht bei jedem), damit Werte, die selbst
--! "=" enthalten (z.B. MCP_SERVERS-JSON mit URL-Query-Strings), nicht abgeschnitten werden.
fn load_env path
    env_map: {}
    if file_exists path
        lines: split (read_file path) "\n"
        for line in lines
            ln: trim line
            if (len ln) > 0
                if (at ln 0) != "#"
                    kv: split ln "="
                    if (len kv) >= 2
                        key: trim (at kv 0)
                        val: join (slice kv 1 (len kv)) "="
                        set env_map key (trim val)
    env_map

--! Wert-Lookup: zuerst echte Umgebungsvariable, dann .env.
fn cfg_get cfg key
    v: env key
    if v != nil && v != ""
        return v
    get cfg key

--! Richtet den AI-Provider ein (DeepSeek; KI-Klassifikation, Kondensation, Embeddings).
--! Nimmt den Key direkt entgegen (nicht cfg+cfg_get): sobald die Sandbox aktiv ist,
--! blockiert `env()` sicherheitshalber jeden Namen, der wie ein Secret aussieht
--! (*KEY*/*TOKEN*/*SECRET*) — DEEPSEEK_API_KEY muss also VOR set_sandbox gelesen sein.
fn setup_ai key
    ai_provider "deepseek" {thinking: false}
    if key != nil && key != ""
        ai_set_key "deepseek" key
    ai_model "deepseek-chat"

--! Aktiviert Muninns Sandbox-Profil (P1: Tool-Sandboxing). fs bleibt "full", da
--! die reine-Pipe-sqlite-Persistenz (muninn.db) Dateizugriff braucht; exec ist
--! nur erlaubt, wenn MCP-Server konfiguriert sind, und dann ausschliesslich auf
--! deren Kommandos beschraenkt (Lehre der Sandbox-Audit-Reihe: nie unbeschraenkter
--! exec an die KI). network bleibt offen, da Web-Recherche beliebige Treffer-URLs
--! abruft; eine feste Whitelist wuerde die Recherche brechen.
fn setup_sandbox servers
    wl: mcp.exec_whitelist_for servers
    allow_exec: (len wl) > 0
    sandbox_profile "muninn" {fs: "full", network: true, exec: allow_exec, exec_whitelist: wl, ai: true, max_tool_calls: 40, audit_log: true}
    set_sandbox "muninn"
    nil

--! Prüft, ob eine Chat-ID bedient werden darf (leere Whitelist = alle erlauben).
fn is_allowed cid allowed
    if allowed == nil || allowed == ""
        return true
    allow_list: split allowed ","
    for a in allow_list
        if (trim a) == (to_str cid)
            return true
    false

--! Begrüßungstext.
fn greeting_text _
    "Muninn ist online.\n\nDu kannst mir etwas sagen, das ich mir merken soll (z.B. \"Merke dir, dass ich Tee mag\"), mir eine Aufgabe geben (z.B. \"Erledige das Reporting\"), eine Frage stellen oder im Web suchen (z.B. \"/search Odin nordische Mythologie\").\n\n/help für alle Befehle."

--! Hilfetext.
fn help_text _
    "/start      — Begrüßung\n/help       — diese Hilfe\n/status     — Zustand von Muninn\n/list       — deine wichtigsten Erinnerungen\n/search     — im Web suchen (z.B. /search Huginn und Muninn)\n/learn      — Dokument lernen (z.B. /learn https://... oder eine .txt/.md-Datei schicken)\n/graph      — Wissensgraph abfragen (z.B. /graph Harry)\n/remind     — Erinnerung planen (z.B. /remind in 10 Minuten an die Pause)\n/reminders  — offene Erinnerungen/Briefings anzeigen\n/briefing   — tägliches Morgen-Briefing aktivieren (/briefing stop zum Abbestellen)\n/reset      — Gesprächsverlauf zurücksetzen (frischer Kontext für Folgefragen)\n/consolidate — Traum: alte Gespräche verdichten, Erinnerungen altern/vergessen lassen"

--! Status-Text (Statistiken aus der Seele).
fn status_text dbh
    n: mem.memory_count dbh
    tool_n: len (mcp_tools)
    gc: mem.graph_counts dbh
    "Muninn-Status:\n• Erinnerungen: " ++ (to_str n) ++ "\n• Wissensgraph: " ++ (to_str (get gc "entities")) ++ " Entitäten, " ++ (to_str (get gc "relations")) ++ " Relationen\n• Provider: DeepSeek\n• Gremium: 4-5 Agenten (mit Web-Recherche + MCP-Werkzeugen)\n• Werkzeuge gesamt (lokal + MCP): " ++ (to_str tool_n) ++ "\n• Executor: aktiv\n• Web: DDG + Wikipedia"

--! Liste der wichtigsten Erinnerungen.
fn list_text dbh
    rows: mem.top_memories dbh 10
    if (len rows) == 0
        return "Noch keine Erinnerungen gespeichert."
    out: "Deine wichtigsten Erinnerungen:\n"
    for r in rows
        out: out ++ "• " ++ (get r "content") ++ "\n"
    out

--! Verarbeitet ein eingehendes Update (extrahiert Text, behandelt Nicht-Text).
fn handle_update token cid msg dbh
    txt: get msg "text"
    if txt == nil
        doc: get msg "document"
        if doc != nil
            handle_document token cid dbh doc
            return nil
        if (get msg "photo") != nil
            tel.tel_send_message token cid "Ich kann aktuell nur Text verarbeiten, keine Fotos."
            return nil
        if (get msg "sticker") != nil
            tel.tel_send_message token cid "Netter Sticker — ich verstehe aber nur Text."
            return nil
        if (get msg "voice") != nil
            tel.tel_send_message token cid "Sprachnachrichten verstehe ich noch nicht. Bitte tippe es."
            return nil
        return nil
    handle_message token cid txt dbh

--! Prüft anhand Dateiname/Mime-Type, ob ein Dokument reiner Text ist (.txt/.md
--! oder mime "text/..."). PDFs/Binärformate liefern hier false.
fn is_text_doc fname mime
    if mime != nil
        if contains mime "text/"
            return true
    low: lower fname
    if contains low ".txt"
        return true
    if contains low ".md"
        return true
    if contains low ".markdown"
        return true
    false

--! Verarbeitet ein hochgeladenes Dokument (Telegram "document"-Nachricht, P2).
--! Nur reiner Text wird unterstützt — siehe ingest_document-Kommentar in
--! memory.pipe zur bewussten PDF-Einschränkung.
fn handle_document token cid dbh doc
    fname: get doc "file_name"
    if fname == nil
        fname: "Dokument"
    mime: get doc "mime_type"
    if !(is_text_doc fname mime)
        tel.tel_send_message token cid ("'" ++ fname ++ "' wird nicht unterstützt — aktuell nur reine Textdateien (.txt, .md). Für PDFs/Binärformate bräuchte es einen angebundenen MCP-Server mit Extraktion.")
        return nil
    tel.tel_send_chat_action token cid "typing"
    fpath: tel.tel_get_file token (get doc "file_id")
    if fpath == nil
        tel.tel_send_message token cid "Datei konnte nicht abgerufen werden."
        return nil
    content: tel.tel_download_file token fpath
    if content == nil || content == ""
        tel.tel_send_message token cid "Datei war leer oder nicht lesbar."
        return nil
    res: mem.ingest_document dbh content ("telegram-datei:" ++ fname) fname 20
    tel.tel_send_message token cid ("Gelernt aus '" ++ fname ++ "': " ++ (to_str (get res "chunks_ingested")) ++ " von " ++ (to_str (get res "chunks_total")) ++ " Abschnitten gespeichert.")

--! Verarbeitet eine eingehende Textnachricht und antwortet.
fn handle_message token cid text dbh
    if text == nil
        return nil
    tnorm: trim text
    if tnorm == ""
        return nil
    low: lower tnorm
    if low == "/start" || low == "/hello" || low == "hallo" || low == "hi"
        tel.tel_send_message token cid (greeting_text 0)
        return nil
    if low == "/help"
        tel.tel_send_message token cid (help_text 0)
        return nil
    if low == "/status"
        tel.tel_send_message token cid (status_text dbh)
        return nil
    if low == "/list"
        tel.tel_send_message token cid (list_text dbh)
        return nil
    if low == "/reminders"
        rows: sched.list dbh cid
        if (len rows) == 0
            tel.tel_send_message token cid "Keine offenen Erinnerungen oder Briefings geplant."
        else
            out: "Offene Erinnerungen/Briefings:\n"
            for r in rows
                out: out ++ "• [" ++ (get r "kind") ++ "] " ++ (get r "note") ++ " — am " ++ (format_time (get r "due_ts") "2006-01-02 15:04:05") ++ "\n"
            tel.tel_send_message token cid (shorten out)
        return nil
    if low == "/briefing stop"
        rows: sched.list dbh cid
        cancelled: 0
        for r in rows
            if (get r "kind") == "briefing"
                sched.cancel dbh (get r "id")
                cancelled: cancelled + 1
        if cancelled > 0
            tel.tel_send_message token cid "Tägliches Briefing abbestellt."
        else
            tel.tel_send_message token cid "Kein aktives Briefing gefunden."
        return nil
    if low == "/briefing"
        rows: sched.list dbh cid
        for r in rows
            if (get r "kind") == "briefing"
                sched.cancel dbh (get r "id")
        bt: parse_briefing_time briefing_time
        nsec: now
        first_due: sched.next_hhmm (get bt "hh") (get bt "mm") nsec tz_offset
        sched.schedule dbh "briefing" (to_str cid) "Tägliches Briefing" first_due "daily"
        tel.tel_send_message token cid ("Tägliches Briefing aktiv — ich melde mich das nächste Mal um " ++ (format_time first_due "15:04") ++ " (und danach täglich).")
        return nil
    rq: remind_query low tnorm
    if rq != ""
        nsec2: now
        parsed: sched.parse_reminder rq nsec2 tz_offset
        sched.schedule dbh "reminder" (to_str cid) (get parsed "text") (get parsed "due") (get parsed "repeat")
        tel.tel_send_message token cid ("Notiert — ich erinnere dich am " ++ (format_time (get parsed "due") "2006-01-02 15:04:05") ++ " an: " ++ (get parsed "text"))
        return nil
    if low == "/reset"
        mem.close_thread dbh cid
        tel.tel_send_message token cid "Gespraechsverlauf zurueckgesetzt — ich starte den Kontext frisch."
        return nil
    if low == "/consolidate"
        tel.tel_send_chat_action token cid "typing"
        res: mem.consolidate dbh
        tel.tel_send_message token cid ("Konsolidierung: " ++ (to_str (get res "threads_summarized")) ++ " Threads verdichtet, " ++ (to_str (get res "memories_decayed")) ++ " Erinnerungen gealtert, " ++ (to_str (get res "memories_forgotten")) ++ " vergessen.")
        return nil
    if low == "/graph"
        tel.tel_send_message token cid "Bitte gib eine Entität an: /graph <Name>"
        return nil
    gname: graph_query low tnorm
    if gname != ""
        n: mem.neighbors_of dbh gname
        if (len n) == 0
            tel.tel_send_message token cid ("Keine Verknüpfungen zu '" ++ gname ++ "' im Wissensgraphen gefunden.")
        else
            out: gname ++ ":\n"
            for x in n
                out: out ++ "• " ++ (get x "rel") ++ " → " ++ (get x "target") ++ "\n"
            tel.tel_send_message token cid (shorten out)
        return nil
    if low == "/search"
        tel.tel_send_message token cid "Bitte gib einen Suchbegriff an: /search <begriff>"
        return nil
    sq: search_query low tnorm
    if sq != ""
        do_search token cid dbh sq
        return nil
    if low == "/learn"
        tel.tel_send_message token cid "Bitte gib eine URL an: /learn <URL> — oder schick mir direkt eine .txt/.md-Datei."
        return nil
    lurl: learn_query low tnorm
    if lurl != ""
        tel.tel_send_chat_action token cid "typing"
        dtext: web.web_fetch_raw lurl
        if dtext == nil || dtext == ""
            tel.tel_send_message token cid "Seite nicht abrufbar oder leer."
            return nil
        res: mem.ingest_document dbh dtext lurl lurl 20
        tel.tel_send_message token cid ("Gelernt aus " ++ lurl ++ ": " ++ (to_str (get res "chunks_ingested")) ++ " von " ++ (to_str (get res "chunks_total")) ++ " Abschnitten gespeichert.")
        return nil
    kind: mem.classify_input tnorm
    mem.log_event dbh (to_str cid) tnorm kind
    if kind == "reminder"
        nsec3: now
        parsed: sched.parse_reminder tnorm nsec3 tz_offset
        sched.schedule dbh "reminder" (to_str cid) (get parsed "text") (get parsed "due") (get parsed "repeat")
        tel.tel_send_message token cid ("Notiert — ich erinnere dich am " ++ (format_time (get parsed "due") "2006-01-02 15:04:05") ++ " an: " ++ (get parsed "text"))
        return nil
    if kind == "permanent"
        mem.add_memory dbh tnorm "permanent" 3 "telegram" "nutzer"
        tel.tel_send_message token cid ("Notiert: " ++ tnorm)
        return nil
    if kind == "task" || kind == "goal"
        tel.tel_send_chat_action token cid "typing"
        res: exe.execute_task dbh tnorm
        if get res "ok"
            tel.tel_send_message token cid ("Erledigt (" ++ (to_str (get res "steps_done")) ++ " Schritte).")
        else
            tel.tel_send_message token cid ("Plan fehlgeschlagen: " ++ (get res "error"))
        return nil
    if kind == "question"
        tel.tel_send_chat_action token cid "typing"
        tid: mem.active_thread dbh cid
        hist: mem.thread_history dbh tid 6
        task: tnorm
        if (len hist) > 0
            task: "Bisheriger Gespraechsverlauf (aeltester zuerst):\n" ++ (mem.format_history hist) ++ "\nAktuelle Frage: " ++ tnorm
        answer: ""
        try
            res: grm.run_gremium dbh task
            answer: get res "content"
        catch
            answer: ""
        mem.add_message dbh tid cid "user" tnorm
        if answer == nil || answer == "" || question_needs_research answer
            ctx: mem.retrieve_context dbh tnorm 3
            if (len ctx) > 0
                ctx_text: join ctx "\n\n"
                reply: ""
                try
                    reply: ai_chat "Du bist Muninn, ein persoenlicher KI-Assistent. Beantworte die Frage anhand des folgenden Kontexts knapp und faktentreu. Wenn der Kontext nichts Passendes enthaelt, sage ehrlich, dass du es nicht weisst. Gib nur die Antwort aus, kein internes Reasoning." ("Frage: " ++ tnorm ++ "\n\nKontext:\n" ++ ctx_text)
                catch
                    reply: ""
                if reply == nil || reply == ""
                    reply: "Dazu erinnere ich mich an:\n"
                    for c in ctx
                        reply: reply ++ "• " ++ c ++ "\n"
                mem.add_message dbh tid cid "assistant" reply
                tel.tel_send_message token cid reply
            else
                tel.tel_send_message token cid "Kein Wissen darüber. Recherchiere..."
                rr: web.research tnorm
                ctx2: get rr "context"
                srcs2: get rr "sources"
                if ctx2 == nil || ctx2 == ""
                    fallback: "Ich konnte online nichts Relevantes finden."
                    mem.add_message dbh tid cid "assistant" fallback
                    tel.tel_send_message token cid fallback
                else
                    answer2: ""
                    try
                        answer2: ai_chat "Du bist Muninn, ein persoenlicher KI-Assistent. Beantworte die Frage anhand des recherchierten Kontexts knapp und faktentreu. Gib nur die Antwort aus, kein internes Reasoning." ("Frage: " ++ tnorm ++ "\n\nKontext:\n" ++ ctx2)
                    catch
                        answer2: ctx2
                    if answer2 == nil || answer2 == ""
                        answer2: ctx2
                    mem.add_memory dbh (mem.condense_fact answer2) "fact" 3 "web_research" "web"
                    mem.add_message dbh tid cid "assistant" answer2
                    src_text: ""
                    for u in srcs2
                        src_text: src_text ++ "\n" ++ u
                    full: (shorten answer2) ++ "\n— Quellen:" ++ (shorten src_text)
                    kb: []
                    row: []
                    push row (tel.tel_button "💾 Merken" "save")
                    push row (tel.tel_button "🔍 Vertiefen" "more")
                    push kb row
                    row2: []
                    push row2 (tel.tel_button "👍" "up")
                    push row2 (tel.tel_button "👎" "down")
                    push kb row2
                    tel.tel_send_message_kb token cid (shorten full) kb
        else
            mem.add_message dbh tid cid "assistant" answer
            kb: []
            row: []
            push row (tel.tel_button "💾 Merken" "save")
            push row (tel.tel_button "🔍 Vertiefen" "more")
            push kb row
            row2: []
            push row2 (tel.tel_button "👍" "up")
            push row2 (tel.tel_button "👎" "down")
            push kb row2
            tel.tel_send_message_kb token cid (shorten answer) kb
        return nil
    tel.tel_send_message token cid ("Verstanden. (" ++ kind ++ ")")

--! Prüft, ob eine KI-Antwort einen "ich weiß es nicht"-Fallback darstellt,
--! der nach einer Web-Recherche auffordert.
fn question_needs_research answer
    if answer == nil || answer == ""
        return true
    low: lower answer
    if contains low "ich weiß es nicht"
        return true
    if contains low "ich weiss es nicht"
        return true
    if contains low "weis es nicht"
        return true
    if contains low "keine informationen"
        return true
    if contains low "keine relevanten informationen"
        return true
    if contains low "ich kenne keine"
        return true
    if contains low "ich kann dir nicht sagen"
        return true
    if contains low "ich weiss nichts"
        return true
    if contains low "ich weiß nichts"
        return true
    if contains low "konnte keine"
        return true
    false

--! Kürzt Text auf Telegram-Grenze (4096 Zeichen).
fn shorten s
    if s == nil
        return ""
    if (len s) > 4000
        (substring s 0 4000) ++ "…"
    else
        s

--! Führt eine Web-Recherche aus und antwortet mit Quellen + Buttons.
fn do_search token cid dbh query
    tel.tel_send_chat_action token cid "typing"
    tid: mem.active_thread dbh cid
    mem.add_message dbh tid cid "user" ("/search " ++ query)
    rr: web.research query
    ctx: get rr "context"
    srcs: get rr "sources"
    if ctx == nil || ctx == ""
        fallback: "Keine brauchbaren Ergebnisse gefunden."
        mem.add_message dbh tid cid "assistant" fallback
        tel.tel_send_message token cid fallback
        return nil
    answer: ""
    try
        answer: ai_chat "Du bist ein präziser Recherche-Assistent. Beantworte die Frage anhand des recherchierten Kontexts, kurz und faktentreu." ("Frage: " ++ query ++ "\n\nKontext:\n" ++ ctx)
    catch
        answer: ctx
    mem.add_message dbh tid cid "assistant" answer
    src_text: ""
    for u in srcs
        src_text: src_text ++ "\n" ++ u
    full: (shorten answer) ++ "\n— Quellen:" ++ (shorten src_text)
    kb: []
    row: []
    push row (tel.tel_button "💾 Merken" "save")
    push kb row
    tel.tel_send_message_kb token cid (shorten full) kb
    nil

--! Erkennt eine Such-Intention und liefert den Suchbegriff (oder "").
fn search_query low tnorm
    if (len low) >= 8
        if (substring low 0 8) == "/search "
            return (trim (substring tnorm 8 (len tnorm)))
    if (len low) >= 6
        if (substring low 0 6) == "suche "
            return (trim (substring tnorm 6 (len tnorm)))
    if (len low) >= 12
        if (substring low 0 12) == "recherchiere "
            return (trim (substring tnorm 12 (len tnorm)))
    if (len low) >= 6
        if (substring low 0 6) == "finde "
            return (trim (substring tnorm 6 (len tnorm)))
    ""

--! Erkennt eine /graph-Anfrage und liefert den Entitätsnamen (oder "").
fn graph_query low tnorm
    if (len low) >= 7
        if (substring low 0 7) == "/graph "
            return (trim (substring tnorm 7 (len tnorm)))
    ""

--! Erkennt eine /learn-Anfrage und liefert die URL (oder "").
fn learn_query low tnorm
    if (len low) >= 7
        if (substring low 0 7) == "/learn "
            return (trim (substring tnorm 7 (len tnorm)))
    ""

--! Erkennt eine /remind-Anfrage und liefert die Erinnerungs-Anweisung (oder "").
fn remind_query low tnorm
    if (len low) >= 8
        if (substring low 0 8) == "/remind "
            return (trim (substring tnorm 8 (len tnorm)))
    ""

--! Verarbeitet einen Inline-Button-Druck (callback_query).
fn handle_callback token dbh cbq
    cbid: get cbq "id"
    data: get cbq "data"
    msg: get cbq "message"
    chat: get msg "chat"
    cid: get chat "id"
    txt: get msg "text"
    tel.tel_answer_callback token cbid ""
    if data == "save"
        if txt != nil
            mem.add_memory dbh (mem.condense_fact txt) "fact" 3 "telegram" "nutzer"
            tel.tel_send_message token cid "In der Seele gespeichert."
        return nil
    if data == "more"
        if txt != nil
            tel.tel_send_chat_action token cid "typing"
            res: grm.run_gremium dbh ("Vertiefe bitte diesen Sachverhalt: " ++ txt)
            a: get res "content"
            if a != nil && a != ""
                tid: mem.active_thread dbh cid
                mem.add_message dbh tid cid "assistant" a
                tel.tel_send_message token cid (shorten a)
            else
                tel.tel_send_message token cid "Ich konnte leider nichts vertiefen."
        return nil
    if data == "up"
        if txt != nil
            n: mem.adjust_by_content dbh txt 1
            if n == 0
                mem.add_memory dbh (mem.condense_fact txt) "fact" 3 "telegram" "feedback"
                tel.tel_send_message token cid "Danke! Ich merke mir das."
            else
                tel.tel_send_message token cid "Danke! Wichtigkeit erhöht."
        return nil
    if data == "down"
        if txt != nil
            mem.adjust_by_content dbh txt (-1)
            tel.tel_send_message token cid "Notiert — ich werte das ab."
        return nil
    tel.tel_send_message token cid "Unbekannte Aktion."

--! Zerlegt BRIEFING_TIME ("HH:MM") in {hh, mm}. Default 08:00.
fn parse_briefing_time raw
    hh: 8
    mm: 0
    if raw != nil && raw != ""
        p: split raw ":"
        if (len p) >= 2
            hh: to_num (trim (at p 0))
            mm: to_num (trim (at p 1))
    out: {}
    set out "hh" hh
    set out "mm" mm
    out

--! Scheduler-Tick (P4): feuert fällige Erinnerungen/Briefings proaktiv ab —
--! läuft im Bot-Loop nach jedem Poll, single-threaded (kein Goroutine-/DB-
--! Konflikt, siehe Plan.md). Briefings werden erst beim Feuern aus der Seele
--! zusammengestellt (immer aktuell, kein veralteter Snapshot).
fn sched_tick token
    hl: mem.open_locked nil
    dbh: get hl "h"
    now_sec: now
    due: sched.due dbh now_sec
    for item in due
        kind: get item "kind"
        cid: get item "chat_id"
        msg: get item "note"
        if kind == "briefing"
            msg: sched.compose_briefing dbh
        if kind == "goal_tick"
            resumed: exe.resume_running_plans dbh
            if resumed > 0
                tel.tel_send_message token (to_num cid) ("Fortschritt: " ++ (to_str resumed) ++ " unterbrochene Pläne fortgesetzt.")
            sched.mark_fired dbh (get item "id") (get item "repeat") (get item "due_ts")
            continue
        if cid != nil && cid != ""
            try
                tel.tel_send_message token (to_num cid) msg
            catch
                nil
        sched.mark_fired dbh (get item "id") (get item "repeat") (get item "due_ts")
    mem.close_locked hl
    nil

--! Ein Polling-Zyklus. Liefert die letzte verarbeitete update_id zurück.
--! DB-Sperre (mem.open_locked/close_locked) bewusst NICHT um den ganzen
--! Zyklus, sondern nur um die tatsaechlichen DB-Zugriffe: tel_get_updates
--! wartet per Long-Polling bis zu `timeout` Sekunden auf neue Nachrichten —
--! waere die Sperre die ganze Zeit gehalten, koennte das Web-Dashboard
--! waehrenddessen so gut wie nie an die DB. So haelt jeder Kanal die Sperre
--! nur, waehrend er tatsaechlich etwas verarbeitet (siehe Plan.md zur
--! Nebenlaeufigkeit). timeout (Sekunden) kappt der P4-Scheduler dynamisch
--! auf "Zeit bis zur naechsten faelligen Aufgabe".
fn poll_once token offset allowed timeout
    hl: mem.open_locked nil
    dbh: get hl "h"
    if offset == nil
        saved: mem.meta_get dbh "telegram_offset"
        if saved != ""
            offset: to_num saved
    mem.close_locked hl
    updates: []
    try
        updates: tel.tel_get_updates token offset timeout
    catch
        updates: []
    hl2: mem.open_locked nil
    dbh2: get hl2 "h"
    for upd in updates
        uid: get upd "update_id"
        if uid != nil
            offset: uid + 1
        msg: get upd "message"
        if msg != nil
            chat: get msg "chat"
            if chat != nil
                cid: get chat "id"
                if is_allowed cid allowed
                    try
                        handle_update token cid msg dbh2
                    catch
                        nil
        cq: get upd "callback_query"
        if cq != nil
            chat2: get (get cq "message") "chat"
            if chat2 != nil
                cid2: get chat2 "id"
                if is_allowed cid2 allowed
                    try
                        handle_callback token dbh2 cq
                    catch
                        nil
    if offset != nil
        mem.meta_set dbh2 "telegram_offset" (to_str offset)
    mem.close_locked hl2
    offset

--! Sandbox + KI + MCP + Gremium in einem Rutsch, gemeinsam fuer Telegram- und
--! Web-Modus. Setzt voraus, dass Secrets/Config bereits (vor der Sandbox!)
--! gelesen wurden — siehe die Kommentare bei setup_ai/setup_sandbox.
fn setup_core mcp_servers deepseek_key
    setup_sandbox mcp_servers
    setup_ai deepseek_key
    mcp_results: mcp.connect_servers mcp_servers
    for r in mcp_results
        if get r "ok"
            print ("MCP verbunden: " ++ (get r "alias"))
        else
            print ("MCP fehlgeschlagen (" ++ (get r "alias") ++ "): " ++ (get r "error"))
    grm.init_gremium 0
    nil

--! CLI-Argumente lesen.
avgs: args
once_mode: false
consolidate_mode: false
web_mode: false
if (len avgs) > 0
    if (at avgs 0) == "once"
        once_mode: true
    if (at avgs 0) == "consolidate"
        consolidate_mode: true
    if (at avgs 0) == "web"
        web_mode: true

--! Alle Secrets/Config-Werte werden VOR der Sandbox-Aktivierung gelesen (siehe
--! setup_ai/setup_sandbox): einmal von vertrauenswürdigem Startup-Code eingesammelt,
--! danach nur noch als Wert weitergereicht — nie erneut per env() nachgefragt.
cfg: load_env ".env"
deepseek_key: cfg_get cfg "DEEPSEEK_API_KEY"
dash_bind: cfg_get cfg "DASHBOARD_BIND"
dash_token: cfg_get cfg "DASHBOARD_TOKEN"
briefing_time: cfg_get cfg "BRIEFING_TIME"
tz_offset_raw: cfg_get cfg "MUNINN_TZ_OFFSET"
tz_offset: 0
if tz_offset_raw != nil && tz_offset_raw != ""
    tz_offset: to_num tz_offset_raw
mcp_servers: mcp.parse_mcp_config (cfg_get cfg "MCP_SERVERS")
mcp_servers: mcp.resolve_all_env mcp_servers

--! consolidate-Modus (P2, "Traum"): einmaliger Aufraeum-/Verdichtungslauf,
--! z.B. per externem Cron: `pipe muninn.pipe consolidate`. Kein Scheduler in
--! Pipe selbst vor P4 — daher bewusst als eigener CLI-Modus statt Dauer-Loop.
--! Braucht kein Telegram/MCP, nur optional KI fuer die Thread-Zusammenfassung
--! (Fallback ohne KI: erste 800 Zeichen des Verlaufs, siehe consolidate_threads).
if consolidate_mode
    sandbox_profile "consolidate" {fs: "full", network: false, exec: false, ai: true, audit_log: true}
    set_sandbox "consolidate"
    setup_ai deepseek_key
    hl: mem.open_locked nil
    res: mem.consolidate (get hl "h")
    print ("Konsolidierung: " ++ (to_str (get res "threads_summarized")) ++ " Threads verdichtet, " ++ (to_str (get res "memories_decayed")) ++ " Erinnerungen gealtert, " ++ (to_str (get res "memories_forgotten")) ++ " vergessen.")
    mem.close_locked hl
else
    if web_mode
        --! web-Modus (P3): Dashboard statt Telegram-Loop. DASHBOARD_BIND
        --! (Standard: nur localhost — bewusst kein "0.0.0.0", siehe
        --! dashboard.pipe-Kommentar zur Sicherheit) und optional
        --! DASHBOARD_TOKEN aus .env.
        setup_core mcp_servers deepseek_key
        bind: dash_bind
        if bind == nil || bind == ""
            bind: "127.0.0.1:8787"
        dash.start bind dash_token
    else
        tok: cfg_get cfg "TELEGRAM_BOT_TOKEN"
        allowed: cfg_get cfg "TELEGRAM_ALLOWED_CHAT_ID"
        setup_core mcp_servers deepseek_key
        if tok == nil || tok == ""
            print "TELEGRAM_BOT_TOKEN fehlt (Env oder .env). Abbruch."
        else
            print "Muninn gestartet."
            off: nil
            if once_mode
                print "once-Modus: ein Zyklus"
                off: poll_once tok off allowed 25
                print "once-Zyklus fertig."
            else
                while true
                    try
                        timeout: 25
                        hl0: mem.open_locked nil
                        dbh0: get hl0 "h"
                        nxt: sched.next_due_ms dbh0 (now)
                        mem.close_locked hl0
                        if nxt != nil && nxt < 25000
                            timeout: nxt / 1000
                            if timeout < 1
                                timeout: 1
                        off: poll_once tok off allowed timeout
                        sched_tick tok
                    catch e
                        print ("Zyklus-Fehler — versuche erneut: " ++ (to_str e))
