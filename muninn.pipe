--! muninn.pipe — Einstiegspunkt: Muninn, der Langzeit-KI-Agent.
--! Telegram-Bot (Long-Polling) + persistente sqlite-"Seele".
--! Aufruf:  pipe muninn.pipe             (Produktions-Loop, Telegram)
--!          pipe muninn.pipe once        (ein Polling-Zyklus, dann exit — zum Testen)
--!          pipe muninn.pipe consolidate (Konsolidierung, z.B. per Cron)
--!          pipe muninn.pipe web         (Web-Dashboard, siehe DASHBOARD_BIND/-TOKEN in .env)
import "modules/telegram.pipe" as tel
import "modules/memory.pipe" as mem
import "modules/swarm.pipe" as grm
import "modules/executor.pipe" as exe
import "modules/web.pipe" as web
import "modules/mcp.pipe" as mcp
import "modules/dashboard.pipe" as dash
import "modules/scheduler.pipe" as sched
import "modules/docker_tools.pipe" as dt

--! Lädt KEY=VALUE-Zeilen aus einer .env-Datei in eine Map.
--! Werte werden am ERSTEN "=" getrennt (nicht bei jedem), damit Werte, die selbst
--! "=" enthalten (z.B. MCP_SERVERS-JSON mit URL-Query-Strings), nicht abgeschnitten werden.
fn load_env path
    env_map: {}
    if file_exists path
        lines: split (read_file path) "\n"
        for line in lines
            ln: trim line
            if (len ln) > 0
                if (at ln 0) != "#"
                    kv: split ln "="
                    if (len kv) >= 2
                        key: trim (at kv 0)
                        val: join (slice kv 1 (len kv)) "="
                        set env_map key (trim val)
    env_map

--! Wert-Lookup: zuerst echte Umgebungsvariable, dann .env.
fn cfg_get cfg key
    v: env key
    if v != nil && v != ""
        return v
    get cfg key

--! Richtet den AI-Provider ein (DeepSeek). Muninn soll nur DeepSeek nutzen;
--! andere Provider-Varianten sind hier bewusst nicht erlaubt. Sobald die
--! Sandbox aktiv ist, blockiert `env()` sicherheitshalber jeden Namen, der
--! wie ein Secret aussieht (*KEY*/*TOKEN*/*SECRET*) — DEEPSEEK_API_KEY muss
--! also VOR set_sandbox gelesen sein.
fn setup_ai key
    ai_provider "deepseek" {thinking: false}
    if key != nil && key != ""
        ai_set_key "deepseek" key
    ai_model "deepseek-chat"
    --! Hartes Zeitlimit PRO EINZELNEM KI-Aufruf: haengt der Provider (langsamer
    --! oder stehen gebliebener Stream/Verbindung), blockierte der Aufruf vorher
    --! UNBEGRENZT — und damit den gesamten single-threaded Bot-Loop (Muninn
    --! wirkte dann lebendig, antwortete aber auf nichts mehr; ein Restart war
    --! der einzige Ausweg). Mit Timeout wirft der Aufruf stattdessen einen
    --! Fehler, den die bestehenden try/catch-Pfade abfangen und ehrlich
    --! beantworten. 120s ist grosszuegig genug fuer lange Kontext-/Swarm-
    --! Aufrufe, verhindert aber das ewige Haengen.
    ai_timeout 120

--! Sandbox-Profile sind unveraenderlich und ihr Name ist einmalig vergeben
--! (ein zweiter sandbox_profile-Aufruf mit demselben Namen scheitert mit
--! "already exists") — max_tool_calls zaehlt daher NICHT pro Nachricht oder
--! Gremium-Lauf, sondern kumulativ ueber die GESAMTE Prozess-Laufzeit seit
--! dem letzten Neustart. Live beobachtet: nach genug Nachrichten seit dem
--! letzten Neustart lief eine an sich harmlose Anfrage (Recherche + langes
--! Dokument, viele Werkzeugaufrufe) mitten in echte "E_SANDBOX: max tool
--! calls exceeded"-Fehler, die die KI dann als raetselhaftes "technisches
--! Limit" ausgab und sich in wiederholten, sich selbst widersprechenden
--! Rettungsversuchen verhedderte — nichts davon hatte mit dem KI-Provider
--! zu tun. setup_sandbox bekommt deshalb bei jedem Aufruf einen neuen,
--! durchnummerierten Profilnamen (SANDBOX_STATE.gen), damit ein frischer
--! Aufruf (siehe die beiden run_gremium_stream-Aufrufstellen) das Budget
--! zuverlaessig pro Nachricht statt kumulativ ueber die Prozesslaufzeit
--! zuruecksetzt. Mutable Map statt eines bloßen Zaehlers, weil eine
--! bare Neuzuweisung einer Top-Level-Variable INNERHALB einer Funktion in
--! Pipe nicht nach außen persistiert (siehe COST_STATE fuer dasselbe Muster).
SANDBOX_STATE: {gen: 0}

--! Aktiviert Muninns Sandbox-Profil (P1: Tool-Sandboxing) frisch (siehe
--! SANDBOX_GEN oben). fs bleibt "full", da die reine-Pipe-sqlite-Persistenz
--! (muninn.db) Dateizugriff braucht; exec ist nur erlaubt, wenn MCP-Server
--! konfiguriert sind, und dann ausschliesslich auf deren Kommandos
--! beschraenkt (Lehre der Sandbox-Audit-Reihe: nie unbeschraenkter exec an
--! die KI). network bleibt offen, da Web-Recherche beliebige Treffer-URLs
--! abruft; eine feste Whitelist wuerde die Recherche brechen.
fn setup_sandbox servers
    wl: mcp.exec_whitelist_for servers
    --! "docker" zusaetzlich zur Whitelist: modules/docker_tools.pipe ruft
    --! `docker pull`/`docker run` direkt per exec() auf (nicht ueber den
    --! MCP-Server "docker", der nur bestehende Container verwaltet). Siehe
    --! Sicherheits-Kommentar in docker_tools.pipe — strikt validierte
    --! Argumente, kein Volume-Mount, kein --privileged.
    push wl "docker"
    --! "tts_synth.sh" zusaetzlich zur Whitelist: swarm.pipe (tts_synthesize)
    --! ruft die feste Piper->ffmpeg-Sprachsynthese-Pipeline direkt per exec()
    --! auf (kein MCP-Server dafuer). Fester Skriptpfad, keine AI-kontrollierbaren
    --! Flags — nur die beiden Dateipfade werden uebergeben.
    push wl "tts_synth.sh"
    --! "systemd-notify" zusaetzlich zur Whitelist: der Haupt-Loop (siehe
    --! unten) meldet sich damit periodisch beim systemd-Watchdog
    --! (WatchdogSec in muninn.service) — reines Trust-System-Kommando ohne
    --! AI-kontrollierbare Argumente, kein MCP-Server dafuer noetig.
    push wl "systemd-notify"
    allow_exec: (len wl) > 0
    set SANDBOX_STATE "gen" ((get SANDBOX_STATE "gen") + 1)
    name: "muninn-" ++ (to_str (get SANDBOX_STATE "gen"))
    --! max_tool_calls gilt fuer die GESAMTE Gremiums-Anfrage (Recherche +
    --! evtl. Dokument-Erstellung zusammen), seit obigem Fix pro Nachricht neu.
    --! 40 war dafuer zu knapp: live beobachtet, dass allein die Recherche zu
    --! einem schwer im Web dokumentierten Thema schon 40+ Tool-Aufrufe braucht
    --! (viele Fehlversuche/Praezisierungen), WOVOR ueberhaupt ein Kapitel ins
    --! Dokument geschrieben wurde — das Limit schlug dann mitten in der
    --! Dokument-Erstellung zu, das Dokument blieb nur teilweise befuellt.
    --! timeout: 180 — WATCHDOG gegen einen exec()-Aufruf, der nie zurueckkehrt.
    --! Live reproduziert: die KI versuchte auf Nutzerwunsch, per exec() einen
    --! HTTP-Server im VORDERGRUND zu starten — exec() wartet aber, bis der
    --! Befehl SELBST beendet ist, und ein dauerhaft laufender Server beendet
    --! sich nie. Ohne Timeout blockierte das den GESAMTEN Bot fuer immer
    --! (Pipe ist bewusst single-threaded), UND weil der Telegram-Offset erst
    --! NACH erfolgreicher Verarbeitung gespeichert wird, haengte sich Muninn
    --! bei jedem Neustart sofort wieder an derselben Nachricht auf. Der
    --! Interpreter selbst kennt bereits einen exec()-Timeout
    --! (sandbox.go/buildExecCommand, context.WithTimeout) — er war nur nie
    --! aktiviert (Timeout: 0 = unbegrenzt ohne dieses Feld). 180s deckt den
    --! langsamsten legitimen Fall (docker_pull_image bei einem grossen, noch
    --! nicht gecachten Image) grosszuegig ab, garantiert aber, dass KEIN
    --! exec()-Aufruf mehr unbegrenzt haengen kann. MCP-Werkzeugaufrufe (z.B.
    --! whisper) haben bereits eigenstaendig einen 120s-Timeout im
    --! MCP-Client selbst (pkg/mcp/client.go, defaultCallTimeout) — nur
    --! exec() hatte diese Luecke.
    sandbox_profile name {fs: "full", network: true, exec: allow_exec, exec_whitelist: wl, ai: true, max_tool_calls: 150, timeout: 180, audit_log: true}
    set_sandbox name
    nil

fn ensure_mcp_for_task task
    results: mcp.ensure_for_task mcp_auto_servers task
    for r in results
        if get r "ok"
            print ("MCP autonom verbunden: " ++ (get r "alias"))
        else
            print ("MCP autonom fehlgeschlagen (" ++ (get r "alias") ++ "): " ++ (get r "error"))
    if (len results) > 0
        grm.init_gremium 0
    nil

fn list_configured_mcp_aliases _
    names: []
    for s in all_mcp_servers
        alias: get s "alias"
        if alias != nil && alias != ""
            push names alias
    names

fn connected_mcp_tool_names _
    out: []
    try
        tools: mcp_tools
        for t in tools
            n: get t "name"
            if n != nil && n != ""
                push out n
    catch
        nil
    out

--! Prüft, ob eine Chat-ID bedient werden darf (leere Whitelist = alle erlauben).
fn is_allowed cid allowed
    if allowed == nil || allowed == ""
        return true
    allow_list: split allowed ","
    for a in allow_list
        if (trim a) == (to_str cid)
            return true
    false

--! Begrüßungstext.
fn greeting_text _
    "Muninn ist online.\n\nDu kannst mir etwas sagen, das ich mir merken soll (z.B. \"Merke dir, dass ich Tee mag\"), mir eine Aufgabe geben (z.B. \"Erledige das Reporting\"), eine Frage stellen oder im Web suchen (z.B. \"/search Odin nordische Mythologie\").\n\n/help für alle Befehle."

--! Hilfetext.
fn help_text _
    "/start      — Begrüßung\n/help       — diese Hilfe\n/status     — Zustand von Muninn\n/costs      — KI-Betriebskosten zusammengefasst (Sessions, Tokens, $)\n/list       — deine wichtigsten Erinnerungen\n/search     — im Web suchen (z.B. /search Huginn und Muninn)\n/learn      — Dokument lernen (z.B. /learn https://... oder eine .txt/.md-Datei schicken)\n/graph      — Wissensgraph abfragen (z.B. /graph Harry)\n/remind     — Erinnerung planen (z.B. /remind in 10 Minuten an die Pause)\n/reminders  — offene Erinnerungen/Briefings anzeigen\n/briefing   — tägliches Morgen-Briefing aktivieren (/briefing stop zum Abbestellen)\n/reset      — Gesprächsverlauf zurücksetzen (frischer Kontext für Folgefragen)\n/consolidate — Traum: alte Gespräche verdichten, Erinnerungen altern/vergessen lassen"

--! Status-Text (Statistiken aus der Seele).
fn status_text dbh
    n: mem.memory_count dbh
    tool_n: len (mcp_tools)
    gc: mem.graph_counts dbh
    "Muninn-Status:\n• Erinnerungen: " ++ (to_str n) ++ "\n• Wissensgraph: " ++ (to_str (get gc "entities")) ++ " Entitäten, " ++ (to_str (get gc "relations")) ++ " Relationen\n• Provider: DeepSeek\n• Gremium: 4-5 Agenten (mit Web-Recherche + MCP-Werkzeugen)\n• Werkzeuge gesamt (lokal + MCP): " ++ (to_str tool_n) ++ "\n• Executor: aktiv\n• Web: DDG + Wikipedia"

--! /costs: KI-generierte Kosten-Zusammenfassung. Die Zahlen selbst werden
--! DETERMINISTISCH aus cost_log berechnet (mem.cost_summary) — der KI wird
--! nur die Aufgabe gegeben, diese FESTEN Zahlen lesbar zu formulieren, sie
--! soll NICHTS selbst berechnen oder schaetzen (sonst Halluzinationsrisiko
--! bei Zahlen, siehe die Lehren aus dem restlichen Gremium heute).
fn costs_text dbh
    s: mem.cost_summary dbh
    sessions: get s "sessions"
    if (len sessions) == 0
        return "Noch keine Kosten aufgezeichnet — das sammelt sich waehrend des laufenden Betriebs an."
    lines: "Gesamt ueber " ++ (to_str (get s "session_count")) ++ " Sessions: $" ++ (to_str (get s "total_cost_usd")) ++ ", " ++ (to_str (get s "total_tokens")) ++ " Tokens, " ++ (to_str (get s "total_calls")) ++ " KI-Aufrufe.\n\nLetzte Sessions (neueste zuerst):\n"
    i: 0
    while i < 10 && i < (len sessions)
        sess: at sessions i
        lines: lines ++ "- Session " ++ (to_str (get sess "session_id")) ++ " (" ++ (get sess "first_ts") ++ " bis " ++ (get sess "last_ts") ++ "): $" ++ (to_str (get sess "cost_usd")) ++ ", " ++ (to_str (get sess "tokens")) ++ " Tokens, " ++ (to_str (get sess "calls")) ++ " Aufrufe, " ++ (to_str (get sess "cache_hits")) ++ " Cache-Treffer\n"
        i: i + 1
    summary: ""
    try
        summary: ai_chat "Du bist Muninn und fasst Betriebskosten fuer deinen Nutzer zusammen. Du bekommst FERTIG BERECHNETE Zahlen — uebernimm sie EXAKT und woertlich, berechne oder schaetze NICHTS selbst nach, erfinde keine zusaetzlichen Zahlen. Schreib eine kurze, natuerliche Zusammenfassung in 3-5 Saetzen: Gesamtkosten, wie viele Sessions, grober Trend falls erkennbar (steigt/faellt/stabil), und ob irgendeine Session auffaellig teuer war. Telegram-Formatierung: einfache Sternchen fuer Fettung, keine Ueberschriften." lines
    catch
        summary: ""
    if summary == nil || summary == ""
        return lines
    summary ++ "\n\n" ++ lines

--! Liste der wichtigsten Erinnerungen.
fn list_text dbh
    rows: mem.top_memories dbh 10
    if (len rows) == 0
        return "Noch keine Erinnerungen gespeichert."
    out: "Deine wichtigsten Erinnerungen:\n"
    for r in rows
        out: out ++ "• " ++ (get r "content") ++ "\n"
    out

--! Verarbeitet ein eingehendes Update (extrahiert Text, behandelt Nicht-Text).
fn handle_update token cid msg dbh
    txt: get msg "text"
    if txt == nil
        doc: get msg "document"
        if doc != nil
            handle_document token cid dbh doc
            return nil
        if (get msg "photo") != nil
            handle_photo token cid dbh msg
            return nil
        if (get msg "sticker") != nil
            tel.tel_send_message token cid "Netter Sticker — ich verstehe aber nur Text."
            return nil
        if (get msg "voice") != nil
            handle_voice token cid dbh msg
            return nil
        return nil
    handle_message token cid txt dbh

--! Prüft anhand Dateiname/Mime-Type, ob ein Dokument reiner Text ist (.txt/.md
--! oder mime "text/..."). PDFs/Binärformate liefern hier false.
fn is_text_doc fname mime
    if mime != nil
        if contains mime "text/"
            return true
    low: lower fname
    if contains low ".txt"
        return true
    if contains low ".md"
        return true
    if contains low ".markdown"
        return true
    false

fn is_mcp_server_question low
    if !contains low "mcp"
        return false
    if contains low "server" || contains low "werkzeug" || contains low "verfuegbar" || contains low "verfugbar" || contains low "verfügbar" || contains low "welche" || contains low "tools"
        return true
    false

--! Nur der Dateiname-Teil, ohne Pfad-Traversal — Telegrams file_name kommt
--! vom Nutzer/Absender und darf niemals ungeprueft in einen Speicherpfad.
fn safe_filename fname
    base: fname
    parts: split fname "/"
    if (len parts) > 0
        base: at parts ((len parts) - 1)
    base: replace_all base ".." ""
    if base == nil || base == ""
        base: "datei"
    base

--! Verarbeitet ein hochgeladenes Dokument (Telegram "document"-Nachricht).
--! JEDE Datei wird roh im mcp_data-Ordner gespeichert (fuer werkzeug_
--! filesystem lesbar/bearbeitbar); reine Textdateien werden zusaetzlich ins
--! Gedaechtnis gelernt (ingest_document, siehe dortigen Kommentar zur
--! bewussten PDF-Einschraenkung dafuer — das Lernen, nicht das Speichern).
fn handle_document token cid dbh doc
    fname: get doc "file_name"
    if fname == nil
        fname: "dokument"
    mime: get doc "mime_type"
    tel.tel_send_chat_action token cid "typing"
    fpath: tel.tel_get_file token (get doc "file_id")
    if fpath == nil
        tel.tel_send_message token cid "Datei konnte nicht abgerufen werden."
        return nil
    content: tel.tel_download_file token fpath
    if content == nil || content == ""
        tel.tel_send_message token cid "Datei war leer oder nicht lesbar."
        return nil
    safe_name: safe_filename fname
    save_path: "/root/muninn/mcp_data/" ++ safe_name
    write_file save_path content
    out: "Gespeichert: " ++ safe_name ++ " (" ++ (to_str (len content)) ++ " Bytes)."
    if is_text_doc fname mime
        res: mem.ingest_document dbh content ("telegram-datei:" ++ fname) fname 20
        out: out ++ "\nZusaetzlich als Wissen gelernt: " ++ (to_str (get res "chunks_ingested")) ++ " von " ++ (to_str (get res "chunks_total")) ++ " Abschnitten."
    tel.tel_send_message token cid out

--! Verarbeitet ein hochgeladenes Foto (Telegram "photo"-Nachricht) per ai_vision.
--! "photo" ist eine Liste von Groessen aufsteigend sortiert — das letzte Element
--! ist die hoechste Aufloesung. Die Bytes kommen ueber Telegrams File-API als
--! rohe Bytes zurueck; ai_vision akzeptiert dafuer explizit ein Bytes-Objekt
--! (kein String — ein String wird sonst als lokaler Pfad/URL interpretiert,
--! siehe resolveImageURL in pipe/pkg/object/builtins_vision.go), daher to_bytes.
--! DeepSeeks Standardmodell (deepseek-chat, siehe setup_ai) kann keine Bilder —
--! fuer den Aufruf kurz auf das Vision-Modell umschalten und danach IMMER
--! zurueckschalten (try/catch), sonst laufen alle folgenden Text-Antworten mit
--! dem falschen Modell.
fn handle_photo token cid dbh msg
    photos: get msg "photo"
    if photos == nil || (len photos) == 0
        tel.tel_send_message token cid "Foto konnte nicht gelesen werden."
        return nil
    largest: at photos ((len photos) - 1)
    caption: get msg "caption"
    prompt: "Was ist auf diesem Bild zu sehen? Beschreibe es kurz und pruefe, ob etwas Wichtiges oder Auffaelliges zu erkennen ist."
    if caption != nil && (trim caption) != ""
        prompt: caption
    tel.tel_send_chat_action token cid "typing"
    fpath: tel.tel_get_file token (get largest "file_id")
    if fpath == nil
        tel.tel_send_message token cid "Bild konnte nicht abgerufen werden."
        return nil
    raw: tel.tel_download_file token fpath
    if raw == nil || raw == ""
        tel.tel_send_message token cid "Bild war leer oder nicht lesbar."
        return nil
    answer: ""
    try
        ai_model "deepseek-v4-flash-vision-exp"
        answer: ai_vision (to_bytes raw) prompt
        ai_model "deepseek-chat"
    catch e
        ai_model "deepseek-chat"
        answer: "Ich konnte das Bild nicht auswerten: " ++ (to_str e)
    tid: mem.active_thread dbh cid
    mem.add_message dbh tid cid "user" ("[Foto] " ++ prompt)
    mem.add_message dbh tid cid "assistant" answer
    kb: []
    row: []
    push row (tel.tel_button "💾 Merken" "save")
    push kb row
    tel.tel_send_message_kb token cid (shorten answer) kb
    nil

--! Verarbeitet eine eingehende Sprachnachricht: laedt die OGG/Opus-Datei
--! herunter, transkribiert sie lokal per whisper-transcribe-mcp (kein
--! API-Key, siehe .env.example) und reicht den erkannten Text danach
--! GENAUSO durch handle_message wie eine getippte Nachricht — Befehle,
--! Erinnerungen und das Gremium funktionieren also identisch per Sprache.
--! Ist der "whisper"-MCP-Server nicht konfiguriert/verbunden, faellt das
--! ehrlich zurueck auf die Bitte, stattdessen zu tippen (kein Vortaeuschen
--! einer Faehigkeit, die gerade nicht verfuegbar ist).
fn handle_voice token cid dbh msg
    voice: get msg "voice"
    tel.tel_send_chat_action token cid "typing"
    fpath: tel.tel_get_file token (get voice "file_id")
    if fpath == nil
        tel.tel_send_message token cid "Sprachnachricht konnte nicht abgerufen werden."
        return nil
    raw: tel.tel_download_file token fpath
    if raw == nil || raw == ""
        tel.tel_send_message token cid "Sprachnachricht war leer oder nicht lesbar."
        return nil
    --! Frisches Tool-Budget fuer die Transkription: tool_call laeuft unter dem
    --! AKTUELL aktiven Sandbox-Profil und verbraucht dessen max_tool_calls-
    --! Kontingent. Ueber den normalen Nachrichtenfluss wurden diese Profile nur
    --! vor Gremium-Laefen zurueckgesetzt (setup_sandbox), NIE auf dem Sprachweg
    --! — dadurch schlug der whisper-Aufruf bei einer spaeten Sprachnachricht
    --! mit "E_SANDBOX: max tool calls exceeded" fehl, waerend die erste noch
    --! funktionierte (frisches Profil). Wie bei den Gremium-Aufrufstellen hier
    --! ein frisches Budget setzen, bevor transkribiert wird.
    setup_sandbox all_mcp_servers
    text: nil
    last_err: nil
    try
        b64: base64_encode raw
        res: tool_call "whisper_transcribe_base64" {audio_base64: b64, extension: "ogg", language: "de"}
        --! tool_call liefert bei einem MCP-Fehler einen Rohtext (kein JSON, z.B.
        --! "mcp call transcribe_base64: ..."). Erst als JSON-Objekt verstehen, wenn
        --! es wirklich mit "{" beginnt; sonst den Rohtext als Fehlergrund notieren.
        if (trim res) != nil && (len (trim res)) > 0 && (substring (trim res) 0 1) == "{"
            try
                j: parse_json res
                text: get j "text"
                if (get j "error") != nil
                    last_err: to_str (get j "error")
            catch e2
                last_err: to_str e2
        else
            last_err: to_str res
    catch e
        last_err: to_str e
    if text == nil || (trim text) == ""
        --! Echten Grund ins Journal loggen statt ihn still zu schlucken (der
        --! alte leere catch lieferte KEINEN Hinweis, warum die Transkription
        --! fehlschlug). Dem Nutzer ehrlich mitteilen, dass es fehlgeschlagen ist.
        if last_err != nil
            print ("whisper_transcribe_base64 fehlgeschlagen: " ++ last_err)
        tel.tel_send_message token cid "Sprachnachrichten verstehe ich gerade nicht (Transkription nicht verfuegbar oder fehlgeschlagen). Bitte tippe es."
        return nil
    handle_message token cid (trim text) dbh

--! Verarbeitet eine eingehende Textnachricht und antwortet.
fn handle_message token cid text dbh
    if text == nil
        return nil
    tnorm: trim text
    if tnorm == ""
        return nil
    low: lower tnorm
    if low == "/start" || low == "/hello" || low == "hallo" || low == "hi"
        tel.tel_send_message token cid (greeting_text 0)
        return nil
    if low == "/help" || low == "hilfe" || low == "help"
        tel.tel_send_message token cid (help_text 0)
        return nil
    if low == "/status"
        tel.tel_send_message token cid (status_text dbh)
        return nil
    if low == "/costs"
        tel.tel_send_chat_action token cid "typing"
        tel.tel_send_message token cid (shorten (costs_text dbh))
        return nil
    if low == "/list"
        tel.tel_send_message token cid (list_text dbh)
        return nil
    if low == "/reminders"
        rows: sched.list dbh cid
        if (len rows) == 0
            tel.tel_send_message token cid "Keine offenen Erinnerungen oder Briefings geplant."
        else
            out: "Offene Erinnerungen/Briefings:\n"
            for r in rows
                out: out ++ "• [" ++ (get r "kind") ++ "] " ++ (get r "note") ++ " — am " ++ (format_time ((get r "due_ts") + tz_offset) "2006-01-02 15:04:05") ++ "\n"
            tel.tel_send_message token cid (shorten out)
        return nil
    if low == "/briefing stop"
        rows: sched.list dbh cid
        cancelled: 0
        for r in rows
            if (get r "kind") == "briefing"
                sched.cancel dbh (get r "id")
                cancelled: cancelled + 1
        if cancelled > 0
            tel.tel_send_message token cid "Tägliches Briefing abbestellt."
        else
            tel.tel_send_message token cid "Kein aktives Briefing gefunden."
        return nil
    if low == "/briefing"
        rows: sched.list dbh cid
        for r in rows
            if (get r "kind") == "briefing"
                sched.cancel dbh (get r "id")
        bt: parse_briefing_time briefing_time
        nsec: now
        first_due: sched.next_hhmm (get bt "hh") (get bt "mm") nsec tz_offset
        sched.schedule dbh "briefing" (to_str cid) "Tägliches Briefing" first_due "daily"
        tel.tel_send_message token cid ("Tägliches Briefing aktiv — ich melde mich das nächste Mal um " ++ (format_time (first_due + tz_offset) "15:04") ++ " (und danach täglich).")
        return nil
    rq: remind_query low tnorm
    if rq != ""
        nsec2: now
        parsed: sched.parse_reminder rq nsec2 tz_offset
        sched.schedule dbh "reminder" (to_str cid) (get parsed "text") (get parsed "due") (get parsed "repeat")
        tel.tel_send_message token cid ("Notiert — ich erinnere dich am " ++ (format_time ((get parsed "due") + tz_offset) "2006-01-02 15:04:05") ++ " an: " ++ (get parsed "text"))
        return nil
    if low == "/reset"
        mem.close_thread dbh cid
        tel.tel_send_message token cid "Gespraechsverlauf zurueckgesetzt — ich starte den Kontext frisch."
        return nil
    if low == "/consolidate"
        tel.tel_send_chat_action token cid "typing"
        res: mem.consolidate dbh
        tel.tel_send_message token cid ("Konsolidierung: " ++ (to_str (get res "threads_summarized")) ++ " Threads verdichtet, " ++ (to_str (get res "memories_decayed")) ++ " Erinnerungen gealtert, " ++ (to_str (get res "memories_forgotten")) ++ " vergessen.")
        return nil
    if low == "/graph"
        tel.tel_send_message token cid "Bitte gib eine Entität an: /graph <Name>"
        return nil
    gname: graph_query low tnorm
    if gname != ""
        n: mem.neighbors_of dbh gname
        if (len n) == 0
            tel.tel_send_message token cid ("Keine Verknüpfungen zu '" ++ gname ++ "' im Wissensgraphen gefunden.")
        else
            out: gname ++ ":\n"
            for x in n
                out: out ++ "• " ++ (get x "rel") ++ " → " ++ (get x "target") ++ "\n"
            tel.tel_send_message token cid (shorten out)
        return nil
    if low == "/search"
        tel.tel_send_message token cid "Bitte gib einen Suchbegriff an: /search <begriff>"
        return nil
    sq: search_query low tnorm
    if sq != ""
        do_search token cid dbh sq
        return nil
    if low == "/learn"
        tel.tel_send_message token cid "Bitte gib eine URL an: /learn <URL> — oder schick mir direkt eine .txt/.md-Datei."
        return nil
    lurl: learn_query low tnorm
    if lurl != ""
        tel.tel_send_chat_action token cid "typing"
        dtext: web.web_fetch_raw lurl
        if dtext == nil || dtext == ""
            tel.tel_send_message token cid "Seite nicht abrufbar oder leer."
            return nil
        res: mem.ingest_document dbh dtext lurl lurl 20
        tel.tel_send_message token cid ("Gelernt aus " ++ lurl ++ ": " ++ (to_str (get res "chunks_ingested")) ++ " von " ++ (to_str (get res "chunks_total")) ++ " Abschnitten gespeichert.")
        return nil
    if contains low "was kannst du"
        tel.tel_send_message token cid (capability_text 0)
        return nil
    if is_mcp_server_question low
        names: list_configured_mcp_aliases 0
        if (len names) == 0
            tel.tel_send_message token cid "Aktuell sind keine MCP-Server konfiguriert."
        else
            available: "Verfügbare MCP-Server: " ++ (join names ", ") ++ "."
            tool_names: connected_mcp_tool_names 0
            if (len tool_names) > 0
                available: available ++ " Verfügbare Tools: " ++ (join tool_names ", ") ++ "."
            tel.tel_send_message token cid available
        return nil
    --! Ab hier: EIN gemeinsamer Pfad fuer das gesamte freie Gespraech. Frueher
    --! stand hier eine vorab-Klassifikation (regelbasiert + ein kontextfreier
    --! KI-Einwort-Aufruf) in sechs isolierte Toepfe (reminder/permanent/task/
    --! goal/fleeting/question), von denen nur "question" wirklich Werkzeuge,
    --! Gedaechtnis und Gespraechsverlauf hatte. Das fuehrte zu widerspruechlichem
    --! Verhalten bei identischem Text (je nachdem, welchen Topf die KI beim
    --! naechsten Aufruf traf) und zu einem blind JSON-Schritte erfindenden
    --! "task"-Executor ohne jeden Kontext (siehe Plan.md-Diskussion). Jetzt
    --! bekommt das Gremium (schon fuer "question" bewaehrt: echte Werkzeuge,
    --! Gedaechtnis, Verlauf) IMMER den vollen Kontext und entscheidet selbst,
    --! ob es merkt, eine Erinnerung plant, recherchiert oder einfach antwortet.
    ensure_mcp_for_task tnorm
    tel.tel_send_chat_action token cid "typing"
    tid: mem.active_thread dbh cid
    hist: mem.thread_history dbh tid 12
    task: tnorm
    if (len hist) > 0
        task: "Bisheriger Gespraechsverlauf (aeltester zuerst, ungekuerzt):\n" ++ (mem.format_history hist) ++ "\nAktuelle Nachricht: " ++ tnorm
    mem.log_event dbh (to_str cid) tnorm "chat"
    --! Live-Status: EINE Platzhalter-Nachricht senden und per editMessageText
    --! immer wieder aktualisieren, statt neuer Nachrichtenbloecke oder
    --! komplettem Schweigen waehrend das Gremium arbeitet (siehe
    --! swarm_status_text/tel_finalize unten, run_gremium_stream in swarm.pipe).
    message_id: nil
    ph: tel.tel_send_message token cid "🧠 Denke nach..."
    if (get ph "ok") == true
        message_id: get (get ph "result") "message_id"
    on_update: make_swarm_updater token cid message_id
    setup_sandbox all_mcp_servers
    answer: ""
    try
        res: grm.run_gremium_stream dbh cid task on_update
        answer: get res "content"
    catch
        answer: ""
    mem.add_message dbh tid cid "user" tnorm
    if question_needs_research answer
        tel_finalize token cid message_id "Kein Wissen darüber. Recherchiere..." nil
        do_search token cid dbh tnorm
        return nil
    if answer == nil || answer == ""
        ctx: mem.retrieve_context dbh tnorm 3
        if (len ctx) > 0
            ctx_text: join ctx "\n\n"
            reply: ""
            try
                reply: ai_chat ((grm.self_context 0) ++ "Du bist Muninn, ein persoenlicher KI-Assistent. Beantworte die Frage anhand des folgenden Kontexts knapp und faktentreu. Wenn der Kontext nichts Passendes enthaelt, sage ehrlich, dass du es nicht weisst. Gib nur die Antwort aus, kein internes Reasoning.") ("Frage: " ++ tnorm ++ "\n\nKontext:\n" ++ ctx_text)
            catch
                reply: ""
            if reply == nil || reply == ""
                reply: "Dazu erinnere ich mich an:\n"
                for c in ctx
                    reply: reply ++ "• " ++ c ++ "\n"
            mem.add_message dbh tid cid "assistant" reply
            tel_finalize token cid message_id reply nil
        else
            tel_finalize token cid message_id "Kein Wissen darüber. Recherchiere..." nil
            rr: web.research tnorm
            ctx2: get rr "context"
            srcs2: get rr "sources"
            if ctx2 == nil || ctx2 == ""
                fallback: "Ich konnte online nichts Relevantes finden."
                mem.add_message dbh tid cid "assistant" fallback
                tel_finalize token cid message_id fallback nil
            else
                answer2: ""
                try
                    answer2: ai_chat ((grm.self_context 0) ++ "Du bist Muninn, ein persoenlicher KI-Assistent. Beantworte die Frage anhand des recherchierten Kontexts knapp und faktentreu — der Kontext stammt aus einer WEB-Recherche zum Thema der Frage, NICHT aus einer Recherche ueber Muninn selbst. Geht es in der Frage um Muninns eigene Faehigkeiten/Werkzeuge, nutze dafuer das Selbstwissen oben, nicht den Web-Kontext. WICHTIG: Dieser Aufruf hier ist reine Textzusammenfassung OHNE Werkzeugzugriff — behaupte NIEMALS, gerade etwas zu tun/recherchieren/einzurichten oder Schritte einzuleiten. Ist die Anfrage eine AKTION (z.B. 'richte X ein', 'lege einen Container an') statt einer Wissensfrage, erklaere knapp, dass du das ueber deine echten Werkzeuge tun kannst, und bitte den Nutzer, es nochmal als direkte Aufforderung zu senden. Gib nur die Antwort aus, kein internes Reasoning.") ("Frage: " ++ tnorm ++ "\n\nKontext:\n" ++ ctx2)
                catch
                    answer2: ctx2
                if answer2 == nil || answer2 == ""
                    answer2: ctx2
                mem.add_memory dbh (mem.condense_fact answer2) "fact" 3 "web_research" "web"
                mem.add_message dbh tid cid "assistant" answer2
                src_text: ""
                for u in srcs2
                    src_text: src_text ++ "\n" ++ u
                full: (shorten answer2) ++ "\n— Quellen:" ++ (shorten src_text)
                kb: []
                row: []
                push row (tel.tel_button "💾 Merken" "save")
                push row (tel.tel_button "🔍 Vertiefen" "more")
                push kb row
                row2: []
                push row2 (tel.tel_button "👍" "up")
                push row2 (tel.tel_button "👎" "down")
                push kb row2
                tel_finalize token cid message_id (shorten full) kb
    else
        mem.add_message dbh tid cid "assistant" answer
        kb: []
        row: []
        push row (tel.tel_button "💾 Merken" "save")
        push row (tel.tel_button "🔍 Vertiefen" "more")
        push kb row
        row2: []
        push row2 (tel.tel_button "👍" "up")
        push row2 (tel.tel_button "👎" "down")
        push kb row2
        tel_finalize token cid message_id (shorten answer) kb

--! Kappt einen Status-Schnipsel auf n Zeichen (fuer die Live-Statuszeile —
--! anders als shorten (4000 Zeichen, fuer Telegram-Nachrichten) hier bewusst
--! kurz, damit eine einzelne Werkzeug-Zeile nicht die ganze Statusnachricht sprengt.
fn truncate_status s n
    if s == nil
        return ""
    if (len s) > n
        (substring s 0 n) ++ "…"
    else
        s

--! Zieht aus den rohen JSON-Argumenten eines Werkzeugaufrufs einen kurzen,
--! menschenlesbaren Schnipsel (die echte Suchanfrage/URL/o.ae., nicht nur der
--! Werkzeugname) — fuer bekannte lokale Werkzeuge (siehe ai_tool-Registrierung
--! in swarm.pipe) gezielt nach dem passenden Feld, sonst best-effort das erste
--! String-Feld in den Argumenten (deckt MCP-Werkzeuge mit unbekanntem Schema ab).
fn tool_arg_summary tool_name args_json
    if args_json == nil || args_json == ""
        return ""
    a: nil
    try
        a: parse_json args_json
    catch
        a: nil
    if a == nil || (type_of a) != "MAP"
        return ""
    field: nil
    if tool_name == "web_search" || tool_name == "erinnerungen_suchen"
        field: get a "query"
    else if tool_name == "web_fetch"
        field: get a "url"
    else if tool_name == "erinnerung_planen"
        field: get a "text"
    else if tool_name == "merken" || tool_name == "merken_quelle"
        field: get a "content"
    else if tool_name == "docker_pull_image"
        field: get a "image"
    else if tool_name == "docker_create_container"
        field: get a "name"
    else if tool_name == "bild_senden" || tool_name == "datei_senden"
        field: get a "path"
    if field == nil
        for k in (keys a)
            v: get a k
            if field == nil && (type_of v) == "STRING" && v != ""
                field: v
    if field == nil || field == ""
        return ""
    truncate_status (to_str field) 70

--! Uebersetzt einen Gremium-Fortschritts-Schritt (siehe ai_swarm_stream/
--! run_gremium_stream) in eine kurze Statuszeile fuers Live-Editieren der
--! Telegram-Platzhalternachricht. "handoff"/"final" werden vom Aufrufer schon
--! rausgefiltert (der naechste "start" zeigt den neuen Agenten ohnehin an).
fn swarm_status_text agent event detail args_json
    label: "🧠 " ++ agent ++ " denkt nach..."
    if agent == "planer"
        label: "🧭 Plane die Antwort..."
    else if agent == "faktenwaechter"
        label: "🔍 Prüfe Fakten und Gedächtnis..."
    else if agent == "kritiker"
        label: "🧐 Prüfe die Antwort..."
    else if agent == "registrator"
        label: "✍️ Schreibe die Antwort..."
    else if (len agent) > 9 && (substring agent 0 9) == "werkzeug_"
        label: "🔧 Nutze " ++ (substring agent 9 (len agent)) ++ "..."
    if event == "tool" && detail != nil && detail != ""
        label: label ++ "\n→ ruft " ++ detail ++ " auf"
        arg_hint: tool_arg_summary detail args_json
        if arg_hint != ""
            label: label ++ " (" ++ arg_hint ++ ")"
    label

--! Baut die on_update-Closure fuer run_gremium_stream: uebersetzt jeden
--! Fortschritts-Schritt in eine Statuszeile und editiert damit (gedrosselt
--! auf ca. 1x/Sekunde, keine Wiederholungen) die per message_id referenzierte
--! Platzhalternachricht. message_id darf nil sein (Platzhalter-Versand
--! fehlgeschlagen) — dann ist die Closure ein No-op.
fn make_swarm_updater token cid message_id
    stream_state: {last_text: "", last_ms: 0}
    fn on_update agent event detail args_json
        if event == "handoff" || event == "final"
            return nil
        text: swarm_status_text agent event detail args_json
        if text == (get stream_state "last_text")
            return nil
        ms: time_ms
        if (ms - (get stream_state "last_ms")) < 1000
            return nil
        set stream_state "last_text" text
        set stream_state "last_ms" ms
        if message_id != nil
            tel.tel_edit_message_text token cid message_id text
    on_update

--! Schliesst eine Live-Status-Nachricht mit dem Endergebnis ab: editiert die
--! per message_id referenzierte Platzhalternachricht (optional mit Tastatur
--! kb), faellt aber auf eine neue Nachricht zurueck, wenn message_id fehlt
--! (Platzhalter konnte nicht gesendet werden) oder der Edit selbst scheitert
--! (z.B. Nutzer hat die Nachricht geloescht) — so geht nie eine fertige
--! Antwort verloren.
fn tel_finalize token cid message_id text kb
    if message_id == nil
        if kb == nil
            return (tel.tel_send_message token cid text)
        return (tel.tel_send_message_kb token cid text kb)
    r: nil
    if kb == nil
        r: tel.tel_edit_message_text token cid message_id text
    else
        r: tel.tel_edit_message_text_kb token cid message_id text kb
    if (get r "ok") == false
        if kb == nil
            r: tel.tel_send_message token cid text
        else
            r: tel.tel_send_message_kb token cid text kb
    r

--! Prüft, ob eine KI-Antwort einen "ich weiß es nicht"-Fallback darstellt,
--! der nach einer Web-Recherche auffordert.
fn question_needs_research answer
    if answer == nil || answer == ""
        return true
    low: lower answer
    if contains low "ich weiß es nicht"
        return true
    if contains low "ich weiss es nicht"
        return true
    if contains low "weis es nicht"
        return true
    if contains low "kein wissen"
        return true
    if contains low "kein wissen darüber"
        return true
    if contains low "keine informationen"
        return true
    if contains low "keine relevanten informationen"
        return true
    if contains low "keine ahnung"
        return true
    if contains low "ich kenne keine"
        return true
    if contains low "ich kann dir nicht sagen"
        return true
    if contains low "ich weiss nichts"
        return true
    if contains low "ich weiß nichts"
        return true
    if contains low "konnte keine"
        return true
    if contains low "echtzeitdaten"
        return true
    if contains low "echtzeitzugriff"
        return true
    if contains low "keine echtzeit"
        return true
    if contains low "als sprachmodell"
        return true
    if contains low "kein internetzugriff"
        return true
    if contains low "keinen zugriff auf das internet"
        return true
    if contains low "kann ich nicht abrufen"
        return true
    if contains low "aktuell nicht bekannt"
        return true
    false

--! Liefert eine direkte Übersicht der Fähigkeiten statt einer Faktenantwort.
fn capability_text _
    "Ich kann dich unterstützen bei:\n• Fragen beantworten und bei fehlendem Wissen selbstständig im Web recherchieren\n• Informationen mit Quellen in meiner Seele speichern und später wiederfinden\n• Aufgaben planen und über den Executor ausführen\n• Ziele und zeitgesteuerte Erinnerungen verwalten\n• Wissensgraphen und Dokumente aufbauen\n• Fotos verstehen und beschreiben (einfach schicken, optional mit Bildunterschrift als Frage)\n• Bilder auf Anfrage generieren (kostenloser KI-Bildgenerator)\n• Sprachnachrichten verstehen (lokale Transkription, kein API-Key)\n• angebundene MCP-Werkzeuge kontrolliert nutzen\n• Telegram und das Web-Dashboard bedienen\n\nSchreib einfach eine Frage oder eine konkrete Aufgabe."

--! Kürzt Text auf Telegram-Grenze (4096 Zeichen).
fn shorten s
    if s == nil
        return ""
    if (len s) > 4000
        (substring s 0 4000) ++ "…"
    else
        s

--! Führt eine Web-Recherche aus und antwortet mit Quellen + Buttons.
fn do_search token cid dbh query
    tel.tel_send_chat_action token cid "typing"
    tid: mem.active_thread dbh cid
    mem.add_message dbh tid cid "user" ("/search " ++ query)
    rr: web.research query
    ctx: get rr "context"
    srcs: get rr "sources"
    if ctx == nil || ctx == ""
        fallback: "Keine brauchbaren Ergebnisse gefunden."
        mem.add_message dbh tid cid "assistant" fallback
        tel.tel_send_message token cid fallback
        return nil
    answer: ""
    try
        answer: ai_chat ((grm.self_context 0) ++ "Du bist ein präziser Recherche-Assistent. Beantworte die Frage anhand des recherchierten Kontexts, kurz und faktentreu. WICHTIG: Dieser Aufruf hier ist reine Textzusammenfassung OHNE Werkzeugzugriff — behaupte NIEMALS, du könntest generell keine Dokumente/Dateien erstellen oder versenden (das kannst du sehr wohl, nur nicht in DIESEM Aufruf); erwähnt die Frage sowas, sag stattdessen nur, dass du dafür direkt (nicht als Recherche-Anfrage) gefragt werden musst.") ("Frage: " ++ query ++ "\n\nKontext:\n" ++ ctx)
    catch
        answer: ctx
    mem.add_message dbh tid cid "assistant" answer
    src_text: ""
    for u in srcs
        src_text: src_text ++ "\n" ++ u
    full: (shorten answer) ++ "\n— Quellen:" ++ (shorten src_text)
    kb: []
    row: []
    push row (tel.tel_button "💾 Merken" "save")
    push kb row
    tel.tel_send_message_kb token cid (shorten full) kb
    nil

--! Erkennt eine Such-Intention und liefert den Suchbegriff (oder "").
fn search_query low tnorm
    if (len low) >= 8
        if (substring low 0 8) == "/search "
            return (trim (substring tnorm 8 (len tnorm)))
    if (len low) >= 6
        if (substring low 0 6) == "suche "
            return (trim (substring tnorm 6 (len tnorm)))
    if (len low) >= 12
        if (substring low 0 12) == "recherchiere "
            return (trim (substring tnorm 12 (len tnorm)))
    if (len low) >= 6
        if (substring low 0 6) == "finde "
            return (trim (substring tnorm 6 (len tnorm)))
    ""

--! Erkennt eine /graph-Anfrage und liefert den Entitätsnamen (oder "").
fn graph_query low tnorm
    if (len low) >= 7
        if (substring low 0 7) == "/graph "
            return (trim (substring tnorm 7 (len tnorm)))
    ""

--! Erkennt eine /learn-Anfrage und liefert die URL (oder "").
fn learn_query low tnorm
    if (len low) >= 7
        if (substring low 0 7) == "/learn "
            return (trim (substring tnorm 7 (len tnorm)))
    ""

--! Erkennt eine /remind- ODER frei formulierte "erinnere mich..."-Anfrage und
--! liefert die Erinnerungs-Anweisung (oder ""). Bewusst deterministisch statt
--! ueber das Gremiums-Werkzeug 'erinnerung_planen' gelaufen: beobachtet wurde,
--! dass die KI bei "Erinnere mich in 30 Sekunden..." eine Bestaetigung
--! ausgegeben hat, OHNE das Werkzeug tatsaechlich aufzurufen — kein Eintrag in
--! der 'scheduled'-Tabelle trotz "Ich habe die Erinnerung geplant"-Antwort.
--! Fuer eine derart erwartungsstiftende Zusage darf sich das nicht auf
--! Tool-Call-Befolgung durchs LLM verlassen. 'erinnerung_planen' bleibt fuer
--! implizite Faelle (z.B. "Ich habe morgen einen Termin...") zustaendig, die
--! dieses Muster nicht matchen.
fn remind_query low tnorm
    if (len low) >= 8
        if (substring low 0 8) == "/remind "
            return (trim (substring tnorm 8 (len tnorm)))
    if contains low "erinnere mich"
        return tnorm
    ""

--! Verarbeitet einen Inline-Button-Druck (callback_query).
fn handle_callback token dbh cbq
    cbid: get cbq "id"
    data: get cbq "data"
    msg: get cbq "message"
    chat: get msg "chat"
    cid: get chat "id"
    txt: get msg "text"
    tel.tel_answer_callback token cbid ""
    if data == "save"
        if txt != nil
            mem.add_memory dbh (mem.condense_fact txt) "fact" 3 "telegram" "nutzer"
            tel.tel_send_message token cid "In der Seele gespeichert."
        return nil
    if data == "more"
        if txt != nil
            tel.tel_send_chat_action token cid "typing"
            message_id: nil
            ph: tel.tel_send_message token cid "🧠 Vertiefe..."
            if (get ph "ok") == true
                message_id: get (get ph "result") "message_id"
            on_update: make_swarm_updater token cid message_id
            setup_sandbox all_mcp_servers
            res: grm.run_gremium_stream dbh cid ("Vertiefe bitte diesen Sachverhalt: " ++ txt) on_update
            a: get res "content"
            if a != nil && a != ""
                tid: mem.active_thread dbh cid
                mem.add_message dbh tid cid "assistant" a
                tel_finalize token cid message_id (shorten a) nil
            else
                tel_finalize token cid message_id "Ich konnte leider nichts vertiefen." nil
        return nil
    if data == "up"
        if txt != nil
            n: mem.adjust_by_content dbh txt 1
            if n == 0
                mem.add_memory dbh (mem.condense_fact txt) "fact" 3 "telegram" "feedback"
                tel.tel_send_message token cid "Danke! Ich merke mir das."
            else
                tel.tel_send_message token cid "Danke! Wichtigkeit erhöht."
        return nil
    if data == "down"
        if txt != nil
            mem.adjust_by_content dbh txt (-1)
            tel.tel_send_message token cid "Notiert — ich werte das ab."
        return nil
    tel.tel_send_message token cid "Unbekannte Aktion."

--! Zerlegt BRIEFING_TIME ("HH:MM") in {hh, mm}. Default 08:00.
fn parse_briefing_time raw
    hh: 8
    mm: 0
    if raw != nil && raw != ""
        p: split raw ":"
        if (len p) >= 2
            hh: to_num (trim (at p 0))
            mm: to_num (trim (at p 1))
    out: {}
    set out "hh" hh
    set out "mm" mm
    out

--! Unix-Sekunden von "morgen 00:00" in der konfigurierten Zeitzone (fuer
--! "Termine bis Ende des heutigen Tages" in der Briefing-Anreicherung unten
--! — gleiche Tagesgrenzen-Logik wie next_hhmm in scheduler.pipe).
fn day_end_sec now_sec offset_sec
    shifted: now_sec + offset_sec
    day_start: shifted - (shifted % 86400)
    (day_start + 86400) - offset_sec

--! Ruft das Google-Calendar-MCP-Werkzeug fuer Termine im Zeitfenster ab.
--! Liefert den vom Werkzeug formatierten Text (kein rohes JSON verfuegbar)
--! oder nil bei jedem Fehler (Google nicht verbunden, Token abgelaufen —
--! Testing-Mode-Refresh-Token laeuft nach 7 Tagen ab, siehe README). Rein
--! best-effort: eine fehlgeschlagene proaktive Kalenderpruefung darf nie den
--! Scheduler-Tick oder eine andere Nachricht stoeren.
fn calendar_events_text email time_min_sec time_max_sec
    if email == nil || email == ""
        return nil
    t_min: format_time time_min_sec "2006-01-02T15:04:05Z"
    t_max: format_time time_max_sec "2006-01-02T15:04:05Z"
    try
        return (tool_call "google_get_events" {user_google_email: email, calendar_id: "primary", time_min: t_min, time_max: t_max})
    catch e
        return nil

--! Parst eine get_events-Antwort in [{id, line}, ...]. Kein rohes JSON
--! verfuegbar (nur formatierter Text: '- "Titel" (Starts: ...) ID: <id> |
--! Link: ...' pro Zeile) — daher zeilenweise nach 'ID: ' gesucht. Zerbrechlich
--! gegenueber Formatwechseln des MCP-Servers, aber praktikabler als die
--! Alternative (kein strukturiertes Ergebnis verfuegbar).
fn parse_calendar_events text
    out: []
    if text == nil || text == ""
        return out
    lines: split text "\n"
    for line in lines
        idx: index_of line "ID: "
        if idx >= 0
            rest: substring line (idx + 4) (len line)
            endidx: index_of rest " | Link"
            id: rest
            if endidx >= 0
                id: substring rest 0 endidx
            push out {id: (trim id), line: line}
    out

--! Meta-Schluessel fuer die Dedup-Liste bereits gemeldeter Kalendertermine
--! (Format: "<id>:<unix_ts>,<id>:<unix_ts>,..."). Titel+Startzeit waeren als
--! Dedup-Schluessel auch gegangen, aber get_events liefert eine echte
--! Event-ID im Text mit — zuverlaessiger als Freitext-Abgleich.
NOTIFIED_CAL_KEY: "notified_calendar_events"

--! Laedt die Dedup-Liste, entfernt Eintraege aelter als 24h (damit die Liste
--! bei taeglich wiederkehrenden Terminen nicht unbegrenzt waechst).
fn load_notified_ids dbh
    raw: mem.meta_get dbh NOTIFIED_CAL_KEY
    out: {}
    if raw != nil && raw != ""
        cutoff: now - 86400
        for p in (split raw ",")
            kv: split p ":"
            if (len kv) == 2
                ts: to_num (at kv 1)
                if ts > cutoff
                    set out (at kv 0) ts
    out

fn save_notified_ids dbh idmap
    parts: []
    for id in (keys idmap)
        push parts (id ++ ":" ++ (to_str (get idmap id)))
    mem.meta_set dbh NOTIFIED_CAL_KEY (join parts ",")

--! Proaktive Kalender-Erinnerung: prueft anstehende Termine im konfigurierten
--! Vorlauf-Fenster (calendar_reminder_minutes) und meldet neue (noch nicht
--! gemeldete) Termine einmalig per Telegram — Dedup ueber load_notified_ids/
--! save_notified_ids verhindert Wiederholungen bei jedem 15-Minuten-Takt.
fn calendar_notify_new token dbh cid email window_minutes
    text: calendar_events_text email now (now + window_minutes * 60)
    events: parse_calendar_events text
    if (len events) == 0
        return nil
    notified: load_notified_ids dbh
    changed: false
    for ev in events
        id: get ev "id"
        if (get notified id) == nil
            try
                tel.tel_send_message token (to_num cid) ("📅 Bald: " ++ (get ev "line"))
            catch
                nil
            set notified id now
            changed: true
    if changed
        save_notified_ids dbh notified

--! Scheduler-Tick (P4): feuert fällige Erinnerungen/Briefings proaktiv ab —
--! läuft im Bot-Loop nach jedem Poll, single-threaded (kein Goroutine-/DB-
--! Konflikt, siehe Plan.md). Briefings werden erst beim Feuern aus der Seele
--! zusammengestellt (immer aktuell, kein veralteter Snapshot).
fn sched_tick token
    hl: mem.open_locked nil
    dbh: get hl "h"
    now_sec: now
    due: sched.due dbh now_sec
    for item in due
        kind: get item "kind"
        cid: get item "chat_id"
        msg: get item "note"
        if kind == "briefing"
            msg: sched.compose_briefing dbh
            if mcp.is_connected "google" && user_google_email != nil && user_google_email != ""
                evt: calendar_events_text user_google_email now_sec (day_end_sec now_sec tz_offset)
                if (len (parse_calendar_events evt)) > 0
                    msg: msg ++ "\n\n📅 Termine heute:\n" ++ evt
        if kind == "calendar_check"
            calendar_notify_new token dbh cid user_google_email calendar_reminder_minutes
            sched.mark_fired dbh (get item "id") (get item "repeat") (get item "due_ts")
            continue
        if kind == "goal_tick"
            resumed: exe.resume_running_plans dbh
            if resumed > 0
                tel.tel_send_message token (to_num cid) ("Fortschritt: " ++ (to_str resumed) ++ " unterbrochene Pläne fortgesetzt.")
            sched.mark_fired dbh (get item "id") (get item "repeat") (get item "due_ts")
            continue
        if kind == "job_check"
            --! note-Feld traegt die docker_jobs-Zeilen-ID (siehe
            --! grm.tool_docker_hintergrund_setup). Laeuft der Container noch,
            --! einfach neu einplanen — KEIN Telegram-Spam bei jedem Tick, nur
            --! bei tatsaechlichem Abschluss meldet sich Muninn.
            job: dt.get_job dbh (to_num (get item "note"))
            still_running: job != nil && (get job "status") == "running"
            if still_running
                sched.mark_fired dbh (get item "id") "5min" (get item "due_ts")
                continue
            beschreibung: "unbekannt"
            ergebnis: "Job nicht gefunden."
            if job != nil
                beschreibung: get job "description"
                ergebnis: (get job "status") ++ ": " ++ (to_str (get job "result"))
            --! Frisches Tool-Budget wie an den beiden regulaeren
            --! run_gremium_stream-Aufrufstellen — dieser Lauf startet
            --! ausserhalb des normalen Nachrichtenflusses, hat also noch
            --! kein aktuelles Sandbox-Profil fuer DIESE Anfrage.
            setup_sandbox all_mcp_servers
            continuation: "Ein zuvor im Hintergrund gestartetes Docker-Setup ist abgeschlossen. Beschreibung: " ++ beschreibung ++ ". Ergebnis: " ++ ergebnis ++ ". Berichte dem Nutzer knapp und sauber formatiert, was passiert ist. Braucht die urspruengliche Aufgabe noch einen naechsten Schritt, stosse ihn direkt an (z.B. erneuter Aufruf von 'docker_hintergrund_setup')."
            res: grm.run_gremium dbh (to_num cid) continuation
            tel.tel_send_message token (to_num cid) (get res "content")
            sched.cancel dbh (get item "id")
            continue
        if kind == "task_check"
            --! Generische Fortsetzung (siehe grm.tool_hintergrund_fortsetzen) —
            --! im Gegensatz zu job_check oben gibt es hier KEINEN billigen
            --! externen Status-Check: das Gremium bekommt einfach ein
            --! frisches Rundenbudget und arbeitet mit dem gespeicherten
            --! Fortschritt weiter. Ist es JETZT fertig, antwortet es normal;
            --! ist es noch nicht fertig, ruft es 'hintergrund_fortsetzen'
            --! selbst erneut auf (das legt einen NEUEN Checkpoint + neuen
            --! Scheduler-Eintrag an) — DIESER Eintrag hier wird in jedem Fall
            --! abgeschlossen, die Kette laeuft ueber den neuen Eintrag weiter.
            t: sched.get_background_task dbh (to_num (get item "note"))
            if t == nil
                sched.cancel dbh (get item "id")
                continue
            setup_sandbox all_mcp_servers
            continuation2: "Du arbeitest an einer zuvor zurueckgestellten Aufgabe weiter. Urspruengliche Aufgabe: " ++ (get t "task") ++ ". Bisheriger Fortschritt: " ++ (get t "progress") ++ ". Setze die Arbeit fort. Bist du JETZT fertig, teile dem Nutzer das Endergebnis klar mit. Bist du NOCH NICHT fertig, rufe 'hintergrund_fortsetzen' erneut auf mit dem aktualisierten Fortschritt."
            res2: grm.run_gremium dbh (to_num cid) continuation2
            tel.tel_send_message token (to_num cid) (get res2 "content")
            sched.cancel dbh (get item "id")
            continue
        if kind == "proaktiv"
            --! Proaktiver Eigenimpuls (P4): Muninn wurde NICHT angesprochen —
            --! das Gremium entscheidet selbst, ob sich eine Nachricht lohnt.
            --! Schweigen ist hier ein vollwertiges Ergebnis ("NICHTS"), sonst
            --! spammt der taegliche Tick den Nutzer mit Leermeldungen zu.
            setup_sandbox all_mcp_servers
            prompt_proaktiv: "PROAKTIVER IMPULS (du wurdest NICHT angesprochen — entscheide selbst, ob sich eine Nachricht an den Nutzer lohnt): Sieh mit 'erinnerungen_suchen' in dein Gedaechtnis: gibt es offene/angefangene Aufgaben, unterbrochene Arbeiten, bald faellige Termine oder wichtige Entwicklungen zu Themen, die den Nutzer beschaeftigen — etwas, das der Nutzer selbst ansprechen wuerde? Gibt es etwas WICHTIGES: schreibe die kurze, konkrete Nachricht an den Nutzer; findest du eine Aufgabe, die du zu einem bestimmten Zeitpunkt wieder aufgreifen solltest, plane das selbst mit 'erinnerung_planen' bzw. 'hintergrund_fortsetzen'. Gibt es NICHTS Nennenswertes: antworte AUSSCHLIESSLICH mit dem einzelnen Wort NICHTS, ohne weitere Zeichen."
            res_proaktiv: grm.run_gremium dbh (to_num cid) prompt_proaktiv
            sched.mark_fired dbh (get item "id") (get item "repeat") (get item "due_ts")
            content_proaktiv: get res_proaktiv "content"
            if content_proaktiv != nil && (lower (trim content_proaktiv)) != "nichts" && (trim content_proaktiv) != ""
                tel.tel_send_message token (to_num cid) (shorten (trim content_proaktiv))
            continue
        if cid != nil && cid != ""
            try
                tel.tel_send_message token (to_num cid) msg
            catch
                nil
        sched.mark_fired dbh (get item "id") (get item "repeat") (get item "due_ts")
    mem.close_locked hl
    nil

--! Ein Polling-Zyklus. Liefert die letzte verarbeitete update_id zurück.
--! DB-Sperre (mem.open_locked/close_locked) bewusst NICHT um den ganzen
--! Zyklus, sondern nur um die tatsaechlichen DB-Zugriffe: tel_get_updates
--! wartet per Long-Polling bis zu `timeout` Sekunden auf neue Nachrichten —
--! waere die Sperre die ganze Zeit gehalten, koennte das Web-Dashboard
--! waehrenddessen so gut wie nie an die DB. So haelt jeder Kanal die Sperre
--! nur, waehrend er tatsaechlich etwas verarbeitet (siehe Plan.md zur
--! Nebenlaeufigkeit). timeout (Sekunden) kappt der P4-Scheduler dynamisch
--! auf "Zeit bis zur naechsten faelligen Aufgabe".
fn poll_once token offset allowed timeout
    hl: mem.open_locked nil
    dbh: get hl "h"
    if offset == nil
        saved: mem.meta_get dbh "telegram_offset"
        if saved != ""
            offset: to_num saved
    mem.close_locked hl
    updates: []
    try
        updates: tel.tel_get_updates token offset timeout
    catch
        updates: []
    hl2: mem.open_locked nil
    dbh2: get hl2 "h"
    for upd in updates
        uid: get upd "update_id"
        if uid != nil
            offset: uid + 1
        msg: get upd "message"
        if msg != nil
            chat: get msg "chat"
            if chat != nil
                cid: get chat "id"
                if is_allowed cid allowed
                    try
                        handle_update token cid msg dbh2
                    catch
                        nil
        cq: get upd "callback_query"
        if cq != nil
            chat2: get (get cq "message") "chat"
            if chat2 != nil
                cid2: get chat2 "id"
                if is_allowed cid2 allowed
                    try
                        handle_callback token dbh2 cq
                    catch
                        nil
    if offset != nil
        mem.meta_set dbh2 "telegram_offset" (to_str offset)
    mem.close_locked hl2
    offset

--! Geteilter, mutabler Kosten-Zustand fuer maybe_log_cost (siehe dortigen
--! Kommentar zu Pipes Scoping-Regeln — top-level Variablen einfach neu
--! binden persistiert NICHT ueber Funktionsgrenzen hinweg, eine Map schon).
COST_STATE: {session_id: nil, last_calls: -1}

--! Sandbox + KI + MCP + Gremium in einem Rutsch, gemeinsam fuer Telegram- und
--! Web-Modus. Setzt voraus, dass Secrets/Config bereits (vor der Sandbox!)
--! gelesen wurden — siehe die Kommentare bei setup_ai/setup_sandbox.
fn setup_core mcp_servers deepseek_key
    setup_sandbox all_mcp_servers
    setup_ai deepseek_key
    mcp_results: mcp.connect_servers all_mcp_servers
    for r in mcp_results
        if get r "ok"
            print ("MCP verbunden: " ++ (get r "alias"))
        else
            print ("MCP fehlgeschlagen (" ++ (get r "alias") ++ "): " ++ (get r "error"))
    grm.init_gremium 0
    grm.set_tz_offset tz_offset
    hl: mem.open_locked nil
    set COST_STATE "session_id" (mem.next_session_id (get hl "h"))
    mem.close_locked hl
    nil

--! Schreibt einen Kosten-Schnappschuss, wenn sich seit dem letzten Aufruf
--! etwas geaendert hat (ai_cost/ai_tokens sind In-Prozess-Zaehler ueber die
--! GESAMTE Laufzeit — ein Log pro leerem Poll-Zyklus waere reine
--! Tabellen-Blaehung ohne neue Information).
fn maybe_log_cost _
    c: {}
    try
        c: ai_cost
    catch
        return nil
    calls: get c "calls"
    if calls == nil || calls == (get COST_STATE "last_calls")
        return nil
    tk: 0
    try
        tk: ai_tokens
    catch
        tk: 0
    hl: mem.open_locked nil
    mem.log_cost (get hl "h") (get COST_STATE "session_id") (get c "cost_usd") tk calls (get c "cache_hits") (get c "cache_misses")
    mem.close_locked hl
    set COST_STATE "last_calls" calls
    nil

--! CLI-Argumente lesen.
avgs: args
once_mode: false
consolidate_mode: false
web_mode: false
if (len avgs) > 0
    if (at avgs 0) == "once"
        once_mode: true
    if (at avgs 0) == "consolidate"
        consolidate_mode: true
    if (at avgs 0) == "web"
        web_mode: true

--! Alle Secrets/Config-Werte werden VOR der Sandbox-Aktivierung gelesen (siehe
--! setup_ai/setup_sandbox): einmal von vertrauenswürdigem Startup-Code eingesammelt,
--! danach nur noch als Wert weitergereicht — nie erneut per env() nachgefragt.
cfg: load_env ".env"
configured_provider: lower (trim (cfg_get cfg "MUNINN_PROVIDER"))
if configured_provider != nil && configured_provider != "" && configured_provider != "deepseek"
    print ("Muninn nutzt nur DeepSeek; MUNINN_PROVIDER='" ++ configured_provider ++ "' wird ignoriert.")
deepseek_key: cfg_get cfg "DEEPSEEK_API_KEY"
if deepseek_key == nil || deepseek_key == ""
    print "WARNUNG: DEEPSEEK_API_KEY fehlt — Muninn nutzt nur DeepSeek und kann keine KI-Antworten generieren."
dash_bind: cfg_get cfg "DASHBOARD_BIND"
dash_token: cfg_get cfg "DASHBOARD_TOKEN"
briefing_time: cfg_get cfg "BRIEFING_TIME"
tz_offset_raw: cfg_get cfg "MUNINN_TZ_OFFSET"
tz_offset: 0
if tz_offset_raw != nil && tz_offset_raw != ""
    tz_offset: to_num tz_offset_raw
--! Fuer proaktive Kalender-Erinnerungen (siehe calendar_notify_new/sched_tick
--! unten). Kein eigener .env-Schluessel noetig/keine Duplizierung — die
--! Adresse steckt bereits im "google"-Eintrag von MCP_AUTO_SERVERS (siehe
--! .env.example), von dort direkt uebernommen (einzige Quelle der Wahrheit).
calendar_reminder_minutes_raw: cfg_get cfg "CALENDAR_REMINDER_MINUTES"
calendar_reminder_minutes: 30
if calendar_reminder_minutes_raw != nil && calendar_reminder_minutes_raw != ""
    calendar_reminder_minutes: to_num calendar_reminder_minutes_raw
mcp_servers: mcp.parse_mcp_config (cfg_get cfg "MCP_SERVERS")
mcp_servers: mcp.resolve_all_env mcp_servers
mcp_auto_servers: mcp.parse_mcp_config (cfg_get cfg "MCP_AUTO_SERVERS")
mcp_auto_servers: mcp.resolve_all_env mcp_auto_servers
all_mcp_servers: []
for configured_server in mcp_servers
    push all_mcp_servers configured_server
for auto_server in mcp_auto_servers
    push all_mcp_servers auto_server
user_google_email: nil
for s in all_mcp_servers
    if (get s "alias") == "google"
        genv: get s "env"
        if genv != nil
            user_google_email: get genv "USER_GOOGLE_EMAIL"

--! consolidate-Modus (P2, "Traum"): einmaliger Aufraeum-/Verdichtungslauf,
--! z.B. per externem Cron: `pipe muninn.pipe consolidate`. Kein Scheduler in
--! Pipe selbst vor P4 — daher bewusst als eigener CLI-Modus statt Dauer-Loop.
--! Braucht kein Telegram/MCP, nur optional KI fuer die Thread-Zusammenfassung
--! (Fallback ohne KI: erste 800 Zeichen des Verlaufs, siehe consolidate_threads).
if consolidate_mode
    sandbox_profile "consolidate" {fs: "full", network: false, exec: false, ai: true, audit_log: true}
    set_sandbox "consolidate"
    setup_ai deepseek_key
    hl: mem.open_locked nil
    res: mem.consolidate (get hl "h")
    print ("Konsolidierung: " ++ (to_str (get res "threads_summarized")) ++ " Threads verdichtet, " ++ (to_str (get res "memories_decayed")) ++ " Erinnerungen gealtert, " ++ (to_str (get res "memories_forgotten")) ++ " vergessen.")
    mem.close_locked hl
else
    if web_mode
        --! web-Modus (P3): Dashboard statt Telegram-Loop. DASHBOARD_BIND
        --! (Standard: nur localhost — bewusst kein "0.0.0.0", siehe
        --! dashboard.pipe-Kommentar zur Sicherheit) und optional
        --! DASHBOARD_TOKEN aus .env.
        setup_core mcp_servers deepseek_key
        bind: dash_bind
        if bind == nil || bind == ""
            bind: "127.0.0.1:8787"
        dash.start bind dash_token
    else
        tok: cfg_get cfg "TELEGRAM_BOT_TOKEN"
        allowed: cfg_get cfg "TELEGRAM_ALLOWED_CHAT_ID"
        setup_core mcp_servers deepseek_key
        --! Fuer das Gremiums-Werkzeug bild_senden/datei_senden (siehe swarm.pipe)
        --! — braucht den Bot-Token, um selbst an Telegram senden zu koennen.
        grm.set_token tok
        if tok == nil || tok == ""
            print "TELEGRAM_BOT_TOKEN fehlt (Env oder .env). Abbruch."
        else
            print "Muninn gestartet."
            --! Proaktive Kalender-Erinnerungen (siehe calendar_notify_new oben):
            --! automatisch aktiv, sobald Google verbunden UND eine feste
            --! TELEGRAM_ALLOWED_CHAT_ID konfiguriert ist — ohne konfigurierten
            --! Empfaenger gaebe es keine eindeutige Zieladresse fuer eine
            --! unaufgeforderte Nachricht, daher bewusst kein Rateversuch.
            --! Idempotent: registriert nur, wenn noch kein "calendar_check"
            --! fuer diesen Chat existiert (sonst haeufen sich bei jedem
            --! Neustart doppelte Scheduler-Eintraege).
            if mcp.is_connected "google" && allowed != nil && allowed != ""
                hlc: mem.open_locked nil
                dbhc: get hlc "h"
                has_check: false
                for e in (sched.list dbhc allowed)
                    if (get e "kind") == "calendar_check"
                        has_check: true
                if !has_check
                    sched.schedule dbhc "calendar_check" allowed "" (now + 60) "15min"
                    print "Proaktive Kalender-Erinnerungen aktiviert."
                mem.close_locked hlc
            --! Taeglicher proaktiver Eigenimpuls (siehe sched_tick, kind
            --! "proaktiv"): Muninn schaut einmal taeglich von sich aus ins
            --! Gedaechtnis (offene Aufgaben, angefangene Arbeiten, Themen)
            --! und meldet sich NUR, wenn es etwas Wichtiges gibt — sonst
            --! Schweigen. Braucht eine feste TELEGRAM_ALLOWED_CHAT_ID als
            --! Zieladresse (wie calendar_check oben). Idempotent: nur EIN
            --! "proaktiv"-Eintrag pro Chat, sonst haeufen sich bei jedem
            --! Neustart Doppel-Ticks.
            if allowed != nil && allowed != ""
                hlp: mem.open_locked nil
                dbhp: get hlp "h"
                has_proaktiv: false
                for e in (sched.list dbhp allowed)
                    if (get e "kind") == "proaktiv"
                        has_proaktiv: true
                if !has_proaktiv
                    proaktiv_due: sched.next_hhmm 12 0 now tz_offset
                    sched.schedule dbhp "proaktiv" allowed "" proaktiv_due "daily"
                    print "Taeglicher proaktiver Eigenimpuls aktiviert."
                mem.close_locked hlp
            try
                cmds: []
                push cmds {command: "start", description: "Begrüßung"}
                push cmds {command: "help", description: "Alle Befehle anzeigen"}
                push cmds {command: "status", description: "Zustand von Muninn"}
                push cmds {command: "costs", description: "KI-Betriebskosten zusammengefasst"}
                push cmds {command: "list", description: "Wichtigste Erinnerungen"}
                push cmds {command: "search", description: "Im Web suchen"}
                push cmds {command: "learn", description: "Dokument/URL lernen"}
                push cmds {command: "graph", description: "Wissensgraph abfragen"}
                push cmds {command: "remind", description: "Erinnerung planen"}
                push cmds {command: "reminders", description: "Offene Erinnerungen/Briefings"}
                push cmds {command: "briefing", description: "Tägliches Briefing an/aus"}
                push cmds {command: "reset", description: "Gesprächsverlauf zurücksetzen"}
                push cmds {command: "consolidate", description: "Traum: Gedächtnis verdichten"}
                tel.tel_set_my_commands tok cmds
            catch
                nil
            off: nil
            if once_mode
                print "once-Modus: ein Zyklus"
                off: poll_once tok off allowed 25
                print "once-Zyklus fertig."
            else
                while true
                    try
                        timeout: 25
                        hl0: mem.open_locked nil
                        dbh0: get hl0 "h"
                        nxt: sched.next_due_ms dbh0 (now)
                        mem.close_locked hl0
                        if nxt != nil && nxt < 25000
                            timeout: nxt / 1000
                            if timeout < 1
                                timeout: 1
                        off: poll_once tok off allowed timeout
                        sched_tick tok
                        maybe_log_cost 0
                    catch e
                        print ("Zyklus-Fehler — versuche erneut: " ++ (to_str e))
                    --! systemd-Watchdog-Heartbeat: bewusst AUSSERHALB des
                    --! try/catch oben, damit auch ein abgefangener
                    --! Zyklus-Fehler als "lebt noch, iteriert weiter"
                    --! zaehlt — nur ein echter Haenger (gar kein Code laeuft
                    --! mehr, siehe Kommentar bei WatchdogSec in
                    --! muninn.service) laesst diesen Aufruf ausbleiben.
                    --! try/catch hier: best-effort, kein NOTIFY_SOCKET
                    --! gesetzt (z.B. manueller Testlauf ausserhalb von
                    --! systemd) darf die Hauptschleife nicht stoppen.
                    try
                        exec "systemd-notify WATCHDOG=1"
                    catch
                        nil
