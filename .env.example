# Muninn — Konfiguration (Kopiere nach .env und fülle aus. .env ist gitignored!)
# Hol dir einen Token von @BotFather:  /newbot
TELEGRAM_BOT_TOKEN=123456:ABC...
# Deine Telegram-Nutzer-ID (nur diese Chat-ID darf den Bot nutzen). Von @userinfobot.
TELEGRAM_ALLOWED_CHAT_ID=
# Muninn nutzt derzeit nur den DeepSeek-Provider. Andere Werte werden ignoriert,
# weil die aktuelle Implementierung hardcodiert auf DeepSeek setzt.
MUNINN_PROVIDER=deepseek
# DeepSeek API-Key für Klassifikation, Gremium, Zusammenfassung und Bilder.
DEEPSEEK_API_KEY=

# Optional (P1): externe MCP-Server als Werkzeuge einbinden (JSON-Liste, einzeilig).
# Jeder Eintrag: {"alias": "...", "type": "stdio"|"sse", "command"/"url", "args", "env"}.
# "env"-Werte im Format "env:NAME" werden zur Laufzeit aus der echten Umgebung gelesen,
# damit Secrets (z.B. GITHUB_TOKEN) nicht doppelt hier stehen muessen.
# stdio-Server laufen unter einer exec-Whitelist, die NUR die hier konfigurierten
# Kommandos zulaesst. Leer lassen = MCP deaktiviert (kein exec noetig).
# Beispiel:
# MCP_SERVERS=[{"alias":"fs","type":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/root/muninn/mcp_data"]}]
MCP_SERVERS=
# Vertrauenswuerdige MCP-Server fuer autonome Nutzung bei passendem Bedarf.
# Alle folgenden Pakete wurden im npm-Registry geprueft und verbinden ohne
# zusaetzliche API-Keys. Jeder verbundene Server bekommt automatisch einen
# eigenen Spezial-Agenten im Gremium (P5, siehe swarm.pipe/init_gremium) —
# einfach anhaengen, kein Code-Umbau noetig.
# Eintrag zusaetzlich mit "keywords" versehen; gestartet wird erst bei Treffer.
# - Filesystem: nur der dedizierte mcp_data-Ordner wird freigegeben.
# - Memory: persistente Wissensgraph-Funktionen des MCP-Servers.
# - Sequential-Thinking: strukturiertes Durchdenken komplexer Anfragen.
# - Browser (Playwright, offiziell von Microsoft): echte Web-Interaktion
#   (navigieren, klicken, Formulare, Screenshots). --executable-path zeigt auf
#   einen bereits vorhandenen Chrome-Testbinary, damit kein zusaetzlicher
#   Playwright-eigener Browser-Download noetig ist — Pfad ggf. anpassen/
#   entfernen, wenn Playwright seinen eigenen Browser verwalten soll.
# GitHub kann bei vorhandenem GITHUB_TOKEN zusaetzlich aktiviert werden.
# MCP_AUTO_SERVERS=[{"alias":"filesystem","type":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/root/muninn/mcp_data"],"keywords":["datei","dateien","filesystem","ordner"]},{"alias":"memory","type":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-memory"],"keywords":["wissen","wissensgraph","entitaet","beziehung"]},{"alias":"denkwerkzeug","type":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-sequential-thinking"],"keywords":["komplex","plane","durchdenke","analysiere","strategie","abwaegen"]},{"alias":"browser","type":"stdio","command":"npx","args":["-y","@playwright/mcp@latest","--headless","--executable-path","/root/.cache/puppeteer/chrome/linux-148.0.7778.97/chrome-linux64/chrome"],"keywords":["browser","webseite","website","navigiere","screenshot","klick","formular","internetseite","oeffne die seite"]}]
MCP_AUTO_SERVERS=

# Google Workspace (Gmail, Drive, Kalender) ueber den Server
# taylorwilsdon/google_workspace_mcp (Python/uvx, MIT, ~3k Sterne). Braucht
# echtes OAuth 2.0 (kein einfacher API-Key) — siehe README fuer die
# Einrichtung in der Google Cloud Console. Tokens landen NICHT in mcp_data
# (das waere ueber den Filesystem-MCP-Server erreichbar), sondern in
# google_creds/ (gitignored, chmod 700).
# WICHTIG: Anders als bei MCP_SERVERS liest "env:NAME" hier NUR aus der
# ECHTEN Prozessumgebung, NICHT aus dieser .env-Datei (load_env baut nur eine
# Pipe-interne Map, exportiert nichts per os.Setenv) — "env:GOOGLE_..." wuerde
# also still zu "nil" aufloesen. Die Google-Werte deshalb unten DIREKT als
# Literal in den MCP_AUTO_SERVERS-Eintrag schreiben (.env ist gitignored, das
# ist hier unproblematisch), nicht ueber eine "env:"-Indirektion:
# BROWSER=/bin/true im env-Block unten ist Absicht, nicht Zierde: der Server
# ruft bei jeder Auth-Anfrage webbrowser.open() auf; auf einem Server ohne
# GUI-Browser fallen manche Linux-Distros auf xdg-open -> www-browser (einen
# Terminal-Textbrowser) zurueck, der volle ANSI-Steuercodes auf STDOUT
# schreibt — genau den Kanal, den MCP-stdio fuer JSON braucht. Das zerstoert
# den Protokoll-Stream und laesst den Aufruf haengen/fehlschlagen. /bin/true
# macht webbrowser.open() zu einem sauberen No-op (Login-URL steht trotzdem
# in der Antwort).
# <deine Client-ID>/<dein Client-Secret>/deine@gmail.com unten ausfuellen und
# diesen Eintrag an MCP_AUTO_SERVERS anhaengen (Gmail: voller Versand erlaubt;
# Drive/Kalender: voller Lese-/Schreibzugriff — bewusste Entscheidung, siehe
# README):
# {"alias":"google","type":"stdio","command":"/root/.local/bin/uvx","args":["workspace-mcp","--single-user"],"env":{"GOOGLE_OAUTH_CLIENT_ID":"<deine Client-ID>","GOOGLE_OAUTH_CLIENT_SECRET":"<dein Client-Secret>","GOOGLE_OAUTH_REDIRECT_URI":"http://localhost:8000/oauth2callback","WORKSPACE_MCP_CREDENTIALS_DIR":"/root/muninn/google_creds","USER_GOOGLE_EMAIL":"deine@gmail.com","WORKSPACE_MCP_PERMISSIONS":"gmail:send drive:full calendar:full","BROWSER":"/bin/true"},"keywords":["mail","email","gmail","kalender","termin","google drive","drive"]}

# Optional (P3): Web-Dashboard (pipe muninn.pipe web). Standard-Bind ist NUR
# localhost — bewusst kein "0.0.0.0", damit das Dashboard nicht versehentlich
# aus dem Internet erreichbar wird. DASHBOARD_TOKEN ist ein zusaetzlicher,
# einfacher Schutz (?token=... oder Header X-Dashboard-Token) — KEIN
# vollwertiger Auth-Mechanismus. Fuer eine oeffentliche Bereitstellung gehoert
# ein Reverse-Proxy mit TLS + echter Authentifizierung davor.
DASHBOARD_BIND=127.0.0.1:8787
DASHBOARD_TOKEN=

# Optional (P4): taegliches Briefing (/briefing). BRIEFING_TIME = Uhrzeit im
# Format "HH:MM"; MUNINN_TZ_OFFSET = Sekunden-Offset der lokalen Zeitzone
# (z.B. 7200 fuer UTC+2 im Sommer, 3600 fuer UTC+1 im Winter), weil Pipe
# keinen Timezone-Builtin hat und format_time in UTC arbeitet.
BRIEFING_TIME=08:00
MUNINN_TZ_OFFSET=0
